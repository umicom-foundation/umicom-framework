# File: examples/kanban_completion/check.cmake
# PURPOSE: Exercise the public consumer in an isolated private evidence directory.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
cmake_minimum_required(VERSION 3.24)
if(NOT IS_ABSOLUTE "${PROGRAM}" OR NOT EXISTS "${PROGRAM}" OR NOT IS_ABSOLUTE "${WORK}")
    message(FATAL_ERROR "Set absolute PROGRAM and WORK paths")
endif()
set(scenarios normal blocked stale existing suffix)
if(NOT SCENARIO IN_LIST scenarios)
    message(FATAL_ERROR "Unknown completion consumer scenario")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${WORK}/run-${nonce}")
if(EXISTS "${run}")
    message(FATAL_ERROR "Refusing to reuse an evidence directory")
endif()
file(MAKE_DIRECTORY "${run}/private reviews" "${run}/elsewhere")
set(path "${run}/private reviews/review.umicompletion")
set(mode "${SCENARIO}")
set(expected 0)
if(SCENARIO STREQUAL "existing" OR SCENARIO STREQUAL "suffix")
    set(mode normal)
endif()
if(SCENARIO STREQUAL "suffix")
    set(path "${run}/private reviews/review.html")
    set(expected 2)
endif()
execute_process(COMMAND "${PROGRAM}" "${mode}" "${path}" WORKING_DIRECTORY "${run}/elsewhere"
    TIMEOUT 15 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${run}/consumer.log" "Exit: ${result}\n${output}\n${error}")
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Completion example failed; read ${run}/consumer.log")
endif()
if(SCENARIO STREQUAL "blocked" OR SCENARIO STREQUAL "suffix")
    if(EXISTS "${path}")
        message(FATAL_ERROR "Refused completion created a file")
    endif()
elseif(NOT EXISTS "${path}")
    message(FATAL_ERROR "Accepted review was not retained")
endif()
if(SCENARIO STREQUAL "existing")
    file(SHA256 "${path}" before)
    execute_process(COMMAND "${PROGRAM}" normal "${path}" WORKING_DIRECTORY "${run}/elsewhere"
        TIMEOUT 15 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${run}/existing.log" "Exit: ${result}\n${output}\n${error}")
    file(SHA256 "${path}" after)
    if(NOT "${result}" STREQUAL "2" OR NOT before STREQUAL after)
        message(FATAL_ERROR "Existing review was replaced; read ${run}/existing.log")
    endif()
endif()
message(STATUS "Completion consumer scenario ${SCENARIO} completed; evidence retained at ${run}")
