cmake_minimum_required(VERSION 3.24)
foreach(required PROGRAM SCENARIO WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Observed impact check needs ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${PROGRAM}" OR NOT EXISTS "${PROGRAM}" OR
   NOT IS_ABSOLUTE "${WORK}")
    message(FATAL_ERROR "Use an existing absolute program and absolute work root")
endif()
set(cases same source first retry union unknown-retry history-pass history-failed history-unknown-tools saved-pass saved-failed saved-unknown-tools restored-pass restored-failed restored-edited)
if(NOT SCENARIO IN_LIST cases)
    message(FATAL_ERROR "Unknown observed impact example scenario")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${WORK}/run-${nonce}")
if(EXISTS "${run}")
    message(FATAL_ERROR "Refusing to overwrite prior example evidence")
endif()
file(MAKE_DIRECTORY "${run}")
execute_process(COMMAND "${PROGRAM}" "${SCENARIO}"
    WORKING_DIRECTORY "${run}" TIMEOUT 15
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${run}/consumer.log" "Exit: ${result}\n${output}\n${error}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Observed impact example failed; read ${run}/consumer.log")
endif()
if(SCENARIO STREQUAL "same" OR SCENARIO STREQUAL "history-pass" OR SCENARIO STREQUAL "saved-pass" OR SCENARIO STREQUAL "restored-pass")
    set(expected "Selected: 0 targets | 0 tests | observation fallback: 0")
    set(identity "changes known: yes | changed: 0")
    string(FIND "${output}" "test: " test_at)
    if(NOT test_at EQUAL -1)
        message(FATAL_ERROR "Unchanged observed inputs unexpectedly selected a test")
    endif()
elseif(SCENARIO STREQUAL "source" OR SCENARIO STREQUAL "restored-edited")
    set(expected "Selected: 2 targets | 1 tests | observation fallback: 0")
    set(identity "changes known: yes | changed: 1")
    foreach(item "target: core" "target: view" "test: view.check")
        string(FIND "${output}" "${item}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Source selection omitted ${item}")
        endif()
    endforeach()
    string(FIND "${output}" "test: other.check" other_at)
    if(NOT other_at EQUAL -1)
        message(FATAL_ERROR "An independent test was selected")
    endif()
elseif(SCENARIO STREQUAL "retry" OR SCENARIO STREQUAL "history-failed" OR SCENARIO STREQUAL "saved-failed" OR SCENARIO STREQUAL "restored-failed")
    set(expected "Selected: 1 targets | 1 tests | observation fallback: 0")
    set(identity "changes known: yes | changed: 0")
    foreach(item "target: other" "test: other.check")
        string(FIND "${output}" "${item}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Required retry omitted ${item}")
        endif()
    endforeach()
    string(FIND "${output}" "test: view.check" independent)
    if(NOT independent EQUAL -1)
        message(FATAL_ERROR "Retry selected an independent test")
    endif()
elseif(SCENARIO STREQUAL "history-unknown-tools" OR SCENARIO STREQUAL "saved-unknown-tools")
    set(expected "Selected: 3 targets | 2 tests | observation fallback: 0")
    set(identity "changes known: yes | changed: 0")
    string(FIND "${output}" "Graph fallback: 1" reason)
    if(reason EQUAL -1)
        message(FATAL_ERROR "Unknown toolchain failed to request the full graph")
    endif()
elseif(SCENARIO STREQUAL "union" OR SCENARIO STREQUAL "unknown-retry")
    set(expected "Selected: 3 targets | 2 tests | observation fallback: 0")
    if(SCENARIO STREQUAL "union")
        set(identity "changes known: yes | changed: 1")
    else()
        set(identity "changes known: yes | changed: 0")
        string(FIND "${output}" "Graph fallback: 64" reason)
        if(reason EQUAL -1)
            message(FATAL_ERROR "Unknown retry did not report missing test ownership")
        endif()
    endif()
    foreach(item "test: view.check" "test: other.check")
        string(FIND "${output}" "${item}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Combined selection omitted ${item}")
        endif()
    endforeach()
else()
    set(expected "Selected: 3 targets | 2 tests | observation fallback: 1")
    set(identity "changes known: no | changed: 0")
    foreach(item "test: view.check" "test: other.check")
        string(FIND "${output}" "${item}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing-baseline fallback omitted ${item}")
        endif()
    endforeach()
endif()
foreach(fragment "${expected}" "${identity}" "This is a selection, not a build or test result.")
    string(FIND "${output}" "${fragment}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Unexpected selection output; read ${run}/consumer.log")
    endif()
endforeach()

if(SCENARIO STREQUAL "history-pass" OR SCENARIO STREQUAL "saved-pass" OR SCENARIO STREQUAL "restored-pass")
    set(history "Synthetic history: 2 considered passes | 0 required tests | reasons: 0")
elseif(SCENARIO STREQUAL "history-failed" OR SCENARIO STREQUAL "saved-failed" OR SCENARIO STREQUAL "restored-failed")
    set(history "Synthetic history: 1 considered passes | 1 required tests | reasons: 0")
elseif(SCENARIO STREQUAL "history-unknown-tools" OR SCENARIO STREQUAL "saved-unknown-tools")
    set(history "Synthetic history: 0 considered passes | 2 required tests | reasons: 16")
endif()
if(SCENARIO STREQUAL "restored-edited")
    set(history "Synthetic history: 2 considered passes | 0 required tests | reasons: 0")
endif()
if(DEFINED history)
    string(FIND "${output}" "${history}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Unexpected identified-history selection; read ${run}/consumer.log")
    endif()
endif()

if(SCENARIO MATCHES "^(saved|restored)-")
    string(FIND "${output}" "Synthetic saved report: reopened after original attempt destruction." saved)
    if(saved EQUAL -1)
        message(FATAL_ERROR "Saved scenario did not demonstrate detached evidence ownership")
    endif()
endif()
if(SCENARIO MATCHES "^restored-")
    string(FIND "${output}" "Restored source baseline: historical observation, not current source proof." restored)
    if(restored EQUAL -1)
        message(FATAL_ERROR "Restored scenario did not reopen its source baseline")
    endif()
endif()
message(STATUS "Observed impact example output retained at ${run}")
