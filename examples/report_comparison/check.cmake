# PURPOSE: Check saved-comparison consumer behavior and input preservation.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
cmake_minimum_required(VERSION 3.24)
foreach(required PROGRAM WORK SCENARIO)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Comparison example check needs ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${PROGRAM}" OR NOT EXISTS "${PROGRAM}" OR NOT IS_ABSOLUTE "${WORK}")
    message(FATAL_ERROR "Comparison example requires an absolute program and work root")
endif()
set(scenarios recovered regressed removed unchanged-failure empty malformed)
if(NOT SCENARIO IN_LIST scenarios)
    message(FATAL_ERROR "Unknown comparison example scenario")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${WORK}/run-${nonce}")
if(EXISTS "${run}")
    message(FATAL_ERROR "Comparison example refuses to reuse an evidence directory")
endif()
file(MAKE_DIRECTORY "${run}/evidence with spaces" "${run}/elsewhere")
# Positive fixtures follow CTest's exact status/time/message contract.
set(failed "<testsuite tests='1'><testcase name='example.open' status='fail' time='1'><failure message='Failed'/></testcase></testsuite>")
set(passed "<testsuite tests='1'><testcase name='example.open' status='run' time='1'/></testsuite>")
set(empty "<testsuite tests='0'></testsuite>")
set(before "${failed}")
set(after "${passed}")
set(pattern "[recovered] example.open")
set(expected 0)
if(SCENARIO STREQUAL "regressed")
    set(before "${passed}")
    set(after "${failed}")
    set(pattern "[regressed] example.open")
elseif(SCENARIO STREQUAL "removed")
    set(after "${empty}")
    set(pattern "[removed] example.open")
elseif(SCENARIO STREQUAL "unchanged-failure")
    set(after "${failed}")
    set(pattern "Unchanged outcomes: 1 | Changed: 0")
elseif(SCENARIO STREQUAL "empty")
    set(before "${empty}")
    set(after "${empty}")
    set(pattern "No outcome changes. This does not establish an all-passed result.")
elseif(SCENARIO STREQUAL "malformed")
    set(after "<testsuite>")
    set(expected 2)
    set(pattern "Comparison input refused:")
endif()
set(first "${run}/evidence with spaces/before.xml")
set(second "${run}/evidence with spaces/after.xml")
file(WRITE "${first}" "${before}")
file(WRITE "${second}" "${after}")
file(SHA256 "${first}" first_before)
file(SHA256 "${second}" second_before)
execute_process(COMMAND "${PROGRAM}" "${first}" "${second}"
    WORKING_DIRECTORY "${run}/elsewhere" TIMEOUT 15
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${run}/consumer.log" "Exit: ${result}\n${output}\n${error}")
string(FIND "${output}\n${error}" "${pattern}" found)
if(NOT "${result}" STREQUAL "${expected}" OR found LESS 0)
    message(FATAL_ERROR "Comparison example mismatch; read ${run}/consumer.log")
endif()
# Compare captured digests with the independent CMake file digest. A rejected
# pair must not print either side as accepted evidence.
if(expected EQUAL 0)
    file(SIZE "${first}" first_size)
    file(SIZE "${second}" second_size)
    string(FIND "${output}" "Baseline bytes: ${first_size} | SHA-256: ${first_before}" found_first)
    string(FIND "${output}" "Current bytes: ${second_size} | SHA-256: ${second_before}" found_second)
    if(found_first LESS 0 OR found_second LESS 0)
        message(FATAL_ERROR "Comparison consumer did not identify parsed inputs; read ${run}/consumer.log")
    endif()
else()
    string(FIND "${output}" "SHA-256:" unexpected_identity)
    if(NOT unexpected_identity LESS 0)
        message(FATAL_ERROR "Rejected pair exposed an accepted identity")
    endif()
endif()
file(SHA256 "${first}" first_after)
file(SHA256 "${second}" second_after)
if(NOT first_before STREQUAL first_after OR NOT second_before STREQUAL second_after)
    message(FATAL_ERROR "Comparison consumer changed its input files")
endif()
message(STATUS "Comparison consumer scenario ${SCENARIO} completed; evidence retained at ${run}")
