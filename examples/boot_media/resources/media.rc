/* The shared application-branding helper now embeds resource 101 from the
 * canonical ICO. Retain the previous setup-copy binding for engineering review;
 * emitting it as well would create two resources with the same identity. */
#if 0
101 ICON "umicom.ico"
#endif
102 BITMAP "umicom-logo.bmp"
1 RT_MANIFEST "media.manifest"
