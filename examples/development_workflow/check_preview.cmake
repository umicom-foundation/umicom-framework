if(NOT DEFINED TEST_PROGRAM OR NOT EXISTS "${TEST_PROGRAM}")
    message(FATAL_ERROR "Supply the built workflow example")
endif()
set(_source "${CMAKE_CURRENT_BINARY_DIR}/preview source ${SCENARIO}")
set(_build "${CMAKE_CURRENT_BINARY_DIR}/preview build ${SCENARIO}")
set(_configuration Release)
set(_resolved Release)
set(_generator "Ninja Multi-Config")
set(_expected_exit 0)
if(SCENARIO STREQUAL "debug")
    set(_configuration Debug)
    set(_resolved Debug)
elseif(SCENARIO STREQUAL "relwithdebinfo")
    set(_configuration RelWithDebInfo)
    set(_resolved RelWithDebInfo)
elseif(SCENARIO STREQUAL "default-generator")
    set(_generator Ninja)
elseif(SCENARIO STREQUAL "empty-configuration")
    set(_configuration "")
    set(_resolved Debug)
elseif(SCENARIO STREQUAL "escaped")
    # Quotes are data in the JSON preview; no filesystem path is opened.
    set(_source "${CMAKE_CURRENT_BINARY_DIR}/preview \"quoted\" source")
    set(_build "${CMAKE_CURRENT_BINARY_DIR}/preview \"quoted\" build")
elseif(SCENARIO STREQUAL "usage")
    set(_expected_exit 2)
elseif(SCENARIO STREQUAL "configuration-overflow")
    string(REPEAT "q" 128 _configuration)
    set(_expected_exit 1)
elseif(NOT SCENARIO STREQUAL "release")
    message(FATAL_ERROR "Unknown preview scenario")
endif()
if(EXISTS "${_source}" OR EXISTS "${_build}")
    message(FATAL_ERROR "Preview fixture paths must be absent before this inspection")
endif()
if(SCENARIO STREQUAL "usage")
    execute_process(COMMAND "${TEST_PROGRAM}" preview
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _json ERROR_VARIABLE _error TIMEOUT 10)
elseif(SCENARIO STREQUAL "default-generator")
    execute_process(COMMAND "${TEST_PROGRAM}" preview "${_source}" "${_build}" "${_configuration}"
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _json ERROR_VARIABLE _error TIMEOUT 10)
else()
    execute_process(COMMAND "${TEST_PROGRAM}" preview "${_source}" "${_build}" "${_configuration}" "${_generator}"
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _json ERROR_VARIABLE _error TIMEOUT 10)
endif()
if(NOT "${_exit}" STREQUAL "${_expected_exit}")
    message(FATAL_ERROR "Preview exit ${_exit}, expected ${_expected_exit}: ${_error}")
endif()
if(EXISTS "${_source}" OR EXISTS "${_build}")
    message(FATAL_ERROR "An inspection-only preview created a project or build directory")
endif()
if(NOT _expected_exit EQUAL 0)
    if(NOT _json STREQUAL "")
        message(FATAL_ERROR "A refused preview published partial JSON")
    endif()
    if(SCENARIO STREQUAL "usage")
        if(NOT _error MATCHES "^Usage:")
            message(FATAL_ERROR "Expected the preview usage diagnostic")
        endif()
    elseif(NOT _error MATCHES "^Cannot preview development plan:")
        message(FATAL_ERROR "Expected the planner refusal diagnostic")
    endif()
    return()
endif()
if(NOT _error STREQUAL "")
    message(FATAL_ERROR "Successful preview emitted an error: ${_error}")
endif()
function(expect_json expected)
    string(JSON _value ERROR_VARIABLE _json_error GET "${_json}" ${ARGN})
    if(NOT _json_error STREQUAL "NOTFOUND" OR NOT "${_value}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected JSON field ${ARGN}: ${_value}; ${_json_error}")
    endif()
endfunction()
expect_json(preview mode)
expect_json(OFF executed)
string(JSON _count LENGTH "${_json}" operations)
if(NOT _count EQUAL 3)
    message(FATAL_ERROR "Expected configure, build and test only")
endif()
set(_ids sdk.preview.configure sdk.preview.build sdk.preview.test)
set(_programs cmake cmake ctest)
set(_counts 7 4 5)
foreach(_index RANGE 0 2)
    list(GET _ids ${_index} _id)
    list(GET _programs ${_index} _program)
    list(GET _counts ${_index} _expected_count)
    expect_json("${_id}" operations ${_index} id)
    expect_json("${_program}" operations ${_index} program)
    expect_json("${_source}" operations ${_index} workingDirectory)
    string(JSON _count LENGTH "${_json}" operations ${_index} arguments)
    if(NOT _count EQUAL _expected_count)
        message(FATAL_ERROR "Unexpected argument count for ${_id}")
    endif()
endforeach()
expect_json(-S operations 0 arguments 0)
expect_json("${_source}" operations 0 arguments 1)
expect_json(-B operations 0 arguments 2)
expect_json("${_build}" operations 0 arguments 3)
expect_json(-G operations 0 arguments 4)
expect_json("${_generator}" operations 0 arguments 5)
expect_json("-DCMAKE_BUILD_TYPE=${_resolved}" operations 0 arguments 6)
expect_json(--build operations 1 arguments 0)
expect_json("${_build}" operations 1 arguments 1)
expect_json(--config operations 1 arguments 2)
expect_json("${_resolved}" operations 1 arguments 3)
expect_json(--test-dir operations 2 arguments 0)
expect_json("${_build}" operations 2 arguments 1)
expect_json(--output-on-failure operations 2 arguments 2)
expect_json(-C operations 2 arguments 3)
expect_json("${_resolved}" operations 2 arguments 4)
