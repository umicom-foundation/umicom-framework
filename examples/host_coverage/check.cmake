# PURPOSE: Check exact consumer outcomes and preserve synthetic input evidence.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
cmake_minimum_required(VERSION 3.24)
foreach(required PROGRAM WORK SCENARIO)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Coverage example check needs ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${PROGRAM}" OR NOT EXISTS "${PROGRAM}" OR NOT IS_ABSOLUTE "${WORK}")
    message(FATAL_ERROR "Coverage example requires an existing absolute program and absolute work root")
endif()
set(scenarios passed skipped stale malformed)
if(NOT SCENARIO IN_LIST scenarios)
    message(FATAL_ERROR "Unknown coverage example scenario")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${WORK}/run-${nonce}")
if(EXISTS "${run}")
    message(FATAL_ERROR "Coverage example refuses to reuse an existing evidence directory")
endif()
file(MAKE_DIRECTORY "${run}/evidence with spaces" "${run}/elsewhere")
set(report "<testsuite tests='1'><testcase name='example.open' status='run' time='1'/></testsuite>")
set(expected 0)
set(pattern "Passed: 1 \\| Outstanding: 0")
set(source "source-A")
if(SCENARIO STREQUAL "skipped")
    set(report "<testsuite tests='1'><testcase name='example.open' time='0' status='notrun'><skipped message='SKIP_RETURN_CODE=77'/></testcase></testsuite>")
    set(expected 1)
    set(pattern "\\[skipped\\]")
elseif(SCENARIO STREQUAL "stale")
    set(source "source-B")
    set(expected 1)
    set(pattern "\\[source mismatch\\]")
elseif(SCENARIO STREQUAL "malformed")
    set(report "<testsuite>")
    set(expected 2)
    set(pattern "Coverage input refused:")
endif()
set(manifest "${run}/evidence with spaces/coverage.csv")
set(xml "${run}/evidence with spaces/results.xml")
file(WRITE "${manifest}"
    "kind,host,configuration,source_identity,test,capability,report\n"
    "host,desktop,Debug,source-A,,,results.xml\n"
    "require,desktop,Debug,,example.open,GTK display,\n")
file(WRITE "${xml}" "${report}")
file(SHA256 "${manifest}" manifest_before)
file(SHA256 "${xml}" xml_before)
execute_process(COMMAND "${PROGRAM}" "${manifest}" "${source}"
    WORKING_DIRECTORY "${run}/elsewhere" TIMEOUT 15
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${run}/consumer.log" "Exit: ${result}\n${output}\n${error}")
if(NOT "${result}" STREQUAL "${expected}" OR NOT "${output}\n${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Coverage example did not produce expected exit/outcome; read ${run}/consumer.log")
endif()
file(SHA256 "${manifest}" manifest_after)
file(SHA256 "${xml}" xml_after)
if(NOT manifest_before STREQUAL manifest_after OR NOT xml_before STREQUAL xml_after)
    message(FATAL_ERROR "Coverage consumer changed its input evidence")
endif()
message(STATUS "Coverage consumer scenario ${SCENARIO} completed; evidence retained at ${run}")
