// Framework application branding now supplies canonical icon 101 and version
// metadata. Keep the former local resource for comparison, without duplicate IDs.
#if 0
101 ICON "umicom.ico"
#endif
102 BITMAP "umicom-logo.bmp"
1 RT_MANIFEST "setup.manifest"
