@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@UMICOM_STUDY_SQLITE@)
    find_dependency(SQLite3)
    include("${CMAKE_CURRENT_LIST_DIR}/UmicomSQLiteTarget.cmake")
    umicom_resolve_sqlite_target(_study_sqlite)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UmicomFrameworkTargets.cmake")
check_required_components(UmicomFramework)
