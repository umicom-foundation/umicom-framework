                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup_printf("%zu diagnostics in the first matching publication. Select a "
                                              "message, inspect its details, then open its range. An empty "
                                              "set does not prove all project analysis has finished.",
                                              UmiLanguageDiagnosticCatalogueCount(review->diagnostics))
