                                           : diagnostic.severity == 2 ? "Warning"
                                           : diagnostic.severity == 3 ? "Information"
                                                                      : "Hint";
                    char *label = g_strdup_printf(
                        "%s %llu:%llu  %s", severity, (unsigned long long)diagnostic.range.start.line + 1ULL,
