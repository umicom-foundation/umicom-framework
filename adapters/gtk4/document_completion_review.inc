static UmiStatus CompletionReviewShowDiagnostic(GtkWidget *window, CompletionReview *review);
static UmiStatus CompletionReviewShowCalls(GtkWidget *window, CompletionReview *review);
static UmiStatus CompletionReviewShowAction(GtkWidget *window, CompletionReview *review);
static CompletionReview *CompletionReviewState(GtkWidget *window)
{
    return g_object_get_data(G_OBJECT(window), "umicom-document-completion");
}
static UmiGtk4Adapter *CompletionReviewOwner(GtkWidget *window, CompletionReview *review)
{
    if (review == NULL || review->closed ||
        g_object_get_data(review->lifetime, "completion-review") != window)
        return NULL;
    UmiGtk4Adapter *owner = g_object_get_data(review->lifetime, "adapter");
    return owner != NULL && owner->edit_coordinator != NULL && owner->window != NULL &&
                   UmiGtk4WindowIsOpen(owner->window)
               ? owner
               : NULL;
}
