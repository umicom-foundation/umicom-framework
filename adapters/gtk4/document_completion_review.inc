                                  : g_strdup_printf("Code actions: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the source changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->source_diagnostics)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup_printf("%zu diagnostics in the first matching publication. Select a "
                                              "message, inspect its details, then open its range. An empty "
                                              "set does not prove all project analysis has finished.",
                                              UmiLanguageDiagnosticCatalogueCount(review->diagnostics))
                            : g_strdup_printf(
                                  "Source diagnostics: %s. Close: %s. Shutdown: %s. A server that only "
                                  "supports pull diagnostics cannot supply this capture.",
                                  umi_status_text(status), umi_status_text(work->report.close_status),
                                  umi_status_text(work->report.shutdown_status));
                }
                gtk_label_set_text(GTK_LABEL(review->message), message);
                g_free(message);
            }
            if (!review->source_diagnostics && !review->code_actions &&
                CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                gtk_widget_set_sensitive(
                    review->preview,
                    status == UMI_STATUS_OK && !review->source_information &&
                        (review->document_symbols ? UmiLanguageSymbolCatalogueCount(review->symbols) != 0U
                         : review->navigation ? (review->locations != NULL &&
                                                 UmiLanguageLocationCatalogueCount(review->locations) != 0U)
                         : review->formatting
                             ? review->formatted != NULL
                             : (review->catalogue != NULL &&
                                UmiLanguageCompletionCatalogueCount(review->catalogue) != 0U)));
            review->rendering = 0;
            if (CompletionReviewOwner(window, review) != NULL)
                gtk_widget_set_sensitive(review->request, TRUE);
        }
    }
    g_clear_object(&window);
    CompletionReviewWorkFree(work);
}
