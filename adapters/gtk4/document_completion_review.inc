/* Use a neutral fallback for new protocol kinds. The numeric value remains in
 * the catalogue so adding a presentation name never changes decoder behavior. */
static const char *CompletionReviewSymbolKind(int32_t kind)
{
    static const char *names[] = {
        "Symbol",   "File",        "Module",      "Namespace", "Package",   "Class",         "Method",
        "Property", "Field",       "Constructor", "Enum",      "Interface", "Function",      "Variable",
        "Constant", "String",      "Number",      "Boolean",   "Array",     "Object",        "Key",
        "Null",     "Enum member", "Struct",      "Event",     "Operator",  "Type parameter"};
    return kind > 0 && kind < (int32_t)(sizeof(names) / sizeof(names[0])) ? names[kind] : names[0];
}
