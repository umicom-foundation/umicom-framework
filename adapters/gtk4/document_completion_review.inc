                    if (review->signatures != NULL && CompletionReviewOwner(window, review) != NULL)
                        gtk_drop_down_set_selected(GTK_DROP_DOWN(review->choice),
                                                   active == SIZE_MAX ? GTK_INVALID_LIST_POSITION
                                                                      : (guint)active);
                    generation = review->generation;
                    if (review->signatures == NULL)
                        status = UMI_STATUS_CANCELLED;
                    else if (active != SIZE_MAX)
                        status = CompletionReviewShowSignature(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->source_information && !review->parameter_help)
            {
                const char *text = NULL;
                size_t bytes = 0U;
                status = UmiLanguageHoverDocumentText(work->hover, &text, &bytes);
                if (status == UMI_STATUS_OK)
                {
                    /* A plain text view never evaluates provider markup, opens
                     * links or treats returned examples as editor commands.
                     * The buffer copies bytes before its widget is published. */
                    GtkWidget *information = g_object_ref_sink(gtk_text_view_new());
                    gtk_text_view_set_editable(GTK_TEXT_VIEW(information), FALSE);
                    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(information), GTK_WRAP_WORD_CHAR);
                    gtk_text_view_set_monospace(GTK_TEXT_VIEW(information), TRUE);
                    gtk_text_buffer_set_text(gtk_text_view_get_buffer(GTK_TEXT_VIEW(information)), text,
                                             (gint)bytes);
                    (void)umi_gtk4_automation_tag_widget(information, "document.source-information.output");
                    gtk_accessible_update_property(GTK_ACCESSIBLE(information), GTK_ACCESSIBLE_PROPERTY_LABEL,
                                                   "Source information from the selected language server",
                                                   -1);
                    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                        gtk_box_append(GTK_BOX(review->comparison), information);
                    g_object_unref(information);
                    if (review->generation != generation)
                        status = UMI_STATUS_CANCELLED;
                }
            }
            if (CompletionReviewOwner(window, review) != NULL)
            {
                char *message =
                    status == UMI_STATUS_OK
                        ? g_strdup_printf(
                              "%zu suggestions returned. Choose one and Preview complete draft.%s",
                              UmiLanguageCompletionCatalogueCount(review->catalogue),
                              UmiLanguageCompletionCatalogueIncomplete(review->catalogue)
                                  ? " The server marked this list incomplete."
                                  : "")
                        : g_strdup_printf("Suggestions: %s. Close: %s. Shutdown: %s. Close this review and "
                                          "capture again if the source changed.",
                                          umi_status_text(status), umi_status_text(work->report.close_status),
                                          umi_status_text(work->report.shutdown_status));
                if (review->formatting && status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf(
                        "Formatting returned %zu edits. Preview the complete document before applying.",
                        UmiLanguageTextEditPreviewCount(review->formatted));
                }
                if (review->source_information)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup(work->report.choices == 0U
                                                 ? "No source information was returned at this caret."
                                                 : "Source information is shown as literal text. The source "
                                                   "document has not changed.")
                                  : g_strdup_printf("Source information: %s. Close: %s. Shutdown: %s. "
                                                    "Capture again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu locations returned. Select a destination, then Open "
                                                    "selected location. Existing unsaved drafts are kept.",
                                                    UmiLanguageLocationCatalogueCount(review->locations))
                                  : g_strdup_printf("Source navigation: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation && !review->document_symbols && !review->source_diagnostics &&
                    review->navigation_kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES &&
                    status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf("%zu syntax ranges returned, smallest first. "
                                              "Choose an enclosing range, then Select range. Source text and "
                                              "Undo remain unchanged.",
                                              UmiLanguageLocationCatalogueCount(review->locations));
                }
                if (review->document_symbols)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup_printf(
                                  "%zu %s symbols returned. Select a name, then Open selected location. %s",
                                  UmiLanguageSymbolCatalogueCount(review->symbols),
                                  work->workspace_symbols ? "project" : "document",
                                  work->workspace_symbols
                                      ? "Container names are labels; locations are explicit."
                                      : "Indentation shows explicit parent-child structure.")
                            : g_strdup_printf("Document symbols: %s. Close: %s. Shutdown: %s. Capture again "
                                              "if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->parameter_help)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf(
                                        "%zu overloads returned. Select a signature to read its parameters. "
                                        "The active parameter is marked; source text is unchanged.",
                                        UmiLanguageSignatureCatalogueCount(review->signatures))
                                  : g_strdup_printf("Parameter help: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->rename_symbol)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup("Rename proposal received. Preview the complete draft and all listed "
                                       "confirmation requests before approving.")
                        : status == UMI_STATUS_NOT_IMPLEMENTED && review->rename_details != NULL
                            ? g_strdup("This proposal affects another document or several documents. Nothing "
                                       "was applied. This review can apply only a complete proposal for its "
                                       "captured draft.")
                        : status == UMI_STATUS_NOT_FOUND
                            ? g_strdup(
                                  "No applicable rename was returned for this position. Nothing was changed.")
                            : g_strdup_printf("Rename: %s. Close: %s. Shutdown: %s. Check the new name and "
                                              "capture again if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->code_actions)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu code actions returned. Select an available "
                                                    "edit-only action, then preview its complete result. "
                                                    "Commands and unresolved actions remain unavailable.",
                                                    UmiLanguageCodeActionCatalogueCount(review->actions))
                                  : g_strdup_printf("Code actions: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the source changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->call_direction != 0)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu prepared symbols, %zu direct relationships. Select "
                                                    "a relationship, then its symbol or a call site. "
                                                    "Other unsaved drafts are not synchronized; results "
                                                    "depend on the selected server's project index.",
                                                    UmiLanguageCallResultRootCount(review->calls),
                                                    UmiLanguageCallResultCount(review->calls))
                                  : g_strdup_printf("Call inspection: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->source_diagnostics)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf(
                                        "%zu diagnostics in the complete %s. Select a message, inspect "
                                        "its details, then open its range. An empty set does not prove all "
                                        "project analysis has finished.",
                                        UmiLanguageDiagnosticCatalogueCount(review->diagnostics),
                                        work->pull_diagnostics ? "requested report" : "matching publication")
                                  : g_strdup_printf("Source diagnostics: %s. Close: %s. Shutdown: %s. Check "
                                                    "the chosen diagnostic mode "
                                                    "and capture again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                gtk_label_set_text(GTK_LABEL(review->message), message);
                g_free(message);
            }
            if (review->call_direction == 0 && !review->source_diagnostics && !review->code_actions &&
                CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                gtk_widget_set_sensitive(
                    review->preview,
                    status == UMI_STATUS_OK && !review->source_information &&
                        (review->document_symbols ? UmiLanguageSymbolCatalogueCount(review->symbols) != 0U
                         : review->navigation ? (review->locations != NULL &&
                                                 UmiLanguageLocationCatalogueCount(review->locations) != 0U)
                         : review->formatting
                             ? review->formatted != NULL
                             : (review->catalogue != NULL &&
                                UmiLanguageCompletionCatalogueCount(review->catalogue) != 0U)));
            review->rendering = 0;
            if (CompletionReviewOwner(window, review) != NULL)
                gtk_widget_set_sensitive(review->request, TRUE);
        }
    }
    g_clear_object(&window);
    CompletionReviewWorkFree(work);
}
#endif
static void CompletionReviewComplete(GObject *source, GAsyncResult *result, gpointer data)
{
    (void)source;
    (void)data;
    GTask *task = G_TASK(result);
    (void)g_task_propagate_boolean(task, NULL);
    CompletionReviewWork *work = g_task_get_task_data(task);
    g_task_set_task_data(task, NULL, NULL);
    GtkWidget *window = g_weak_ref_get(&work->window);
    CompletionReview *review = window == NULL ? NULL : CompletionReviewState(window);
    if (work->include_open_drafts && work->rename_symbol)
    {
        CompletionWorkspaceComplete(window, review, work);
        g_clear_object(&window);
        CompletionReviewWorkFree(work);
        return;
    }
    if (review != NULL && review->pending == work)
    {
        review->pending = NULL;
        g_object_set_data(G_OBJECT(window), "umicom-completion-pending", NULL);
        review->rendering = 1;
        UmiGtk4Adapter *owner = CompletionReviewOwner(window, review);
        if (owner != NULL)
        {
            UmiStatus status = work->stale || umi_cancellation_token_is_requested(work->cancel)
                                   ? UMI_STATUS_CANCELLED
                                   : work->status;
            if (status == UMI_STATUS_OK)
                status = UmiDocumentSourceRequestCheck(owner->edit_coordinator, review->source);
            if (status == UMI_STATUS_OK && review->code_actions && work->include_open_drafts)
            {
                status = UmiDocumentSourceWorkspaceCheck(owner->edit_coordinator, review->workspace_sources);
                if (status == UMI_STATUS_OK)
                    review->workspace_actions = 1;
            }
            uint64_t generation = review->generation;
            if (review->rename_symbol && work->rename_details != NULL && !work->stale &&
                !umi_cancellation_token_is_requested(work->cancel))
            {
                UmiStatus current = UmiDocumentSourceRequestCheck(owner->edit_coordinator, review->source);
                if (current != UMI_STATUS_OK)
                    status = current;
                else
                {
                    g_free(review->rename_details);
                    review->rename_details = work->rename_details;
                    work->rename_details = NULL;
                    GtkWidget *notes = CompletionRenameNotes(review->rename_details);
                    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                        gtk_box_append(GTK_BOX(review->comparison), notes);
                    g_object_unref(notes);
                    if (review->generation != generation || CompletionReviewOwner(window, review) == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
            }
            if (status == UMI_STATUS_OK && review->formatting)
            {
                UmiLanguageTextEditPreviewDestroy(review->formatted);
                review->formatted = work->formatted;
                work->formatted = NULL;
            }
            if (status == UMI_STATUS_OK && !review->code_actions && !review->formatting &&
                !review->source_information && !review->navigation)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageCompletionCatalogueCount(work->catalogue); ++i)
                {
                    UmiLanguageCompletionChoice choice;
                    status = UmiLanguageCompletionCatalogueAt(work->catalogue, i, &choice);
                    if (status != UMI_STATUS_OK)
                        break;
                    gtk_string_list_append(labels, choice.label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageCompletionCatalogueDestroy(review->catalogue);
                    review->catalogue = work->catalogue;
                    work->catalogue = NULL;
                    /* set_model borrows a reference. Keep and release our own
                     * list; unlike gtk_drop_down_new it does not take ownership. */
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    /* A settings observer may have invalidated the catalogue
                     * while the dropdown announced its new selection. */
                    if (review->catalogue == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->call_direction != 0)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageCallResultCount(work->calls); ++i)
                {
                    UmiLanguageCallRelation relation;
                    status = UmiLanguageCallResultAt(work->calls, i, &relation);
                    if (status != UMI_STATUS_OK)
                        break;
                    char *label = g_strdup_printf(
                        "%s -> %s (%zu call sites)",
                        work->call_direction == UMI_LANGUAGE_CALL_INCOMING ? relation.related.name
                                                                           : relation.root.name,
                        work->call_direction == UMI_LANGUAGE_CALL_INCOMING ? relation.root.name
                                                                           : relation.related.name,
                        relation.call_sites);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageCallResultDestroy(review->calls);
                    review->calls = work->calls;
                    work->calls = NULL;
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->calls == NULL || CompletionReviewOwner(window, review) == NULL ||
                        review->generation != generation)
                        status = UMI_STATUS_CANCELLED;
                    else if (UmiLanguageCallResultCount(review->calls) != 0U)
                        status = CompletionReviewShowCalls(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->source_diagnostics)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageDiagnosticCatalogueCount(work->diagnostics); ++i)
                {
                    UmiLanguageDiagnostic diagnostic;
                    status = UmiLanguageDiagnosticCatalogueAt(work->diagnostics, i, &diagnostic);
                    if (status != UMI_STATUS_OK)
                        break;
                    const char *severity = diagnostic.severity == 1   ? "Error"
                                           : diagnostic.severity == 2 ? "Warning"
                                           : diagnostic.severity == 3 ? "Information"
                                                                      : "Hint";
                    char *label = g_strdup_printf(
                        "%s %llu:%llu  %s", severity, (unsigned long long)diagnostic.range.start.line + 1ULL,
                        (unsigned long long)diagnostic.range.start.utf16_column + 1ULL, diagnostic.message);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageDiagnosticCatalogueDestroy(review->diagnostics);
                    review->diagnostics = work->diagnostics;
                    work->diagnostics = NULL;
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->diagnostics == NULL)
                        status = UMI_STATUS_CANCELLED;
                    else if (UmiLanguageDiagnosticCatalogueCount(review->diagnostics) != 0U)
                        status = CompletionReviewShowDiagnostic(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->code_actions)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageCodeActionCatalogueCount(work->actions); ++i)
                {
                    UmiLanguageCodeAction action;
                    status = UmiLanguageCodeActionCatalogueAt(work->actions, i, &action);
                    if (status != UMI_STATUS_OK)
                        break;
                    char *label =
                        g_strdup_printf("%s%s%s", action.title, action.preferred ? " [preferred]" : "",
                                        action.disabled      ? " [unavailable]"
                                        : action.has_command ? " [requires command]"
                                        : !action.has_edit   ? " [requires resolution]"
                                                             : "");
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageCodeActionCatalogueDestroy(review->actions);
                    review->actions = work->actions;
                    work->actions = NULL;
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->actions == NULL)
                        status = UMI_STATUS_CANCELLED;
                    else if (UmiLanguageCodeActionCatalogueCount(review->actions) != 0U)
                        status = CompletionReviewShowAction(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->navigation && !review->document_symbols &&
                !review->source_diagnostics && review->call_direction == 0)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageLocationCatalogueCount(work->locations); ++i)
                {
                    UmiLanguageSourceLocation location;
                    status = UmiLanguageLocationCatalogueAt(work->locations, i, &location);
                    if (status != UMI_STATUS_OK)
                        break;
                    char *label=work->navigation_kind==UMI_LANGUAGE_NAVIGATION_FOLDING_RANGES
                        ? g_strdup_printf("%zu. Region from line %llu to %llu:%llu (end excluded)",i+1U,
                            (unsigned long long)location.selection.start.line+1ULL,
                            (unsigned long long)location.selection.end.line+1ULL,
                            (unsigned long long)location.selection.end.utf16_column+1ULL)
                        : work->navigation_kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES
                                      ? g_strdup_printf(
                                            "%zu. %llu:%llu to %llu:%llu%s", i + 1U,
                                            (unsigned long long)location.selection.start.line + 1ULL,
                                            (unsigned long long)location.selection.start.utf16_column + 1ULL,
                                            (unsigned long long)location.selection.end.line + 1ULL,
                                            (unsigned long long)location.selection.end.utf16_column + 1ULL,
                                            i == 0U ? " (smallest reported range)" : " (enclosing range)")
                                      : g_strdup_printf(
                                            "%s  —  %llu:%llu", location.uri,
                                            (unsigned long long)location.selection.start.line + 1ULL,
                                            (unsigned long long)location.selection.start.utf16_column + 1ULL);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageLocationCatalogueDestroy(review->locations);
                    review->locations = work->locations;
                    work->locations = NULL;
                    /* set_model borrows the list; the form owns its complete
                     * location catalogue separately from the displayed labels. */
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->locations == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->document_symbols)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageSymbolCatalogueCount(work->symbols); ++i)
                {
                    UmiLanguageSymbol symbol;
                    status = UmiLanguageSymbolCatalogueAt(work->symbols, i, &symbol);
                    if (status != UMI_STATUS_OK)
                        break;
                    char *label = g_strdup_printf(
                        "%*s%s [%s%s]  %s:%llu:%llu  %s%s%s", (int)(symbol.depth * 2U), "", symbol.name,
                        CompletionReviewSymbolKind(symbol.kind), symbol.deprecated ? ", deprecated" : "",
                        symbol.location.uri, (unsigned long long)symbol.location.selection.start.line + 1ULL,
                        (unsigned long long)symbol.location.selection.start.utf16_column + 1ULL,
                        symbol.detail, symbol.container[0] == '\0' ? "" : "  in ", symbol.container);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageSymbolCatalogueDestroy(review->symbols);
                    review->symbols = work->symbols;
                    work->symbols = NULL;
                    /* The dropdown borrows its model. Keep the decoded rows
                     * separate so a label never becomes a navigation command. */
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->symbols == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->parameter_help)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageSignatureCatalogueCount(work->signatures); ++i)
                {
                    UmiLanguageSignature signature;
                    status = UmiLanguageSignatureCatalogueAt(work->signatures, i, &signature);
                    if (status != UMI_STATUS_OK)
                        break;
                    gtk_string_list_append(labels, signature.label);
                }
                if (status == UMI_STATUS_OK)
                {
                    size_t active = UmiLanguageSignatureCatalogueActive(work->signatures);
                    UmiLanguageSignatureCatalogueDestroy(review->signatures);
                    review->signatures = work->signatures;
                    work->signatures = NULL;
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    if (review->signatures != NULL && CompletionReviewOwner(window, review) != NULL)
                        gtk_drop_down_set_selected(GTK_DROP_DOWN(review->choice),
                                                   active == SIZE_MAX ? GTK_INVALID_LIST_POSITION
                                                                      : (guint)active);
                    generation = review->generation;
                    if (review->signatures == NULL)
                        status = UMI_STATUS_CANCELLED;
                    else if (active != SIZE_MAX)
                        status = CompletionReviewShowSignature(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->source_information && !review->parameter_help)
            {
                const char *text = NULL;
                size_t bytes = 0U;
                status = UmiLanguageHoverDocumentText(work->hover, &text, &bytes);
                if (status == UMI_STATUS_OK)
                {
                    /* A plain text view never evaluates provider markup, opens
                     * links or treats returned examples as editor commands.
                     * The buffer copies bytes before its widget is published. */
                    GtkWidget *information = g_object_ref_sink(gtk_text_view_new());
                    gtk_text_view_set_editable(GTK_TEXT_VIEW(information), FALSE);
                    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(information), GTK_WRAP_WORD_CHAR);
                    gtk_text_view_set_monospace(GTK_TEXT_VIEW(information), TRUE);
                    gtk_text_buffer_set_text(gtk_text_view_get_buffer(GTK_TEXT_VIEW(information)), text,
                                             (gint)bytes);
                    (void)umi_gtk4_automation_tag_widget(information, "document.source-information.output");
                    gtk_accessible_update_property(GTK_ACCESSIBLE(information), GTK_ACCESSIBLE_PROPERTY_LABEL,
                                                   "Source information from the selected language server",
                                                   -1);
                    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                        gtk_box_append(GTK_BOX(review->comparison), information);
                    g_object_unref(information);
                    if (review->generation != generation)
                        status = UMI_STATUS_CANCELLED;
                }
            }
            if (CompletionReviewOwner(window, review) != NULL)
            {
                char *message =
                    status == UMI_STATUS_OK
                        ? g_strdup_printf(
                              "%zu suggestions returned. Choose one and Preview complete draft.%s",
                              UmiLanguageCompletionCatalogueCount(review->catalogue),
                              UmiLanguageCompletionCatalogueIncomplete(review->catalogue)
                                  ? " The server marked this list incomplete."
                                  : "")
                        : g_strdup_printf("Suggestions: %s. Close: %s. Shutdown: %s. Close this review and "
                                          "capture again if the source changed.",
                                          umi_status_text(status), umi_status_text(work->report.close_status),
                                          umi_status_text(work->report.shutdown_status));
                if (review->formatting && status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf(
                        "Formatting returned %zu edits. Preview the complete document before applying.",
                        UmiLanguageTextEditPreviewCount(review->formatted));
                }
                if (review->source_information)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup(work->report.choices == 0U
                                                 ? "No source information was returned at this caret."
                                                 : "Source information is shown as literal text. The source "
                                                   "document has not changed.")
                                  : g_strdup_printf("Source information: %s. Close: %s. Shutdown: %s. "
                                                    "Capture again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu locations returned. Select a destination, then Open "
                                                    "selected location. Existing unsaved drafts are kept.",
                                                    UmiLanguageLocationCatalogueCount(review->locations))
                                  : g_strdup_printf("Source navigation: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation && !review->document_symbols && !review->source_diagnostics &&
                    review->navigation_kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES &&
                    status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf("%zu syntax ranges returned, smallest first. "
                                              "Choose an enclosing range, then Select range. Source text and "
                                              "Undo remain unchanged.",
                                              UmiLanguageLocationCatalogueCount(review->locations));
                }
                if(review->navigation && !review->document_symbols && !review->source_diagnostics &&
                    review->navigation_kind==UMI_LANGUAGE_NAVIGATION_FOLDING_RANGES && status==UMI_STATUS_OK) {
                    g_free(message);message=g_strdup_printf("%zu complete-line regions returned. Choose a region and Select region, "
                        "then use the editor's Fold selection command. Discovery does not hide text or edit the draft. "
                        "A single-line region has no body to collapse.",UmiLanguageLocationCatalogueCount(review->locations));
                }
                if (review->document_symbols)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup_printf(
                                  "%zu %s symbols returned. Select a name, then Open selected location. %s",
                                  UmiLanguageSymbolCatalogueCount(review->symbols),
                                  work->workspace_symbols ? "project" : "document",
                                  work->workspace_symbols
                                      ? "Container names are labels; locations are explicit."
                                      : "Indentation shows explicit parent-child structure.")
                            : g_strdup_printf("Document symbols: %s. Close: %s. Shutdown: %s. Capture again "
                                              "if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->parameter_help)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf(
                                        "%zu overloads returned. Select a signature to read its parameters. "
                                        "The active parameter is marked; source text is unchanged.",
                                        UmiLanguageSignatureCatalogueCount(review->signatures))
                                  : g_strdup_printf("Parameter help: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->rename_symbol)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup("Rename proposal received. Preview the complete draft and all listed "
                                       "confirmation requests before approving.")
                        : status == UMI_STATUS_NOT_IMPLEMENTED && review->rename_details != NULL
                            ? g_strdup("This proposal affects another document or several documents. Nothing "
                                       "was applied. This review can apply only a complete proposal for its "
                                       "captured draft.")
                        : status == UMI_STATUS_NOT_FOUND
                            ? g_strdup(
                                  "No applicable rename was returned for this position. Nothing was changed.")
                            : g_strdup_printf("Rename: %s. Close: %s. Shutdown: %s. Check the new name and "
                                              "capture again if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->code_actions)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu code actions returned. Select an available "
                                                    "edit-only action, then preview its complete result. "
                                                    "Commands and unresolved actions remain unavailable.",
                                                    UmiLanguageCodeActionCatalogueCount(review->actions))
                                  : g_strdup_printf("Code actions: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the source changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->call_direction != 0)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu prepared symbols, %zu direct relationships. Select "
                                                    "a relationship, then its symbol or a call site. "
                                                    "Other unsaved drafts are not synchronized; results "
                                                    "depend on the selected server's project index.",
                                                    UmiLanguageCallResultRootCount(review->calls),
                                                    UmiLanguageCallResultCount(review->calls))
                                  : g_strdup_printf("Call inspection: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->source_diagnostics)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf(
                                        "%zu diagnostics in the complete %s. Select a message, inspect "
                                        "its details, then open its range. An empty set does not prove all "
                                        "project analysis has finished.",
                                        UmiLanguageDiagnosticCatalogueCount(review->diagnostics),
                                        work->pull_diagnostics ? "requested report" : "matching publication")
                                  : g_strdup_printf("Source diagnostics: %s. Close: %s. Shutdown: %s. Check "
                                                    "the chosen diagnostic mode "
                                                    "and capture again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                gtk_label_set_text(GTK_LABEL(review->message), message);
                g_free(message);
            }
            if (review->call_direction == 0 && !review->source_diagnostics && !review->code_actions &&
                CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                gtk_widget_set_sensitive(
                    review->preview,
                    status == UMI_STATUS_OK && !review->source_information &&
                        (review->document_symbols ? UmiLanguageSymbolCatalogueCount(review->symbols) != 0U
                         : review->navigation ? (review->locations != NULL &&
                                                 UmiLanguageLocationCatalogueCount(review->locations) != 0U)
                         : review->formatting
                             ? review->formatted != NULL
                             : (review->catalogue != NULL &&
                                UmiLanguageCompletionCatalogueCount(review->catalogue) != 0U)));
            review->rendering = 0;
            if (CompletionReviewOwner(window, review) != NULL)
                gtk_widget_set_sensitive(review->request, TRUE);
        }
    }
    g_clear_object(&window);
    CompletionReviewWorkFree(work);
}
