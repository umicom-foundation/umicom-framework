     * construction observers may close or replace Studio's document binding. */
    gchar *folder = g_strdup(workspace_folder == NULL ? "" : workspace_folder);
    GObject *lifetime = g_object_ref(adapter->edit_lifetime);
    GtkWindow *parent = g_object_ref(adapter->window);
    GtkWidget *window = gtk_window_new();
    g_object_ref(window);
    CompletionReview *review = g_new0(CompletionReview, 1);
    review->lifetime = g_object_ref(lifetime);
    review->source = source;
