        status = UMI_STATUS_INVALID_ARGUMENT;
    gchar *uri = status == UMI_STATUS_OK ? g_filename_to_uri(work->directory, NULL, NULL) : NULL;
    if (status == UMI_STATUS_OK)
        status =
            uri == NULL ? UMI_STATUS_INVALID_ARGUMENT : umi_text_copy(work->root, sizeof(work->root), uri);
