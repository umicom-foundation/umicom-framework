                g_string_append_printf(text, "; explanation %zu", edit.annotation + 1U);
            g_string_append_c(text, '\n');
        }
    }
    if (UmiLanguageWorkspaceEditCatalogueAnnotationCount(catalogue) != 0U)
        g_string_append(text, "\nChange explanations\n");
    for (size_t i = 0U; i < UmiLanguageWorkspaceEditCatalogueAnnotationCount(catalogue); ++i)
    {
        UmiLanguageWorkspaceChangeAnnotation annotation;
        if (UmiLanguageWorkspaceEditCatalogueAnnotation(catalogue, i, &annotation) != UMI_STATUS_OK)
            continue;
        g_string_append_printf(text, "\nExplanation %zu\n%s%s\n%s\n", i + 1U,
                               annotation.needs_confirmation ? "Confirmation required: " : "",
                               annotation.label, annotation.description);
    }
    return g_string_free(text, FALSE);
}
