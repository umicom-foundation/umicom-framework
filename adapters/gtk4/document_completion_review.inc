/* Build an owned presentation before calling GTK: a widget observer can change
 * settings and release the catalogue while the new text view is constructed. */
static UmiStatus CompletionReviewShowSignature(GtkWidget *window, CompletionReview *review)
{
    UmiGtk4Adapter *owner = CompletionReviewOwner(window, review);
    if (owner == NULL || review->signatures == NULL)
        return UMI_STATUS_CANCELLED;
    UmiStatus status = UmiDocumentSourceRequestCheck(owner->edit_coordinator, review->source);
    if (status != UMI_STATUS_OK)
        return status;
    size_t selected = gtk_drop_down_get_selected(GTK_DROP_DOWN(review->choice));
    UmiLanguageSignature signature;
    status = UmiLanguageSignatureCatalogueAt(review->signatures, selected, &signature);
    if (status != UMI_STATUS_OK)
        return status;
    GString *text = g_string_new(signature.label);
    if (signature.documentation.text[0] != '\0')
        g_string_append_printf(text, "\n\n%s", signature.documentation.text);
    size_t first = 0U, last = 0U;
    int highlight = 0;
    for (size_t i = 0U; i < signature.parameter_count; ++i)
    {
        UmiLanguageSignatureParameter parameter;
        status = UmiLanguageSignatureCatalogueParameter(review->signatures, selected, i, &parameter);
        if (status != UMI_STATUS_OK)
            break;
        g_string_append_printf(text, "\n\n%sParameter %zu: %s",
                               i == signature.active_parameter ? "Active " : "", i + 1U, parameter.label);
        if (parameter.documentation.text[0] != '\0')
            g_string_append_printf(text, "\n%s", parameter.documentation.text);
        if (i == signature.active_parameter && parameter.has_label_span)
        {
            first = parameter.start_byte;
            last = parameter.end_byte;
            highlight = 1;
        }
    }
    if (status != UMI_STATUS_OK)
    {
        g_string_free(text, TRUE);
        return status;
    }
    uint64_t generation = review->generation;
    GtkWidget *view = g_object_ref_sink(gtk_text_view_new());
    gtk_text_view_set_editable(GTK_TEXT_VIEW(view), FALSE);
    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(view), GTK_WRAP_WORD_CHAR);
    gtk_text_view_set_monospace(GTK_TEXT_VIEW(view), TRUE);
    GtkTextBuffer *buffer = gtk_text_view_get_buffer(GTK_TEXT_VIEW(view));
    gtk_text_buffer_set_text(buffer, text->str, (gint)text->len);
    if (highlight)
    {
        GtkTextIter begin, end;
        gtk_text_buffer_get_iter_at_offset(buffer, &begin,
                                           (gint)g_utf8_pointer_to_offset(text->str, text->str + first));
        gtk_text_buffer_get_iter_at_offset(buffer, &end,
                                           (gint)g_utf8_pointer_to_offset(text->str, text->str + last));
        GtkTextTag *tag =
            gtk_text_buffer_create_tag(buffer, "active-parameter", "weight", PANGO_WEIGHT_BOLD, NULL);
        gtk_text_buffer_apply_tag(buffer, tag, &begin, &end);
    }
    g_string_free(text, TRUE);
    (void)umi_gtk4_automation_tag_widget(view, "document.parameter-help.output");
    gtk_accessible_update_property(GTK_ACCESSIBLE(view), GTK_ACCESSIBLE_PROPERTY_LABEL,
                                   "Function signatures and parameter documentation", -1);
    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
        gtk_box_append(GTK_BOX(review->comparison), view);
    else
        status = UMI_STATUS_CANCELLED;
    g_object_unref(view);
    if (review->generation != generation)
        status = UMI_STATUS_CANCELLED;
    return status;
}
