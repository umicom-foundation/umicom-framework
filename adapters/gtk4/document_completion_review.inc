                                            (unsigned long long)location.selection.end.line + 1ULL,
                                            (unsigned long long)location.selection.end.utf16_column + 1ULL,
                                            i == 0U ? " (smallest reported range)" : " (enclosing range)")
                                      : g_strdup_printf(
                                            "%s  —  %llu:%llu", location.uri,
                                            (unsigned long long)location.selection.start.line + 1ULL,
                                            (unsigned long long)location.selection.start.utf16_column + 1ULL);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageLocationCatalogueDestroy(review->locations);
                    review->locations = work->locations;
                    work->locations = NULL;
                    /* set_model borrows the list; the form owns its complete
                     * location catalogue separately from the displayed labels. */
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->locations == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->document_symbols)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageSymbolCatalogueCount(work->symbols); ++i)
                {
                    UmiLanguageSymbol symbol;
                    status = UmiLanguageSymbolCatalogueAt(work->symbols, i, &symbol);
                    if (status != UMI_STATUS_OK)
                        break;
                    char *label = g_strdup_printf(
                        "%*s%s [%s%s]  %s:%llu:%llu  %s%s%s", (int)(symbol.depth * 2U), "", symbol.name,
                        CompletionReviewSymbolKind(symbol.kind), symbol.deprecated ? ", deprecated" : "",
                        symbol.location.uri, (unsigned long long)symbol.location.selection.start.line + 1ULL,
                        (unsigned long long)symbol.location.selection.start.utf16_column + 1ULL,
                        symbol.detail, symbol.container[0] == '\0' ? "" : "  in ", symbol.container);
                    gtk_string_list_append(labels, label);
                    g_free(label);
                }
                if (status == UMI_STATUS_OK)
                {
                    UmiLanguageSymbolCatalogueDestroy(review->symbols);
                    review->symbols = work->symbols;
                    work->symbols = NULL;
                    /* The dropdown borrows its model. Keep the decoded rows
                     * separate so a label never becomes a navigation command. */
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    generation = review->generation;
                    if (review->symbols == NULL)
                        status = UMI_STATUS_CANCELLED;
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->parameter_help)
            {
                GtkStringList *labels = gtk_string_list_new(NULL);
                for (size_t i = 0U; i < UmiLanguageSignatureCatalogueCount(work->signatures); ++i)
                {
                    UmiLanguageSignature signature;
                    status = UmiLanguageSignatureCatalogueAt(work->signatures, i, &signature);
                    if (status != UMI_STATUS_OK)
                        break;
                    gtk_string_list_append(labels, signature.label);
                }
                if (status == UMI_STATUS_OK)
                {
                    size_t active = UmiLanguageSignatureCatalogueActive(work->signatures);
                    UmiLanguageSignatureCatalogueDestroy(review->signatures);
                    review->signatures = work->signatures;
                    work->signatures = NULL;
                    gtk_drop_down_set_model(GTK_DROP_DOWN(review->choice), G_LIST_MODEL(labels));
                    if (review->signatures != NULL && CompletionReviewOwner(window, review) != NULL)
                        gtk_drop_down_set_selected(GTK_DROP_DOWN(review->choice),
                                                   active == SIZE_MAX ? GTK_INVALID_LIST_POSITION
                                                                      : (guint)active);
                    generation = review->generation;
                    if (review->signatures == NULL)
                        status = UMI_STATUS_CANCELLED;
                    else if (active != SIZE_MAX)
                        status = CompletionReviewShowSignature(window, review);
                }
                g_object_unref(labels);
            }
            if (status == UMI_STATUS_OK && review->source_information && !review->parameter_help)
            {
                const char *text = NULL;
                size_t bytes = 0U;
                status = UmiLanguageHoverDocumentText(work->hover, &text, &bytes);
                if (status == UMI_STATUS_OK)
                {
                    /* A plain text view never evaluates provider markup, opens
                     * links or treats returned examples as editor commands.
                     * The buffer copies bytes before its widget is published. */
                    GtkWidget *information = g_object_ref_sink(gtk_text_view_new());
                    gtk_text_view_set_editable(GTK_TEXT_VIEW(information), FALSE);
                    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(information), GTK_WRAP_WORD_CHAR);
                    gtk_text_view_set_monospace(GTK_TEXT_VIEW(information), TRUE);
                    gtk_text_buffer_set_text(gtk_text_view_get_buffer(GTK_TEXT_VIEW(information)), text,
                                             (gint)bytes);
                    (void)umi_gtk4_automation_tag_widget(information, "document.source-information.output");
                    gtk_accessible_update_property(GTK_ACCESSIBLE(information), GTK_ACCESSIBLE_PROPERTY_LABEL,
                                                   "Source information from the selected language server",
                                                   -1);
                    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
                        gtk_box_append(GTK_BOX(review->comparison), information);
                    g_object_unref(information);
                    if (review->generation != generation)
                        status = UMI_STATUS_CANCELLED;
                }
            }
            if (CompletionReviewOwner(window, review) != NULL)
            {
                char *message =
                    status == UMI_STATUS_OK
                        ? g_strdup_printf(
                              "%zu suggestions returned. Choose one and Preview complete draft.%s",
                              UmiLanguageCompletionCatalogueCount(review->catalogue),
                              UmiLanguageCompletionCatalogueIncomplete(review->catalogue)
                                  ? " The server marked this list incomplete."
                                  : "")
                        : g_strdup_printf("Suggestions: %s. Close: %s. Shutdown: %s. Close this review and "
                                          "capture again if the source changed.",
                                          umi_status_text(status), umi_status_text(work->report.close_status),
                                          umi_status_text(work->report.shutdown_status));
                if (review->formatting && status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf(
                        "Formatting returned %zu edits. Preview the complete document before applying.",
                        UmiLanguageTextEditPreviewCount(review->formatted));
                }
                if (review->source_information)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup(work->report.choices == 0U
                                                 ? "No source information was returned at this caret."
                                                 : "Source information is shown as literal text. The source "
                                                   "document has not changed.")
                                  : g_strdup_printf("Source information: %s. Close: %s. Shutdown: %s. "
                                                    "Capture again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu locations returned. Select a destination, then Open "
                                                    "selected location. Existing unsaved drafts are kept.",
                                                    UmiLanguageLocationCatalogueCount(review->locations))
                                  : g_strdup_printf("Source navigation: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->navigation && !review->document_symbols && !review->source_diagnostics &&
                    review->navigation_kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES &&
                    status == UMI_STATUS_OK)
                {
                    g_free(message);
                    message = g_strdup_printf("%zu syntax ranges returned, smallest first. "
                                              "Choose an enclosing range, then Select range. Source text and "
                                              "Undo remain unchanged.",
                                              UmiLanguageLocationCatalogueCount(review->locations));
                }
                if (review->document_symbols)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup_printf(
                                  "%zu %s symbols returned. Select a name, then Open selected location. %s",
                                  UmiLanguageSymbolCatalogueCount(review->symbols),
                                  work->workspace_symbols ? "project" : "document",
                                  work->workspace_symbols
                                      ? "Container names are labels; locations are explicit."
                                      : "Indentation shows explicit parent-child structure.")
                            : g_strdup_printf("Document symbols: %s. Close: %s. Shutdown: %s. Capture again "
                                              "if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->parameter_help)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf(
                                        "%zu overloads returned. Select a signature to read its parameters. "
                                        "The active parameter is marked; source text is unchanged.",
                                        UmiLanguageSignatureCatalogueCount(review->signatures))
                                  : g_strdup_printf("Parameter help: %s. Close: %s. Shutdown: %s. Capture "
                                                    "again if the draft changed.",
                                                    umi_status_text(status),
                                                    umi_status_text(work->report.close_status),
                                                    umi_status_text(work->report.shutdown_status));
                }
                if (review->rename_symbol)
                {
                    g_free(message);
                    message =
                        status == UMI_STATUS_OK
                            ? g_strdup("Rename proposal received. Preview the complete draft and all listed "
                                       "confirmation requests before approving.")
                        : status == UMI_STATUS_NOT_IMPLEMENTED && review->rename_details != NULL
                            ? g_strdup("This proposal affects another document or several documents. Nothing "
                                       "was applied. This review can apply only a complete proposal for its "
                                       "captured draft.")
                        : status == UMI_STATUS_NOT_FOUND
                            ? g_strdup(
                                  "No applicable rename was returned for this position. Nothing was changed.")
                            : g_strdup_printf("Rename: %s. Close: %s. Shutdown: %s. Check the new name and "
                                              "capture again if the draft changed.",
                                              umi_status_text(status),
                                              umi_status_text(work->report.close_status),
                                              umi_status_text(work->report.shutdown_status));
                }
                if (review->code_actions)
                {
                    g_free(message);
                    message = status == UMI_STATUS_OK
                                  ? g_strdup_printf("%zu code actions returned. Select an available "
                                                    "edit-only action, then preview its complete result. "
                                                    "Commands and unresolved actions remain unavailable.",
