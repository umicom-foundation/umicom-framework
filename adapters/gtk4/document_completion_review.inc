    CompletionReview *review = CompletionReviewState(window);
    UmiGtk4Adapter *owner = CompletionReviewOwner(window, review);
    if (owner == NULL || UmiGtk4AdapterReplacementReviewBusy(owner) || review->pending != NULL ||
        review->preference_pending != NULL || review->rendering)
    {
        g_object_unref(window);
        return;
    }
    review->rendering = 1;
    CompletionReviewInvalidate(review);
    UmiLanguageCompletionCatalogueDestroy(review->catalogue);
    review->catalogue = NULL;
    UmiLanguageTextEditPreviewDestroy(review->formatted);
    UmiLanguageLocationCatalogueDestroy(review->locations);
    UmiLanguageSymbolCatalogueDestroy(review->symbols);
    UmiLanguageCallResultDestroy(review->calls);
    review->calls = NULL;
    UmiLanguageSignatureCatalogueDestroy(review->signatures);
    UmiLanguageCodeActionCatalogueDestroy(review->actions);
    UmiLanguageDiagnosticCatalogueDestroy(review->diagnostics);
    review->diagnostics = NULL;
    review->actions = NULL;
    g_clear_pointer(&review->rename_details, g_free);
    review->signatures = NULL;
    review->symbols = NULL;
    review->locations = NULL;
    review->formatted = NULL;
    owner = CompletionReviewOwner(window, review);
    UmiStatus status = owner == NULL ? UMI_STATUS_CANCELLED
                                     : UmiDocumentSourceRequestCheck(owner->edit_coordinator, review->source);
    CompletionReviewWork *work = g_try_new0(CompletionReviewWork, 1);
    if (work == NULL)
        status = UMI_STATUS_OUT_OF_MEMORY;
    if (work != NULL)
        g_weak_ref_init(&work->window, window);
    if (status == UMI_STATUS_OK)
    {
        work->formatting = review->formatting;
        work->format_selection = review->formatting && !review->rename_symbol &&
                                 review->format_selection != NULL &&
                                 gtk_check_button_get_active(GTK_CHECK_BUTTON(review->format_selection));

        work->source_information = review->source_information;
        work->navigation = review->navigation;
        work->call_direction = review->call_direction;
        work->document_symbols = review->document_symbols;
        work->workspace_symbols = review->document_symbols && review->workspace_symbols != NULL &&
                                  gtk_check_button_get_active(GTK_CHECK_BUTTON(review->workspace_symbols));
        if (work->workspace_symbols)
            status = umi_text_copy(work->symbol_query, sizeof(work->symbol_query),
                                   gtk_editable_get_text(GTK_EDITABLE(review->symbol_query)));

        work->parameter_help = review->parameter_help;
        work->rename_symbol = review->rename_symbol;
        work->include_open_drafts =
            (review->rename_symbol || review->code_actions) && review->include_open_drafts != NULL &&
            gtk_check_button_get_active(GTK_CHECK_BUTTON(review->include_open_drafts));
        work->code_actions = review->code_actions;
        work->resolve_actions = review->code_actions && review->resolve_actions != NULL &&
                                gtk_check_button_get_active(GTK_CHECK_BUTTON(review->resolve_actions));

        if (review->code_actions && review->action_filter != NULL)
        {
            guint selected = gtk_drop_down_get_selected(GTK_DROP_DOWN(review->action_filter));
            if (selected > (guint)UMI_LANGUAGE_ACTION_FILTER_FIX_ALL)
                status = UMI_STATUS_INVALID_ARGUMENT;
            else
                work->action_filter = (UmiLanguageCodeActionFilter)selected;
        }

        work->source_diagnostics = review->source_diagnostics;
        work->pull_diagnostics =
            (review->source_diagnostics ||
             (review->code_actions && review->include_diagnostics != NULL &&
              gtk_check_button_get_active(GTK_CHECK_BUTTON(review->include_diagnostics)))) &&
            review->pull_diagnostics != NULL &&
            gtk_check_button_get_active(GTK_CHECK_BUTTON(review->pull_diagnostics));
        work->diagnostic_context = review->code_actions && review->include_diagnostics != NULL &&
                                   gtk_check_button_get_active(GTK_CHECK_BUTTON(review->include_diagnostics));
        if (review->rename_symbol)
            status = umi_text_copy(work->new_name, sizeof(work->new_name),
                                   gtk_editable_get_text(GTK_EDITABLE(review->new_name)));
        work->navigation_kind = review->navigation_kind;
        if (review->navigation && review->include_declaration != NULL)
            work->include_declaration =
                gtk_check_button_get_active(GTK_CHECK_BUTTON(review->include_declaration)) ? 1 : 0;
        if (review->formatting && !review->rename_symbol)
        {
            work->tab_size = (uint32_t)gtk_spin_button_get_value_as_int(GTK_SPIN_BUTTON(review->tab_size));
            work->insert_spaces =
                gtk_check_button_get_active(GTK_CHECK_BUTTON(review->insert_spaces)) ? 1 : 0;
        }
    }
    if (status == UMI_STATUS_OK)
        status = umi_cancellation_token_create(&work->cancel);
    if (status == UMI_STATUS_OK)
        status = UmiDocumentSourceRequestInspect(review->source, &work->source);
    if (status == UMI_STATUS_OK && work->format_selection && work->source.selection_bytes == 0U)
        status = UMI_STATUS_INVALID_ARGUMENT;
    const char *text = NULL;
    size_t bytes = 0U;
    if (status == UMI_STATUS_OK)
        status = UmiDocumentSourceRequestRead(review->source, &text, &bytes);
    if (status == UMI_STATUS_OK && bytes >= UMI_LANGUAGE_RUNTIME_JSON_CAPACITY)
        status = UMI_STATUS_CAPACITY_EXCEEDED;
    if (status == UMI_STATUS_OK)
    {
        work->text = g_try_malloc(bytes + 1U);
        if (work->text == NULL)
            status = UMI_STATUS_OUT_OF_MEMORY;
        else
        {
            memcpy(work->text, text, bytes);
            work->text[bytes] = '\0';
        }
    }
    if (status == UMI_STATUS_OK && work->include_open_drafts)
    {
        owner = CompletionReviewOwner(window, review);
        status = owner == NULL ? UMI_STATUS_CANCELLED : CompletionWorkspaceCapture(owner, review, work);
    }
    if (status == UMI_STATUS_OK)
        status = umi_text_copy(work->profile.executable, sizeof(work->profile.executable),
                               gtk_editable_get_text(GTK_EDITABLE(review->program)));
    if (status == UMI_STATUS_OK)
        status = umi_text_copy(work->profile.arguments, sizeof(work->profile.arguments),
                               gtk_editable_get_text(GTK_EDITABLE(review->arguments)));
    if (status == UMI_STATUS_OK)
        status = umi_text_copy(work->directory, sizeof(work->directory),
                               gtk_editable_get_text(GTK_EDITABLE(review->folder)));
    if (status == UMI_STATUS_OK &&
        (!umi_path_is_absolute(work->profile.executable) || !umi_path_is_absolute(work->directory)))
        status = UMI_STATUS_INVALID_ARGUMENT;
    gchar *uri = status == UMI_STATUS_OK ? g_filename_to_uri(work->directory, NULL, NULL) : NULL;
    if (status == UMI_STATUS_OK)
        status =
            uri == NULL ? UMI_STATUS_INVALID_ARGUMENT : umi_text_copy(work->root, sizeof(work->root), uri);
    g_free(uri);
    if (status == UMI_STATUS_OK && CompletionReviewOwner(window, review) != NULL)
    {
        (void)umi_text_copy(work->profile.id, sizeof(work->profile.id), "selected-language-server");
        work->profile.enabled = 1;
        review->pending = work;
        g_object_set_data(G_OBJECT(window), "umicom-completion-pending", GINT_TO_POINTER(1));
        gtk_widget_set_sensitive(review->request, FALSE);
        if (CompletionReviewOwner(window, review) != NULL)
            gtk_widget_set_sensitive(review->preview, FALSE);
        if (CompletionReviewOwner(window, review) != NULL)
            gtk_label_set_text(
                GTK_LABEL(review->message),
                review->source_diagnostics ? "Waiting for a diagnostic publication for the captured draft..."
                : review->code_actions     ? "Requesting code actions for the captured range..."
                : review->rename_symbol    ? "Requesting a rename proposal for the captured symbol..."
                : review->parameter_help   ? "Requesting parameter help at the captured caret..."
                : review->document_symbols ? "Requesting the captured document outline..."
                : review->navigation       ? "Requesting source locations at the captured caret..."
                : review->source_information ? "Requesting source information at the captured caret..."
                : review->formatting         ? "Requesting formatting for the captured draft..."
                                             : "Requesting suggestions for the captured draft...");
        if (CompletionReviewOwner(window, review) != NULL &&
            !umi_cancellation_token_is_requested(work->cancel))
        {
            GTask *task = g_task_new(NULL, NULL, CompletionReviewComplete, NULL);
            /* GTK completion releases weak references and copied inputs.
             * No widget or document ownership crosses onto the worker. */
            g_task_set_task_data(task, work, NULL);
