typedef struct CompletionReviewWork
{
    UmiLanguageQuerySource *additional_sources;
    UmiDocumentSourceRequestSummary *additional_documents;
    size_t additional_count;
    int include_open_drafts;
    UmiLanguageWorkspaceEditCatalogue *workspace_edits;
    GWeakRef window;
    UmiCancellationToken *cancel;
    UmiLanguageServerProfile profile;
    UmiDocumentSourceRequestSummary source;
    char directory[UMI_PATH_CAPACITY], root[UMI_LANGUAGE_RUNTIME_PATH_CAPACITY];
    char *text;
    char new_name[1025];
    char symbol_query[4097];
    int workspace_symbols;
    int format_selection;
    UmiLanguageCodeActionFilter action_filter;
    int resolve_actions;
    UmiLanguageCompletionCatalogue *catalogue;
    UmiLanguageCompletionQueryReport report;
    UmiLanguageTextEditPreview *formatted;
    int formatting, insert_spaces, source_information;
    UmiLanguageHoverDocument *hover;
    UmiLanguageLocationCatalogue *locations;
    UmiLanguageSymbolCatalogue *symbols;
