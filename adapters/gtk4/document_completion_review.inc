static void CompletionReviewOptionsChanged(GtkWidget *control, gpointer window)
{
    (void)control;
    CompletionReviewDraftChanged(NULL, window);
}
/* A result belongs to the requested action family. Retire it on every change,
 * including a change back to the earlier family, before any review can apply. */
static void CompletionReviewActionFilterChanged(GObject *control, GParamSpec *property, gpointer window)
{
    (void)property;
    CompletionReviewOptionsChanged(GTK_WIDGET(control), window);
}
/* Choosing a related location only selects a destination. The explicit Open
 * action owns file access and rechecks source identity before navigation. */
static void CompletionReviewDiagnosticLocationChanged(GObject *control, GParamSpec *property, gpointer data)
{
    (void)control;
    (void)property;
    GtkWidget *window = g_object_ref(data);
    CompletionReview *review = CompletionReviewState(window);
    UmiGtk4Adapter *owner = CompletionReviewOwner(window, review);
    if (owner != NULL && review->source_diagnostics && !review->rendering && review->pending == NULL &&
        review->diagnostics != NULL)
    {
        UmiStatus status = UmiDocumentSourceRequestCheck(owner->edit_coordinator, review->source);
        UmiLanguageSourceLocation location;
        if (status == UMI_STATUS_OK)
            status = UmiLanguageDiagnosticCatalogueLocation(
                review->diagnostics, gtk_drop_down_get_selected(GTK_DROP_DOWN(review->choice)),
                gtk_drop_down_get_selected(GTK_DROP_DOWN(review->diagnostic_location)), &location);
        gtk_widget_set_sensitive(review->preview, status == UMI_STATUS_OK);
    }
    g_object_unref(window);
}

/* Scope changes retire results before relabelling the explicit request button.
 * Holding the window protects callback state if an observer closes the form. */
static void CompletionReviewSymbolScopeChanged(GtkWidget *control, gpointer data)
{
    GtkWidget *window = g_object_ref(data);
    CompletionReviewOptionsChanged(control, window);
    CompletionReview *review = CompletionReviewState(window);
    if (CompletionReviewOwner(window, review) != NULL && review->request != NULL)
        gtk_button_set_label(GTK_BUTTON(review->request),
                             gtk_check_button_get_active(GTK_CHECK_BUTTON(control))
                                 ? "Find project symbols"
                                 : "Request document symbols");
    g_object_unref(window);
}

static GtkWidget *CompletionReviewControl(CompletionReview *review, GtkWidget *box, GtkWidget *control,
                                          const char *id)
{
    g_ptr_array_add(review->controls, g_object_ref_sink(control));
    gtk_box_append(GTK_BOX(box), control);
    (void)umi_gtk4_automation_tag_widget(control, id);
    return control;
}
static GtkWidget *CompletionReviewEntry(CompletionReview *review, GtkWidget *window, GtkWidget *box,
                                        const char *label, const char *id, const char *value)
{
    gtk_box_append(GTK_BOX(box), gtk_label_new(label));
    GtkWidget *entry = CompletionReviewControl(review, box, gtk_entry_new(), id);
    gtk_editable_set_text(GTK_EDITABLE(entry), value == NULL ? "" : value);
    gtk_accessible_update_property(GTK_ACCESSIBLE(entry), GTK_ACCESSIBLE_PROPERTY_LABEL, label, -1);
    g_signal_connect_object(entry, "changed", G_CALLBACK(CompletionReviewDraftChanged), window, 0);
    return entry;
}
