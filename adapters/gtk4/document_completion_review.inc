                                   gtk_editable_get_text(GTK_EDITABLE(review->new_name)));
        work->navigation_kind = review->navigation_kind;
        if (review->navigation && review->include_declaration != NULL)
            work->include_declaration =
                gtk_check_button_get_active(GTK_CHECK_BUTTON(review->include_declaration)) ? 1 : 0;
        if (review->formatting && !review->rename_symbol)
        {
            work->tab_size = (uint32_t)gtk_spin_button_get_value_as_int(GTK_SPIN_BUTTON(review->tab_size));
            work->insert_spaces =
                gtk_check_button_get_active(GTK_CHECK_BUTTON(review->insert_spaces)) ? 1 : 0;
