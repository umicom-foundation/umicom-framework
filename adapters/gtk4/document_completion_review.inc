    {
        (void)umi_text_copy(work->profile.id, sizeof(work->profile.id), "selected-language-server");
        work->profile.enabled = 1;
        review->pending = work;
        g_object_set_data(G_OBJECT(window), "umicom-completion-pending", GINT_TO_POINTER(1));
        gtk_widget_set_sensitive(review->request, FALSE);
