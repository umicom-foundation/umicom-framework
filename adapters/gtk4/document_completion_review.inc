                  "unavailable. The server can inspect the project folder."
            : rename_symbol
                ? "Request sends the captured draft to the selected local language server. Review the "
                  "complete rename and confirmation requests before applying. Enable other open drafts "
                  "to review a complete edit across captured sources. Uncaptured targets are refused. "
                  "The server can inspect the project folder."
            : navigation
                ? "Find sends the captured draft to the selected local language server. "
                  "The server can inspect the project folder. Review each URI before opening a local "
                  "destination."
            : source_information ? "Request sends the captured draft to the selected local language server. "
                                   "The server can inspect the project folder. Returned text is displayed "
                                   "without executing markup or editing your source."
            : formatting
                ? "Request sends the complete captured draft to the selected local language server. "
                  "Review its formatting result before applying. The server can inspect the project folder."
                : "Request sends this captured draft to the selected local language server. Select a "
                  "typed word before opening this form to replace it; otherwise the fallback inserts at "
                  "the caret. The server can inspect the project folder."),
        "document.completion.message");
    gtk_label_set_wrap(GTK_LABEL(review->message), TRUE);
    review->comparison = CompletionReviewControl(review, box, gtk_box_new(GTK_ORIENTATION_VERTICAL, 4),
                                                 "document.completion.comparison");
    review->approve = CompletionReviewControl(
        review, box,
        gtk_check_button_new_with_label(
            code_actions    ? "I approve the displayed action and all listed confirmation requests"
            : rename_symbol ? "I approve the displayed rename and all listed confirmation requests"
                            : "I approve the displayed result"),
        "document.completion.approve");
    review->apply = CompletionReviewControl(review, box, gtk_button_new_with_label("Apply to captured draft"),
                                            "document.completion.apply");
    GtkWidget *cancel = CompletionReviewControl(
        review, box, gtk_button_new_with_label((source_information || navigation) ? "Close" : "Cancel"),
        "document.completion.cancel");
    gtk_widget_set_visible(review->preview, !source_information);
    gtk_widget_set_visible(review->approve, !source_information && !navigation);
    gtk_widget_set_visible(review->apply, !source_information && !navigation);
    gtk_widget_set_sensitive(review->preview, FALSE);
    gtk_widget_set_sensitive(review->apply, FALSE);
    (void)umi_gtk4_automation_tag_widget(window, "document.completion.review");
    (void)UmiGtk4RecordingSetPrivate(window, 1);
    g_signal_connect_object(review->request, "clicked", G_CALLBACK(CompletionReviewRequest), window, 0);
    g_signal_connect_object(review->choice, "notify::selected", G_CALLBACK(CompletionReviewChoiceChanged),
                            window, 0);
    g_signal_connect_object(review->preview, "clicked", G_CALLBACK(CompletionReviewPreview), window, 0);
    g_signal_connect_object(review->apply, "clicked", G_CALLBACK(CompletionReviewApply), window, 0);
    g_signal_connect_object(cancel, "clicked", G_CALLBACK(CompletionReviewCancel), window, 0);
    g_signal_connect(window, "close-request", G_CALLBACK(CompletionReviewClosing), NULL);
    g_signal_connect(window, "unmap", G_CALLBACK(CompletionReviewRemoved), NULL);
    g_signal_connect(window, "destroy", G_CALLBACK(CompletionReviewRemoved), NULL);
    gtk_window_set_title(
        GTK_WINDOW(window),
        source_diagnostics ? "Source diagnostics"
        : code_actions     ? "Review code actions"
        : rename_symbol    ? "Review symbol rename"
        : parameter_help   ? "Parameter help"
        : document_symbols ? "Document symbols"
        : navigation       ? (kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES  ? "Syntax selection ranges"
                              : kind == UMI_LANGUAGE_NAVIGATION_TYPE_DEFINITION ? "Type definition locations"
                              : kind == UMI_LANGUAGE_NAVIGATION_IMPLEMENTATION  ? "Implementation locations"
                              : kind == UMI_LANGUAGE_NAVIGATION_DEFINITION      ? "Definition locations"
                                                                                : "Reference locations")
        : source_information ? "Source information"
        : formatting         ? "Review document formatting"
                             : "Review language completion");
    gtk_window_set_default_size(GTK_WINDOW(window), 960, 760);
    gtk_window_set_default_widget(GTK_WINDOW(window), cancel);
    gtk_window_set_modal(GTK_WINDOW(window), TRUE);
    gtk_window_set_transient_for(GTK_WINDOW(window), parent);
    gtk_window_set_destroy_with_parent(GTK_WINDOW(window), TRUE);
    if (g_object_get_data(lifetime, "adapter") != adapter || !UmiGtk4WindowIsOpen(parent))
        status = UMI_STATUS_CANCELLED;
    else if (g_object_get_data(lifetime, "completion-review") != NULL)
        status = UMI_STATUS_BUSY;
    else
    {
        g_object_set_data(lifetime, "completion-review", window);
        g_signal_connect_object(parent, "destroy", G_CALLBACK(CompletionReviewParentRemoved), window, 0);
        gtk_window_present(GTK_WINDOW(window));
        if (CompletionReviewOwner(window, review) == NULL)
            status = UMI_STATUS_CANCELLED;
    }
    if (status != UMI_STATUS_OK)
        CompletionReviewClose(window, 0, status);
    g_object_unref(parent);
    g_object_unref(lifetime);
    g_object_unref(window);
    return status;
}
