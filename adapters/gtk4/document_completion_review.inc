    else if (g_object_get_data(lifetime, "completion-review") != NULL)
        status = UMI_STATUS_BUSY;
    else
    {
        g_object_set_data(lifetime, "completion-review", window);
        g_signal_connect_object(parent, "destroy", G_CALLBACK(CompletionReviewParentRemoved), window, 0);
        gtk_window_present(GTK_WINDOW(window));
        if (CompletionReviewOwner(window, review) == NULL)
            status = UMI_STATUS_CANCELLED;
    }
    if (status != UMI_STATUS_OK)
        CompletionReviewClose(window, 0, status);
    g_object_unref(parent);
    g_object_unref(lifetime);
    g_object_unref(window);
    return status;
