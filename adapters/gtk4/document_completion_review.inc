        gtk_widget_set_tooltip_text(
            review->resolve_actions,
            "Ask this same server to supply edits for up to 32 enabled actions in the requested family. "
            "Requires server support. Commands are not run; changes still need review and approval.");
        g_signal_connect_object(review->resolve_actions, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);

        /* The order corresponds to the public action filter enum. All actions
         * stays the default; choosing a family never starts the server. */
        const char *families[] = {"All actions",      "Quick fixes", "Refactoring",
                                  "Organize imports", "Fix all",     NULL};
        gtk_box_append(GTK_BOX(box), gtk_label_new("Requested action family"));
        review->action_filter = CompletionReviewControl(review, box, gtk_drop_down_new_from_strings(families),
                                                        "document.code-actions.kind");
        gtk_widget_set_tooltip_text(review->action_filter,
                                    "Request one family of complete actions from the server. Fix all still "
                                    "requires review and approval. "
                                    "Commands and unsupported edits are not executed. Resolve missing text "
                                    "edits is a separate option.");
        g_signal_connect_object(review->action_filter, "notify::selected",
                                G_CALLBACK(CompletionReviewActionFilterChanged), window, 0);

        review->include_diagnostics = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Include fresh diagnostics for fixes"),
            "document.code-actions.diagnostics");
        gtk_widget_set_tooltip_text(
            review->include_diagnostics,
            "Capture fresh primary-source diagnostics in this connection before asking for fixes. "
            "Use notifications by default, or select pull diagnostics below. No cached provider data is "
            "replayed.");
        g_signal_connect_object(review->include_diagnostics, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (rename_symbol)
        review->new_name =
            CompletionReviewEntry(review, window, box, "New symbol name", "document.rename.name", "");
    if (source_diagnostics || code_actions)
    {
        review->pull_diagnostics = CompletionReviewControl(
            review, box,
            gtk_check_button_new_with_label(code_actions ? "Use pull diagnostics for fixes"
                                                         : "Request diagnostics explicitly (pull)"),
            code_actions ? "document.code-actions.pull" : "document.diagnostics.pull");
        gtk_widget_set_tooltip_text(review->pull_diagnostics,
                                    "Choose this for a server offering diagnosticProvider. Actions also "
                                    "require Include fresh diagnostics. Request one "
                                    "complete report for the captured draft. "
                                    "Leave unchecked to wait for a diagnostic notification. Changing this "
                                    "choice requires a new request.");
        g_signal_connect_object(review->pull_diagnostics, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (rename_symbol || code_actions)
    {
        review->include_open_drafts = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Include other open drafts of the same language"),
            rename_symbol ? "document.rename.open-drafts" : "document.code-actions.open-drafts");
        gtk_widget_set_tooltip_text(
            review->include_open_drafts,
            "Send every open draft with this exact language ID to the selected server, including unsaved "
            "text. Up to 64 drafts; each message must fit the native transport limit. Rename opens a "
            "complete review after the reply; "
            "code actions open it when you preview a selected action. Other targets are refused.");
        g_signal_connect_object(review->include_open_drafts, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (formatting && !rename_symbol)
    {
        review->format_selection = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Request formatting for the captured selection"),
            "document.formatting.selection");
        gtk_widget_set_sensitive(review->format_selection, summary.selection_bytes != 0U);
        gtk_widget_set_tooltip_text(
            review->format_selection,
            "Select source text before opening this form. The server may adjust surrounding code; "
            "review the complete resulting draft before applying. Leave unchecked to format the complete "
            "document.");
        g_signal_connect_object(review->format_selection, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
        gtk_box_append(GTK_BOX(box), gtk_label_new("Tab width"));
        review->tab_size = CompletionReviewControl(
            review, box, gtk_spin_button_new_with_range(1.0, 32.0, 1.0), "document.formatting.tab-size");
        gtk_spin_button_set_value(GTK_SPIN_BUTTON(review->tab_size), 4.0);
        review->insert_spaces = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Use spaces for indentation"),
            "document.formatting.insert-spaces");
        gtk_check_button_set_active(GTK_CHECK_BUTTON(review->insert_spaces), TRUE);
        g_signal_connect_object(review->tab_size, "value-changed", G_CALLBACK(CompletionReviewOptionsChanged),
                                window, 0);
        g_signal_connect_object(review->insert_spaces, "toggled", G_CALLBACK(CompletionReviewOptionsChanged),
                                window, 0);
    }
    if (navigation && kind == UMI_LANGUAGE_NAVIGATION_REFERENCES)
    {
        /* Declaration inclusion changes the query itself, so changing it also
         * retires any result produced with the previous setting. */
        review->include_declaration =
            CompletionReviewControl(review, box, gtk_check_button_new_with_label("Include the declaration"),
                                    "document.source-navigation.include-declaration");
        g_signal_connect_object(review->include_declaration, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    review->request = CompletionReviewControl(
        review, box,
        gtk_button_new_with_label(
            call_direction != 0
                ? (call_direction == UMI_LANGUAGE_CALL_INCOMING ? "Find callers" : "Find callees")
            : source_diagnostics ? "Capture source diagnostics"
            : code_actions       ? "Request code actions"
            : rename_symbol      ? "Request rename"
            : parameter_help     ? "Request parameter help"
            : document_symbols   ? "Request document symbols"
            : navigation ? (kind == UMI_LANGUAGE_NAVIGATION_FOLDING_RANGES ? "Find folding regions"
 : kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES  ? "Find selection ranges"
                            : kind == UMI_LANGUAGE_NAVIGATION_TYPE_DEFINITION ? "Find type definitions"
                            : kind == UMI_LANGUAGE_NAVIGATION_IMPLEMENTATION  ? "Find implementations"
                            : kind == UMI_LANGUAGE_NAVIGATION_DEFINITION      ? "Find definitions"
                                                                              : "Find references")
            : source_information ? "Request source information"
            : formatting         ? "Request formatting"
                                 : "Request suggestions"),
        "document.completion.request");
    review->choice =
        CompletionReviewControl(review, box, gtk_drop_down_new(NULL, NULL), "document.completion.choice");
    gtk_drop_down_set_enable_search(GTK_DROP_DOWN(review->choice), TRUE);
    gtk_widget_set_visible(review->choice, !formatting && (!source_information || parameter_help));
    if (call_direction != 0)
    {
        gtk_box_append(GTK_BOX(box), gtk_label_new("Symbol or call site to open"));
        review->call_location =
            CompletionReviewControl(review, box, gtk_drop_down_new(NULL, NULL), "document.calls.location");
        gtk_drop_down_set_enable_search(GTK_DROP_DOWN(review->call_location), TRUE);
        gtk_widget_set_sensitive(review->call_location, FALSE);
        gtk_widget_set_tooltip_text(
            review->call_location,
            "Choose the related symbol or a reported call expression. "
            "Call expressions stay in their caller's file. Opening a destination preserves unsaved drafts.");
        g_signal_connect_object(review->call_location, "notify::selected",
                                G_CALLBACK(CompletionReviewCallLocationChanged), window, 0);
    }
    if (source_diagnostics)
    {
        gtk_box_append(GTK_BOX(box), gtk_label_new("Source location to open"));
        review->diagnostic_location = CompletionReviewControl(review, box, gtk_drop_down_new(NULL, NULL),
                                                              "document.source-diagnostics.location");
        gtk_drop_down_set_enable_search(GTK_DROP_DOWN(review->diagnostic_location), TRUE);
        gtk_widget_set_sensitive(review->diagnostic_location, FALSE);
        gtk_widget_set_tooltip_text(
            review->diagnostic_location,
            "Choose the reported range or a related source location, then Open reported range. "
            "Existing drafts keep unsaved changes; external ranges are checked when opened.");
        g_signal_connect_object(review->diagnostic_location, "notify::selected",
                                G_CALLBACK(CompletionReviewDiagnosticLocationChanged), window, 0);
    }
    review->preview = CompletionReviewControl(
        review, box,
        gtk_button_new_with_label(source_diagnostics ? "Open reported range"
                                  : code_actions     ? "Preview selected action"
                                  : navigation       ? (kind == UMI_LANGUAGE_NAVIGATION_FOLDING_RANGES ? "Select region"
 : kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES
                                                            ? "Select range"
                                                            : "Open selected location")
                                                     : "Preview complete draft"),
        "document.completion.preview");
    review->message = CompletionReviewControl(
        review, box,
        gtk_label_new(
            source_diagnostics ? "Capture sends the complete draft to a newly started local language server. "
                                 "The server can inspect the project folder. Review its first matching "
                                 "diagnostic publication; no source edits or automatic links are performed."
            : code_actions
                ? "Request sends the captured source range to the selected local language server. Review a "
                  "complete edit-only action before applying. Enable other open drafts to review a "
                  "complete edit across captured sources. Resolve missing text edits is an explicit option; "
                  "commands remain unavailable. The server can inspect the project folder."
            : rename_symbol
                ? "Request sends the captured draft to the selected local language server. Review the "
                  "complete rename and confirmation requests before applying. Enable other open drafts "
                  "to review a complete edit across captured sources. Uncaptured targets are refused. "
                  "The server can inspect the project folder."
            : navigation
                ? "Find sends the captured draft to the selected local language server. "
                  "The server can inspect the project folder. Review each URI before opening a local "
                  "destination."
            : source_information ? "Request sends the captured draft to the selected local language server. "
                                   "The server can inspect the project folder. Returned text is displayed "
                                   "without executing markup or editing your source."
            : formatting
                ? "Request sends the complete captured draft to the selected local language server. "
                  "Review its formatting result before applying. The server can inspect the project folder."
                : "Request sends this captured draft to the selected local language server. Select a "
                  "typed word before opening this form to replace it; otherwise the fallback inserts at "
                  "the caret. The server can inspect the project folder."),
        "document.completion.message");
    gtk_label_set_wrap(GTK_LABEL(review->message), TRUE);
    review->comparison = CompletionReviewControl(review, box, gtk_box_new(GTK_ORIENTATION_VERTICAL, 4),
                                                 "document.completion.comparison");
    review->approve = CompletionReviewControl(
        review, box,
        gtk_check_button_new_with_label(
            code_actions    ? "I approve the displayed action and all listed confirmation requests"
            : rename_symbol ? "I approve the displayed rename and all listed confirmation requests"
                            : "I approve the displayed result"),
        "document.completion.approve");
    review->apply = CompletionReviewControl(review, box, gtk_button_new_with_label("Apply to captured draft"),
                                            "document.completion.apply");
    GtkWidget *cancel = CompletionReviewControl(
        review, box, gtk_button_new_with_label((source_information || navigation) ? "Close" : "Cancel"),
        "document.completion.cancel");
    gtk_widget_set_visible(review->preview, !source_information);
    gtk_widget_set_visible(review->approve, !source_information && !navigation);
    gtk_widget_set_visible(review->apply, !source_information && !navigation);
    gtk_widget_set_sensitive(review->preview, FALSE);
    gtk_widget_set_sensitive(review->apply, FALSE);
    (void)umi_gtk4_automation_tag_widget(window, "document.completion.review");
    (void)UmiGtk4RecordingSetPrivate(window, 1);
    g_signal_connect_object(review->request, "clicked", G_CALLBACK(CompletionReviewRequest), window, 0);
    g_signal_connect_object(review->choice, "notify::selected", G_CALLBACK(CompletionReviewChoiceChanged),
                            window, 0);
    g_signal_connect_object(review->preview, "clicked", G_CALLBACK(CompletionReviewPreview), window, 0);
    g_signal_connect_object(review->apply, "clicked", G_CALLBACK(CompletionReviewApply), window, 0);
    g_signal_connect_object(cancel, "clicked", G_CALLBACK(CompletionReviewCancel), window, 0);
    g_signal_connect(window, "close-request", G_CALLBACK(CompletionReviewClosing), NULL);
    g_signal_connect(window, "unmap", G_CALLBACK(CompletionReviewRemoved), NULL);
    g_signal_connect(window, "destroy", G_CALLBACK(CompletionReviewRemoved), NULL);
    gtk_window_set_title(
        GTK_WINDOW(window),
        call_direction != 0  ? (call_direction == UMI_LANGUAGE_CALL_INCOMING ? "Callers of captured symbol"
                                                                             : "Callees of captured symbol")
        : source_diagnostics ? "Source diagnostics"
        : code_actions       ? "Review code actions"
        : rename_symbol      ? "Review symbol rename"
        : parameter_help     ? "Parameter help"
        : document_symbols   ? "Document symbols"
        : navigation ? (kind == UMI_LANGUAGE_NAVIGATION_FOLDING_RANGES ? "Syntax folding regions"
 : kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES  ? "Syntax selection ranges"
                        : kind == UMI_LANGUAGE_NAVIGATION_TYPE_DEFINITION ? "Type definition locations"
                        : kind == UMI_LANGUAGE_NAVIGATION_IMPLEMENTATION  ? "Implementation locations"
                        : kind == UMI_LANGUAGE_NAVIGATION_DEFINITION      ? "Definition locations"
                                                                          : "Reference locations")
        : source_information ? "Source information"
        : formatting         ? "Review document formatting"
                             : "Review language completion");
    gtk_window_set_default_size(GTK_WINDOW(window), 960, 760);
    gtk_window_set_default_widget(GTK_WINDOW(window), cancel);
    gtk_window_set_modal(GTK_WINDOW(window), TRUE);
    gtk_window_set_transient_for(GTK_WINDOW(window), parent);
    gtk_window_set_destroy_with_parent(GTK_WINDOW(window), TRUE);
    if (g_object_get_data(lifetime, "adapter") != adapter || !UmiGtk4WindowIsOpen(parent))
        status = UMI_STATUS_CANCELLED;
    else if (g_object_get_data(lifetime, "completion-review") != NULL)
        status = UMI_STATUS_BUSY;
    else
    {
        g_object_set_data(lifetime, "completion-review", window);
        g_signal_connect_object(parent, "destroy", G_CALLBACK(CompletionReviewParentRemoved), window, 0);
        gtk_window_present(GTK_WINDOW(window));
        if (CompletionReviewOwner(window, review) == NULL)
            status = UMI_STATUS_CANCELLED;
    }
    if (status != UMI_STATUS_OK)
        CompletionReviewClose(window, 0, status);
    g_object_unref(parent);
    g_object_unref(lifetime);
    g_object_unref(window);
    return status;
}
/* Compatibility forms continue to use their original call contract. */
static UmiStatus CompletionReviewCreate(UmiGtk4Adapter *adapter, const char *workspace_folder,
                                        const char *application_directory, const char *base_override,
                                        int formatting, int source_information,
                                        const UmiLanguageNavigationKind *navigation_kind,
                                        int document_symbols, int parameter_help, int rename_symbol,
                                        int code_actions, int source_diagnostics)
{
    return CompletionReviewCreateWithCallDirection(adapter, workspace_folder, application_directory,
                                                   base_override, formatting, source_information,
                                                   navigation_kind, document_symbols, parameter_help,
                                                   rename_symbol, code_actions, source_diagnostics, 0);
}

