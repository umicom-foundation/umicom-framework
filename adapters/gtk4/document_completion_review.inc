    int navigation, include_declaration;
    uint32_t tab_size;
    UmiStatus status;
    int stale; /* GTK thread only; worker observes the atomic token instead. */
} CompletionReviewWork;
/* A settings request owns only copied values. Explicit saves may finish after
 * the form closes; loads never start a server and publish only to a live form. */
typedef struct CompletionPreferenceWork
{
    GWeakRef window;
    UmiLanguageServerPreferences preferences;
    char path[UMI_PATH_CAPACITY];
    UmiStatus status;
    int save, stale; /* stale belongs to the GTK thread alone. */
} CompletionPreferenceWork;
typedef struct CompletionReview
{
    UmiDocumentSourceWorkspace *workspace_sources;
    int workspace_actions;
    GtkWidget *include_open_drafts;
    GObject *lifetime;
