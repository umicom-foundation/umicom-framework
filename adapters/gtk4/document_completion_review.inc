        g_string_append(text, "\nMarked deprecated by the server.");
    if (publication.has_version)
        g_string_append_printf(text, "\nSource version: %d", (int)publication.version);
    else
        g_string_append(text,
                        "\nNo version supplied; this result came from the newly opened captured draft.");
    for (size_t i = 0U; i < diagnostic.related_count; ++i)
    {
        UmiLanguageDiagnosticRelated related;
        status = UmiLanguageDiagnosticCatalogueRelated(review->diagnostics, selected, i, &related);
        if (status != UMI_STATUS_OK)
            break;
        g_ptr_array_add(
            destinations,
            g_strdup_printf("%zu. %s — %s  %llu:%llu", i + 1U, related.message, related.location.uri,
                            (unsigned long long)related.location.selection.start.line + 1ULL,
                            (unsigned long long)related.location.selection.start.utf16_column + 1ULL));
        g_string_append_printf(text, "\n\nRelated: %s\n%s  %llu:%llu to %llu:%llu", related.message,
                               related.location.uri,
                               (unsigned long long)related.location.selection.start.line + 1ULL,
                               (unsigned long long)related.location.selection.start.utf16_column + 1ULL,
                               (unsigned long long)related.location.selection.end.line + 1ULL,
                               (unsigned long long)related.location.selection.end.utf16_column + 1ULL);
    }
    g_ptr_array_add(destinations, NULL);
    GtkStringList *locations = gtk_string_list_new((const char *const *)destinations->pdata);
    g_ptr_array_free(destinations, TRUE);
    if (status == UMI_STATUS_OK && CompletionReviewOwner(window, review) != NULL &&
        review->generation == generation)
        gtk_drop_down_set_model(GTK_DROP_DOWN(review->diagnostic_location), G_LIST_MODEL(locations));
    if (status == UMI_STATUS_OK && CompletionReviewOwner(window, review) != NULL &&
        review->generation == generation)
        gtk_drop_down_set_selected(GTK_DROP_DOWN(review->diagnostic_location), 0U);
    if (status == UMI_STATUS_OK && CompletionReviewOwner(window, review) != NULL &&
        review->generation == generation)
        gtk_widget_set_sensitive(review->diagnostic_location, TRUE);
    g_object_unref(locations);

    GtkWidget *view = g_object_ref_sink(gtk_text_view_new());
    gtk_text_view_set_editable(GTK_TEXT_VIEW(view), FALSE);
    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(view), GTK_WRAP_WORD_CHAR);
    gtk_text_buffer_set_text(gtk_text_view_get_buffer(GTK_TEXT_VIEW(view)), text->str, -1);
    g_string_free(text, TRUE);
    (void)umi_gtk4_automation_tag_widget(view, "document.source-diagnostics.details");
    gtk_accessible_update_property(GTK_ACCESSIBLE(view), GTK_ACCESSIBLE_PROPERTY_LABEL,
                                   "Diagnostic and related source locations", -1);
    if (status == UMI_STATUS_OK && CompletionReviewOwner(window, review) != NULL &&
        review->generation == generation)
        gtk_box_append(GTK_BOX(review->comparison), view);
    g_object_unref(view);
    if (CompletionReviewOwner(window, review) != NULL && review->generation == generation)
        gtk_widget_set_sensitive(review->preview, status == UMI_STATUS_OK);
    if (CompletionReviewOwner(window, review) == NULL || review->generation != generation)
        status = UMI_STATUS_CANCELLED;
    return status;
}
