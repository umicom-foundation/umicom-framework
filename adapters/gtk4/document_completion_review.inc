    if (UmiGtk4AdapterCompletionReviewBusy(adapter) || UmiGtk4AdapterDocumentProposalBusy(adapter) ||
        UmiGtk4AdapterReplacementReviewBusy(adapter) || UmiGtk4AdapterDocumentSaveAllBusy(adapter) ||
        UmiGtk4AdapterDocumentCloseBusy(adapter) || adapter->edit_cancel != NULL)
        return UMI_STATUS_BUSY;
    UmiDocumentId id = 0U;
    UmiDocumentSourceRequest *source = NULL;
    UmiStatus status = EditFindDocument(adapter, NULL, &id);
    if (status == UMI_STATUS_OK)
        status = (source_information || navigation)
                     ? UmiDocumentSourceRequestCreateInspection(adapter->edit_coordinator, id, &source)
                     : UmiDocumentSourceRequestCreate(adapter->edit_coordinator, id, &source);
    if (status != UMI_STATUS_OK)
        return status;
    UmiDocumentSourceRequestSummary summary;
    const char *text = NULL;
    size_t bytes = 0U;
    status = UmiDocumentSourceRequestInspect(source, &summary);
    if (status == UMI_STATUS_OK)
        status = UmiDocumentSourceRequestRead(source, &text, &bytes);
    UmiEditorTextBufferView view = {0};
    view.struct_size = (uint32_t)sizeof(view);
    view.api_version = UMI_EDITOR_TEXT_BUFFER_API_VERSION;
    view.bytes = text;
    view.byte_count = bytes;
    view.capacity = bytes;
    UmiEditorTextPosition begin, end;
    if (status == UMI_STATUS_OK)
        status = UmiEditorTextViewPositionAt(&view, summary.cursor_offset, &begin);
    if (status == UMI_STATUS_OK)
        status = UmiEditorTextViewPositionAt(&view, summary.cursor_offset + summary.selection_bytes, &end);
    if (status == UMI_STATUS_OK && !code_actions && !formatting && !source_information && !navigation &&
        begin.line != end.line)
        status = UMI_STATUS_INVALID_ARGUMENT;
    if (status == UMI_STATUS_OK && bytes >= UMI_LANGUAGE_RUNTIME_JSON_CAPACITY)
        status = UMI_STATUS_CAPACITY_EXCEEDED;
    if (status != UMI_STATUS_OK)
    {
        UmiDocumentSourceRequestDestroy(source);
        return status;
    }
    char settings_path[UMI_PATH_CAPACITY] = {0};
    if (application_directory != NULL)
        status = UmiLanguageServerPreferencesPath(application_directory, base_override, summary.language_id,
                                                  settings_path, sizeof(settings_path));
    if (status != UMI_STATUS_OK)
    {
        UmiDocumentSourceRequestDestroy(source);
        return status;
    }
    /* Copy borrowed application values before publishing a toplevel. Native
     * construction observers may close or replace Studio's document binding. */
    gchar *folder = g_strdup(workspace_folder == NULL ? "" : workspace_folder);
    GObject *lifetime = g_object_ref(adapter->edit_lifetime);
    GtkWindow *parent = g_object_ref(adapter->window);
    GtkWidget *window = gtk_window_new();
    g_object_ref(window);
    CompletionReview *review = g_new0(CompletionReview, 1);
    review->lifetime = g_object_ref(lifetime);
    review->source = source;
    review->formatting = formatting;
    review->source_information = source_information;
    review->navigation = navigation;
    review->document_symbols = document_symbols;
    review->parameter_help = parameter_help;
    review->rename_symbol = rename_symbol;
    review->code_actions = code_actions;
    review->source_diagnostics = source_diagnostics;
    review->navigation_kind = kind;
    review->generation = 1U;
    memcpy(review->settings_path, settings_path, sizeof(settings_path));
    review->controls = g_ptr_array_new_with_free_func(g_object_unref);
    g_object_set_data_full(G_OBJECT(window), "umicom-document-completion", review, CompletionReviewFree);
    GtkWidget *box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 8), *scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(scroll), box);
    gtk_window_set_child(GTK_WINDOW(window), scroll);
    review->program = CompletionReviewEntry(review, window, box, "Language server executable",
                                            "document.completion.program", "");
    review->arguments =
        CompletionReviewEntry(review, window, box, "Server arguments", "document.completion.arguments", "");
    review->folder =
        CompletionReviewEntry(review, window, box, "Project folder", "document.completion.folder", folder);
    g_free(folder);
    if (review->settings_path[0] != '\0')
    {
        review->load_settings = CompletionReviewControl(
            review, box, gtk_button_new_with_label("Load saved server"), "document.completion.settings.load");
        review->save_settings =
            CompletionReviewControl(review, box, gtk_button_new_with_label("Save server for this language"),
                                    "document.completion.settings.save");
        g_signal_connect_object(review->load_settings, "clicked", G_CALLBACK(CompletionPreferenceLoad),
                                window, 0);
        g_signal_connect_object(review->save_settings, "clicked", G_CALLBACK(CompletionPreferenceSave),
                                window, 0);
    }
    if (document_symbols)
    {
        review->workspace_symbols =
            CompletionReviewControl(review, box, gtk_check_button_new_with_label("Search project symbols"),
                                    "document.symbols.workspace");
        gtk_widget_set_tooltip_text(
            review->workspace_symbols,
            "Search the server's project index instead of requesting the current document outline. "
            "Only this captured draft is synchronized; other unsaved drafts are not sent.");
        review->symbol_query = CompletionReviewEntry(
            review, window, box, "Project symbol query (empty asks for all)", "document.symbols.query", "");
        g_signal_connect_object(review->workspace_symbols, "toggled",
                                G_CALLBACK(CompletionReviewSymbolScopeChanged), window, 0);
    }
    if (code_actions)
    {
        /* Resolve is preparation, not acceptance. It obtains missing edit data
         * on the worker; the normal complete comparison and approval follow. */
        review->resolve_actions = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Resolve missing text edits"),
            "document.code-actions.resolve");
        gtk_widget_set_tooltip_text(
            review->resolve_actions,
            "Ask this same server to supply edits for up to 32 enabled actions in the requested family. "
            "Requires server support. Commands are not run; changes still need review and approval.");
        g_signal_connect_object(review->resolve_actions, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);

        /* The order corresponds to the public action filter enum. All actions
         * stays the default; choosing a family never starts the server. */
        const char *families[] = {"All actions",      "Quick fixes", "Refactoring",
                                  "Organize imports", "Fix all",     NULL};
        gtk_box_append(GTK_BOX(box), gtk_label_new("Requested action family"));
        review->action_filter = CompletionReviewControl(review, box, gtk_drop_down_new_from_strings(families),
                                                        "document.code-actions.kind");
        gtk_widget_set_tooltip_text(review->action_filter,
                                    "Request one family of complete actions from the server. Fix all still "
                                    "requires review and approval. "
                                    "Commands and unsupported edits are not executed. Resolve missing text "
                                    "edits is a separate option.");
        g_signal_connect_object(review->action_filter, "notify::selected",
                                G_CALLBACK(CompletionReviewActionFilterChanged), window, 0);

        review->include_diagnostics = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Include fresh diagnostics for fixes"),
            "document.code-actions.diagnostics");
        gtk_widget_set_tooltip_text(
            review->include_diagnostics,
            "Capture fresh primary-source diagnostics in this connection before asking for fixes. "
            "Use notifications by default, or select pull diagnostics below. No cached provider data is "
            "replayed.");
        g_signal_connect_object(review->include_diagnostics, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (rename_symbol)
        review->new_name =
            CompletionReviewEntry(review, window, box, "New symbol name", "document.rename.name", "");
    if (source_diagnostics || code_actions)
    {
        review->pull_diagnostics = CompletionReviewControl(
            review, box,
            gtk_check_button_new_with_label(code_actions ? "Use pull diagnostics for fixes"
                                                         : "Request diagnostics explicitly (pull)"),
            code_actions ? "document.code-actions.pull" : "document.diagnostics.pull");
        gtk_widget_set_tooltip_text(review->pull_diagnostics,
                                    "Choose this for a server offering diagnosticProvider. Actions also "
                                    "require Include fresh diagnostics. Request one "
                                    "complete report for the captured draft. "
                                    "Leave unchecked to wait for a diagnostic notification. Changing this "
                                    "choice requires a new request.");
        g_signal_connect_object(review->pull_diagnostics, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (rename_symbol || code_actions)
    {
        review->include_open_drafts = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Include other open drafts of the same language"),
            rename_symbol ? "document.rename.open-drafts" : "document.code-actions.open-drafts");
        gtk_widget_set_tooltip_text(
            review->include_open_drafts,
            "Send every open draft with this exact language ID to the selected server, including unsaved "
            "text. Up to 64 drafts; each message must fit the native transport limit. Rename opens a "
            "complete review after the reply; "
            "code actions open it when you preview a selected action. Other targets are refused.");
        g_signal_connect_object(review->include_open_drafts, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    if (formatting && !rename_symbol)
    {
        review->format_selection = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Request formatting for the captured selection"),
            "document.formatting.selection");
        gtk_widget_set_sensitive(review->format_selection, summary.selection_bytes != 0U);
        gtk_widget_set_tooltip_text(
            review->format_selection,
            "Select source text before opening this form. The server may adjust surrounding code; "
            "review the complete resulting draft before applying. Leave unchecked to format the complete "
            "document.");
        g_signal_connect_object(review->format_selection, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
        gtk_box_append(GTK_BOX(box), gtk_label_new("Tab width"));
        review->tab_size = CompletionReviewControl(
            review, box, gtk_spin_button_new_with_range(1.0, 32.0, 1.0), "document.formatting.tab-size");
        gtk_spin_button_set_value(GTK_SPIN_BUTTON(review->tab_size), 4.0);
        review->insert_spaces = CompletionReviewControl(
            review, box, gtk_check_button_new_with_label("Use spaces for indentation"),
            "document.formatting.insert-spaces");
        gtk_check_button_set_active(GTK_CHECK_BUTTON(review->insert_spaces), TRUE);
        g_signal_connect_object(review->tab_size, "value-changed", G_CALLBACK(CompletionReviewOptionsChanged),
                                window, 0);
        g_signal_connect_object(review->insert_spaces, "toggled", G_CALLBACK(CompletionReviewOptionsChanged),
                                window, 0);
    }
    if (navigation && kind == UMI_LANGUAGE_NAVIGATION_REFERENCES)
    {
        /* Declaration inclusion changes the query itself, so changing it also
         * retires any result produced with the previous setting. */
        review->include_declaration =
            CompletionReviewControl(review, box, gtk_check_button_new_with_label("Include the declaration"),
                                    "document.source-navigation.include-declaration");
        g_signal_connect_object(review->include_declaration, "toggled",
                                G_CALLBACK(CompletionReviewOptionsChanged), window, 0);
    }
    review->request = CompletionReviewControl(
        review, box,
        gtk_button_new_with_label(
            source_diagnostics ? "Capture source diagnostics"
            : code_actions     ? "Request code actions"
            : rename_symbol    ? "Request rename"
            : parameter_help   ? "Request parameter help"
            : document_symbols ? "Request document symbols"
            : navigation       ? (kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES  ? "Find selection ranges"
                                  : kind == UMI_LANGUAGE_NAVIGATION_TYPE_DEFINITION ? "Find type definitions"
                                  : kind == UMI_LANGUAGE_NAVIGATION_IMPLEMENTATION  ? "Find implementations"
                                  : kind == UMI_LANGUAGE_NAVIGATION_DEFINITION      ? "Find definitions"
                                                                                    : "Find references")
            : source_information ? "Request source information"
            : formatting         ? "Request formatting"
                                 : "Request suggestions"),
        "document.completion.request");
    review->choice =
        CompletionReviewControl(review, box, gtk_drop_down_new(NULL, NULL), "document.completion.choice");
    gtk_drop_down_set_enable_search(GTK_DROP_DOWN(review->choice), TRUE);
    gtk_widget_set_visible(review->choice, !formatting && (!source_information || parameter_help));
    if (source_diagnostics)
    {
        gtk_box_append(GTK_BOX(box), gtk_label_new("Source location to open"));
        review->diagnostic_location = CompletionReviewControl(review, box, gtk_drop_down_new(NULL, NULL),
                                                              "document.source-diagnostics.location");
        gtk_drop_down_set_enable_search(GTK_DROP_DOWN(review->diagnostic_location), TRUE);
        gtk_widget_set_sensitive(review->diagnostic_location, FALSE);
        gtk_widget_set_tooltip_text(
            review->diagnostic_location,
            "Choose the reported range or a related source location, then Open reported range. "
            "Existing drafts keep unsaved changes; external ranges are checked when opened.");
        g_signal_connect_object(review->diagnostic_location, "notify::selected",
                                G_CALLBACK(CompletionReviewDiagnosticLocationChanged), window, 0);
    }
    review->preview = CompletionReviewControl(
        review, box,
        gtk_button_new_with_label(source_diagnostics ? "Open reported range"
                                  : code_actions     ? "Preview selected action"
                                  : navigation       ? (kind == UMI_LANGUAGE_NAVIGATION_SELECTION_RANGES
                                                            ? "Select range"
                                                            : "Open selected location")
                                                     : "Preview complete draft"),
