#ifndef UMICOM_CREATIVE_BRAND_RESOURCES_H
#define UMICOM_CREATIVE_BRAND_RESOURCES_H

/* Configure substitutes exact source bytes so exports preserve the original
 * artwork, alpha channel and Windows icon sizes. */
static const unsigned char CreativeBrandWordmark[] = {
@UMICOM_CREATIVE_BRAND_WORDMARK_BYTES@
};
static const unsigned char CreativeBrandIcon[] = {
@UMICOM_CREATIVE_BRAND_ICON_BYTES@
};

#endif
