cmake_minimum_required(VERSION 3.25)
if(NOT EXISTS "${SUBJECT}" OR IS_DIRECTORY "${SUBJECT}")
    message(FATAL_ERROR "Build umicom-training-jsonl-stream-test before running this check.")
endif()
# A fresh fixture directory permits exclusive binary creation without deleting
# earlier evidence. WORK is the selected test-build fixture root.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _run)
set(WORK "${WORK}/run-${_run}")
file(MAKE_DIRECTORY "${WORK}")
set(_path "${WORK}/records.jsonl")
set(_row "{\"source_id\":\"a\",\"prompt\":\"p\",\"completion\":\"c\"}")
set(_input "${_row}\n${_row}\n")
function(padded_record length out)
    string(LENGTH "${_row}" _row_bytes)
    math(EXPR _padding "${length}-${_row_bytes}")
    string(REPEAT " " ${_padding} _spaces)
    set("${out}" "${_row}${_spaces}" PARENT_SCOPE)
endfunction()
if(CASE STREQUAL "unicode")
    set(_path "${WORK}/données-é.jsonl")
elseif(CASE STREQUAL "crlf")
    set(_input "${_row}\r\n${_row}\r\n")
elseif(CASE STREQUAL "last-line")
    set(_input "${_row}\n${_row}")
elseif(CASE STREQUAL "final-cr")
    set(_input "${_row}\n${_row}\r")
elseif(CASE STREQUAL "empty")
    set(_input "")
elseif(CASE STREQUAL "blank")
    set(_input "${_row}\n\n")
elseif(CASE STREQUAL "late-invalid")
    set(_input "${_row}\n{}\n")
elseif(CASE STREQUAL "bom")
    string(ASCII 239 187 191 _bom)
    set(_input "${_bom}${_row}\n")
elseif(CASE STREQUAL "invalid-utf8")
    string(ASCII 195 _bad)
    set(_input "{\"source_id\":\"a\",\"prompt\":\"${_bad}\",\"completion\":\"c\"}\n")
elseif(CASE STREQUAL "multiline")
    set(_input "{\n\"source_id\":\"a\",\"prompt\":\"p\",\"completion\":\"c\"}\n")
elseif(CASE MATCHES "^line-max" OR CASE STREQUAL "line-over" OR CASE STREQUAL "double-cr-over")
    padded_record(32768 _input)
    if(CASE STREQUAL "line-max-crlf")
        string(APPEND _input "\r\n")
    elseif(CASE STREQUAL "line-max-cr")
        string(APPEND _input "\r")
    elseif(CASE STREQUAL "line-over")
        string(APPEND _input " \n")
    elseif(CASE STREQUAL "double-cr-over")
        string(APPEND _input "\r\r\n")
    endif()
elseif(CASE MATCHES "^boundary-")
    padded_record(32768 _first)
    if(CASE STREQUAL "boundary-crlf")
        # Byte 65535 is CR; byte 65536 is LF in the following 64 KiB chunk.
        padded_record(32766 _second)
        set(_input "${_first}\n${_second}\r\n")
    else()
        padded_record(32700 _second)
        set(_input "${_first}\n${_second}\n")
        set(_prefix "{\"source_id\":\"a\",\"prompt\":\"")
        string(LENGTH "${_input}${_prefix}" _before)
        math(EXPR _padding "65535-${_before}")
        string(REPEAT " " ${_padding} _spaces)
        if(CASE STREQUAL "boundary-utf8")
            string(ASCII 195 169 _text)
        else()
            set(_text "\\u00e9")
        endif()
        string(APPEND _input "${_spaces}${_prefix}${_text}\",\"completion\":\"c\"}\n")
    endif()
elseif(CASE STREQUAL "rows-max")
    string(REPEAT "${_row}\n" 4096 _input)
elseif(CASE STREQUAL "rows-over")
    string(REPEAT "${_row}\n" 4097 _input)
elseif(CASE STREQUAL "oversize")
    string(REPEAT " " 16777217 _input)
elseif(CASE STREQUAL "cancel-final")
    set(_input "${_row}\n")
endif()
# Preserve the former text writer for review. Native newline translation can
# move CR/LF and UTF-8 across the intended chunk boundary; binary output replaces it.
if(FALSE)
file(WRITE "${_path}" "${_input}")
endif()
if(CASE STREQUAL "oversize")
    # This capacity fixture is only spaces, so no newline translation occurs.
    file(WRITE "${_path}" "${_input}")
else()
    string(HEX "${_input}" _hex)
    file(WRITE "${WORK}/fixture.hex" "${_hex}")
    execute_process(COMMAND "${SUBJECT}" prepare "${WORK}/fixture.hex" "${_path}"
        RESULT_VARIABLE _prepared OUTPUT_VARIABLE _prepare_output ERROR_VARIABLE _prepare_error)
    if(NOT "${_prepared}" STREQUAL "0")
        message(FATAL_ERROR "Binary fixture preparation failed: ${_prepare_output}${_prepare_error}")
    endif()
endif()
string(SHA256 _intended_hash "${_input}")
file(SHA256 "${_path}" _actual_hash)
if(NOT _intended_hash STREQUAL _actual_hash)
    message(FATAL_ERROR "Fixture bytes do not match the explicitly constructed data")
endif()
file(SHA256 "${_path}" _before_hash)
set(_subject_path "${_path}")
if(CASE STREQUAL "missing")
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _nonce)
    set(_subject_path "${WORK}/absent-${_nonce}.jsonl")
elseif(CASE STREQUAL "relative")
    set(_subject_path "records.jsonl")
elseif(CASE STREQUAL "directory")
    set(_subject_path "${WORK}")
endif()
execute_process(COMMAND "${SUBJECT}" "${CASE}" "${_subject_path}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
if(NOT "${_result}" STREQUAL "0")
    message(FATAL_ERROR "Streaming case ${CASE} failed (${_result}): ${_output}${_error}")
endif()
file(SHA256 "${_path}" _after_hash)
if(NOT _before_hash STREQUAL _after_hash)
    message(FATAL_ERROR "Input fixture changed during a read-only visit")
endif()

if(DEFINED ALLOCATION_SUBJECT)
    if(NOT EXISTS "${ALLOCATION_SUBJECT}" OR IS_DIRECTORY "${ALLOCATION_SUBJECT}")
        message(FATAL_ERROR "Build the streaming allocation observer before this check")
    endif()
    execute_process(COMMAND "${ALLOCATION_SUBJECT}" "${CASE}" "${_subject_path}"
        RESULT_VARIABLE _allocation_result OUTPUT_VARIABLE _allocation_output ERROR_VARIABLE _allocation_error)
    if(NOT "${_allocation_result}" STREQUAL "0")
        message(FATAL_ERROR "Streaming ownership case failed: ${_allocation_output}${_allocation_error}")
    endif()
    file(SHA256 "${_path}" _after_allocation_hash)
    if(NOT _before_hash STREQUAL _after_allocation_hash)
        message(FATAL_ERROR "Allocation checks modified the input fixture")
    endif()
endif()

if(DEFINED EXAMPLE_SUBJECT)
    if(NOT EXISTS "${EXAMPLE_SUBJECT}" OR IS_DIRECTORY "${EXAMPLE_SUBJECT}")
        message(FATAL_ERROR "Build the streaming SDK example subject before this check")
    endif()
    execute_process(COMMAND "${EXAMPLE_SUBJECT}" "${_subject_path}"
        RESULT_VARIABLE _example_result OUTPUT_VARIABLE _example_output ERROR_VARIABLE _example_error)
    string(REPLACE "\r\n" "\n" _example_output "${_example_output}")
    if(CASE STREQUAL "valid")
        if(NOT "${_example_result}" STREQUAL "0" OR
            NOT _example_output STREQUAL "rows: 2\nprompt bytes: 2\ncompletion bytes: 2\n")
            message(FATAL_ERROR "Unexpected successful example output: ${_example_output}${_example_error}")
        endif()
    elseif(NOT "${_example_result}" STREQUAL "1" OR NOT _example_output STREQUAL "" OR
        NOT _example_error MATCHES "accepted rows 1; failed line 2")
        message(FATAL_ERROR "Rejected input published aggregate success or lost progress: ${_example_output}${_example_error}")
    endif()
    file(SHA256 "${_path}" _after_example_hash)
    if(NOT _before_hash STREQUAL _after_example_hash)
        message(FATAL_ERROR "SDK example modified the selected input")
    endif()
endif()
