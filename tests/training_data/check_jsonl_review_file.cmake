cmake_minimum_required(VERSION 3.25)
if(NOT EXISTS "${SUBJECT}" OR IS_DIRECTORY "${SUBJECT}")
    message(FATAL_ERROR "Build umicom-training-jsonl-file-test before running review checks.")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/run-${run}")
file(MAKE_DIRECTORY "${WORK}")
set(file "${WORK}/private-review.jsonl")
if(CASE STREQUAL "unicode")
    set(file "${WORK}/private-資料 café.jsonl")
endif()
execute_process(COMMAND "${SUBJECT}" review-fixture "${CASE}" "${file}"
    RESULT_VARIABLE made OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
if(NOT made EQUAL 0)
    message(FATAL_ERROR "Binary review fixture failed: ${made} ${out} ${err}")
endif()
file(SHA256 "${file}" before)
set(selected "${file}")
set(groups 1)
set(seed 42)
set(budget 65536)
set(expected 0)
set(shared 1)
if(CASE STREQUAL "missing")
    set(selected "${WORK}/private-absent.jsonl")
    set(expected 1)
elseif(CASE STREQUAL "relative")
    set(selected private-review.jsonl)
    set(expected 1)
elseif(CASE STREQUAL "directory")
    set(selected "${WORK}")
    set(expected 1)
elseif(CASE MATCHES "^(oversize|late-invalid)$")
    set(expected 1)
elseif(CASE STREQUAL "budget")
    set(budget 1)
    set(expected 1)
elseif(CASE STREQUAL "groups")
    set(groups 2)
    set(expected 1)
elseif(CASE STREQUAL "distinct")
    set(shared 0)
elseif(CASE STREQUAL "group-zero")
    set(groups 0)
    set(expected 2)
elseif(CASE STREQUAL "group-bound")
    set(groups 4096)
    set(expected 2)
elseif(CASE STREQUAL "group-plus")
    set(groups +1)
    set(expected 2)
elseif(CASE STREQUAL "group-space")
    set(groups " 1")
    set(expected 2)
elseif(CASE STREQUAL "seed-negative")
    set(seed -1)
    set(expected 2)
elseif(CASE STREQUAL "seed-overflow")
    set(seed 18446744073709551616)
    set(expected 2)
elseif(CASE STREQUAL "seed-hex")
    set(seed 0x2a)
    set(expected 2)
elseif(CASE STREQUAL "seed-max")
    set(seed 18446744073709551615)
elseif(CASE STREQUAL "seed-zero")
    set(seed 0)
elseif(CASE STREQUAL "budget-zero")
    set(budget 0)
    set(expected 2)
elseif(CASE STREQUAL "budget-fraction")
    set(budget 65536.0)
    set(expected 2)
elseif(CASE STREQUAL "budget-overflow")
    set(budget 18446744073709551616)
    set(expected 2)
elseif(CASE STREQUAL "budget-text")
    set(budget private-secret)
    set(expected 2)
elseif(CASE STREQUAL "leading-zero")
    set(groups 01)
    set(seed 042)
    set(budget 065536)
elseif(CASE STREQUAL "extra")
    set(expected 2)
elseif(NOT CASE MATCHES "^(valid|unicode|crlf|arguments|cancel|capacity|help)$")
    message(FATAL_ERROR "Unknown review case ${CASE}")
endif()
if(CASE MATCHES "^(valid|unicode|crlf|arguments|cancel|capacity|missing|relative|directory|oversize|late-invalid|budget|groups|distinct)$")
    execute_process(COMMAND "${SUBJECT}" review-service "${CASE}" "${selected}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Review service failed: ${result} ${out} ${err}")
    endif()
endif()
if(NOT CASE MATCHES "^(arguments|cancel|capacity)$")
    set(args review "${selected}" "${groups}" "${seed}" "${budget}")
    if(CASE STREQUAL "extra")
        list(APPEND args private-extra)
    elseif(CASE STREQUAL "help")
        set(args --help)
    endif()
    execute_process(COMMAND "${SUBJECT}" training-data ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "Review CLI exit ${result}; expected ${expected}: ${out} ${err}")
    endif()
    if("${out}${err}" MATCHES "private-question|private-answer|private-one|private-two|private-review|private-secret|private-extra")
        message(FATAL_ERROR "Review output disclosed input content or arguments")
    endif()
    if(CASE STREQUAL "help")
        if(NOT out MATCHES "training-data review" OR NOT out MATCHES "not total process memory")
            message(FATAL_ERROR "Review help omitted its memory boundary: ${out}")
        endif()
    elseif(expected EQUAL 0)
        if(NOT out MATCHES "Rows: 2 . Source groups: 2 . Training rows: 1 . Evaluation rows: 1" OR
            NOT out MATCHES "Shared pairs: ${shared}" OR NOT out MATCHES "not dataset approval")
            message(FATAL_ERROR "Review counts or limits absent: ${out} ${err}")
        endif()
    elseif(out MATCHES "Rows:|Distinct pairs:|Review completed")
        message(FATAL_ERROR "Failed review presented a partial result: ${out}")
    endif()
endif()
file(SHA256 "${file}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Review modified the input dataset")
endif()
