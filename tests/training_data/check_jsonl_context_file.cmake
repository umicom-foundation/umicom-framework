if(NOT DEFINED SUBJECT OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Provide SUBJECT, WORK and CASE")
endif()

# A wrapper can execute even when its child target was never linked. Diagnose
# that prerequisite before creating corpus fixtures; this is still a failure,
# never a skip, a fabricated pass or an automatic build of unrelated targets.
if(NOT EXISTS "${SUBJECT}" OR IS_DIRECTORY "${SUBJECT}")
    message(FATAL_ERROR "Training test subject is missing or not a file. Build umicom-training-jsonl-file-test and resolve prerequisite build errors before CTest. Subject: ${SUBJECT}")
endif()

file(MAKE_DIRECTORY "${WORK}")
set(file "${WORK}/private-corpus.jsonl")
set(first "{\"source_id\":\"private-one\",\"prompt\":\"p\",\"completion\":\"c\"}")
set(second "{\"source_id\":\"private-two\",\"prompt\":\"\",\"completion\":\"xyz\"}")
set(third "{\"source_id\":\"private-three\",\"prompt\":\"long\",\"completion\":\"reply\"}")
set(bytes "${first}\n${second}\n${third}\n")
set(expected 0)
set(rows 4)
set(service FALSE)
set(fit 2)
set(overlong 1)
set(first_overlong 3)
set(valid 7)
set(selected_rows 6)
set(padding 1)
if(CASE MATCHES "^(valid|unicode|crlf|arguments|cancel|invalid-second|missing|relative|directory|oversize)$")
    set(service TRUE)
endif()
if(CASE STREQUAL "unicode")
    set(file "${WORK}/private-資料 café.jsonl")
elseif(CASE STREQUAL "crlf")
    set(bytes "${first}\r\n${second}\r\n${third}\r\n")
elseif(CASE STREQUAL "invalid-second")
    set(bytes "${first}\n{broken}\n")
    set(expected 1)
elseif(CASE STREQUAL "oversize")
    string(REPEAT " " 16777217 bytes)
    set(expected 1)
elseif(CASE MATCHES "^(missing|relative|directory)$")
    set(expected 1)
elseif(CASE STREQUAL "all-overlong")
    set(rows 1)
    set(fit 0)
    set(overlong 3)
    set(first_overlong 1)
    set(valid 0)
    set(selected_rows 0)
    set(padding 0)
elseif(CASE STREQUAL "all-fit")
    set(rows 32)
    set(fit 3)
    set(overlong 0)
    set(first_overlong 0)
    set(valid 17)
    set(selected_rows 12)
    set(padding 79)
elseif(CASE STREQUAL "zero")
    set(rows 0)
    set(expected 2)
elseif(CASE STREQUAL "above-limit")
    set(rows 33)
    set(expected 2)
elseif(CASE STREQUAL "negative")
    set(rows -1)
    set(expected 2)
elseif(CASE STREQUAL "plus")
    set(rows +4)
    set(expected 2)
elseif(CASE STREQUAL "space")
    set(rows " 4")
    set(expected 2)
elseif(CASE STREQUAL "fraction")
    set(rows 4.0)
    set(expected 2)
elseif(CASE STREQUAL "overflow")
    set(rows 18446744073709551616)
    set(expected 2)
elseif(CASE STREQUAL "text")
    set(rows private-secret)
    set(expected 2)
elseif(CASE STREQUAL "hex")
    set(rows 0x4)
    set(expected 2)
elseif(CASE STREQUAL "leading-zero")
    set(rows 04)
elseif(CASE STREQUAL "extra")
    set(expected 2)
elseif(NOT CASE MATCHES "^(valid|arguments|cancel|help)$")
    message(FATAL_ERROR "Unknown case ${CASE}")
endif()
file(WRITE "${file}" "${bytes}")
file(SHA256 "${file}" before)
set(selected "${file}")
if(CASE STREQUAL "missing")
    set(selected "${WORK}/private-absent.jsonl")
elseif(CASE STREQUAL "relative")
    set(selected private-corpus.jsonl)
elseif(CASE STREQUAL "directory")
    set(selected "${WORK}")
endif()
if(service)
    execute_process(COMMAND "${SUBJECT}" context-service "${CASE}" "${selected}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Context service failed: ${result}\n${output}\n${error}")
    endif()
endif()
if(NOT CASE MATCHES "^(arguments|cancel)$")
    set(arguments context "${selected}" "${rows}")
    if(CASE STREQUAL "help")
        set(arguments --help)
    elseif(CASE STREQUAL "extra")
        list(APPEND arguments --train)
    endif()
    execute_process(COMMAND "${SUBJECT}" training-data ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI expected ${expected}, got ${result}\n${output}\n${error}")
    endif()
    if(output MATCHES "private-" OR error MATCHES "private-")
        message(FATAL_ERROR "CLI exposed input text or path")
    endif()
    if(CASE STREQUAL "help")
        string(FIND "${output}" "training-data context ABSOLUTE_JSONL_FILE CONTEXT_ROWS" found)
        if(found LESS 0)
            message(FATAL_ERROR "Context command missing from help")
        endif()
    elseif(expected EQUAL 0)
        # Parse the rendered decimal rather than interpreting a leading-zero spelling.
        if(CASE STREQUAL "leading-zero")
            set(rows 4)
        endif()
        foreach(fragment
            "Native byte context: ${rows} | Records: 3 | Fitting: ${fit} | Overlong: ${overlong} | First overlong line: ${first_overlong}"
            "Required rows (all): 17 | Shortest: 3 | Longest: 10"
            "Fitting valid rows: ${valid} | Fitting selected rows: ${selected_rows} | Fitting padding rows: ${padding}"
            "No text was truncated and no model or training started.")
            string(FIND "${output}" "${fragment}" found)
            if(found LESS 0)
                message(FATAL_ERROR "Missing aggregate output ${fragment}\n${output}")
            endif()
        endforeach()
    elseif(expected EQUAL 1)
        if(NOT error MATCHES "Training context refused" OR NOT output STREQUAL "")
            message(FATAL_ERROR "Refusal published a summary or omitted failure")
        endif()
    elseif(NOT output STREQUAL "")
        message(FATAL_ERROR "Usage refusal published a summary")
    endif()
endif()
file(SHA256 "${file}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Context inspection changed the selected file")
endif()
