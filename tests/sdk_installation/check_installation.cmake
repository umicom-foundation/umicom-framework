# These are presence fixtures, deliberately not compilable SDK installations.
foreach(_required TEST_BINARY CASE)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing SDK fixture argument: ${_required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _suffix)
set(_root "${TEST_BINARY}/${CASE}-${_suffix}")
file(MAKE_DIRECTORY "${_root}")
file(REAL_PATH "${_root}" _root)
set(_library lib)
set(_include include)
set(_archive libumicom_base.a)
set(_version 7.12.3)
set(_abi 17)
if(CASE STREQUAL "lib64")
    set(_library lib64)
elseif(CASE STREQUAL "multiarch")
    set(_library lib/cpu-linux)
    set(_include "public headers")
elseif(CASE STREQUAL "old_version")
    set(_version 7.11.0)
elseif(CASE STREQUAL "low_abi")
    set(_abi 16)
endif()
file(MAKE_DIRECTORY "${_root}/${_library}/cmake/UmicomFramework"
    "${_root}/${_include}/umicom" "${_root}/share/umicom/framework")
if(NOT CASE STREQUAL "no_metadata")
    if(NOT CASE STREQUAL "config")
        file(WRITE "${_root}/${_library}/cmake/UmicomFramework/UmicomFrameworkConfig.cmake"
            "message(FATAL_ERROR \"Inspection must never execute package code\")\n")
    endif()
    if(NOT CASE STREQUAL "targets")
        file(WRITE "${_root}/${_library}/cmake/UmicomFramework/UmicomFrameworkTargets.cmake" "# presence fixture\n")
    endif()
    if(NOT CASE STREQUAL "package_version")
        file(WRITE "${_root}/${_library}/cmake/UmicomFramework/UmicomFrameworkConfigVersion.cmake" "# presence fixture\n")
    endif()
    if(NOT CASE STREQUAL "header")
        file(WRITE "${_root}/${_include}/umicom/umicom.h" "/* presence fixture */\n")
    endif()
    if(CASE STREQUAL "library_directory")
        file(MAKE_DIRECTORY "${_root}/${_library}/${_archive}")
    elseif(NOT CASE STREQUAL "library")
        file(WRITE "${_root}/${_library}/${_archive}" "presence only, not an archive\n")
    endif()
endif()
if(CASE STREQUAL "malformed")
    file(WRITE "${_root}/share/umicom/framework/sdk.properties" "schema=foreign.sdk\n")
elseif(NOT CASE STREQUAL "legacy" AND NOT CASE STREQUAL "no_metadata")
    file(WRITE "${_root}/share/umicom/framework/sdk.properties"
        "schema=umicom.sdk\nframework_version=${_version}\nframework_abi=${_abi}\ninclude_directory=${_include}\nlibrary_directory=${_library}\nbase_library=${_library}/${_archive}\n")
endif()
if(DEFINED CLI_PROGRAM)
    execute_process(COMMAND "${CLI_PROGRAM}" sdk inspect "${_root}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 20)
    set(_expected 1)
    if(CASE MATCHES "^(complete|lib64|multiarch|old_version|low_abi)$")
        set(_expected 0)
    endif()
    if(NOT _result STREQUAL "${_expected}")
        message(FATAL_ERROR "SDK CLI ${CASE}: ${_result}\n${_output}\n${_error}")
    endif()
    if(CASE MATCHES "^(no_metadata|legacy|malformed)$")
        if(NOT _error MATCHES "Cannot inspect SDK")
            message(FATAL_ERROR "SDK CLI did not explain metadata failure: ${_error}")
        endif()
    elseif(NOT _output MATCHES "File-presence evidence only")
        message(FATAL_ERROR "SDK CLI did not identify its evidence limits: ${_output}")
    endif()
elseif(DEFINED SDK_GTK_CASE)
    execute_process(COMMAND "${TEST_PROGRAM}" "${SDK_GTK_CASE}" "${_root}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 20)
    if(_result STREQUAL "77")
        message(STATUS "SDK GTK display unavailable")
    elseif(NOT _result STREQUAL "0")
        message(FATAL_ERROR "SDK settings ${SDK_GTK_CASE}: ${_result}\n${_output}\n${_error}")
    endif()
else()
    execute_process(COMMAND "${TEST_PROGRAM}" "${CASE}" "${_root}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 20)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "SDK observation ${CASE}: ${_result}\n${_output}\n${_error}")
    endif()
endif()
