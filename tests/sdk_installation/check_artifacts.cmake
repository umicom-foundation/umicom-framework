# Fixture roots and logs are private build output. Each run retains its evidence.
cmake_minimum_required(VERSION 3.24)
if(NOT CASE MATCHES "^(complete|missing|directory|absent|unicode|malformed|relative|unknown-option)$")
    message(FATAL_ERROR "Unknown artifact observation case: ${CASE}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(_root "${TEST_BINARY}/${CASE}-${_id}")
if(EXISTS "${_root}")
    message(FATAL_ERROR "Artifact fixture already exists")
endif()
set(_prefix "${_root}/SDK")
if(CASE STREQUAL "unicode")
    set(_prefix "${_root}/SDK Ω")
endif()
file(MAKE_DIRECTORY "${_prefix}/share/umicom/framework" "${_prefix}/lib" "${_prefix}/bin")
set(_receipt "${_prefix}/share/umicom/framework/sdk-artifacts.txt")
file(WRITE "${_prefix}/lib/a.a" "fixture archive; presence only")
if(CASE STREQUAL "directory")
    file(MAKE_DIRECTORY "${_prefix}/bin/sdk-tool.exe")
elseif(NOT CASE STREQUAL "missing")
    file(WRITE "${_prefix}/bin/sdk-tool.exe" "fixture command; never executed")
endif()
if(NOT CASE STREQUAL "absent")
    set(_records "a|archive|lib/a.a\ntool|tool|bin/sdk-tool.exe\napi|interface|-\n")
    set(_count 3)
    if(CASE STREQUAL "malformed")
        set(_count 4)
    endif()
    file(WRITE "${_receipt}" "schema=umicom.sdk.artifacts/1\nconfiguration=Debug\nentries=${_count}\n${_records}")
    file(SHA256 "${_receipt}" _before)
endif()
set(_expected 0)
if(DEFINED CLI_PROGRAM)
    if(CASE STREQUAL "relative")
        set(_argument SDK)
    else()
        set(_argument "${_prefix}")
    endif()
    set(_option --all)
    if(CASE STREQUAL "unknown-option")
        set(_option --execute)
    endif()
    set(_command "${CLI_PROGRAM}" sdk artifacts "${_argument}" "${_option}")
    if(CASE STREQUAL "missing" OR CASE STREQUAL "directory")
        set(_expected 1)
    elseif(CASE STREQUAL "absent" OR CASE STREQUAL "malformed" OR CASE STREQUAL "unknown-option")
        set(_expected 2)
    endif()
else()
    set(_observation "${CASE}")
    if(CASE STREQUAL "unicode")
        set(_observation complete)
    endif()
    set(_command "${TEST_PROGRAM}" inspect "${_prefix}" "${_observation}")
endif()
execute_process(COMMAND ${_command} WORKING_DIRECTORY "${_root}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 20)
file(WRITE "${_root}/observe.log" "${_out}\n${_err}")
if(NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Artifact observation returned ${_result}, expected ${_expected}; see ${_root}/observe.log\n${_out}\n${_err}")
endif()
if(DEFINED CLI_PROGRAM AND _expected LESS 2)
    if(NOT _out MATCHES "Declared file-presence evidence only")
        message(FATAL_ERROR "Artifact inspection did not explain its evidence boundary")
    endif()
    if(_expected EQUAL 1 AND NOT _out MATCHES "missing.*tool.*bin/sdk-tool.exe")
        message(FATAL_ERROR "Artifact diagnostic did not identify the missing developer tool")
    endif()
endif()
if(EXISTS "${_receipt}")
    file(SHA256 "${_receipt}" _after)
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Read-only observation changed the SDK receipt")
    endif()
endif()
file(READ "${_prefix}/lib/a.a" _archive)
if(NOT _archive STREQUAL "fixture archive; presence only")
    message(FATAL_ERROR "Read-only observation changed an installed artifact")
endif()
