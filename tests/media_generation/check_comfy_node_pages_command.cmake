if(NOT DEFINED HOST_EXE OR NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_CASE)
    message(FATAL_ERROR "HOST_EXE, TEST_ROOT and TEST_CASE are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/comfy_node_pages_fixture.cmake")
umicom_comfy_node_pages_fixture("${TEST_ROOT}" "${TEST_CASE}")
file(SHA256 "${NODE_DOCUMENT}" document_before)
file(SHA256 "${NODE_DATA_FILE}" data_before)
set(args comfy nodes "${NODE_DOCUMENT}" "${NODE_INPUT}")
set(expected 0)
set(ids A B C Z)
set(source_count 4)
set(offset 0)
set(limit 32)
set(selection_digest "985e214b6802f0a8c9a1fca992f3652e5840639702618a0aeeca601daf02c85d")
if(TEST_CASE STREQUAL "empty")
    set(ids)
    set(source_count 0)
    set(selection_digest "777574ba752c47d3daaac660ee2082aef0645c48f5e21925e3fdc2bf42935db8")
elseif(TEST_CASE STREQUAL "help")
    set(args comfy nodes --help)
elseif(TEST_CASE STREQUAL "relative")
    set(args comfy nodes "${NODE_DOCUMENT}" relative.json)
    set(expected 1)
elseif(TEST_CASE STREQUAL "extra")
    list(APPEND args extra)
    set(expected 2)
elseif(TEST_CASE MATCHES "^(disabled|malformed-document|malformed-catalogue|missing-file|directory|catalogue-limit|document-limit|empty-file)$")
    set(expected 1)
elseif(TEST_CASE STREQUAL "page" OR TEST_CASE STREQUAL "options-order")
    set(offset 1)
    set(limit 2)
    if(TEST_CASE STREQUAL "page")
        list(APPEND args --offset 1 --limit 2)
    else()
        list(APPEND args --limit 2 --order class --offset 1)
    endif()
elseif(TEST_CASE STREQUAL "last-page")
    set(offset 3)
    set(limit 2)
    list(APPEND args --offset 3 --limit 2)
elseif(TEST_CASE STREQUAL "end")
    set(offset 4)
    list(APPEND args --offset 4)
elseif(TEST_CASE STREQUAL "beyond")
    list(APPEND args --offset 5)
    set(expected 1)
elseif(TEST_CASE STREQUAL "offset-overflow")
    list(APPEND args --offset 184467440737095516160)
    set(expected 2)
elseif(TEST_CASE STREQUAL "negative")
    list(APPEND args --offset -1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "zero-limit")
    list(APPEND args --limit 0)
    set(expected 2)
elseif(TEST_CASE STREQUAL "limit-overflow")
    list(APPEND args --limit 65)
    set(expected 2)
elseif(TEST_CASE STREQUAL "duplicate")
    list(APPEND args --limit 1 --limit 2)
    set(expected 2)
elseif(TEST_CASE STREQUAL "duplicate-search")
    list(APPEND args --search A --search B)
    set(expected 2)
elseif(TEST_CASE STREQUAL "unknown-option")
    list(APPEND args --activate yes)
    set(expected 2)
elseif(TEST_CASE STREQUAL "missing-value")
    list(APPEND args --search)
    set(expected 2)
elseif(TEST_CASE STREQUAL "search")
    list(APPEND args --search IMAGE)
    set(ids A B Z)
    set(selection_digest "e8d892b40aa5e703b295beecb68f6a71ed7e9a9b3f99dea1e2042671b4c1cf6e")
elseif(TEST_CASE STREQUAL "category")
    list(APPEND args --category image)
    set(ids A Z)
    set(selection_digest "e83863ec9b358a264c31fe183637508029fbfb351244ae7d9310f4664d6380a9")
elseif(TEST_CASE STREQUAL "category-boundary")
    list(APPEND args --category image2)
    set(ids B)
    set(selection_digest "8e9a54c0ca624e87d77d85d59d4352b84f3e1fb18edb12b71e5750413e5ad8d6")
elseif(TEST_CASE STREQUAL "invalid-category")
    list(APPEND args --category image//edit)
    set(expected 1)
elseif(TEST_CASE STREQUAL "order-source")
    list(APPEND args --order source)
    set(ids Z A B C)
    set(selection_digest "6d9a68b2a1c215bd1df87101a13444b3c7d2d463d9aa12ea693696e3a2692045")
elseif(TEST_CASE STREQUAL "order-display")
    list(APPEND args --order display)
elseif(TEST_CASE STREQUAL "order-category")
    list(APPEND args --order category)
    set(ids A Z B C)
    set(selection_digest "87dc1d2f6d39ae3986be78ba157c22459f24f8bf8a4eb8d6131ec5bd800b2cb1")
elseif(TEST_CASE STREQUAL "require-true")
    list(APPEND args --require-true 1)
    set(ids Z)
    set(selection_digest "9aeddf18efc2020a7280af6fd5af488adc916173aa7747b4d5c4d22eedee8067")
elseif(TEST_CASE STREQUAL "require-false")
    list(APPEND args --require-false 1)
    set(ids C)
    set(selection_digest "d59f5e9d7e796a146c8d09f7475759f0eae803a55fbea83a308f8e8bcba1cc1d")
elseif(TEST_CASE STREQUAL "flags-overlap")
    list(APPEND args --require-true 1 --require-false 1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "flags-range")
    list(APPEND args --require-true 16)
    set(expected 2)
elseif(TEST_CASE STREQUAL "invalid-order")
    list(APPEND args --order random)
    set(expected 2)
elseif(TEST_CASE STREQUAL "long-search")
    string(REPEAT x 257 query)
    list(APPEND args --search "${query}")
    set(expected 2)
endif()
execute_process(COMMAND "${HOST_EXE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 35)
if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "Node command ${TEST_CASE}: ${result}, expected ${expected}: ${error}")
endif()
if(expected EQUAL 0 AND NOT TEST_CASE STREQUAL "help")
    string(JSON origin GET "${output}" origin)
    string(JSON scope GET "${output}" report scope)
    string(JSON revision_type TYPE "${output}" report connection_revision)
    string(JSON revision GET "${output}" report connection_revision)
    string(JSON response GET "${output}" report response_sha256)
    string(JSON selection GET "${output}" report selection_sha256)
    string(JSON actual_source GET "${output}" report source_count)
    string(JSON selected GET "${output}" report selected_count)
    string(JSON actual_offset GET "${output}" report offset)
    string(JSON count GET "${output}" report page_count)
    string(JSON next GET "${output}" report next_offset)
    string(JSON remaining GET "${output}" report remaining_count)
    string(JSON rows LENGTH "${output}" report nodes)
    list(LENGTH ids total)
    math(EXPR expected_count "${total}-${offset}")
    if(expected_count GREATER limit)
        set(expected_count "${limit}")
    endif()
    math(EXPR expected_next "${offset}+${expected_count}")
    math(EXPR expected_remaining "${total}-${expected_next}")
    if(NOT origin STREQUAL "offline-files" OR NOT scope STREQUAL "node-selection-observations" OR
       NOT revision_type STREQUAL "STRING" OR NOT revision STREQUAL "7" OR
       NOT response STREQUAL data_before OR NOT selection STREQUAL selection_digest OR
       NOT actual_source EQUAL source_count OR NOT selected EQUAL total OR NOT actual_offset EQUAL offset OR
       NOT count EQUAL expected_count OR NOT rows EQUAL expected_count OR
       NOT next EQUAL expected_next OR NOT remaining EQUAL expected_remaining OR error)
        message(FATAL_ERROR "Node page identity, counts or output contract changed")
    endif()
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(i RANGE 0 ${last})
            math(EXPR position "${offset}+${i}")
            list(GET ids ${position} id)
            string(JSON actual_id GET "${output}" report nodes ${i} class_type)
            string(JSON actual_position GET "${output}" report nodes ${i} selection_index)
            if(NOT actual_id STREQUAL id OR NOT actual_position EQUAL position)
                message(FATAL_ERROR "Node page order changed")
            endif()
            if(id STREQUAL "A")
                string(JSON unknown TYPE "${output}" report nodes ${i} output_node)
                string(JSON known TYPE "${output}" report nodes ${i} deprecated)
                string(JSON value GET "${output}" report nodes ${i} deprecated)
                if(NOT unknown STREQUAL "NULL" OR NOT known STREQUAL "BOOLEAN" OR value)
                    message(FATAL_ERROR "Unknown flag was confused with explicit false")
                endif()
            endif()
        endforeach()
    endif()
    if(output MATCHES "PRIVATE_DEFAULT|PRIVATE_EXTENSION")
        message(FATAL_ERROR "Descriptor or extension leaked into metadata projection")
    endif()
elseif(expected GREATER 0 AND NOT output STREQUAL "")
    message(FATAL_ERROR "Failed node command emitted partial output")
elseif(TEST_CASE STREQUAL "help" AND NOT output MATCHES "comfy nodes CONNECTION OBJECT_INFO")
    message(FATAL_ERROR "Node browsing help missing")
endif()
if(DEFINED COMPARE_EXE)
    execute_process(COMMAND "${COMPARE_EXE}" ${args}
        RESULT_VARIABLE peer_result OUTPUT_VARIABLE peer_output ERROR_VARIABLE peer_error TIMEOUT 35)
    if(NOT peer_result STREQUAL result OR NOT peer_output STREQUAL output OR NOT peer_error STREQUAL error)
        message(FATAL_ERROR "Native hosts disagree about node browsing")
    endif()
endif()
file(SHA256 "${NODE_DOCUMENT}" document_after)
file(SHA256 "${NODE_DATA_FILE}" data_after)
if(NOT document_before STREQUAL document_after OR NOT data_before STREQUAL data_after)
    message(FATAL_ERROR "Node command changed its inputs")
endif()
