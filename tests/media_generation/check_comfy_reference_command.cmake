if(NOT DEFINED HOST_EXE OR NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_CASE)
    message(FATAL_ERROR "HOST_EXE, TEST_ROOT and TEST_CASE are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/comfy_inspection_fixture.cmake")
umicom_comfy_inspection_fixture("${TEST_ROOT}" "${TEST_CASE}")
set(flow [=[{"root":{"class_type":"Text","inputs":{"text":"PRIVATE_SENTINEL_DO_NOT_EMIT"}},"reader":{"class_type":"Text","inputs":{"a":["root",0],"b":["missing",0]}}}]=])
if(TEST_CASE STREQUAL "complete")
    string(REPLACE "[\"missing\",0]" "[\"root\",0]" flow "${flow}")
elseif(TEST_CASE STREQUAL "unknown-slot")
    string(REPLACE "[\"root\",0]" "[\"root\",true]" flow "${flow}")
elseif(TEST_CASE STREQUAL "empty")
    set(flow [=[{"root":{"class_type":"Text","inputs":{}}}]=])
elseif(TEST_CASE STREQUAL "malformed-workflow")
    set(flow "{")
endif()
file(WRITE "${INSPECTION_WORKFLOW}" "${flow}")
set(args comfy references "${INSPECTION_CONNECTION}" "${INSPECTION_WORKFLOW}" "${INSPECTION_NODES}")
set(expected 0)
set(offset 0)
set(page 2)
if(TEST_CASE STREQUAL "page")
    list(APPEND args --limit 1)
    set(page 1)
elseif(TEST_CASE STREQUAL "last-page")
    list(APPEND args --offset 1 --limit 1)
    set(offset 1)
    set(page 1)
elseif(TEST_CASE STREQUAL "end")
    list(APPEND args --offset 2)
    set(offset 2)
    set(page 0)
elseif(TEST_CASE STREQUAL "beyond")
    list(APPEND args --offset 3)
    set(expected 1)
elseif(TEST_CASE STREQUAL "offset-overflow")
    list(APPEND args --offset 99999999999999999999999999)
    set(expected 2)
elseif(TEST_CASE STREQUAL "negative")
    list(APPEND args --offset -1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "zero-limit")
    list(APPEND args --limit 0)
    set(expected 2)
elseif(TEST_CASE STREQUAL "limit-overflow")
    list(APPEND args --limit 257)
    set(expected 2)
elseif(TEST_CASE STREQUAL "duplicate")
    list(APPEND args --offset 0 --offset 1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "unknown-option")
    list(APPEND args --unknown 1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "missing-value")
    list(APPEND args --offset)
    set(expected 2)
elseif(TEST_CASE STREQUAL "malformed-workflow")
    set(expected 1)
elseif(TEST_CASE STREQUAL "relative")
    set(args comfy references "${INSPECTION_CONNECTION}" relative.json "${INSPECTION_NODES}")
    set(expected 1)
elseif(TEST_CASE STREQUAL "help")
    set(args comfy references --help)
elseif(TEST_CASE STREQUAL "options-order")
    list(APPEND args --limit 1 --client-id "review session" --offset 1)
    set(offset 1)
    set(page 1)
elseif(TEST_CASE STREQUAL "empty-client")
    # Keep an explicit empty argument at the execute_process boundary; list expansion may discard it.
    if(FALSE)
        list(APPEND args --client-id "")
    endif()
    set(expected 2)
elseif(TEST_CASE STREQUAL "empty")
    set(page 0)
endif()
# Preserve the initial list-only execution for review. The shared runner also
# transports an explicit empty client argument without list expansion loss.
if(FALSE)
execute_process(COMMAND "${HOST_EXE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 35)
endif()
function(reference_run executable prefix)
    if(TEST_CASE STREQUAL "empty-client")
        execute_process(COMMAND "${executable}" ${args} --client-id ""
            RESULT_VARIABLE run_result OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error TIMEOUT 35)
    else()
        execute_process(COMMAND "${executable}" ${args}
            RESULT_VARIABLE run_result OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error TIMEOUT 35)
    endif()
    set("${prefix}result" "${run_result}" PARENT_SCOPE)
    set("${prefix}output" "${run_output}" PARENT_SCOPE)
    set("${prefix}error" "${run_error}" PARENT_SCOPE)
endfunction()
reference_run("${HOST_EXE}" "")
if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "Reference command exit ${result}; expected ${expected}: ${error}")
endif()
if(TEST_CASE STREQUAL "help")
    if(NOT output MATCHES "reference observations" OR NOT output MATCHES "custom-node data")
        message(FATAL_ERROR "Missing scoped reference help")
    endif()
elseif(expected EQUAL 0)
    string(JSON origin GET "${output}" origin)
    string(JSON scope GET "${output}" report scope)
    string(JSON count GET "${output}" report candidate_count)
    string(JSON page_count GET "${output}" report page_count)
    string(JSON actual_offset GET "${output}" report offset)
    string(JSON actual_length LENGTH "${output}" report candidates)
    string(JSON remaining GET "${output}" report remaining_count)
    if(NOT origin STREQUAL "offline-files" OR NOT scope STREQUAL "reference-candidate-observations" OR
       NOT page_count EQUAL page OR NOT actual_length EQUAL page OR NOT actual_offset EQUAL offset)
        message(FATAL_ERROR "Reference page metadata differs")
    endif()
    if(TEST_CASE STREQUAL "empty")
        if(NOT count EQUAL 0 OR NOT remaining EQUAL 0)
            message(FATAL_ERROR "Empty inventory misreported")
        endif()
    else()
        math(EXPR expected_remaining "2 - ${offset} - ${page}")
        string(JSON missing GET "${output}" report missing_target_count)
        set(expected_missing 1)
        if(TEST_CASE STREQUAL "complete")
            set(expected_missing 0)
        endif()
        if(NOT count EQUAL 2 OR NOT remaining EQUAL expected_remaining OR NOT missing EQUAL expected_missing)
            message(FATAL_ERROR "Complete aggregate counts were lost during pagination")
        endif()
        if(TEST_CASE STREQUAL "unknown-slot")
            string(JSON slot_type TYPE "${output}" report candidates 0 output_slot)
            if(NOT slot_type STREQUAL "NULL")
                message(FATAL_ERROR "Unknown slot was coerced")
            endif()
        endif()
    endif()
    if(output MATCHES "PRIVATE_SENTINEL_DO_NOT_EMIT")
        message(FATAL_ERROR "Unrelated input value appeared in reference output")
    endif()
elseif(NOT output STREQUAL "")
    message(FATAL_ERROR "Refused reference command emitted a partial page")
endif()
if(DEFINED COMPARE_EXE)
    # Use the same exact argument transport for the comparison host.
    if(FALSE)
    execute_process(COMMAND "${COMPARE_EXE}" ${args}
        RESULT_VARIABLE other_result OUTPUT_VARIABLE other_output ERROR_VARIABLE other_error TIMEOUT 35)
    endif()
    reference_run("${COMPARE_EXE}" "other_")
    if(NOT other_result STREQUAL result OR NOT other_output STREQUAL output OR NOT other_error STREQUAL error)
        message(FATAL_ERROR "Reference command differs between shared hosts")
    endif()
endif()
