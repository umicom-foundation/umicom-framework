if(NOT DEFINED HOST_EXE OR NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_CASE)
    message(FATAL_ERROR "HOST_EXE, TEST_ROOT and TEST_CASE are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/comfy_queue_fixture.cmake")
umicom_comfy_queue_fixture("${TEST_ROOT}" "${TEST_CASE}")
file(SHA256 "${QUEUE_DOCUMENT_FILE}" document_before)
file(SHA256 "${QUEUE_DATA_FILE}" queue_before)
set(args comfy queue "${QUEUE_DOCUMENT}" "${QUEUE_INPUT}")
set(expected 0)
set(offset 0)
set(page 3)
set(total 3)
if(TEST_CASE STREQUAL "empty")
    set(page 0)
    set(total 0)
elseif(TEST_CASE STREQUAL "page")
    list(APPEND args --limit 1)
    set(page 1)
elseif(TEST_CASE STREQUAL "last-page")
    list(APPEND args --offset 2 --limit 1)
    set(offset 2)
    set(page 1)
elseif(TEST_CASE STREQUAL "end")
    list(APPEND args --offset 3)
    set(offset 3)
    set(page 0)
elseif(TEST_CASE STREQUAL "beyond")
    list(APPEND args --offset 4)
    set(expected 1)
elseif(TEST_CASE STREQUAL "offset-overflow")
    list(APPEND args --offset 99999999999999999999999999)
    set(expected 2)
elseif(TEST_CASE STREQUAL "negative")
    list(APPEND args --offset -1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "zero-limit")
    list(APPEND args --limit 0)
    set(expected 2)
elseif(TEST_CASE STREQUAL "limit-overflow")
    list(APPEND args --limit 257)
    set(expected 2)
elseif(TEST_CASE STREQUAL "duplicate")
    list(APPEND args --limit 1 --limit 2)
    set(expected 2)
elseif(TEST_CASE STREQUAL "unknown-option")
    list(APPEND args --unknown 1)
    set(expected 2)
elseif(TEST_CASE STREQUAL "missing-value")
    list(APPEND args --limit)
    set(expected 2)
elseif(TEST_CASE STREQUAL "relative")
    set(args comfy queue "${QUEUE_DOCUMENT}" relative.json)
    set(expected 1)
elseif(TEST_CASE STREQUAL "help")
    set(args comfy queue --help)
elseif(TEST_CASE STREQUAL "options-order")
    list(APPEND args --limit 1 --offset 1)
    set(offset 1)
    set(page 1)
elseif(TEST_CASE STREQUAL "extra")
    list(APPEND args extra)
    set(expected 2)
elseif(TEST_CASE MATCHES "^(malformed-queue|disabled|malformed-document|missing-file|directory|queue-limit)$")
    set(expected 1)
endif()
execute_process(COMMAND "${HOST_EXE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 35)
if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "Queue command ${TEST_CASE}: ${result}, expected ${expected}\n${output}\n${error}")
endif()
if(output MATCHES "PRIVATE_|127\\.0\\.0\\.1" OR error MATCHES "PRIVATE_|127\\.0\\.0\\.1")
    message(FATAL_ERROR "Raw prompt, extra data, output-node or endpoint escaped into console output")
endif()
if(expected EQUAL 0 AND NOT TEST_CASE STREQUAL "help")
    string(JSON origin GET "${output}" origin)
    string(JSON scope GET "${output}" report scope)
    string(JSON revision_type TYPE "${output}" report connection_revision)
    string(JSON revision GET "${output}" report connection_revision)
    string(JSON digest GET "${output}" report response_sha256)
    string(JSON actual_offset GET "${output}" report offset)
    string(JSON actual_page GET "${output}" report page_count)
    string(JSON actual_total GET "${output}" report entry_count)
    string(JSON entries LENGTH "${output}" report entries)
    if(NOT origin STREQUAL "offline-files" OR NOT scope STREQUAL "queue-observations" OR
       NOT revision_type STREQUAL "STRING" OR NOT revision STREQUAL "7" OR
       NOT digest STREQUAL queue_before OR NOT actual_offset EQUAL offset OR
       NOT actual_page EQUAL page OR NOT entries EQUAL page OR NOT actual_total EQUAL total)
        message(FATAL_ERROR "Queue page identity or counts differ from the captured fixture")
    endif()
    math(EXPR remaining "${total} - ${offset} - ${page}")
    math(EXPR next "${offset} + ${page}")
    string(JSON actual_remaining GET "${output}" report remaining_count)
    string(JSON actual_next GET "${output}" report next_offset)
    if(NOT actual_remaining EQUAL remaining OR NOT actual_next EQUAL next)
        message(FATAL_ERROR "Queue continuation counts changed")
    endif()
    if(page GREATER 0)
        string(JSON number_type TYPE "${output}" report entries 0 number_json)
        string(JSON number GET "${output}" report entries 0 number_json)
        string(JSON state GET "${output}" report entries 0 state)
        set(numbers "-0" "9007199254740993" "2.5E+2")
        list(GET numbers "${offset}" wanted_number)
        set(wanted_state pending)
        if(offset EQUAL 0)
            set(wanted_state running)
        endif()
        if(NOT number_type STREQUAL "STRING" OR NOT number STREQUAL wanted_number OR NOT state STREQUAL wanted_state)
            message(FATAL_ERROR "Scheduling token or running/pending category changed")
        endif()
    endif()
elseif(expected GREATER 0 AND NOT output STREQUAL "")
    message(FATAL_ERROR "Failed command published partial standard output")
endif()
if(DEFINED COMPARE_EXE)
    execute_process(COMMAND "${COMPARE_EXE}" ${args}
        RESULT_VARIABLE peer_result OUTPUT_VARIABLE peer_output ERROR_VARIABLE peer_error TIMEOUT 35)
    if(NOT peer_result STREQUAL result OR NOT peer_output STREQUAL output OR NOT peer_error STREQUAL error)
        message(FATAL_ERROR "Media/SDK and native CLI queue behavior differ")
    endif()
endif()
file(SHA256 "${QUEUE_DOCUMENT_FILE}" document_after)
file(SHA256 "${QUEUE_DATA_FILE}" queue_after)
if(NOT document_before STREQUAL document_after OR NOT queue_before STREQUAL queue_after)
    message(FATAL_ERROR "Queue command changed its input files")
endif()
