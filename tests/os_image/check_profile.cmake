# Fixtures are confined to this test's binary directory. No image is built.
if(NOT DEFINED PROGRAM OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Supply PROGRAM, WORK and CASE")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(_profile "UMICOM_OS_PROFILE\t1\nbuildroot\t0123456789abcdef0123456789abcdef01234567\nlinux\t6.12.109\nlinux-sha256\t0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\nfile\tframework/notice\nfile\tumicomOS/image/native/profile.umi\n")
set(_file "${WORK}/profile.umi")
set(_expected 0)
set(_extra)
if(CASE STREQUAL "unicode")
    set(_file "${WORK}/profil-café.umi")
elseif(CASE STREQUAL "space")
    set(_file "${WORK}/profile copy.umi")
elseif(CASE STREQUAL "malformed")
    string(APPEND _profile "file\toutside/secret\n")
    set(_expected 1)
elseif(CASE STREQUAL "missing")
    set(_expected 1)
elseif(CASE STREQUAL "extra-option")
    set(_extra --arch riscv64)
    set(_expected 2)
elseif(CASE STREQUAL "duplicate")
    set(_extra --file "${_file}")
    set(_expected 2)
elseif(NOT CASE STREQUAL "valid")
    message(FATAL_ERROR "Unknown profile case")
endif()
if(NOT CASE STREQUAL "missing")
    file(WRITE "${_file}" "${_profile}")
else()
    # Unique directory per invocation prevents an earlier run supplying input.
    string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef _suffix)
    set(_file "${WORK}/absent-${_suffix}.umi")
endif()
execute_process(COMMAND "${PROGRAM}" profile --file "${_file}" ${_extra}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
if(NOT _result STREQUAL "${_expected}")
    message(FATAL_ERROR "Profile command returned ${_result}, expected ${_expected}\n${_out}\n${_err}")
endif()
if(_expected EQUAL 0)
    if(NOT _out MATCHES "UMICOM_OS_PROFILE_INSPECTION 1" OR
       NOT _out MATCHES "files=2" OR NOT _out MATCHES "process-launched=0" OR
       NOT _out MATCHES "profile-sha256=[0-9a-f]+" OR
       NOT _out MATCHES "file=framework/notice")
        message(FATAL_ERROR "Accepted profile output is incomplete: ${_out}")
    endif()
else()
    if(_out MATCHES "UMICOM_OS_PROFILE_INSPECTION 1" OR _out MATCHES "completed=1")
        message(FATAL_ERROR "Rejected input produced accepted profile output")
    endif()
endif()
