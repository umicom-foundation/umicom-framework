# Umicom Framework
# File: tests/check_cli_compiler_plan.cmake
#
# PURPOSE:
#   Inspect native CLI plan JSON and exact argument order without a real driver.
#
# AUTHOR AND ORGANISATION:
# Sammy Hegab
# Umicom Foundation
#
# LICENCE:
# MIT
#-----------------------------------------------------------------------------
foreach(_key IN ITEMS UMICOM PROVIDER ACTION LANGUAGE)
    if(NOT DEFINED ${_key} OR "${${_key}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${_key}")
    endif()
endforeach()
if(LANGUAGE STREQUAL "c")
    set(_standard c17)
    set(_language_id 1)
else()
    set(_standard c++20)
    set(_language_id 2)
endif()
set(_source "source with spaces.${LANGUAGE}")
set(_directory "directory that is not opened")
set(_driver "driver that does not exist")
set(_output "object that is not created.o")
set(_definition "NAME=\"quoted value\"")
set(_options --include "first include" --include "second include"
    --define "${_definition}" --define SECOND=2 --warnings-as-errors)
if(ACTION STREQUAL "compile")
    list(APPEND _options --output "${_output}" --debug)
    set(_action_id 1)
else()
    set(_action_id 6)
endif()
if(POSITION_INDEPENDENT)
    if(NOT ACTION STREQUAL "compile" OR PROVIDER STREQUAL "msvc")
        message(FATAL_ERROR "Position-independent fixture requires GCC/Clang compile")
    endif()
    list(APPEND _options --position-independent)
endif()
# The tested executable is the Umicom presentation client. The requested compiler
# and source do not exist; a successful preview must not require or execute them.
execute_process(COMMAND "${UMICOM}" compiler plan --provider "${PROVIDER}"
    --executable "${_driver}" --language "${LANGUAGE}" --action "${ACTION}"
    --standard "${_standard}" --source "${_source}" --working-directory "${_directory}"
    ${_options}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _json ERROR_VARIABLE _error TIMEOUT 10)
if(NOT _result STREQUAL "0" OR NOT _error STREQUAL "")
    message(FATAL_ERROR "Plan refused: ${_result}; ${_error}")
endif()
string(JSON _version GET "${_json}" schema_version)
string(JSON _executed GET "${_json}" executed)
string(JSON _verified GET "${_json}" toolchain_verified)
if(NOT _version EQUAL 1 OR _executed OR _verified)
    message(FATAL_ERROR "Preview claimed execution or an unknown schema")
endif()
foreach(_field IN ITEMS provider executable working_directory language action)
    string(JSON _value GET "${_json}" "${_field}")
    if(_field STREQUAL "provider")
        set(_expected "${PROVIDER}")
    elseif(_field STREQUAL "executable")
        set(_expected "${_driver}")
    elseif(_field STREQUAL "working_directory")
        set(_expected "${_directory}")
    elseif(_field STREQUAL "language")
        set(_expected "${_language_id}")
    else()
        set(_expected "${_action_id}")
    endif()
    if(NOT _value STREQUAL _expected)
        message(FATAL_ERROR "Unexpected ${_field}: ${_value}")
    endif()
endforeach()
if(PROVIDER STREQUAL "msvc")
    if(ACTION STREQUAL "check")
        set(_arguments /nologo /Zs "/std:${_standard}" "${_source}")
    else()
        set(_arguments /nologo /c "/std:${_standard}" "${_source}" "/Fo${_output}")
    endif()
    list(APPEND _arguments "/Ifirst include" "/Isecond include" "/D${_definition}" /DSECOND=2)
    if(ACTION STREQUAL "compile")
        list(APPEND _arguments /Zi)
    endif()
    list(APPEND _arguments /WX)
else()
    if(ACTION STREQUAL "check")
        set(_arguments -fsyntax-only "-std=${_standard}")
    else()
        set(_arguments -c "-std=${_standard}")
    endif()
    if(PROVIDER STREQUAL "clang")
        # Host-target spelling varies by the build platform. Check its explicit
        # token without pretending this metadata qualifies that target.
        string(JSON _target GET "${_json}" arguments 2)
        if(NOT _target MATCHES "^--target=.+$")
            message(FATAL_ERROR "Clang target token is absent")
        endif()
        list(APPEND _arguments "${_target}")
    endif()
    list(APPEND _arguments "${_source}")
    if(ACTION STREQUAL "compile")
        list(APPEND _arguments -o "${_output}")
    endif()
    list(APPEND _arguments "-Ifirst include" "-Isecond include" "-D${_definition}" -DSECOND=2)
    if(ACTION STREQUAL "compile")
        list(APPEND _arguments -g)
    endif()
    list(APPEND _arguments -Werror)
    if(POSITION_INDEPENDENT)
        list(APPEND _arguments -fPIC)
    endif()
endif()
string(JSON _count LENGTH "${_json}" arguments)
list(LENGTH _arguments _expected_count)
if(NOT _count EQUAL _expected_count)
    message(FATAL_ERROR "Unexpected argument count ${_count}, wanted ${_expected_count}")
endif()
math(EXPR _last "${_count} - 1")
foreach(_index RANGE 0 ${_last})
    string(JSON _value GET "${_json}" arguments ${_index})
    list(GET _arguments ${_index} _expected)
    if(NOT _value STREQUAL _expected)
        message(FATAL_ERROR "Argument ${_index} differs: ${_value}")
    endif()
endforeach()
