cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED ROOT OR NOT DEFINED DEST OR NOT DEFINED CASE)
    message(FATAL_ERROR "ROOT, DEST and CASE are required")
endif()
file(MAKE_DIRECTORY "${DEST}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${ROOT}/tests/release_qualification/inputs"
    -B "${DEST}" -G Ninja "-DROOT=${ROOT}" "-DCASE=${CASE}"
    RESULT_VARIABLE _result OUTPUT_FILE "${DEST}/configure.txt" ERROR_FILE "${DEST}/configure-errors.txt")
file(READ "${DEST}/configure-errors.txt" _errors)
set(_expected "")
if(CASE STREQUAL "bad-owner")
    set(_expected "Unknown qualification input owner")
elseif(CASE STREQUAL "alias" OR CASE STREQUAL "imported")
    set(_expected "Qualification inputs require a real local target")
elseif(CASE STREQUAL "expression")
    set(_expected "Qualification input must be a literal file path")
elseif(CASE STREQUAL "directory")
    set(_expected "Qualification input cannot be a directory")
elseif(CASE STREQUAL "no-files" OR CASE STREQUAL "unknown-argument")
    set(_expected "Qualification inputs require FILES")
endif()
if(NOT _expected STREQUAL "")
    if(_result STREQUAL "0" OR NOT _errors MATCHES "${_expected}")
        message(FATAL_ERROR "Invalid declaration was not refused as expected; see ${DEST}")
    endif()
elseif(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Declared input composition failed; see ${DEST}/configure-errors.txt")
endif()
