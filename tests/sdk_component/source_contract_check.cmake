# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
cmake_minimum_required(VERSION 3.24)
foreach(_required FRAMEWORK_ROOT OUTPUT_ROOT GENERATOR CC CTEST_BIN)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Source-contract SDK fixture requires ${_required}")
    endif()
endforeach()
if(NOT TEST_CASE MATCHES "^(source-contracts|source-contracts-relocated|source-contracts-release)$")
    message(FATAL_ERROR "Unknown source-contract SDK fixture: ${TEST_CASE}")
endif()
if(NOT CONFIG)
    set(CONFIG Debug)
endif()
if(TEST_CASE STREQUAL "source-contracts-release")
    set(CONFIG Release)
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run_id)
set(_run "${OUTPUT_ROOT}/run-${_run_id}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Source-contract SDK fixture output already exists")
endif()
file(MAKE_DIRECTORY "${_run}")
function(source_contract_stage name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result
        OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
    file(WRITE "${_run}/${name}.log" "${_out}\n${_err}")
    if(NOT "${_result}" STREQUAL "0")
        message(FATAL_ERROR "Source-contract SDK ${name} failed; see ${_run}/${name}.log\n${_out}\n${_err}")
    endif()
endfunction()
set(_settings -G "${GENERATOR}" "-DCMAKE_C_COMPILER=${CC}"
    "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCMAKE_INSTALL_LIBDIR=lib" "-DBUILD_TESTING=OFF")
foreach(_setting MAKE_PROGRAM GENERATOR_PLATFORM GENERATOR_TOOLSET)
    if(DEFINED ${_setting} AND NOT "${${_setting}}" STREQUAL "")
        list(APPEND _settings "-DCMAKE_${_setting}=${${_setting}}")
    endif()
endforeach()
source_contract_stage(configure "${CMAKE_COMMAND}"
    -S "${FRAMEWORK_ROOT}/tools/source_contracts" -B "${_run}/producer" ${_settings})
source_contract_stage(build "${CMAKE_COMMAND}" --build "${_run}/producer"
    --config "${CONFIG}" --target umicom-sdk-libraries --parallel 2)
set(_prefix "${_run}/installed SDK")
source_contract_stage(install "${CMAKE_COMMAND}" --install "${_run}/producer"
    --config "${CONFIG}" --component FrameworkSDK --prefix "${_prefix}")
file(READ "${_prefix}/share/umicom/framework/sdk-artifacts.txt" _inventory)
foreach(_record "umicom_source_contracts|archive|lib/" "umicom-source-contracts|tool|bin/")
    string(FIND "${_inventory}" "${_record}" _index)
    if(_index LESS 0)
        message(FATAL_ERROR "Production source-contract SDK receipt omitted ${_record}")
    endif()
endforeach()
if(TEST_CASE STREQUAL "source-contracts-relocated")
    # Move only this newly created fixture-owned installation; retain all evidence.
    file(RENAME "${_prefix}" "${_run}/relocated SDK")
    set(_prefix "${_run}/relocated SDK")
endif()
source_contract_stage(consumer-configure "${CMAKE_COMMAND}"
    -S "${FRAMEWORK_ROOT}/tests/sdk_component/source_contract_consumer"
    -B "${_run}/consumer" ${_settings} "-DSDK_ROOT=${_prefix}")
source_contract_stage(consumer-build "${CMAKE_COMMAND}" --build "${_run}/consumer"
    --config "${CONFIG}" --parallel 2)
source_contract_stage(consumer-test "${CTEST_BIN}" --test-dir "${_run}/consumer"
    -C "${CONFIG}" --output-on-failure --no-tests=error --output-junit "${_run}/consumer-tests.xml")
message(STATUS "Source-contract SDK fixture passed; logs: ${_run}")
