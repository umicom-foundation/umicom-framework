cmake_minimum_required(VERSION 3.29)
foreach(_required PROGRAM WORK CASE)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Supply PROGRAM, WORK and CASE")
    endif()
endforeach()
set(_cases success failure unicode invalid-state malformed missing-report legacy)
if(NOT CASE IN_LIST _cases)
    message(FATAL_ERROR "Unknown process-result case")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _nonce)
set(_root "${WORK}/${_nonce}")
if(CASE STREQUAL "unicode")
    string(APPEND _root "/résultats with spaces")
endif()
file(MAKE_DIRECTORY "${_root}")
string(REPEAT a 64 _digest)
set(_header "UMICOM-TEST-REUSE 1 ${_digest}\n")
set(_initial "${_header}alpha\t${_digest}\t2\nbeta\t${_digest}\t0\n")
set(_current "${_header}alpha\t${_digest}\t0\nbeta\t${_digest}\t0\n")
set(_state "${_root}/state.tsv")
set(_report "${_root}/report.xml")
file(CONFIGURE OUTPUT "${_state}" CONTENT "${_initial}" @ONLY NEWLINE_STYLE LF)
file(CONFIGURE OUTPUT "${_root}/current.tsv" CONTENT "${_current}" @ONLY NEWLINE_STYLE LF)
set(_xml "<testsuite tests='1'><testcase name='beta' status='run' time='0'/></testsuite>")
set(_status failure)
set(_expected_status 0)
set(_expected_state "${_initial}")
set(_expected_excluded "alpha\n")
if(CASE STREQUAL "success" OR CASE STREQUAL "legacy")
    set(_status success)
    set(_expected_state "${_header}alpha\t${_digest}\t2\nbeta\t${_digest}\t2\n")
    set(_expected_excluded "alpha\nbeta\n")
elseif(CASE STREQUAL "invalid-state")
    set(_status unknown)
    set(_expected_status 1)
elseif(CASE STREQUAL "malformed")
    set(_xml "<testsuite tests='2'><testcase name='beta' status='run' time='0'/></testsuite>")
    set(_expected_status 1)
elseif(CASE STREQUAL "missing-report")
    set(_expected_status 1)
endif()
if(NOT CASE STREQUAL "missing-report")
    file(CONFIGURE OUTPUT "${_report}" CONTENT "${_xml}" @ONLY NEWLINE_STYLE LF)
endif()
file(SHA256 "${_state}" _before_hash)
if(CASE STREQUAL "legacy")
    set(_arguments record "${_state}" "${_report}")
else()
    set(_arguments record-result "${_state}" "${_report}" "${_status}")
endif()
execute_process(COMMAND "${PROGRAM}" ${_arguments}
    RESULT_VARIABLE _actual OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 15)
if(NOT _actual STREQUAL "${_expected_status}")
    message(FATAL_ERROR "record result ${_actual}, expected ${_expected_status}: ${_out}\n${_err}")
endif()
file(READ "${_state}" _saved)
if(NOT _saved STREQUAL _expected_state)
    message(FATAL_ERROR "Saved outcomes differ from process-result policy")
endif()
if(NOT _expected_status EQUAL 0)
    file(SHA256 "${_state}" _after_hash)
    if(NOT _before_hash STREQUAL _after_hash)
        message(FATAL_ERROR "Rejected observation replaced the prior receipt")
    endif()
endif()
execute_process(COMMAND "${PROGRAM}" prepare "${_root}/current.tsv" "${_state}" "${_root}/excluded.txt"
    RESULT_VARIABLE _prepared OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 15)
if(NOT _prepared STREQUAL "0")
    message(FATAL_ERROR "Retry preparation failed: ${_out}\n${_err}")
endif()
file(READ "${_root}/excluded.txt" _excluded)
if(NOT _excluded STREQUAL _expected_excluded)
    message(FATAL_ERROR "Unexpected historical exclusions: [${_excluded}]")
endif()
message(STATUS "Process-result file boundary checked: ${CASE}; evidence ${_root}")
