if(NOT DEFINED TOOL OR NOT DEFINED DEST OR NOT DEFINED ROOT OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL, DEST, ROOT and CASE are required")
endif()
include("${ROOT}/cmake/UmicomReleaseInventoryFormat.cmake")
file(MAKE_DIRECTORY "${DEST}")
file(WRITE "${DEST}/a.c" "aaaa")
file(WRITE "${DEST}/a.h" "hhhh")
set(_input "${DEST}/inventory.tsv")
string(HEX "${DEST}" _source)
string(HEX "${DEST}/build" _build)
string(HEX "${DEST}/a.h" _header)
file(WRITE "${_input}" "UMICOM-RELEASE-INVENTORY\t1\ncontext\tcmake\t0123456789abcdef0123456789abcdef\t${_source}\t${_build}\t4465627567\n")
_umicom_inventory_row("${_input}" target base "${DEST}" configured "impact-version=1\ncomplete=1\nimpact-end\n")
_umicom_inventory_row("${_input}" source "${DEST}/a.c" base present "synthetic")
_umicom_inventory_row("${_input}" header "a.h" base declared "impact-version=1\npath=${_header}\nimpact-end\nsynthetic")
_umicom_inventory_row("${_input}" test check "${DEST}" registered "impact-version=1\ncomplete=1\ntarget=62617365\nimpact-end\n")
if(CASE STREQUAL "duplicate" OR CASE STREQUAL "list-duplicate")
    _umicom_inventory_row("${_input}" target helper "${DEST}" configured "impact-version=1\ncomplete=1\nimpact-end\n")
    _umicom_inventory_row("${_input}" source "${DEST}/a.c" helper present "synthetic")
endif()
file(SHA256 "${_input}" _inventory_before)
file(SHA256 "${DEST}/a.c" _source_before)
# The original invocation is retained for review; the replacement also exercises
# implicit observation through input listing while retaining the default cases.
#[[
execute_process(COMMAND "${TOOL}" impact --inventory "${_input}" --full --observe-sources
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _errors TIMEOUT 30)
]]
set(_observe_flags --observe-sources)
set(_list_flags "")
if(CASE MATCHES "^list")
    set(_observe_flags --list-inputs)
    set(_list_flags --list-inputs)
endif()
execute_process(COMMAND "${TOOL}" impact --inventory "${_input}" --full ${_observe_flags}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _errors TIMEOUT 30)
file(WRITE "${DEST}/capture.txt" "${_output}\n${_errors}")
if(NOT _result STREQUAL "0" OR NOT _output MATCHES "Source observation: ([0-9a-f]+); files: 2")
    message(FATAL_ERROR "Source capture failed; inspect ${DEST}")
endif()
set(_fingerprint "${CMAKE_MATCH_1}")
if(CASE MATCHES "^list")
    string(REGEX MATCHALL "source-file\t[^\n]*" _listed "${_output}")
    list(LENGTH _listed _listed_count)
    file(SHA256 "${DEST}/a.h" _header_digest)
    if(NOT _listed_count EQUAL 2 OR NOT _output MATCHES "source-file\t${_source_before}\t4\t" OR
            NOT _output MATCHES "source-file\t${_header_digest}\t4\t")
        message(FATAL_ERROR "Complete deduplicated input evidence was not listed")
    endif()
endif()
string(LENGTH "${_fingerprint}" _length)
if(NOT _length EQUAL 64 OR NOT _output MATCHES "PREVIEW ONLY")
    message(FATAL_ERROR "Observation omitted its bounded identity or preview-only meaning")
endif()
file(SHA256 "${_input}" _inventory_after)
file(SHA256 "${DEST}/a.c" _source_after)
if(NOT _inventory_before STREQUAL _inventory_after OR NOT _source_before STREQUAL _source_after)
    message(FATAL_ERROR "Source observation mutated its inputs")
endif()
set(_expected 0)
if(CASE STREQUAL "same-size")
    file(WRITE "${DEST}/a.c" "bbbb")
    set(_expected 3)
elseif(CASE STREQUAL "header")
    file(WRITE "${DEST}/a.h" "jjjj")
    set(_expected 3)
elseif(CASE STREQUAL "missing" OR CASE STREQUAL "list-missing")
    file(REMOVE "${DEST}/a.c")
    set(_expected 2)
elseif(CASE STREQUAL "context")
    file(READ "${_input}" _text)
    string(REPLACE "0123456789abcdef0123456789abcdef" "a123456789abcdef0123456789abcdef" _text "${_text}")
    file(WRITE "${_input}" "${_text}")
    set(_expected 3)
elseif(CASE STREQUAL "unresolved")
    _umicom_inventory_row("${_input}" source "${DEST}/generated.c" base unresolved "generated")
    set(_expected 2)
elseif(CASE STREQUAL "directory")
    file(MAKE_DIRECTORY "${DEST}/not-a-file")
    _umicom_inventory_row("${_input}" source "${DEST}/not-a-file" base present "synthetic")
    set(_expected 2)
elseif(CASE STREQUAL "invalid-fingerprint")
    set(_fingerprint "not-a-fingerprint")
    set(_expected 2)
elseif(NOT CASE STREQUAL "same" AND NOT CASE STREQUAL "duplicate" AND
        NOT CASE STREQUAL "list" AND NOT CASE STREQUAL "list-duplicate")
    message(FATAL_ERROR "Unknown observation CLI case")
endif()
execute_process(COMMAND "${TOOL}" impact --inventory "${_input}" --full --expect-sources "${_fingerprint}" ${_list_flags}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _errors TIMEOUT 30)
file(WRITE "${DEST}/compare.txt" "${_output}\n${_errors}")
if(NOT _result STREQUAL "${_expected}")
    message(FATAL_ERROR "Source comparison exit code mismatch; inspect ${DEST}")
endif()
if(_expected EQUAL 3)
    if(NOT _output MATCHES "Source observation changed" OR _output MATCHES "selected targets:")
        message(FATAL_ERROR "A stale source observation emitted a usable selection")
    endif()
elseif(_expected EQUAL 2)
    if(_output MATCHES "Source observation:" OR _output MATCHES "selected targets:" OR _output MATCHES "source-file\t")
        message(FATAL_ERROR "A failed observation emitted partial evidence")
    endif()
elseif(NOT _output MATCHES "Listed source bytes and inventory match" OR NOT _output MATCHES "PREVIEW ONLY")
    message(FATAL_ERROR "A matching observation was not reported as preview-only")
endif()

if(CASE STREQUAL "missing" OR CASE STREQUAL "unresolved" OR CASE STREQUAL "directory")
    if(NOT _errors MATCHES "Source observation input:")
        message(FATAL_ERROR "Observation failure did not identify its input")
    endif()
    if(CASE STREQUAL "missing" AND NOT _errors MATCHES "/a\\.c")
        message(FATAL_ERROR "Missing source diagnostic named the wrong path")
    elseif(CASE STREQUAL "unresolved" AND NOT _errors MATCHES "/generated\\.c")
        message(FATAL_ERROR "Unresolved source diagnostic named the wrong path")
    elseif(CASE STREQUAL "directory" AND NOT _errors MATCHES "/not-a-file")
        message(FATAL_ERROR "Directory diagnostic named the wrong path")
    endif()
endif()
