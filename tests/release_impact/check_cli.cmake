#-----------------------------------------------------------------------------
if(NOT DEFINED TOOL OR NOT DEFINED DEST OR NOT DEFINED ROOT OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL, DEST, ROOT and CASE are required")
endif()
include("${ROOT}/cmake/UmicomReleaseInventoryFormat.cmake")
file(MAKE_DIRECTORY "${DEST}")
set(_input "${DEST}/inventory.tsv")
string(HEX "${DEST}" _source)
string(HEX "${DEST}/build" _build)
file(WRITE "${_input}" "UMICOM-RELEASE-INVENTORY\t1\ncontext\tcmake\t0123456789abcdef0123456789abcdef\t${_source}\t${_build}\t4465627567\n")
_umicom_inventory_row("${_input}" target base "${DEST}" configured "impact-version=1\ncomplete=1\nimpact-end\n")
_umicom_inventory_row("${_input}" source "${DEST}/a.c" base present "synthetic")
if(NOT CASE STREQUAL "no-tests")
    _umicom_inventory_row("${_input}" test "test.[x]" "${DEST}" registered "impact-version=1\ncomplete=1\ntarget=62617365\nimpact-end\n")
endif()
file(SHA256 "${_input}" _before)
set(_expected 0)
set(_arguments --inventory "${_input}" --changed a.c)
if(CASE STREQUAL "unknown")
    set(_arguments --inventory "${_input}" --changed new.c)
elseif(CASE STREQUAL "invalid")
    set(_arguments --inventory "${_input}" --changed ../a.c)
    set(_expected 2)
elseif(CASE STREQUAL "conflicting-options")
    set(_arguments --inventory "${_input}" --changed a.c --working-tree)
    set(_expected 2)
elseif(CASE STREQUAL "expression")
    list(APPEND _arguments --expression)
elseif(CASE STREQUAL "no-tests")
    set(_expected 1)
elseif(NOT CASE STREQUAL "selected")
    message(FATAL_ERROR "Unknown CLI case")
endif()
execute_process(COMMAND "${TOOL}" impact ${_arguments}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _errors TIMEOUT 30)
file(WRITE "${DEST}/stdout.txt" "${_output}")
file(WRITE "${DEST}/stderr.txt" "${_errors}")
file(SHA256 "${_input}" _after)
if(NOT _before STREQUAL _after OR NOT _result STREQUAL "${_expected}")
    message(FATAL_ERROR "Impact CLI status/immutability failure; inspect ${DEST}")
endif()
if(CASE STREQUAL "selected" OR CASE STREQUAL "expression")
    if(NOT _output MATCHES "selected targets: 1; selected tests: 1" OR NOT _output MATCHES "PREVIEW ONLY")
        message(FATAL_ERROR "Expected native preview evidence was omitted")
    endif()
endif()
if(CASE STREQUAL "expression")
    string(FIND "${_output}" "^(test\\.\\[x\\])$" _found)
    if(_found LESS 0)
        message(FATAL_ERROR "Exact test-name expression was not escaped")
    endif()
endif()
if(CASE STREQUAL "unknown" AND NOT _output MATCHES "changed path has no configured owner")
    message(FATAL_ERROR "Unmapped-path fallback reason was omitted")
endif()
