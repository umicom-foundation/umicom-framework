if(NOT DEFINED HOST_EXE OR NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_CASE)
    message(FATAL_ERROR "HOST_EXE, TEST_ROOT and TEST_CASE are required")
endif()
if(NOT IS_ABSOLUTE "${TEST_ROOT}")
    message(FATAL_ERROR "TEST_ROOT must be an absolute build-owned path")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(path "${TEST_ROOT}/progress.ndjson")
set(content "{\"status\":\"PRIVATE_SENTINEL\",\"total\":8,\"completed\":4}\n{\"status\":\"success\"}\n")
set(expected 0)
set(outcome success)
if(TEST_CASE STREQUAL "error" OR TEST_CASE STREQUAL "json-error")
    set(content "{\"status\":\"pulling\"}\n{\"error\":\"PRIVATE_SENTINEL\"}\n")
    set(expected 3)
    set(outcome error)
elseif(TEST_CASE STREQUAL "incomplete")
    set(content "{\"status\":\"pulling\"}\n")
    set(expected 1)
elseif(TEST_CASE STREQUAL "malformed")
    set(content "{\n")
    set(expected 1)
elseif(TEST_CASE STREQUAL "duplicate")
    set(content "{\"status\":\"success\",\"status\":\"success\"}\n")
    set(expected 1)
elseif(TEST_CASE STREQUAL "empty")
    set(content "")
    set(expected 1)
elseif(TEST_CASE STREQUAL "crlf")
    string(REPLACE "\n" "\r\n" content "${content}")
elseif(TEST_CASE STREQUAL "no-final-lf")
    string(REGEX REPLACE "\n$" "" content "${content}")
elseif(TEST_CASE STREQUAL "after-terminal")
    string(APPEND content "{\"status\":\"pulling\"}\n")
    set(expected 1)
elseif(TEST_CASE STREQUAL "line-limit")
    string(REPEAT " " 16385 content)
    string(APPEND content "\n")
    set(expected 1)
elseif(TEST_CASE STREQUAL "file-limit")
    string(REPEAT "\n" 16777217 content)
    set(expected 1)
elseif(TEST_CASE STREQUAL "unicode")
    set(path "${TEST_ROOT}/café-進捗.ndjson")
endif()
file(WRITE "${path}" "${content}")
file(SHA256 "${path}" expected_hash)
file(SIZE "${path}" expected_bytes)
if(TEST_CASE STREQUAL "missing")
    set(path "${TEST_ROOT}/never-created.ndjson")
    if(EXISTS "${path}")
        message(FATAL_ERROR "Missing-file fixture was unexpectedly populated")
    endif()
    set(expected 1)
elseif(TEST_CASE STREQUAL "relative")
    set(path relative.ndjson)
    set(expected 1)
elseif(TEST_CASE STREQUAL "directory")
    set(path "${TEST_ROOT}")
    set(expected 1)
endif()
if(API_EXE)
    execute_process(COMMAND "${API_EXE}" "${TEST_CASE}" "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "API fixture ${TEST_CASE} failed: ${result} ${error}")
    endif()
    return()
endif()
# Standalone umicom-models excludes the umbrella models prefix. Other hosts
# deliberately run identical argument vectors through their thin routes.
set(prefix models)
if(STANDALONE_MODELS)
    set(prefix)
endif()
if(TEST_CASE STREQUAL "help")
    execute_process(COMMAND "${HOST_EXE}" ${prefix} inspect-pull --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
elseif(TEST_CASE STREQUAL "usage")
    set(expected 2)
    execute_process(COMMAND "${HOST_EXE}" ${prefix} inspect-pull RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
elseif(TEST_CASE STREQUAL "extra")
    set(expected 2)
    execute_process(COMMAND "${HOST_EXE}" ${prefix} inspect-pull "${path}" --apply RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
else()
    execute_process(COMMAND "${HOST_EXE}" ${prefix} inspect-pull "${path}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
endif()
if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "${TEST_CASE}: expected ${expected}, got ${result}: ${error}")
endif()
if(output MATCHES "PRIVATE_SENTINEL")
    message(FATAL_ERROR "Provider message leaked into metadata output")
endif()
if(TEST_CASE STREQUAL "help")
    if(NOT output MATCHES "no endpoint or model operation")
        message(FATAL_ERROR "Help does not explain observation-only scope")
    endif()
elseif(expected EQUAL 0 OR expected EQUAL 3)
    foreach(key scope file_sha256 bytes events provider_outcome server_identity_verified model_installation_verified)
        string(JSON value_${key} ERROR_VARIABLE parse_error GET "${output}" "${key}")
        if(parse_error)
            message(FATAL_ERROR "Missing JSON field ${key}: ${parse_error}")
        endif()
    endforeach()
    if(NOT value_scope STREQUAL "offline-pull-progress-file" OR
       NOT value_file_sha256 STREQUAL expected_hash OR NOT value_bytes EQUAL expected_bytes OR
       NOT value_events EQUAL 2 OR NOT value_provider_outcome STREQUAL outcome OR
       value_server_identity_verified OR value_model_installation_verified)
        message(FATAL_ERROR "Incorrect complete observation: ${output}")
    endif()
else()
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "Failed inspection published output: ${output}")
    endif()
endif()
