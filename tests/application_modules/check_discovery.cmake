cmake_minimum_required(VERSION 3.24)
# Each CTest case gets a separate directory, making concurrent runs independent.
set(_source "${TEST_BINARY}/source")
set(_binary "${TEST_BINARY}/build")
file(MAKE_DIRECTORY "${_source}/applications/weather")
configure_file("${FRAMEWORK_SOURCE}/tests/application_modules/discovery/CMakeLists.txt"
    "${_source}/CMakeLists.txt" COPYONLY)
file(READ "${FRAMEWORK_SOURCE}/tests/application_modules/fixtures/application.umicom.yaml" _manifest)
set(_registry "[submodule \"Weather tools\"]\n path = applications/weather\n url = https://example.invalid/weather.git\n")
set(_expected "")
if(CASE STREQUAL "duplicate_id")
    set(_expected "identity collision")
elseif(CASE STREQUAL "duplicate_option")
    set(_expected "option or installer component collision")
elseif(CASE STREQUAL "duplicate_component")
    set(_expected "option or installer component collision")
elseif(CASE STREQUAL "duplicate_executable")
    set(_expected "executable collision")
elseif(CASE STREQUAL "traversal")
    set(_registry "[submodule \"bad\"]\n path = applications/../outside\n")
    set(_expected "direct children")
elseif(CASE STREQUAL "device" OR CASE STREQUAL "leading_digit" OR CASE STREQUAL "trailing_dash")
    if(CASE STREQUAL "device")
        set(_slug "con")
    elseif(CASE STREQUAL "leading_digit")
        set(_slug "1weather")
    else()
        set(_slug "weather-")
    endif()
    string(REPLACE "applications/weather" "applications/${_slug}" _registry "${_registry}")
    set(_expected "portable direct children")
elseif(CASE STREQUAL "path_newline")
    string(REPLACE "path = applications/weather"
        "path = \"applications/weather\\nsubmodule.fake.path applications/other\"" _registry "${_registry}")
    set(_expected "Control byte in submodule path record")
elseif(CASE STREQUAL "quoted_path")
    string(REPLACE "path = applications/weather" "path = \"applications/weather\"" _registry "${_registry}")
elseif(CASE STREQUAL "registry_crlf")
    string(REPLACE "\n" "\r\n" _registry "${_registry}")
elseif(CASE STREQUAL "duplicate_path")
    string(APPEND _registry "[submodule \"again\"]\n path = applications/weather\n")
    set(_expected "Duplicate registered application path")
elseif(CASE STREQUAL "malformed")
    string(REPLACE "  id: org.umicom.weather" "  id: org.umicom.weather\n  id: org.umicom.other" _manifest "${_manifest}")
    set(_expected "Duplicate or malformed id")
elseif(CASE STREQUAL "indent")
    string(REPLACE "  id:" "    id:" _manifest "${_manifest}")
    set(_expected "malformed id")
elseif(CASE STREQUAL "frontend")
    string(REPLACE "  - gtk\n" "" _manifest "${_manifest}")
    set(_expected "Native executable requires")
elseif(CASE STREQUAL "frontend_indent")
    string(REPLACE "  - gtk" "    - gtk" _manifest "${_manifest}")
    set(_expected "Native executable requires")
elseif(CASE STREQUAL "frontend_section")
    string(REPLACE "capabilities:" "frontends:\n  - console\ncapabilities:" _manifest "${_manifest}")
    set(_expected "Repeated or malformed frontends")
elseif(CASE STREQUAL "list_syntax")
    string(REPLACE "Umicom Weather" "Weather;Injected" _manifest "${_manifest}")
    set(_expected "Unsupported name")
elseif(CASE STREQUAL "array_syntax")
    string(REPLACE "Umicom Weather" "Weather[Injected" _manifest "${_manifest}")
    set(_expected "Unsupported name")
elseif(CASE STREQUAL "oversize")
    string(REPEAT "x" 65537 _manifest)
    set(_expected "1..65536 bytes")
elseif(CASE STREQUAL "crlf")
    string(REPLACE "\n" "\r\n" _manifest "${_manifest}")
elseif(CASE STREQUAL "missing_manifest")
    set(_expected "lacks application.umicom.yaml")
elseif(CASE STREQUAL "missing_all")
    set(_expected "Initialise these application submodules")
elseif(CASE STREQUAL "reserved")
    set(_expected "option or installer component collision")
elseif(CASE STREQUAL "duplicate_registration")
    set(_expected "already registered")
endif()
# Source rules are tiny, but use real install and add_test registration.
set(_module [=[
add_library(weather-module INTERFACE)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/component.txt" "${CMAKE_INSTALL_DEFAULT_COMPONENT_NAME}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/component.txt" DESTINATION share/weather)
if(BUILD_TESTING)
    add_test(NAME weather.module.registered COMMAND "${CMAKE_COMMAND}" -E true)
endif()
]=])
if(NOT CASE STREQUAL "missing" AND NOT CASE STREQUAL "missing_all")
    file(WRITE "${_source}/applications/weather/CMakeLists.txt" "${_module}")
endif()
if(NOT CASE STREQUAL "missing_manifest")
    file(WRITE "${_source}/applications/weather/application.umicom.yaml" "${_manifest}")
endif()
if(CASE MATCHES "^duplicate_(id|option|component|executable)$")
    file(MAKE_DIRECTORY "${_source}/applications/rain")
    string(APPEND _registry "[submodule \"rain\"]\n path = applications/rain\n")
    file(WRITE "${_source}/applications/rain/CMakeLists.txt" "add_library(rain-module INTERFACE)\n")
    set(_other "${_manifest}")
    if(NOT CASE STREQUAL "duplicate_id")
        string(REPLACE "org.umicom.weather" "org.umicom.rain" _other "${_other}")
    endif()
    string(REPLACE "Umicom Weather" "Umicom Rain" _other "${_other}")
    string(REPLACE "umicom-weather" "umicom-rain" _other "${_other}")
    if(CASE STREQUAL "duplicate_option")
        # Prefix stripping maps weather and umicom-weather to one option.
        string(REPLACE "umicom-rain" "weather" _other "${_other}")
    elseif(CASE STREQUAL "duplicate_component")
        string(APPEND _other "\ninstallation:\n  component: UmicomWeather\n")
    elseif(CASE STREQUAL "duplicate_executable")
        string(REPLACE "console_executable: umicom-rain-console"
            "console_executable: umicom-weather-console" _other "${_other}")
    endif()
    file(WRITE "${_source}/applications/rain/application.umicom.yaml" "${_other}")
endif()
if(CASE STREQUAL "metadata_escape")
    file(MAKE_DIRECTORY "${TEST_BINARY}/outside")
    file(WRITE "${TEST_BINARY}/outside/CMakeLists.txt" "add_library(escaped INTERFACE)\n")
    # A distinct module avoids deleting any source file when a case is rerun.
    file(MAKE_DIRECTORY "${_source}/applications/linked")
    if(IS_SYMLINK "${_source}/applications/linked/CMakeLists.txt")
        file(READ_SYMLINK "${_source}/applications/linked/CMakeLists.txt" _existing_link)
        if(NOT _existing_link STREQUAL "${TEST_BINARY}/outside/CMakeLists.txt")
            message(FATAL_ERROR "Fixture contains an unexpected existing link")
        endif()
        set(_link_status "0")
    else()
        file(CREATE_LINK "${TEST_BINARY}/outside/CMakeLists.txt" "${_source}/applications/linked/CMakeLists.txt"
            SYMBOLIC RESULT _link_status)
    endif()
    if(NOT _link_status STREQUAL "0")
        message("SKIP: developer symlink creation is unavailable")
        return()
    endif()
    file(WRITE "${_source}/applications/linked/application.umicom.yaml" "${_manifest}")
    set(_registry "[submodule \"linked\"]\n path = applications/linked\n")
    set(_expected "metadata escapes its module")
elseif(CASE STREQUAL "module_escape")
    file(MAKE_DIRECTORY "${TEST_BINARY}/outside")
    file(WRITE "${TEST_BINARY}/outside/CMakeLists.txt" "add_library(escaped INTERFACE)\n")
    file(WRITE "${TEST_BINARY}/outside/application.umicom.yaml" "${_manifest}")
    if(IS_SYMLINK "${_source}/applications/linked")
        file(READ_SYMLINK "${_source}/applications/linked" _existing_link)
        if(NOT _existing_link STREQUAL "${TEST_BINARY}/outside")
            message(FATAL_ERROR "Fixture contains an unexpected existing link")
        endif()
        set(_link_status "0")
    else()
        file(CREATE_LINK "${TEST_BINARY}/outside" "${_source}/applications/linked"
            SYMBOLIC RESULT _link_status)
    endif()
    if(NOT _link_status STREQUAL "0")
        message("SKIP: developer symlink creation is unavailable")
        return()
    endif()
    set(_registry "[submodule \"linked\"]\n path = applications/linked\n")
    set(_expected "escapes the suite")
endif()
# An unregistered folder must never be discovered or execute CMake.
file(MAKE_DIRECTORY "${_source}/applications/unregistered")
file(WRITE "${_source}/applications/unregistered/CMakeLists.txt"
    "message(FATAL_ERROR \"Unregistered source executed\")\n")
file(WRITE "${_source}/.gitmodules" "${_registry}")
set(_generator_args -G "${TEST_GENERATOR}")
if(TEST_PLATFORM)
    list(APPEND _generator_args -A "${TEST_PLATFORM}")
endif()
if(TEST_TOOLSET)
    list(APPEND _generator_args -T "${TEST_TOOLSET}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${_generator_args} -S "${_source}" -B "${_binary}"
    "-DFRAMEWORK_SOURCE=${FRAMEWORK_SOURCE}" "-DCASE=${CASE}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
if(_expected)
    if(_result STREQUAL "0")
        message(FATAL_ERROR "Invalid module configuration succeeded")
    endif()
    string(FIND "${_output}\n${_error}" "${_expected}" _match)
    if(_match EQUAL -1)
        message(FATAL_ERROR "Expected '${_expected}', got: ${_output}\n${_error}")
    endif()
elseif(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Discovery configuration failed: ${_output}\n${_error}")
elseif(CASE STREQUAL "enabled" OR CASE STREQUAL "all")
    # Generate, but do not install or build. Inspect the real generated rules.
    file(READ "${_binary}/applications/weather/cmake_install.cmake" _install)
    string(FIND "${_install}" "UmicomWeather" _component)
    file(READ "${_binary}/applications/weather/CTestTestfile.cmake" _tests)
    string(FIND "${_tests}" "weather.module.registered" _test)
    if(_component EQUAL -1 OR _test EQUAL -1)
        message(FATAL_ERROR "Module install or CTest rules were not preserved")
    endif()
endif()
