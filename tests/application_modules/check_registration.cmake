# Local metadata fixtures never create a Git repository or contact a remote.
foreach(_required TEST_PROGRAM TEST_BINARY CASE GIT_PROGRAM)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing registration test argument: ${_required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _suffix)
set(_root "${TEST_BINARY}/${CASE}-${_suffix}")
file(MAKE_DIRECTORY "${_root}/applications/weather")
file(REAL_PATH "${_root}" _root)
set(_manifest "schema: umicom.application.v1\napplication:\n  id: org.example.weather\n  name: Weather\n  version: 0.1.0\n  executable: umicom-weather\n  console_executable: umicom-weather\nframework:\n  minimum_version: 0.9.0\n  compatible_major: 0\nfrontends:\n  - console\ninstallation:\n  component: weather\n")
set(_modules "[submodule \"weather\"]\n path = applications/weather\n")
string(REPLACE "weather" "forecast" _candidate "${_manifest}")
string(REPLACE "Weather" "Forecast" _candidate "${_candidate}")
if(CASE STREQUAL "id")
    string(REPLACE "org.example.forecast" "org.example.WEATHER" _candidate "${_candidate}")
elseif(CASE STREQUAL "option")
    string(REPLACE "umicom-forecast" "umicom-WEATHER" _candidate "${_candidate}")
elseif(CASE STREQUAL "component")
    string(REPLACE "component: forecast" "component: WEATHER" _candidate "${_candidate}")
elseif(CASE STREQUAL "executable")
    string(REPLACE "console_executable: umicom-forecast" "console_executable: umicom-weather" _candidate "${_candidate}")
elseif(CASE STREQUAL "empty")
    set(_modules "# No registrations\n")
elseif(CASE STREQUAL "capacity")
    set(_modules "")
    foreach(_index RANGE 0 127)
        string(REPLACE "weather" "app${_index}" _other "${_manifest}")
        file(MAKE_DIRECTORY "${_root}/applications/app${_index}")
        file(WRITE "${_root}/applications/app${_index}/application.umicom.yaml" "${_other}")
        string(APPEND _modules "[submodule \"app${_index}\"]\n path = applications/app${_index}\n")
    endforeach()
endif()
if(CASE STREQUAL "malformed")
    file(WRITE "${_root}/applications/weather/application.umicom.yaml" "invalid\n")
elseif(NOT CASE STREQUAL "unavailable")
    file(WRITE "${_root}/applications/weather/application.umicom.yaml" "${_manifest}")
endif()
file(WRITE "${_root}/candidate.yaml" "${_candidate}")
file(WRITE "${_root}/.gitmodules" "${_modules}")
if(DEFINED CLI_PROGRAM)
    # Run the real command against the same fixture and require its evidence.
    get_filename_component(_git_directory "${GIT_PROGRAM}" DIRECTORY)
    if(WIN32)
        set(ENV{PATH} "${_git_directory};$ENV{PATH}")
    else()
        set(ENV{PATH} "${_git_directory}:$ENV{PATH}")
    endif()
    execute_process(COMMAND "${CLI_PROGRAM}" repo check-module "${_root}" "${_root}/candidate.yaml" applications/forecast
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 40)
    if(CASE STREQUAL "ready" OR CASE STREQUAL "empty")
        set(_expected 0)
    else()
        set(_expected 1)
    endif()
    if(NOT _result STREQUAL "${_expected}" OR NOT _output MATCHES "No submodule, index, commit or remote was changed")
        message(FATAL_ERROR "Registration CLI ${CASE} failed (${_result}):\n${_output}\n${_error}")
    endif()
else()
    execute_process(COMMAND "${TEST_PROGRAM}" "${CASE}" "${_root}" "${GIT_PROGRAM}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 40)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Registration ${CASE} failed (${_result}):\n${_output}\n${_error}")
    endif()
endif()
