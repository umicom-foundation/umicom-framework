foreach(_required TEST_BINARY TEST_PROGRAM TEMPLATE_SOURCE CASE)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing CLI test argument: ${_required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _suffix)
set(_root "${TEST_BINARY}/cli-${CASE}-${_suffix}")
file(MAKE_DIRECTORY "${_root}/applications")
file(REAL_PATH "${_root}" _root)
set(_arguments repo create "Weather" --module --parent "${_root}/applications"
    --slug weather --id org.example.weather --template-root "${TEMPLATE_SOURCE}")
if(CASE STREQUAL "unknown")
    list(APPEND _arguments --remote)
elseif(CASE STREQUAL "duplicate")
    list(APPEND _arguments --slug weather)
elseif(CASE STREQUAL "conflicting")
    list(APPEND _arguments --apply --dry-run)
elseif(CASE STREQUAL "show")
    list(APPEND _arguments --show CMakeLists.txt)
elseif(CASE STREQUAL "show_missing")
    list(APPEND _arguments --show absent.txt)
elseif(CASE STREQUAL "create" OR CASE STREQUAL "discover")
    list(APPEND _arguments --console-only --apply)
elseif(NOT CASE STREQUAL "preview")
    message(FATAL_ERROR "Unknown CLI case: ${CASE}")
endif()
execute_process(COMMAND "${TEST_PROGRAM}" ${_arguments}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 30)
if(CASE MATCHES "^(unknown|duplicate|conflicting|show_missing)$")
    if(_result STREQUAL "0")
        message(FATAL_ERROR "Invalid invocation succeeded: ${CASE}")
    endif()
elseif(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Creation command failed: ${_result}\n${_output}\n${_error}")
endif()
if(CASE STREQUAL "create" OR CASE STREQUAL "discover")
    set(_manifest "${_root}/applications/weather/application.umicom.yaml")
    if(NOT EXISTS "${_manifest}" OR EXISTS "${_root}/applications/weather/.git")
        message(FATAL_ERROR "Source creation did not preserve the source-only boundary")
    endif()
    execute_process(COMMAND "${TEST_PROGRAM}" repo inspect-module "${_manifest}"
        RESULT_VARIABLE _inspect OUTPUT_VARIABLE _identity ERROR_VARIABLE _error TIMEOUT 15)
    if(NOT _inspect STREQUAL "0" OR NOT _identity MATCHES "UMICOM_APPLICATIONS_BUILD_WEATHER")
        message(FATAL_ERROR "Created manifest cannot be inspected:\n${_identity}\n${_error}")
    endif()
else()
    if(EXISTS "${_root}/applications/weather")
        message(FATAL_ERROR "A preview or invalid invocation created destination source")
    endif()
endif()
if(CASE STREQUAL "show" AND NOT _output MATCHES "add_library\\(umicom_weather_model")
    message(FATAL_ERROR "File preview did not expose the rendered CMake source")
endif()
if(CASE STREQUAL "discover")
    # Only a local Git membership fixture is needed. No git init, add, commit,
    # remote connection or submodule clone is performed by this regression.
    file(WRITE "${_root}/.gitmodules"
        "[submodule \"applications/weather\"]\n path = applications/weather\n url = https://example.invalid/weather.git\n")
    file(COPY "${FIXTURE_SOURCE}/CMakeLists.txt" DESTINATION "${_root}")
    set(_configure "${CMAKE_COMMAND}" -S "${_root}" -B "${_root}/build"
        -G "${TEST_GENERATOR}" "-DCMAKE_C_COMPILER=${TEST_C_COMPILER}"
        "-DFRAMEWORK_SOURCE=${FRAMEWORK_SOURCE}")
    if(TEST_PLATFORM)
        list(APPEND _configure -A "${TEST_PLATFORM}")
    endif()
    if(TEST_TOOLSET)
        list(APPEND _configure -T "${TEST_TOOLSET}")
    endif()
    execute_process(COMMAND ${_configure} RESULT_VARIABLE _configured
        OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 60)
    if(NOT _configured STREQUAL "0")
        message(FATAL_ERROR "Generated source registration failed:\n${_output}\n${_error}")
    endif()
endif()
