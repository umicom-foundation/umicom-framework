# Isolated source fixtures exercise actual Git config parsing without repositories.
foreach(_required TEST_PROGRAM TEST_BINARY CASE GIT_PROGRAM)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing catalogue argument: ${_required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _suffix)
set(_root "${TEST_BINARY}/${CASE}-${_suffix}")
file(MAKE_DIRECTORY "${_root}/applications/weather" "${_root}/applications/other")
file(REAL_PATH "${_root}" _root)
set(_manifest "schema: umicom.application.v1\napplication:\n  id: org.example.weather\n  name: Weather\n  version: 0.1.0\n  executable: umicom-weather\n  console_executable: umicom-weather\nframework:\n  minimum_version: 0.9.0\n  compatible_major: 0\nfrontends:\n  - console\ninstallation:\n  component: weather\n")
file(WRITE "${_root}/applications/weather/application.umicom.yaml" "${_manifest}")
set(_modules "[submodule \"weather\"]\n path = applications/weather\n url = https://example.invalid/weather.git\n")
if(CASE STREQUAL "absent")
    set(_modules "")
elseif(CASE STREQUAL "empty" OR CASE STREQUAL "unregistered")
    set(_modules "# No registered applications\n")
elseif(CASE STREQUAL "includes")
    file(WRITE "${_root}/extra.config" "${_modules}")
    set(_modules "[include]\n path = extra.config\n")
elseif(CASE STREQUAL "missing")
    # A registered but uninitialised checkout remains visible as unavailable.
    set(_manifest "")
elseif(CASE STREQUAL "malformed")
    file(WRITE "${_root}/applications/weather/application.umicom.yaml" "not a manifest\n")
elseif(CASE STREQUAL "traversal")
    string(REPLACE "applications/weather" "applications/../weather" _modules "${_modules}")
elseif(CASE STREQUAL "nested")
    string(REPLACE "applications/weather" "applications/weather/nested" _modules "${_modules}")
elseif(CASE STREQUAL "key_space")
    string(REPLACE "\"weather\"" "\"weather name\"" _modules "${_modules}")
elseif(CASE STREQUAL "device")
    string(REPLACE "applications/weather" "applications/con" _modules "${_modules}")
elseif(CASE STREQUAL "leading_digit")
    string(REPLACE "applications/weather" "applications/1weather" _modules "${_modules}")
elseif(CASE STREQUAL "trailing_dash")
    string(REPLACE "applications/weather" "applications/weather-" _modules "${_modules}")
elseif(CASE STREQUAL "path_newline")
    string(REPLACE "path = applications/weather" "path = \"applications/weather\\nsubmodule.fake.path applications/other\"" _modules "${_modules}")
elseif(CASE STREQUAL "quoted")
    string(REPLACE "path = applications/weather" "path = \"applications/weather\"" _modules "${_modules}")
elseif(CASE STREQUAL "crlf")
    string(REPLACE "\n" "\r\n" _modules "${_modules}")
elseif(CASE STREQUAL "duplicate_path")
    string(APPEND _modules "[submodule \"second\"]\n path = applications/weather\n")
elseif(CASE MATCHES "^duplicate_")
    string(REPLACE "org.example.weather" "org.example.other" _other "${_manifest}")
    string(REPLACE "umicom-weather" "umicom-other" _other "${_other}")
    string(REPLACE "name: Weather" "name: Other" _other "${_other}")
    string(REPLACE "component: weather" "component: other" _other "${_other}")
    if(CASE STREQUAL "duplicate_id")
        string(REPLACE "org.example.other" "org.example.weather" _other "${_other}")
    elseif(CASE STREQUAL "duplicate_component")
        string(REPLACE "component: other" "component: WEATHER" _other "${_other}")
    elseif(CASE STREQUAL "duplicate_option")
        string(REPLACE "umicom-other" "umicom-WEATHER" _other "${_other}")
    elseif(CASE STREQUAL "duplicate_executable")
        string(REPLACE "console_executable: umicom-other" "console_executable: umicom-weather" _other "${_other}")
    endif()
    file(WRITE "${_root}/applications/other/application.umicom.yaml" "${_other}")
    string(APPEND _modules "[submodule \"other\"]\n path = applications/other\n")
elseif(CASE STREQUAL "capacity")
    set(_modules "")
    foreach(_index RANGE 0 128)
        string(APPEND _modules "[submodule \"app${_index}\"]\n path = applications/app${_index}\n")
    endforeach()
endif()
if(CASE STREQUAL "missing")
    # Point at another absent manifest without deleting any fixture content.
    file(RENAME "${_root}/applications/weather" "${_root}/applications/retained-weather")
endif()
if(NOT CASE STREQUAL "absent")
    file(WRITE "${_root}/.gitmodules" "${_modules}")
endif()
execute_process(COMMAND "${TEST_PROGRAM}" "${CASE}" "${_root}" "${GIT_PROGRAM}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 40)
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Catalogue ${CASE} failed (${_result}):\n${_output}\n${_error}")
endif()
