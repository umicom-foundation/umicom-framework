endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umi-kanban-project-window-test)
endif()
if(COMMAND umicom_register_validation_target)
    umicom_register_validation_target(umi-kanban-project-window-test)
endif()
foreach(_project_board_case IN ITEMS project unicode copy generic closed arguments relative retire edit start metadata)
