# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
get_filename_component(_kanban_gtk_tests "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
add_executable(umi-kanban-gtk-test "${_kanban_gtk_tests}/tests/kanban_gtk4/test_panel.c")
target_link_libraries(umi-kanban-gtk-test PRIVATE Umicom::kanban_gtk4)
set_target_properties(umi-kanban-gtk-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
umicom_apply_warnings(umi-kanban-gtk-test)
umicom_apply_sanitizers(umi-kanban-gtk-test)
if(COMMAND umicom_register_validation_target)
    umicom_register_validation_target(umi-kanban-gtk-test)
endif()
foreach(_case IN ITEMS assignment move drag stale stale-form busy retired publication completion-reenter)
    set(_test "framework.kanban.gtk.${_case}")
    add_test(NAME "${_test}" COMMAND umi-kanban-gtk-test "${_case}")
    set_tests_properties("${_test}" PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77
        LABELS "framework;kanban;gtk4;ownership;regression")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners("${_test}" TARGETS umi-kanban-gtk-test)
    endif()
endforeach()

add_executable(umi-kanban-window-test "${_kanban_gtk_tests}/tests/kanban_gtk4/test_window.c")
