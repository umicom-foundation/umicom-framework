# Project locations use the same checked storage boundary as board documents.
add_executable(umi-kanban-project-window-test "${CMAKE_CURRENT_LIST_DIR}/test_project_window.c")
target_link_libraries(umi-kanban-project-window-test PRIVATE Umicom::kanban_gtk4)
set_target_properties(umi-kanban-project-window-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
