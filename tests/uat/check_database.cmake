# LICENCE: MIT
#-----------------------------------------------------------------------------
set(_args)
set(_expected_exit 0)
set(_expected_failed 0)
set(_expected_cleanup 0)
set(_ids create edit verify drop)
set(_phases 1 2 3 4)
set(_operations 32 32 16 32)
if(MODE STREQUAL "assert")
    set(_args --fail-assertion)
    set(_expected_exit 1)
    set(_expected_failed 1)
elseif(MODE STREQUAL "cleanup")
    set(_args --fail-cleanup)
    set(_expected_exit 1)
    set(_expected_failed 1)
    set(_expected_cleanup 1)
elseif(MODE STREQUAL "rollback")
    # A deliberate SQL refusal is a successful action only after rollback.
    # The subsequent assertion still verifies the exact saved row.
    set(_args --verify-rollback)
    set(_ids create edit rollback verify drop)
    set(_phases 1 2 2 3 4)
    set(_operations 32 32 32 16 32)
elseif(MODE STREQUAL "typed")
    set(_args --verify-types)
elseif(MODE STREQUAL "typed-rejected")
    # A matching display prefix and an extra byte after NUL must still fail.
    set(_args --reject-typed-change)
    set(_expected_exit 1)
    set(_expected_failed 1)
elseif(NOT MODE STREQUAL "pass")
    message(FATAL_ERROR "Unknown fixture mode")
endif()
execute_process(COMMAND "${PROGRAM}" ${_args} RESULT_VARIABLE _exit
    OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 10)
if(NOT "${_exit}" STREQUAL "${_expected_exit}")
    message(FATAL_ERROR "Unexpected example exit: ${_exit}: ${_error}")
endif()
string(JSON _failed GET "${_output}" failed)
string(JSON _cleanup GET "${_output}" cleanup_failed)
string(JSON _accepted GET "${_output}" accepted)
string(JSON _count LENGTH "${_output}" findings)
# The previous fixed cleanup ordinal is retained for review. Resolve the
# cleanup step from the selected plan when the transaction action is present.
if(FALSE)
    string(JSON _drop_state GET "${_output}" findings 3 state)
endif()
list(LENGTH _ids _expected_count)
math(EXPR _last "${_expected_count} - 1")
string(JSON _drop_state GET "${_output}" findings ${_last} state)
string(JSON _protocol GET "${_output}" target protocol)
string(JSON _platform GET "${_output}" target platform)
string(JSON _target GET "${_output}" target target_id)
string(JSON _session GET "${_output}" target session_id)
string(JSON _allowed GET "${_output}" target allowed_operations)
string(JSON _supported GET "${_output}" target supported_operations)
if(NOT _protocol EQUAL 1 OR NOT _platform EQUAL 1 OR NOT _target STREQUAL "sqlite-fixture"
        OR NOT _session STREQUAL "private-memory" OR NOT _allowed EQUAL 48 OR NOT _supported EQUAL 48)
    message(FATAL_ERROR "Incorrect admitted database target: ${_output}")
endif()
# Check the identity, phase and permission of every attempted finding.
foreach(_row RANGE 0 ${_last})
    list(GET _ids ${_row} _id)
    list(GET _phases ${_row} _phase)
    list(GET _operations ${_row} _operation)
    string(JSON _actual GET "${_output}" findings ${_row} operation)
    string(JSON _actual_id GET "${_output}" findings ${_row} id)
    string(JSON _actual_phase GET "${_output}" findings ${_row} phase)
    string(JSON _attempted GET "${_output}" findings ${_row} attempted)
    if(NOT _actual EQUAL _operation OR NOT _actual_id STREQUAL _id OR
            NOT _actual_phase EQUAL _phase OR NOT _attempted)
        message(FATAL_ERROR "Incorrect admitted finding ${_row}: ${_output}")
    endif()
endforeach()
if(NOT _count EQUAL _expected_count OR NOT _failed EQUAL _expected_failed OR NOT _cleanup EQUAL _expected_cleanup)
    message(FATAL_ERROR "Incorrect retained workflow findings: ${_output}")
endif()
if(MODE MATCHES "^(pass|rollback|typed)$")
    if(NOT _accepted)
        message(FATAL_ERROR "Passing fixture was not accepted")
    endif()
    if(MODE STREQUAL "rollback")
        # Keep the independent rollback, read assertion and cleanup results.
        foreach(_row RANGE 2 4)
            string(JSON _state GET "${_output}" findings ${_row} state)
            if(NOT _state STREQUAL "passed")
                message(FATAL_ERROR "The transaction workflow finding ${_row} must pass")
            endif()
        endforeach()
    endif()
elseif(_accepted)
    message(FATAL_ERROR "Failed fixture was incorrectly accepted")
endif()
if(MODE STREQUAL "assert" AND NOT _drop_state STREQUAL "passed")
    message(FATAL_ERROR "Assertion failure prevented eligible table cleanup")
endif()
if(MODE STREQUAL "typed-rejected")
    # A retained mismatch shows a human-readable location without row data.
    string(JSON _mismatch_output GET "${_output}" findings 2 output)
    if(NOT _mismatch_output STREQUAL "Unexpected database cell at row 1, column 2."
        OR _output MATCHES "saved|0001FF" OR NOT _drop_state STREQUAL "passed")
        message(FATAL_ERROR "Typed mismatch evidence omitted its location, exposed a value or lost cleanup")
    endif()
endif()
