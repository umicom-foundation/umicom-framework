# This package is a test double with placeholder archives. It cannot establish
# linkability, binary compatibility, resource staging or installed-model behavior.
get_filename_component(_fixture_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(UMICOM_FRAMEWORK_INSTALL_PREFIX "${_fixture_prefix}")
if(SDK_CASE STREQUAL "wrong-prefix")
    set(UMICOM_FRAMEWORK_INSTALL_PREFIX "${_fixture_prefix}/include")
endif()
if(SDK_CASE STREQUAL "missing-component")
    set(UmicomFramework_FOUND FALSE)
    set(UmicomFramework_NOT_FOUND_MESSAGE "local_models component unavailable in fixture")
    return()
endif()
add_library(Umicom::base STATIC IMPORTED)
set_target_properties(Umicom::base PROPERTIES
    IMPORTED_LOCATION "${_fixture_prefix}/lib/base.a"
    INTERFACE_INCLUDE_DIRECTORIES "${_fixture_prefix}/include"
    UMICOM_PUBLIC_CONTRACT_FINGERPRINT "@FIXTURE_FINGERPRINT@")
add_library(Umicom::local_models INTERFACE IMPORTED)
set_property(TARGET Umicom::local_models PROPERTY INTERFACE_LINK_LIBRARIES Umicom::base)
set(UmicomFramework_local_models_FOUND TRUE)
if(SDK_CASE STREQUAL "outside-library")
    set_property(TARGET Umicom::base PROPERTY IMPORTED_LOCATION "@OUTSIDE_ARCHIVE@")
elseif(SDK_CASE STREQUAL "missing-archive")
    set_property(TARGET Umicom::base PROPERTY IMPORTED_LOCATION "${_fixture_prefix}/lib/absent.a")
endif()

# Derive matching values from this test configure, then inject one incompatibility.
# Real packages publish the producer's metadata instead.
set(UMICOM_FRAMEWORK_ABI_VERSION 2)
set(UMICOM_FRAMEWORK_TARGET_SYSTEM "${CMAKE_SYSTEM_NAME}")
set(UMICOM_FRAMEWORK_TARGET_POINTER_BYTES "${CMAKE_SIZEOF_VOID_P}")
set(UMICOM_FRAMEWORK_PRODUCER_C_COMPILER "${CMAKE_C_COMPILER_ID}")
set(UMICOM_FRAMEWORK_PRODUCER_C_COMPILER_VERSION "${CMAKE_C_COMPILER_VERSION}")
if(SDK_CASE STREQUAL "abi")
    set(UMICOM_FRAMEWORK_ABI_VERSION 999)
elseif(SDK_CASE STREQUAL "compiler")
    set(UMICOM_FRAMEWORK_PRODUCER_C_COMPILER FixtureOtherCompiler)
elseif(SDK_CASE STREQUAL "metadata")
    unset(UMICOM_FRAMEWORK_TARGET_SYSTEM)
endif()
if(NOT SDK_CASE STREQUAL "missing-guard")
    include("${CMAKE_CURRENT_LIST_DIR}/UmicomRequireInstalledSdk.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UmicomRequireSdkEnvironment.cmake")

# The actual consumer must reach its normal target and branding composition
# only after admission. No resource appearance or staging is claimed by this stub.
function(umicom_apply_application_branding)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/fixture-admitted.txt"
        "${UMICOM_FRAMEWORK_INSTALL_PREFIX}\n")
endfunction()
