if(NOT DEFINED UMICOM_COMMAND OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Provide UMICOM_COMMAND, WORK and CASE")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(before_file "${WORK}/before.xml")
set(after_file "${WORK}/after.xml")
set(pass "<testcase name='same' status='run' time='0'/>")
set(fail "<testcase name='same' status='fail' time='0'><failure message='Failed'/></testcase>")
set(skip "<testcase name='same' status='notrun' time='0'><skipped message='SKIP_RETURN_CODE=77'/></testcase>")
set(disabled "<testcase name='same' status='disabled' time='0'/>")
set(before "<testsuite tests='1'>${fail}</testsuite>")
set(after "<testsuite tests='1'>${pass}</testsuite>")
set(expected 0)
set(fragments "Recovered: 1" "[recovered] same : failed -> passed")
if(CASE STREQUAL "unchanged-failure")
    set(after "${before}")
    set(expected 1)
    set(fragments "Unchanged outcomes: 1" "Recovered: 0" "contains non-passed tests")
elseif(CASE STREQUAL "removed-failure")
    set(after "<testsuite tests='0'/>")
    set(expected 1)
    set(fragments "Removed: 1" "Recovered: 0" "[removed] same : failed -> absent" "Removed tests are not verified repairs")
elseif(CASE STREQUAL "added-pass")
    set(before "<testsuite tests='0'/>")
    set(expected 1)
    set(fragments "Added: 1" "Recovered: 0" "[added] same : absent -> passed" "Test inventory changed")
elseif(CASE STREQUAL "regressed-skip")
    set(before "${after}")
    set(after "<testsuite tests='1'>${skip}</testsuite>")
    set(expected 1)
    set(fragments "Regressed: 1" "[regressed] same : passed -> skipped")
elseif(CASE STREQUAL "disabled-skip")
    set(before "<testsuite tests='1'>${disabled}</testsuite>")
    set(after "<testsuite tests='1'>${skip}</testsuite>")
    set(expected 1)
    set(fragments "Recovered: 0" "Other outcome changes: 1" "[outcome changed] same : disabled -> skipped")
elseif(CASE STREQUAL "empty")
    set(before "<testsuite tests='0'/>")
    set(after "${before}")
    set(expected 1)
    set(fragments "Before: 0 | After: 0" "is empty or contains non-passed tests")
elseif(CASE STREQUAL "unicode")
    set(before_file "${WORK}/café before.xml")
    set(after_file "${WORK}/café after.xml")
elseif(CASE STREQUAL "control-name")
    string(REPLACE "name='same'" "name='line&#10;two'" before "${before}")
    string(REPLACE "name='same'" "name='line&#10;two'" after "${after}")
    set(expected 2)
elseif(CASE STREQUAL "literal-name")
    string(REPLACE "name='same'" "name='caf&#233;.[a]+&amp;save'" before "${before}")
    string(REPLACE "name='same'" "name='café.[a]+&amp;save'" after "${after}")
    set(fragments "[recovered] café.[a]+&save : failed -> passed")
elseif(CASE STREQUAL "incomplete-before")
    set(before "<testsuite tests='1'>${fail}")
    set(expected 2)
elseif(CASE STREQUAL "incomplete-after")
    set(after "<testsuite tests='1'>${pass}")
    set(expected 2)
elseif(CASE STREQUAL "missing-before" OR CASE STREQUAL "missing-after")
    set(expected 2)
elseif(NOT CASE STREQUAL "recovered")
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()
file(WRITE "${before_file}" "${before}")
file(WRITE "${after_file}" "${after}")
file(SHA256 "${before_file}" before_hash)
file(SHA256 "${after_file}" after_hash)
set(before_argument "${before_file}")
set(after_argument "${after_file}")
if(CASE STREQUAL "missing-before")
    set(before_argument "${WORK}/absent-before.xml")
elseif(CASE STREQUAL "missing-after")
    set(after_argument "${WORK}/absent-after.xml")
endif()
execute_process(COMMAND "${UMICOM_COMMAND}" test-report --compare "${before_argument}" "${after_argument}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${before_file}" before_after)
file(SHA256 "${after_file}" after_after)
if(NOT before_hash STREQUAL before_after OR NOT after_hash STREQUAL after_after)
    message(FATAL_ERROR "Comparison changed a saved report")
endif()
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected exit ${expected}, got ${result}\n${output}\n${error}")
endif()
if(expected LESS 2)
    if(NOT output MATCHES "did not run tests or verify source revisions")
        message(FATAL_ERROR "Missing saved-evidence boundary")
    endif()
    foreach(fragment IN LISTS fragments)
        string(FIND "${output}" "${fragment}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing output: ${fragment}\n${output}")
        endif()
    endforeach()
elseif(NOT error MATCHES "Cannot compare saved CTest reports")
    message(FATAL_ERROR "Invalid inputs did not explain the comparison failure: ${error}")
endif()
