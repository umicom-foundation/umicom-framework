# -----------------------------------------------------------------------------
# Umicom Framework | Sammy Hegab | MIT
# Check the saved-report CLI boundary using synthetic public test records only.
# -----------------------------------------------------------------------------
if(NOT DEFINED UMICOM_COMMAND OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Provide UMICOM_COMMAND, WORK and CASE")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(report "${WORK}/report.xml")
set(expected 0)
set(passed "<testcase name='notes.pass' status='run' time='0'/>")
set(failed "<testcase name='notes.failure' status='fail' time='0'><failure message='Line&#10;two'/></testcase>")
set(skipped "<testcase name='notes.skip' status='notrun' time='0'><skipped message='SKIP_RETURN_CODE=77'/></testcase>")
set(disabled "<testcase name='notes.disabled' status='disabled' time='0'/>")
set(missing "<testcase name='notes.missing' status='notrun' time='0'><skipped message='Unable to find executable'/></testcase>")
set(timed "<testcase name='notes.timeout' status='fail' time='1'><failure message='Timeout'/></testcase>")
set(xml "<testsuite tests='1'>${passed}</testsuite>")
set(extra)
if(CASE STREQUAL "problems" OR CASE STREQUAL "all")
    set(xml "<testsuite tests='6' failures='2' disabled='1' skipped='2'>${passed}${failed}${skipped}${disabled}${missing}${timed}</testsuite>")
    set(expected 1)
    if(CASE STREQUAL "all")
        set(extra --all)
    endif()
elseif(CASE STREQUAL "empty")
    set(xml "<testsuite tests='0'/>")
    set(expected 1)
elseif(CASE STREQUAL "incomplete")
    set(xml "<testsuite tests='1'>${passed}")
    set(expected 2)
elseif(CASE STREQUAL "console")
    set(xml "100% tests passed, 0 tests failed out of 1\n")
    set(expected 2)
elseif(CASE STREQUAL "unknown-argument")
    set(extra --execute)
    set(expected 2)
elseif(CASE STREQUAL "unicode")
    set(report "${WORK}/café report.xml")
elseif(NOT CASE STREQUAL "help" AND NOT CASE STREQUAL "passed" AND NOT CASE STREQUAL "missing")
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()
file(WRITE "${report}" "${xml}")
file(SHA256 "${report}" before)
set(arguments "${report}" ${extra})
if(CASE STREQUAL "help")
    set(arguments --help)
elseif(CASE STREQUAL "missing")
    set(arguments "${WORK}/absent.xml")
    set(expected 2)
endif()
execute_process(COMMAND "${UMICOM_COMMAND}" test-report ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${report}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Inspection changed its input report")
endif()
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected exit ${expected}, got ${result}\n${output}\n${error}")
endif()
if(CASE STREQUAL "help")
    if(NOT output MATCHES "saved XML only")
        message(FATAL_ERROR "Help does not explain saved report inspection")
    endif()
elseif(expected LESS 2)
    if(NOT output MATCHES "did not run tests or verify source revisions")
        message(FATAL_ERROR "Missing saved-evidence boundary")
    endif()
    if(CASE STREQUAL "problems" OR CASE STREQUAL "all")
        foreach(fragment "Tests: 6 | Passed: 1 | Failed: 1 | Timed out: 1"
            "Skipped: 1 | Disabled: 1 | Not run: 1" "[failed] notes.failure"
            "[timed out] notes.timeout" "[not run] notes.missing" "[disabled] notes.disabled"
            "[skipped] notes.skip" "Line\\x0Atwo")
            string(FIND "${output}" "${fragment}" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "Missing output: ${fragment}\n${output}")
            endif()
        endforeach()
        string(FIND "${output}" "[passed] notes.pass" passed_found)
        if(CASE STREQUAL "all" AND passed_found EQUAL -1)
            message(FATAL_ERROR "--all omitted passed record")
        elseif(CASE STREQUAL "problems" AND NOT passed_found EQUAL -1)
            message(FATAL_ERROR "Default listing included passed record")
        endif()
    elseif(CASE STREQUAL "empty" AND NOT output MATCHES "empty report is not an all-passed")
        message(FATAL_ERROR "Empty reports need an explicit explanation")
    endif()
elseif(NOT CASE STREQUAL "unknown-argument")
    if(NOT error MATCHES "Cannot inspect saved CTest report")
        message(FATAL_ERROR "Invalid report did not explain failure: ${error}")
    endif()
endif()
