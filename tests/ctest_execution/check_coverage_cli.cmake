# File: tests/ctest_execution/check_coverage_cli.cmake
# PURPOSE: Verify saved host-coverage CLI boundaries using synthetic evidence.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
# -----------------------------------------------------------------------------
if(NOT DEFINED UMICOM_COMMAND OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Provide UMICOM_COMMAND, WORK and CASE")
endif()
file(MAKE_DIRECTORY "${WORK}/evidence" "${WORK}/elsewhere")
set(report "${WORK}/evidence/report.xml")
set(manifest "${WORK}/evidence/coverage.csv")
set(manifest_header "kind,host,configuration,source_identity,test,capability,report")
set(xml "<testsuite tests='1'><testcase name='notes.pass' status='run' time='0'/></testsuite>")
set(host "host,windows,Debug,source-A,,,report.xml\n")
set(requirement "require,windows,Debug,,notes.pass,GTK display,\n")
set(identity source-A)
set(expected 0)
set(fragment "[passed] windows / Debug : notes.pass")
set(expected_message "")
set(expected_input_status "")
if(CASE STREQUAL "skipped")
    set(xml "<testsuite tests='1'><testcase name='notes.pass' status='notrun' time='0'><skipped message='SKIP_RETURN_CODE=77'/></testcase></testsuite>")
    set(expected 1)
    set(fragment "[skipped]")
elseif(CASE STREQUAL "stale")
    set(identity source-B)
    set(expected 1)
    set(fragment "[source mismatch]")
elseif(CASE STREQUAL "missing-host")
    set(requirement "require,linux,Debug,,notes.pass,GTK display,\n")
    set(expected 1)
    set(fragment "[missing host]")
elseif(CASE STREQUAL "missing-test")
    set(requirement "require,windows,Debug,,absent,GTK display,\n")
    set(expected 1)
    set(fragment "[missing test]")
elseif(CASE STREQUAL "configuration")
    set(requirement "require,windows,Release,,notes.pass,GTK display,\n")
    set(expected 1)
    set(fragment "[missing host]")
elseif(CASE STREQUAL "empty")
    set(host "")
    set(requirement "")
    set(expected 1)
    set(fragment "No requirements: empty coverage cannot pass.")
elseif(CASE STREQUAL "duplicate")
    string(APPEND requirement "${requirement}")
    set(expected 2)
elseif(CASE STREQUAL "parent-path")
    set(host "host,windows,Debug,source-A,,,../report.xml\n")
    set(expected 2)
elseif(CASE STREQUAL "malformed")
    set(xml "<testsuite>")
    set(expected 2)
elseif(CASE STREQUAL "missing-report")
    set(host "host,windows,Debug,source-A,,,absent.xml\n")
    set(expected 2)
elseif(CASE STREQUAL "two-hosts")
    file(WRITE "${WORK}/evidence/other.xml" "${xml}")
    string(APPEND host "host,linux,Debug,source-A,,,other.xml\n")
    string(APPEND requirement "require,linux,Debug,,notes.pass,GTK display,\n")
    set(fragment "Requirements: 2 | Passed: 2 | Outstanding: 0")
elseif(CASE STREQUAL "unicode")
    set(manifest "${WORK}/evidence/café plan.csv")
elseif(CASE STREQUAL "not-run")
    set(xml "<testsuite tests='1'><testcase name='notes.pass' status='notrun' time='0'><skipped message='Unable to find executable'/></testcase></testsuite>")
    set(expected 1)
    set(fragment "[not run]")
    set(expected_message "Saved result message: Unable to find executable")
elseif(CASE STREQUAL "disabled")
    set(xml "<testsuite tests='1'><testcase name='notes.pass' status='disabled' time='0'/></testsuite>")
    set(expected 1)
    set(fragment "[disabled]")
    set(expected_message "Saved result message: Test is disabled.")
elseif(CASE STREQUAL "message-controls")
    set(xml "<testsuite tests='1'><testcase name='notes.pass' status='fail' time='0'><failure message='Line one&#10;[passed] forged&#9;detail'/></testcase></testsuite>")
    set(expected 1)
    set(fragment "[failed]")
    set(expected_message [=[Saved result message: Line one\x0A[passed] forged\x09detail]=])
elseif(CASE STREQUAL "paging")
    foreach(index RANGE 1 64)
        string(APPEND requirement "require,windows,Debug,,missing.${index},GTK display,\n")
    endforeach()
    set(expected 1)
    set(fragment "[missing test] windows / Debug : missing.64")
elseif(CASE MATCHES "^digest-")
    # Match the original bytes before applying any test change. A newline
    # leaves valid report semantics while giving it a different exact hash.
    string(SHA256 digest "${xml}")
    string(APPEND manifest_header ",report_sha256")
    set(host "host,windows,Debug,source-A,,,report.xml,${digest}\n")
    set(requirement "require,windows,Debug,,notes.pass,GTK display,,\n")
    if(CASE STREQUAL "digest-changed")
        string(APPEND xml "\n")
        set(expected 2)
        set(expected_input_status 2)
    elseif(CASE STREQUAL "digest-second-report" OR CASE STREQUAL "digest-two-hosts")
        # Write an independently hashed second report and qualify both its
        # admitted and refused forms without changing the first report.
        set(other "${xml}\n")
        file(WRITE "${WORK}/evidence/other.xml" "${other}")
        set(other_digest "${digest}")
        if(CASE STREQUAL "digest-two-hosts")
            # Hash the saved file, including the platform's actual line ending.
            file(SHA256 "${WORK}/evidence/other.xml" other_digest)
            set(fragment "Requirements: 2 | Passed: 2 | Outstanding: 0")
        else()
            set(expected 2)
            set(expected_input_status 2)
        endif()
        string(APPEND host "host,linux,Debug,source-A,,,other.xml,${other_digest}\n")
        string(APPEND requirement "require,linux,Debug,,notes.pass,GTK display,,\n")
    elseif(CASE STREQUAL "digest-missing" OR CASE STREQUAL "digest-malformed"
            OR CASE STREQUAL "digest-width" OR CASE STREQUAL "digest-requirement")
        # The extended format binds every host. Reject an absent or malformed
        # digest, a shorter row and a digest placed on a requirement.
        if(CASE STREQUAL "digest-missing")
            set(host "host,windows,Debug,source-A,,,report.xml,\n")
        elseif(CASE STREQUAL "digest-malformed")
            set(host "host,windows,Debug,source-A,,,report.xml,not-a-digest\n")
        elseif(CASE STREQUAL "digest-width")
            set(host "host,windows,Debug,source-A,,,report.xml\n")
        else()
            set(requirement "require,windows,Debug,,notes.pass,GTK display,,${digest}\n")
        endif()
        set(expected 2)
        set(expected_input_status 9)
    elseif(NOT CASE STREQUAL "digest-match")
        message(FATAL_ERROR "Unknown digest fixture: ${CASE}")
    endif()
elseif(NOT CASE STREQUAL "passed" AND NOT CASE STREQUAL "relative-manifest")
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()
file(WRITE "${report}" "${xml}")
# Retain the fixed header for review. The shared fixture now writes the exact
# header selected for the requested unbound or digest-bound plan.
if(FALSE)
    file(WRITE "${manifest}" "kind,host,configuration,source_identity,test,capability,report\n${host}${requirement}")
endif()
file(WRITE "${manifest}" "${manifest_header}\n${host}${requirement}")
file(SHA256 "${report}" before_report)
file(SHA256 "${manifest}" before_manifest)
set(argument "${manifest}")
if(CASE STREQUAL "relative-manifest")
    set(argument "../evidence/coverage.csv")
endif()
# A different process directory ensures report paths are anchored to the plan,
# not whichever folder the terminal or Studio currently uses.
execute_process(COMMAND "${UMICOM_COMMAND}" test-report --coverage "${identity}" "${argument}"
    WORKING_DIRECTORY "${WORK}/elsewhere" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${report}" after_report)
file(SHA256 "${manifest}" after_manifest)
if(NOT before_report STREQUAL after_report OR NOT before_manifest STREQUAL after_manifest)
    message(FATAL_ERROR "Coverage inspection changed its evidence")
endif()
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, got ${result}\n${output}\n${error}")
endif()
if(expected LESS 2)
    foreach(text "${fragment}" "did not run tests or verify source revisions" "Unlisted tests and hosts are outside this gate")
        string(FIND "${output}" "${text}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing output: ${text}\n${output}")
        endif()
    endforeach()
elseif(NOT error MATCHES "Cannot review saved host coverage")
    message(FATAL_ERROR "Input refusal needs an explanation: ${error}")
endif()

# An input refusal must occur before a partial row or a passing summary can
# appear, even when the first declared report was correct.
if(NOT expected_input_status STREQUAL "")
    if(NOT error MATCHES "status ${expected_input_status}[)]" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Digest refusal published an unexpected result: ${output}\n${error}")
    endif()
endif()

# Messages remain saved evidence; control bytes cannot add forged rows.
if(CASE STREQUAL "skipped")
    set(expected_message "Saved result message: SKIP_RETURN_CODE=77")
endif()
if(NOT expected_message STREQUAL "")
    string(FIND "${output}" "${expected_message}" found_message)
    if(found_message EQUAL -1)
        message(FATAL_ERROR "Coverage CLI omitted its saved result message: ${output}")
    endif()
endif()
if(CASE STREQUAL "message-controls")
    string(FIND "${output}" "\n[passed] forged" forged_line)
    if(NOT forged_line EQUAL -1)
        message(FATAL_ERROR "Coverage message created a forged result line")
    endif()
endif()
if(CASE STREQUAL "paging")
    foreach(page "Showing 1..64 of 65" "Showing 65..65 of 65")
        string(FIND "${output}" "${page}" found_page)
        if(found_page EQUAL -1)
            message(FATAL_ERROR "Coverage CLI omitted a bounded page: ${page}")
        endif()
    endforeach()
endif()
