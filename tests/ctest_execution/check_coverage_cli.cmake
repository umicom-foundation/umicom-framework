# Umicom Framework
# File: tests/ctest_execution/check_coverage_cli.cmake
# PURPOSE: Verify saved host-coverage CLI boundaries using synthetic evidence.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
# -----------------------------------------------------------------------------
if(NOT DEFINED UMICOM_COMMAND OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "Provide UMICOM_COMMAND, WORK and CASE")
endif()
file(MAKE_DIRECTORY "${WORK}/evidence" "${WORK}/elsewhere")
set(report "${WORK}/evidence/report.xml")
set(manifest "${WORK}/evidence/coverage.csv")
set(xml "<testsuite tests='1'><testcase name='notes.pass' status='run' time='0'/></testsuite>")
set(host "host,windows,Debug,source-A,,,report.xml\n")
set(requirement "require,windows,Debug,,notes.pass,GTK display,\n")
set(identity source-A)
set(expected 0)
set(fragment "[passed] windows / Debug : notes.pass")
if(CASE STREQUAL "skipped")
    set(xml "<testsuite tests='1'><testcase name='notes.pass' status='notrun' time='0'><skipped message='SKIP_RETURN_CODE=77'/></testcase></testsuite>")
    set(expected 1)
    set(fragment "[skipped]")
elseif(CASE STREQUAL "stale")
    set(identity source-B)
    set(expected 1)
    set(fragment "[source mismatch]")
elseif(CASE STREQUAL "missing-host")
    set(requirement "require,linux,Debug,,notes.pass,GTK display,\n")
    set(expected 1)
    set(fragment "[missing host]")
elseif(CASE STREQUAL "missing-test")
    set(requirement "require,windows,Debug,,absent,GTK display,\n")
    set(expected 1)
    set(fragment "[missing test]")
elseif(CASE STREQUAL "configuration")
    set(requirement "require,windows,Release,,notes.pass,GTK display,\n")
    set(expected 1)
    set(fragment "[missing host]")
elseif(CASE STREQUAL "empty")
    set(host "")
    set(requirement "")
    set(expected 1)
    set(fragment "No requirements: empty coverage cannot pass.")
elseif(CASE STREQUAL "duplicate")
    string(APPEND requirement "${requirement}")
    set(expected 2)
elseif(CASE STREQUAL "parent-path")
    set(host "host,windows,Debug,source-A,,,../report.xml\n")
    set(expected 2)
elseif(CASE STREQUAL "malformed")
    set(xml "<testsuite>")
    set(expected 2)
elseif(CASE STREQUAL "missing-report")
    set(host "host,windows,Debug,source-A,,,absent.xml\n")
    set(expected 2)
elseif(CASE STREQUAL "two-hosts")
    file(WRITE "${WORK}/evidence/other.xml" "${xml}")
    string(APPEND host "host,linux,Debug,source-A,,,other.xml\n")
    string(APPEND requirement "require,linux,Debug,,notes.pass,GTK display,\n")
    set(fragment "Requirements: 2 | Passed: 2 | Outstanding: 0")
elseif(CASE STREQUAL "unicode")
    set(manifest "${WORK}/evidence/café plan.csv")
elseif(NOT CASE STREQUAL "passed" AND NOT CASE STREQUAL "relative-manifest")
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()
file(WRITE "${report}" "${xml}")
file(WRITE "${manifest}" "kind,host,configuration,source_identity,test,capability,report\n${host}${requirement}")
file(SHA256 "${report}" before_report)
file(SHA256 "${manifest}" before_manifest)
set(argument "${manifest}")
if(CASE STREQUAL "relative-manifest")
    set(argument "../evidence/coverage.csv")
endif()
# A different process directory ensures report paths are anchored to the plan,
# not whichever folder the terminal or Studio currently uses.
execute_process(COMMAND "${UMICOM_COMMAND}" test-report --coverage "${identity}" "${argument}"
    WORKING_DIRECTORY "${WORK}/elsewhere" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${report}" after_report)
file(SHA256 "${manifest}" after_manifest)
if(NOT before_report STREQUAL after_report OR NOT before_manifest STREQUAL after_manifest)
    message(FATAL_ERROR "Coverage inspection changed its evidence")
endif()
if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, got ${result}\n${output}\n${error}")
endif()
if(expected LESS 2)
    foreach(text "${fragment}" "did not run tests or verify source revisions" "Unlisted tests and hosts are outside this gate")
        string(FIND "${output}" "${text}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing output: ${text}\n${output}")
        endif()
    endforeach()
elseif(NOT error MATCHES "Cannot review saved host coverage")
    message(FATAL_ERROR "Input refusal needs an explanation: ${error}")
endif()
