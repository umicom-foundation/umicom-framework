{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umicom.org/context/trade.schema.json",
  "title": "Umicom trade context",
  "type": "object",
  "required": [
    "trade_id"
  ],
  "properties": {
    "trade_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "counterparty_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
