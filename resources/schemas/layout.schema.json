{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umicom.org/layout.schema.json",
  "title": "Portable Umicom Semantic Layout",
  "type": "object",
  "required": ["schema", "layout"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "umicom.layout/1" },
    "layout": {
      "type": "object",
      "required": ["id", "name", "category", "root"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "locked": { "type": "boolean" },
        "root": { "$ref": "#/$defs/node" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "empty",
            "window",
            "split",
            "tab-group",
            "panel",
            "editor-group",
            "floating-window"
          ]
        },
        "orientation": { "enum": ["horizontal", "vertical"] },
        "ratio": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "component_id": { "type": "string" },
        "owner_application_id": { "type": "string" },
        "context_group_id": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
