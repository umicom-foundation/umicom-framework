{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umicom.org/workbench-layout-sync.schema.json",
  "title": "Umicom Workbench Layout Synchronisation Plan",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "local_replica_id",
    "remote_replica_id",
    "direction",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "umicom.workbench-layout-sync/1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "local_replica_id": {
      "type": "string",
      "minLength": 1
    },
    "remote_replica_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "pull",
        "push",
        "bidirectional"
      ]
    },
    "from_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "to_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "layout_id",
          "action",
          "sequence",
          "reason"
        ],
        "properties": {
          "layout_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "no-action",
              "create-local",
              "update-local",
              "delete-local",
              "create-remote",
              "update-remote",
              "delete-remote",
              "record-conflict"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "local_revision": {
            "type": "integer",
            "minimum": 0
          },
          "remote_revision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
