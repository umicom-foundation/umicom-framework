{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Umicom Live Workbench Context Source",
  "type": "object",
  "required": [
    "sourceId",
    "applicationId",
    "panelId",
    "sourceKind",
    "trigger",
    "contextKind"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 159
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 159
    },
    "panelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 159
    },
    "displayName": {
      "type": "string",
      "maxLength": 511
    },
    "preferredGroupId": {
      "type": "string",
      "maxLength": 159
    },
    "sourceKind": {
      "enum": [
        "generic",
        "editor",
        "project-explorer",
        "problems",
        "source-control",
        "test-explorer",
        "debugger",
        "terminal",
        "ai",
        "application-launcher",
        "watchlist",
        "account-selector",
        "trade-blotter",
        "chart",
        "risk",
        "media"
      ]
    },
    "trigger": {
      "enum": [
        "activate",
        "select",
        "caret",
        "range",
        "change",
        "focus",
        "open",
        "navigate"
      ]
    },
    "contextKind": {
      "enum": [
        "generic",
        "source-location",
        "instrument",
        "account",
        "trade",
        "project",
        "workspace",
        "media",
        "selection"
      ]
    },
    "coalescingWindowMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "minimumIntervalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
