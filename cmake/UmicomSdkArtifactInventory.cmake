# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Generate a bounded, data-only inventory from registered SDK target ownership.
# The native inspector reads this file without evaluating installed CMake code.
include_guard(GLOBAL)
# Capture Framework-owned directories before a parent executes its final callback.
set_property(GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_LIBDIR "${CMAKE_INSTALL_LIBDIR}")
set_property(GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_BINDIR "${CMAKE_INSTALL_BINDIR}")
set_property(GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_BUILD "${CMAKE_CURRENT_BINARY_DIR}")
function(umicom_generate_sdk_artifact_inventory)
    get_property(_done GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_INVENTORY_GENERATED)
    if(_done)
        return()
    endif()
    get_property(_targets GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_TARGETS)
    if(NOT _targets)
        return()
    endif()
    get_property(_libdir GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_LIBDIR)
    get_property(_bindir GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_BINDIR)
    get_property(_build GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_BUILD)
    # Absolute/custom layouts remain supported, but cannot claim a relocatable
    # receipt. Match the native parser's portable relative-directory grammar.
    foreach(_directory "${_libdir}" "${_bindir}")
        if(IS_ABSOLUTE "${_directory}" OR _directory STREQUAL "" OR
           NOT _directory MATCHES "^[A-Za-z0-9_+./ -]+$" OR
           _directory MATCHES "(^|/)(\\.\\.?|[^/]*[ .]| [^/]*)(/|$)" OR
           _directory MATCHES "//" OR _directory MATCHES "/$")
            message(STATUS "SDK artifact inventory unavailable for this non-relative installation layout")
            return()
        endif()
    endforeach()
    set_property(GLOBAL PROPERTY UMICOM_SDK_ARTIFACT_INVENTORY_GENERATED TRUE)
    list(REMOVE_DUPLICATES _targets)
    list(SORT _targets)
    set(_records "")
    set(_record_count 0)
    foreach(_target IN LISTS _targets)
        if(NOT _target MATCHES "^[A-Za-z0-9_.+-]+$")
            message(FATAL_ERROR "SDK inventory target has an unsupported name: ${_target}")
        endif()
        math(EXPR _record_count "${_record_count} + 1")
        get_target_property(_type "${_target}" TYPE)
        if(_type STREQUAL "INTERFACE_LIBRARY")
            string(APPEND _records "${_target}|interface|-\n")
        elseif(_type STREQUAL "EXECUTABLE")
            string(APPEND _records "${_target}|tool|${_bindir}/$<TARGET_FILE_NAME:${_target}>\n")
        elseif(_type STREQUAL "STATIC_LIBRARY")
            string(APPEND _records "${_target}|archive|${_libdir}/$<TARGET_FILE_NAME:${_target}>\n")
        elseif(_type STREQUAL "SHARED_LIBRARY" AND WIN32)
            math(EXPR _record_count "${_record_count} + 1")
            string(APPEND _records "${_target}|shared|${_bindir}/$<TARGET_FILE_NAME:${_target}>\n")
            string(APPEND _records "${_target}|import|${_libdir}/$<TARGET_LINKER_FILE_NAME:${_target}>\n")
        elseif(_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
            string(APPEND _records "${_target}|shared|${_libdir}/$<TARGET_FILE_NAME:${_target}>\n")
        else()
            message(FATAL_ERROR "SDK inventory cannot describe target: ${_target}")
        endif()
    endforeach()
    if(_record_count GREATER 4096)
        message(FATAL_ERROR "SDK artifact inventory exceeds the native reader record limit")
    endif()
    set(_records "schema=umicom.sdk.artifacts/1\nconfiguration=$<CONFIG>\nentries=${_record_count}\n${_records}")
    # A prefix holds one selected configuration. Independent prefixes preserve
    # evidence when qualifying another configuration or an optional adapter set.
    set(_file "${_build}/sdk-artifacts/$<CONFIG>/sdk-artifacts.txt")
    file(GENERATE OUTPUT "${_file}" CONTENT "${_records}")
    install(FILES "${_file}" DESTINATION share/umicom/framework COMPONENT Framework)
    install(FILES "${_file}" DESTINATION share/umicom/framework
        COMPONENT FrameworkSDK EXCLUDE_FROM_ALL)
endfunction()
