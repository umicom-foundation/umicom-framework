# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Receipt presentation uses the shared data validator and GTK host only.
if(NOT TARGET Umicom::data OR NOT TARGET Umicom::ui_gtk4)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_receipt_view_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_record_transfer_receipt_gtk4 STATIC "${_receipt_view_root}/adapters/gtk4/record_transfer_receipt_gtk4.c")
add_library(Umicom::record_transfer_receipt_gtk4 ALIAS umicom_record_transfer_receipt_gtk4)
set_target_properties(umicom_record_transfer_receipt_gtk4 PROPERTIES EXPORT_NAME record_transfer_receipt_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_record_transfer_receipt_gtk4 PUBLIC Umicom::data Umicom::ui_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_record_transfer_receipt_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_record_transfer_receipt_gtk4)
endif()
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_record_transfer_receipt_gtk4 FILES
        "${_receipt_view_root}/adapters/gtk4/record_time_internal.h")
endif()
install(TARGETS umicom_record_transfer_receipt_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_record_transfer_receipt_gtk4)
install(FILES "${_receipt_view_root}/include/umicom/ui/gtk4/record_transfer_receipt.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_record_transfer_receipt_gtk4 include/umicom/ui/gtk4/record_transfer_receipt.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-record-transfer-receipt-gtk-test "${_receipt_view_root}/tests/data_history/test_record_transfer_receipt_gtk4.c")
    target_link_libraries(umicom-record-transfer-receipt-gtk-test PRIVATE Umicom::record_transfer_receipt_gtk4)
    set_target_properties(umicom-record-transfer-receipt-gtk-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-record-transfer-receipt-gtk-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-record-transfer-receipt-gtk-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-record-transfer-receipt-gtk-test)
    endif()
    foreach(_receipt_view_case IN ITEMS fields owned readonly markup utf8 clock unknown null output wrong-widget changed-copy unicode)
        add_test(NAME framework.data.transfer.receipt.gtk.${_receipt_view_case} COMMAND umicom-record-transfer-receipt-gtk-test ${_receipt_view_case})
        set_tests_properties(framework.data.transfer.receipt.gtk.${_receipt_view_case} PROPERTIES TIMEOUT 30
            SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;data;record-transfer;gtk4;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.transfer.receipt.gtk.${_receipt_view_case} TARGETS umicom-record-transfer-receipt-gtk-test)
        endif()
    endforeach()
endif()
unset(_receipt_view_root)
unset(_receipt_view_case)