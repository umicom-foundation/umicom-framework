# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Typed conflict adoption joins copied form decisions and atomic record drafts.
if(NOT TARGET umicom_form_records)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_conflict_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_form_records PRIVATE "${_form_conflict_root}/src/data/structured_form_conflict.c"
    "${_form_conflict_root}/src/data/structured_form_session_internal.h")
install(FILES "${_form_conflict_root}/include/umicom/data/structured_form_conflict.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_conflict.h)
endif()
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_form_records FILES
        "${_form_conflict_root}/src/data/structured_form_session_internal.h")
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-record-example "${_form_conflict_root}/examples/form_records/main.c")
    target_link_libraries(umicom-form-record-example PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-record-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-record-example)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-record-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-record-example)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-record-example FILES
            "${_form_conflict_root}/examples/form_records/schema.h")
    endif()
    add_test(NAME framework.structured_forms.record.example COMMAND umicom-form-record-example)
    set_tests_properties(framework.structured_forms.record.example PROPERTIES TIMEOUT 30
        LABELS "framework;forms;data;example;regression")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.structured_forms.record.example TARGETS umicom-form-record-example)
    endif()
    add_executable(umicom-form-conflict-test "${_form_conflict_root}/tests/data_history/test_structured_form_conflict.c")
    target_link_libraries(umicom-form-conflict-test PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-conflict-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-conflict-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-conflict-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-conflict-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-conflict-test FILES
            "${_form_conflict_root}/tests/application_experience/structured_form_fixture.h"
            "${_form_conflict_root}/src/data/structured_form_session_internal.h")
    endif()
    foreach(_form_conflict_case IN ITEMS local incoming base custom disjoint unresolved late-local generation review-revision
            other-session new-collision wrong-entity corrupt same-revision pending request-lifetime stale-after-review required preview recovery)
        add_test(NAME framework.structured_forms.conflict.${_form_conflict_case} COMMAND umicom-form-conflict-test ${_form_conflict_case})
        set_tests_properties(framework.structured_forms.conflict.${_form_conflict_case} PROPERTIES TIMEOUT 30
            LABELS "framework;forms;data;conflict-review;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.conflict.${_form_conflict_case} TARGETS umicom-form-conflict-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME framework.structured_forms.conflict.sqlite.${_form_conflict_case}
                COMMAND umicom-form-conflict-test ${_form_conflict_case} sqlite)
            set_tests_properties(framework.structured_forms.conflict.sqlite.${_form_conflict_case} PROPERTIES TIMEOUT 30
                LABELS "framework;forms;data;sqlite;conflict-review;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.conflict.sqlite.${_form_conflict_case} TARGETS umicom-form-conflict-test)
            endif()
        endif()
    endforeach()
endif()
unset(_form_conflict_root)
unset(_form_conflict_case)

foreach(_form_conflict_doc_component IN ITEMS Framework FrameworkSDK)
    set(_form_conflict_doc_exclude "")
    if(_form_conflict_doc_component STREQUAL "FrameworkSDK")
        set(_form_conflict_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${CMAKE_CURRENT_LIST_DIR}/../docs/guides/form-conflict-review.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_conflict_doc_component} ${_form_conflict_doc_exclude})
endforeach()
unset(_form_conflict_doc_component)
unset(_form_conflict_doc_exclude)
