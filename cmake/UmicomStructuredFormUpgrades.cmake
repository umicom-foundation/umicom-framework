# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Reviewed upgrades reuse the form-record target and its checked append contract.
if(NOT TARGET umicom_form_records)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_upgrade_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_form_records PRIVATE "${_form_upgrade_root}/src/data/structured_form_upgrade.c")
install(FILES "${_form_upgrade_root}/include/umicom/data/structured_form_upgrade.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_upgrade.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-upgrade-test "${_form_upgrade_root}/tests/data_history/test_structured_form_upgrade.c")
    target_link_libraries(umicom-form-upgrade-test PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-upgrade-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-upgrade-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-upgrade-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-upgrade-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-upgrade-test FILES
            "${_form_upgrade_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_upgrade_case IN ITEMS compatible add-default removed-unanswered removed-known unit wrong-version wrong-schema corrupt
            source-copy edit invalid-edit stale-review required pending wrong-reply failed-retry wrong-store changed-request stale-store history noop new-source)
        add_test(NAME framework.structured_forms.upgrade.${_form_upgrade_case}
            COMMAND umicom-form-upgrade-test ${_form_upgrade_case})
        set_tests_properties(framework.structured_forms.upgrade.${_form_upgrade_case} PROPERTIES TIMEOUT 30
            LABELS "framework;forms;data;schema-upgrade;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.upgrade.${_form_upgrade_case} TARGETS umicom-form-upgrade-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME framework.structured_forms.upgrade.sqlite.${_form_upgrade_case}
                COMMAND umicom-form-upgrade-test ${_form_upgrade_case} sqlite)
            set_tests_properties(framework.structured_forms.upgrade.sqlite.${_form_upgrade_case} PROPERTIES TIMEOUT 30
                LABELS "framework;forms;data;sqlite;schema-upgrade;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.upgrade.sqlite.${_form_upgrade_case} TARGETS umicom-form-upgrade-test)
            endif()
        endif()
    endforeach()
endif()
foreach(_form_upgrade_doc_component IN ITEMS Framework FrameworkSDK)
    set(_form_upgrade_doc_exclude "")
    if(_form_upgrade_doc_component STREQUAL "FrameworkSDK")
        set(_form_upgrade_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_upgrade_root}/docs/guides/form-record-upgrades.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_upgrade_doc_component} ${_form_upgrade_doc_exclude})
endforeach()
unset(_form_upgrade_root)
unset(_form_upgrade_case)
unset(_form_upgrade_doc_component)
unset(_form_upgrade_doc_exclude)
