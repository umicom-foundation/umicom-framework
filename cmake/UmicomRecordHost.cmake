# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# One owned service coordinates storage and security for background application work.
if(NOT TARGET Umicom::authorized_form_records)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_record_host_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_record_host STATIC "${_record_host_root}/src/data/record_host.c")
add_library(Umicom::record_host ALIAS umicom_record_host)
target_link_libraries(umicom_record_host PUBLIC Umicom::authorized_form_records)
set_target_properties(umicom_record_host PROPERTIES EXPORT_NAME record_host
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_record_host)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_record_host)
endif()
install(TARGETS umicom_record_host EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_record_host)
install(FILES "${_record_host_root}/include/umicom/data/record_host.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_record_host include/umicom/data/record_host.h)
endif()
foreach(_record_host_component IN ITEMS Framework FrameworkSDK)
    set(_record_host_exclude "")
    if(_record_host_component STREQUAL "FrameworkSDK")
        set(_record_host_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_record_host_root}/docs/guides/record-host.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_record_host_component} ${_record_host_exclude})
endforeach()

# Current-time methods are part of the owned-host SDK. They refresh time under
# admission ownership instead of retaining a worker's queued timestamp.
install(FILES "${_record_host_root}/include/umicom/data/record_host_clock.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_record_host include/umicom/data/record_host_clock.h)
endif()
foreach(_record_host_clock_component IN ITEMS Framework FrameworkSDK)
    set(_record_host_clock_exclude "")
    if(_record_host_clock_component STREQUAL "FrameworkSDK")
        set(_record_host_clock_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_record_host_root}/docs/guides/record-host-clocks.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_record_host_clock_component} ${_record_host_clock_exclude})
endforeach()
unset(_record_host_clock_component)
unset(_record_host_clock_exclude)

if(BUILD_TESTING)
    find_package(Threads REQUIRED)
    set(_record_host_lifecycle_cases initial retain retire retired-register retired-enable retired-revoke
        disabled-issuance missing-identity zero-clock expiry-overflow factory-invalid factory-scope null)
    set(_record_host_policy_cases replace clear deny partial-failure invalid-effect long-principal
        too-many null-rules retired last-match null-output)
    set(_record_host_documents_cases latest history reviewed stale-reviewed disabled revoked retired
        policy-changed wrong-purpose stale-amend null)
    set(_record_host_forms_cases latest history reviewed schema-mismatch retired disabled amend retired-save)
    set(_record_host_concurrency_cases competing-create competing-amend retire-race policy-race retained-workers)
    set(_record_host_clock_cases issue issue-zero issue-overflow issue-disabled issue-missing issue-retired
        latest-time unchanged-request append-time history-time reviewed-time form-save-time form-load-time
        form-reviewed-time stale-request-time expired-current rollback zero-current retired-no-clock
        clock-copy policy-denied null-request null-clock default-system)
    set(_record_host_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _record_host_backends sqlite)
    endif()
    foreach(_record_host_group IN ITEMS lifecycle policy documents forms concurrency clock)
        set(_record_host_target "umicom-record-host-${_record_host_group}-test")
        add_executable(${_record_host_target} "${_record_host_root}/tests/data_history/test_record_host_${_record_host_group}.c")
        target_link_libraries(${_record_host_target} PRIVATE Umicom::record_host)
        if(_record_host_group STREQUAL "concurrency")
            target_link_libraries(${_record_host_target} PRIVATE Threads::Threads)
        endif()
        set_target_properties(${_record_host_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_record_host_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_record_host_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_record_host_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_record_host_target} FILES
                "${_record_host_root}/tests/data_history/record_host_fixture.h")
            if(_record_host_group STREQUAL "forms" OR _record_host_group STREQUAL "clock")
                umicom_target_qualification_inputs(${_record_host_target} FILES
                    "${_record_host_root}/tests/application_experience/structured_form_fixture.h")
            endif()
        endif()
        foreach(_record_host_backend IN LISTS _record_host_backends)
            foreach(_record_host_case IN LISTS _record_host_${_record_host_group}_cases)
                set(_record_host_test "framework.record_host.${_record_host_group}.${_record_host_backend}.${_record_host_case}")
                add_test(NAME ${_record_host_test} COMMAND ${_record_host_target}
                    ${_record_host_backend} ${_record_host_case})
                set_tests_properties(${_record_host_test} PROPERTIES TIMEOUT 30
                    LABELS "framework;security;data;record-host;${_record_host_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_record_host_test} TARGETS ${_record_host_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
unset(_record_host_root)
unset(_record_host_component)
unset(_record_host_exclude)
unset(_record_host_lifecycle_cases)
unset(_record_host_policy_cases)
unset(_record_host_documents_cases)
unset(_record_host_forms_cases)
unset(_record_host_concurrency_cases)
unset(_record_host_clock_cases)
unset(_record_host_backends)
unset(_record_host_group)
unset(_record_host_target)
unset(_record_host_backend)
unset(_record_host_case)
unset(_record_host_test)
