# Umicom Framework
# File: cmake/UmicomLanguageComments.cmake
# PURPOSE: Export language-aware commenting and register headless and native editing checks.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor OR NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_comment_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_comment_pair IN ITEMS "editor/comment_style.h|umicom_editor" "document/language_comment.h|umicom_document")
    string(REPLACE "|" ";" _comment_parts "${_comment_pair}")
    list(GET _comment_parts 0 _comment_header)
    list(GET _comment_parts 1 _comment_owner)
    get_filename_component(_comment_directory "${_comment_header}" DIRECTORY)
    install(FILES "${_comment_root}/include/umicom/${_comment_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_comment_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_comment_owner} "include/umicom/${_comment_header}")
    endif()
endforeach()
install(FILES "${_comment_root}/docs/guides/language-comments.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_comment_profiles_cases catalogue lookup unknown arguments bounded literal unsupported)
    set(_comment_detection_cases cmake makefile gnumakefile shell-dot nested-unix nested-windows upper-python uppercase-c uppercase-asm rust go csharp java kotlin swift jsonc ruby perl r lua toml ini old-json unknown directory-dot empty trailing-dot bounded arguments)
    set(_comment_document_cases c python sql ini readonly unknown selection mixed uncomment blank crlf pending undo-redo inactive foreign-view closed arguments registry registry-argument)
    set(_comment_native_cases c python sql unknown readonly selected inactive-view completion-retire legacy unbound)
    foreach(_comment_group IN ITEMS profiles detection document native)
        set(_comment_owner document)
        set(_comment_source "tests/document/test_language_comment.c")
        if(_comment_group STREQUAL "profiles")
            set(_comment_owner editor)
            set(_comment_source "tests/editor/test_comment_style.c")
        elseif(_comment_group STREQUAL "detection")
            set(_comment_source "tests/document/test_language_detection_names.c")
        elseif(_comment_group STREQUAL "native")
            set(_comment_owner ui_gtk4)
            set(_comment_source "tests/document/test_language_comment_gtk4.c")
        endif()
        if(NOT TARGET umicom_${_comment_owner})
            continue()
        endif()
        set(_comment_target "umicom-language-comments-${_comment_group}-test")
        add_executable(${_comment_target} "${_comment_root}/${_comment_source}")
        target_link_libraries(${_comment_target} PRIVATE Umicom::${_comment_owner})
        set_target_properties(${_comment_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_comment_target})
        umicom_apply_sanitizers(${_comment_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_comment_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_comment_target} FILES
                "${_comment_root}/src/document/language_comment.inc"
                "${_comment_root}/adapters/gtk4/document_line_edit.inc"
                "${_comment_root}/tests/document/replacement_fixture.h"
                "${_comment_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_comment_case IN LISTS _comment_${_comment_group}_cases)
            set(_comment_test "framework.editor.language_comments.${_comment_group}.${_comment_case}")
            add_test(NAME ${_comment_test} COMMAND ${_comment_target} ${_comment_case})
            set_tests_properties(${_comment_test} PROPERTIES TIMEOUT 60 LABELS "framework;editor;document;language-comments;regression")
            if(_comment_group STREQUAL "native")
                set_tests_properties(${_comment_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;language-comments;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_comment_test} TARGETS ${_comment_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_comment_variable IN ITEMS root pair parts header owner directory group source target case test profiles_cases detection_cases document_cases native_cases)
    unset(_comment_${_comment_variable})
endforeach()
unset(_comment_variable)
