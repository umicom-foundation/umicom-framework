include_guard(GLOBAL)
if(BUILD_TESTING)
    add_executable(umicom-native-folding-ranges-test "${CMAKE_CURRENT_LIST_DIR}/../tests/language_runtime/test_native_folding_ranges.c")
    target_link_libraries(umicom-native-folding-ranges-test PRIVATE Umicom::developer Umicom::editor Umicom::platform)
    umicom_apply_warnings(umicom-native-folding-ranges-test)
    umicom_apply_sanitizers(umicom-native-folding-ranges-test)
    if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_link_options(umicom-native-folding-ranges-test PRIVATE -municode)
    endif()
    add_dependencies(umicom-native-folding-ranges-test umicom-language-process-fixture)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-native-folding-ranges-test)
    endif()
    foreach(case valid empty empty-array single unicode crlf outside invalid error shutdown encoding)
        add_test(NAME framework.language_runtime.native_folding_ranges.${case} COMMAND umicom-native-folding-ranges-test ${case} "$<TARGET_FILE:umicom-language-process-fixture>")
        set_tests_properties(framework.language_runtime.native_folding_ranges.${case} PROPERTIES TIMEOUT 40
            LABELS "framework;language;rename;native;ownership;regression")
    endforeach()
endif()
