# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Pure matching belongs to application; verified persisted search is an adapter.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_search_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE "${_form_search_root}/src/application/experience/structured_form_filter.c")
install(FILES "${_form_search_root}/include/umicom/application/experience/structured_form_filter.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_filter.h)
endif()
# Native and web clients parse operands through the same locale-independent boundary.
target_sources(umicom_application PRIVATE "${_form_search_root}/src/application/experience/structured_form_filter_text.c")
install(FILES "${_form_search_root}/include/umicom/application/experience/structured_form_filter_text.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_filter_text.h)
endif()
if(TARGET umicom_form_records)
    target_sources(umicom_form_records PRIVATE "${_form_search_root}/src/data/structured_form_query.c")
    install(FILES "${_form_search_root}/include/umicom/data/structured_form_query.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_query.h)
    endif()
endif()
foreach(_form_search_component IN ITEMS Framework FrameworkSDK)
    set(_form_search_exclude "")
    if(_form_search_component STREQUAL "FrameworkSDK")
        set(_form_search_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_search_root}/docs/guides/typed-record-search.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_search_component} ${_form_search_exclude})
endforeach()
if(BUILD_TESTING)
    set(_form_search_filter_cases empty equal unequal less less-equal greater greater-equal outside-range contains contains-case empty-needle boolean integer-min integer-max unanswered unknown not-applicable missing-value all-terms later-invalid field unit type nan infinite state-value state-unit state-reason count operator unterminated-field unterminated-text unterminated-unit date-contains choice-contains ordered-text invalid-form identity null digest-stable digest-inactive digest-value digest-version digest-order)
    set(_form_search_query_cases all filter pages empty metadata metadata-none state version foreign-form unknown-schema unregistered-query payload metadata-only excluded-damage stale changed-filter changed-metadata cursor nested empty-prefix limit-zero limit-large bad-snapshot cursor-without-snapshot invalid-filter null reviewed-open reopen-stale)
    set(_form_search_text_cases decimal integer-min integer-max integer-overflow boolean boolean-case text contains outside-threshold outside-equal state state-value missing-value unit comma nan trailing empty-number field field-termination value-termination date date-invalid alias-parse alias-format format-unit null)
    foreach(_form_search_group IN ITEMS filter query text)
        # Qualify executable names by their owning service so independent test modules
        # can coexist. The former short name is retained for engineering review.
        if(FALSE)
            set(_form_search_target umicom-form-${_form_search_group}-test)
        endif()
        set(_form_search_target umicom-structured-form-filter-${_form_search_group}-test)
        if(_form_search_group STREQUAL "filter")
            add_executable(${_form_search_target} "${_form_search_root}/tests/application_experience/test_structured_form_filter.c")
            target_link_libraries(${_form_search_target} PRIVATE Umicom::application)
            set(_form_search_backends memory)
        elseif(_form_search_group STREQUAL "text")
            add_executable(${_form_search_target} "${_form_search_root}/tests/application_experience/test_structured_form_filter_text.c")
            target_link_libraries(${_form_search_target} PRIVATE Umicom::application)
            set(_form_search_backends memory)
        elseif(TARGET Umicom::form_records)
            add_executable(${_form_search_target} "${_form_search_root}/tests/data_history/test_structured_form_query.c")
            target_link_libraries(${_form_search_target} PRIVATE Umicom::form_records)
            set(_form_search_backends memory)
            get_target_property(_form_search_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
            if("UMICOM_HAS_SQLITE=1" IN_LIST _form_search_definitions)
                list(APPEND _form_search_backends sqlite)
            endif()
        else()
            continue()
        endif()
        set_target_properties(${_form_search_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_form_search_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_form_search_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_form_search_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_form_search_target} FILES "${_form_search_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_form_search_backend IN LISTS _form_search_backends)
            set(_form_search_args "")
            if(_form_search_backend STREQUAL "sqlite")
                set(_form_search_args sqlite)
            endif()
            foreach(_form_search_case IN LISTS _form_search_${_form_search_group}_cases)
                set(_form_search_test framework.structured_forms.${_form_search_group}.${_form_search_backend}.${_form_search_case})
                add_test(NAME ${_form_search_test} COMMAND ${_form_search_target} ${_form_search_case} ${_form_search_args})
                set_tests_properties(${_form_search_test} PROPERTIES TIMEOUT 45 LABELS "framework;forms;search;${_form_search_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_form_search_test} TARGETS ${_form_search_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(TARGET Umicom::form_records)
        add_executable(umicom-form-search-example "${_form_search_root}/examples/data_history/form_search.c")
        target_link_libraries(umicom-form-search-example PRIVATE Umicom::form_records)
        set_target_properties(umicom-form-search-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(umicom-form-search-example)
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(umicom-form-search-example)
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(umicom-form-search-example)
        endif()
        add_test(NAME framework.structured_forms.query.example COMMAND umicom-form-search-example)
        set_tests_properties(framework.structured_forms.query.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;search;example")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.query.example TARGETS umicom-form-search-example)
        endif()
    endif()
endif()
unset(_form_search_root)
unset(_form_search_component)
unset(_form_search_exclude)
unset(_form_search_filter_cases)
unset(_form_search_query_cases)
unset(_form_search_group)
unset(_form_search_target)
unset(_form_search_backends)
unset(_form_search_backend)
unset(_form_search_definitions)
unset(_form_search_args)
unset(_form_search_case)
unset(_form_search_test)

unset(_form_search_text_cases)
