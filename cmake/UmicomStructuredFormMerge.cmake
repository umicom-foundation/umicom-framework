# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Three-way review remains a portable application service with no I/O authority.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_merge_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE "${_form_merge_root}/src/application/experience/structured_form_merge.c")
install(FILES "${_form_merge_root}/include/umicom/application/experience/structured_form_merge.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_merge.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-merge-test "${_form_merge_root}/tests/application_experience/test_structured_form_merge.c")
    target_link_libraries(umicom-form-merge-test PRIVATE Umicom::application)
    set_target_properties(umicom-form-merge-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-merge-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-merge-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-merge-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-merge-test FILES
            "${_form_merge_root}/tests/application_experience/structured_form_fixture.h"
            "${_form_merge_root}/src/application/experience/structured_form_internal.h")
    endif()
    foreach(_form_merge_case IN ITEMS unchanged local incoming same conflict choose-local choose-incoming choose-base
            custom custom-invalid reset stale schema readonly missing inputs overflow required owned field noop disjoint)
        add_test(NAME framework.structured_forms.merge.${_form_merge_case} COMMAND umicom-form-merge-test ${_form_merge_case})
        set_tests_properties(framework.structured_forms.merge.${_form_merge_case} PROPERTIES TIMEOUT 30
            LABELS "framework;forms;conflict-review;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.merge.${_form_merge_case} TARGETS umicom-form-merge-test)
        endif()
    endforeach()
endif()
unset(_form_merge_root)
unset(_form_merge_case)
