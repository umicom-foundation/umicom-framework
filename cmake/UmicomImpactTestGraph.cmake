include_guard(GLOBAL)

# A separate capture namespace avoids stale properties when another inventory
# is prepared. Nothing here changes test commands, ordering or resource locks.
function(umicom_impact_index_tests directory)
    if(CMAKE_VERSION VERSION_LESS "3.28")
        return()
    endif()
    get_property(_generation GLOBAL PROPERTY UMICOM_IMPACT_TEST_GENERATION)
    if(NOT _generation)
        set(_generation 0)
    endif()
    math(EXPR _generation "${_generation} + 1")
    set_property(GLOBAL PROPERTY UMICOM_IMPACT_TEST_GENERATION "${_generation}")
    set(_prefix "UMICOM_IMPACT_TEST_GRAPH_${_generation}")
    set_property(GLOBAL PROPERTY UMICOM_IMPACT_TEST_GRAPH "${_prefix}")
    set_property(GLOBAL PROPERTY "${_prefix}_VALID" TRUE)
    _umicom_impact_index_directory("${directory}" "${_prefix}")
    get_property(_fixture_keys GLOBAL PROPERTY "${_prefix}_FIXTURES")
    list(REMOVE_DUPLICATES _fixture_keys)
    foreach(_fixture_key IN LISTS _fixture_keys)
        get_property(_members GLOBAL PROPERTY "${_prefix}_MEMBERS_${_fixture_key}")
        list(REMOVE_DUPLICATES _members)
        list(SORT _members)
        list(GET _members 0 _anchor)
        set_property(GLOBAL PROPERTY "${_prefix}_ANCHOR_${_fixture_key}" "${_anchor}")
    endforeach()
endfunction()

function(_umicom_impact_index_directory directory prefix)
    get_property(_binary DIRECTORY "${directory}" PROPERTY BINARY_DIR)
    string(SHA256 _directory_key "${_binary}")
    get_property(_visited GLOBAL PROPERTY "${prefix}_DIRECTORY_${_directory_key}")
    if(_visited)
        set_property(GLOBAL PROPERTY "${prefix}_VALID" FALSE)
        return()
    endif()
    set_property(GLOBAL PROPERTY "${prefix}_DIRECTORY_${_directory_key}" TRUE)
    get_property(_tests DIRECTORY "${_binary}" PROPERTY TESTS)
    foreach(_test IN LISTS _tests)
        string(SHA256 _key "${_test}")
        get_property(_known GLOBAL PROPERTY "${prefix}_TEST_${_key}" SET)
        if(_known)
            # A name-only selector cannot distinguish duplicate registrations.
            set_property(GLOBAL PROPERTY "${prefix}_VALID" FALSE)
        endif()
        set_property(GLOBAL PROPERTY "${prefix}_TEST_${_key}" "${_binary}")
        foreach(_property IN ITEMS FIXTURES_REQUIRED FIXTURES_SETUP FIXTURES_CLEANUP)
            get_property(_fixtures TEST "${_test}" DIRECTORY "${_binary}" PROPERTY "${_property}")
            foreach(_fixture IN LISTS _fixtures)
                string(SHA256 _fixture_key "${_fixture}")
                set_property(GLOBAL APPEND PROPERTY "${prefix}_FIXTURES" "${_fixture_key}")
                set_property(GLOBAL APPEND PROPERTY "${prefix}_MEMBERS_${_fixture_key}" "${_test}")
                if(NOT _property STREQUAL "FIXTURES_REQUIRED")
                    set_property(GLOBAL PROPERTY "${prefix}_PROVIDED_${_fixture_key}" TRUE)
                endif()
            endforeach()
        endforeach()
    endforeach()
    get_property(_children DIRECTORY "${_binary}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _umicom_impact_index_directory("${_child}" "${prefix}")
    endforeach()
endfunction()

# Return related registrations as a conservative selection group. DEPENDS means
# ordering, not success. Only CTest interprets that execution distinction.
function(_umicom_impact_related_tests test_name directory output complete)
    set("${output}" "" PARENT_SCOPE)
    set("${complete}" FALSE PARENT_SCOPE)
    get_property(_prefix GLOBAL PROPERTY UMICOM_IMPACT_TEST_GRAPH)
    if(NOT _prefix OR CMAKE_VERSION VERSION_LESS "3.28")
        return()
    endif()
    get_property(_valid GLOBAL PROPERTY "${_prefix}_VALID")
    string(SHA256 _key "${test_name}")
    get_property(_registered GLOBAL PROPERTY "${_prefix}_TEST_${_key}" SET)
    get_property(_registered_directory GLOBAL PROPERTY "${_prefix}_TEST_${_key}")
    get_property(_binary DIRECTORY "${directory}" PROPERTY BINARY_DIR)
    if(NOT _valid OR NOT _registered OR NOT _registered_directory STREQUAL _binary)
        return()
    endif()
    set(_related "")
    get_property(_dependencies TEST "${test_name}" DIRECTORY "${directory}" PROPERTY DEPENDS)
    foreach(_dependency IN LISTS _dependencies)
        if(_dependency MATCHES "\\$<")
            return()
        endif()
        string(SHA256 _dependency_key "${_dependency}")
        get_property(_exists GLOBAL PROPERTY "${_prefix}_TEST_${_dependency_key}" SET)
        if(NOT _exists)
            return()
        endif()
        list(APPEND _related "${_dependency}")
    endforeach()
    get_property(_required TEST "${test_name}" DIRECTORY "${directory}" PROPERTY FIXTURES_REQUIRED)
    foreach(_property IN ITEMS FIXTURES_REQUIRED FIXTURES_SETUP FIXTURES_CLEANUP)
        get_property(_fixtures TEST "${test_name}" DIRECTORY "${directory}" PROPERTY "${_property}")
        foreach(_fixture IN LISTS _fixtures)
            if(_fixture MATCHES "\\$<")
                return()
            endif()
            if(NOT _property STREQUAL "FIXTURES_REQUIRED" AND _fixture IN_LIST _required)
                # CTest refuses a setup/cleanup test requiring its own fixture.
                return()
            endif()
            string(SHA256 _fixture_key "${_fixture}")
            get_property(_provided GLOBAL PROPERTY "${_prefix}_PROVIDED_${_fixture_key}")
            if(NOT _provided)
                return()
            endif()
            # Compute each anchor once at index completion, not once per test.
            # Retain the original lookup for review of the same grouping policy.
            #[[
            get_property(_members GLOBAL PROPERTY "${_prefix}_MEMBERS_${_fixture_key}")
            list(REMOVE_DUPLICATES _members)
            list(SORT _members)
            list(LENGTH _members _member_count)
            if(_member_count EQUAL 0)
                return()
            endif()
            # One edge per member connects the fixture group without creating a
            # quadratic matrix for fixtures used by thousands of test cases.
            list(GET _members 0 _anchor)
            ]]
            get_property(_anchor GLOBAL PROPERTY "${_prefix}_ANCHOR_${_fixture_key}")
            if(NOT _anchor STREQUAL test_name)
                list(APPEND _related "${_anchor}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _related)
    list(SORT _related)
    set("${output}" "${_related}" PARENT_SCOPE)
    set("${complete}" TRUE PARENT_SCOPE)
endfunction()
