# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Qualify inspection independently from the writable Data Server contract.
if(NOT TARGET Umicom::data)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_inspection_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_inspection_component IN ITEMS Framework FrameworkSDK)
    set(_inspection_exclude "")
    if(_inspection_component STREQUAL "FrameworkSDK")
        set(_inspection_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_inspection_root}/docs/guides/read-only-data-inspection.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_inspection_component} ${_inspection_exclude})
endforeach()
if(BUILD_TESTING)
    get_target_property(_inspection_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
    set(_inspection_groups open)
    set(_inspection_open_cases empty null special uri long null-output memory-mode)
    if("UMICOM_HAS_SQLITE=1" IN_LIST _inspection_definitions)
        list(APPEND _inspection_groups mutation transactions records)
        list(APPEND _inspection_open_cases valid missing corrupt unrelated view columns)
    else()
        list(APPEND _inspection_open_cases unavailable)
    endif()
    set(_inspection_mutation_cases set delete insert drop attach pragma vacuum select multi transaction diagnostic read-after-denial)
    set(_inspection_transactions_cases commit rollback nested writer-reserved reader-first visit snapshot outside denial-retains-owner)
    set(_inspection_records_cases document history bundle catalogue receipt verify append-denied restore-denied nested later)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/data-inspection-fixtures")
    foreach(_inspection_group IN LISTS _inspection_groups)
        set(_inspection_target "umicom-data-readonly-${_inspection_group}-test")
        add_executable(${_inspection_target} "${_inspection_root}/tests/data_history/test_data_readonly_${_inspection_group}.c")
        target_link_libraries(${_inspection_target} PRIVATE Umicom::data)
        set_target_properties(${_inspection_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_inspection_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_inspection_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_inspection_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_inspection_target} FILES "${_inspection_root}/tests/data_history/readonly_fixture.h")
        endif()
        foreach(_inspection_case IN LISTS _inspection_${_inspection_group}_cases)
            add_test(NAME framework.data.inspection.${_inspection_group}.${_inspection_case}
                COMMAND ${_inspection_target} ${_inspection_case} "${CMAKE_CURRENT_BINARY_DIR}/data-inspection-fixtures")
            set_tests_properties(framework.data.inspection.${_inspection_group}.${_inspection_case} PROPERTIES TIMEOUT 30
                LABELS "framework;data;inspection;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.inspection.${_inspection_group}.${_inspection_case} TARGETS ${_inspection_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_inspection_root)
unset(_inspection_component)
unset(_inspection_exclude)
unset(_inspection_definitions)
unset(_inspection_groups)
unset(_inspection_group)
unset(_inspection_open_cases)
unset(_inspection_mutation_cases)
unset(_inspection_transactions_cases)
unset(_inspection_records_cases)
unset(_inspection_target)
unset(_inspection_case)