# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Join application semantics and web controls without introducing a cycle into
# either foundational library. The document library owns strict UTF-8 validation.
if(NOT TARGET Umicom::application OR NOT TARGET Umicom::web OR NOT TARGET Umicom::document)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_form_web_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_form_web STATIC
    "${_form_web_root}/src/web/form_body.c"
    "${_form_web_root}/src/web/structured_form_submit.c"
    "${_form_web_root}/src/web/structured_form_html.c")
add_library(Umicom::form_web ALIAS umicom_form_web)
set_target_properties(umicom_form_web PROPERTIES EXPORT_NAME form_web
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_form_web PUBLIC Umicom::application Umicom::web PRIVATE Umicom::document)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_form_web)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_form_web)
endif()
install(TARGETS umicom_form_web EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_form_web)
install(FILES "${_form_web_root}/include/umicom/web/form_body.h" "${_form_web_root}/include/umicom/web/structured_form.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/web" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_web include/umicom/web/form_body.h include/umicom/web/structured_form.h)
endif()
foreach(_form_web_component IN ITEMS Framework FrameworkSDK)
    set(_form_web_exclude "")
    if(_form_web_component STREQUAL "FrameworkSDK")
        set(_form_web_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_web_root}/docs/guides/browser-forms.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_web_component} ${_form_web_exclude})
    install(DIRECTORY "${_form_web_root}/examples/browser_forms/"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/examples/browser_forms"
        COMPONENT ${_form_web_component} ${_form_web_exclude}
        FILES_MATCHING PATTERN "*.c" PATTERN "*.h" PATTERN "CMakeLists.txt")
endforeach()
if(BUILD_TESTING)
    foreach(_form_web_group IN ITEMS body submit html url)
        if(_form_web_group STREQUAL "body")
            set(_form_web_cases empty valid escaped duplicate encoded-duplicate malformed nul unicode capacity names segments equals source-overlap bounds)
        elseif(_form_web_group STREQUAL "submit")
            set(_form_web_cases draft submit incomplete stale-revision schema token unknown duplicate readonly missing unit invalid-second no-op changed-after missing-state revision-overflow newlines bare-cr)
        elseif(_form_web_group STREQUAL "html")
            set(_form_web_cases render escaping readonly secret action token capacity utf8 schema numbers empty leading-newline carriage-return)
        else()
            set(_form_web_cases valid malformed nul capacity overlap empty high-byte)
        endif()
        set(_form_web_target umicom-form-web-${_form_web_group}-test)
        add_executable(${_form_web_target} "${_form_web_root}/tests/web_forms/test_${_form_web_group}.c")
        target_link_libraries(${_form_web_target} PRIVATE Umicom::form_web)
        set_target_properties(${_form_web_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_form_web_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_form_web_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_form_web_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_form_web_target} FILES
                "${_form_web_root}/tests/web_forms/fixture.h"
                "${_form_web_root}/tests/application_experience/structured_form_fixture.h"
                "${_form_web_root}/src/web/structured_form_internal.h")
        endif()
        foreach(_form_web_case IN LISTS _form_web_cases)
            add_test(NAME framework.structured_forms.web.${_form_web_group}.${_form_web_case}
                COMMAND ${_form_web_target} ${_form_web_case})
            set_tests_properties(framework.structured_forms.web.${_form_web_group}.${_form_web_case}
                PROPERTIES TIMEOUT 30 LABELS "framework;forms;web;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.web.${_form_web_group}.${_form_web_case} TARGETS ${_form_web_target})
            endif()
        endforeach()
    endforeach()
    add_executable(umicom-browser-form-example "${_form_web_root}/examples/browser_forms/main.c")
    target_link_libraries(umicom-browser-form-example PRIVATE Umicom::form_web)
    set_target_properties(umicom-browser-form-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-browser-form-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-browser-form-example)
    endif()
    add_test(NAME framework.structured_forms.web.example COMMAND umicom-browser-form-example)
    set_tests_properties(framework.structured_forms.web.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;web;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.structured_forms.web.example TARGETS umicom-browser-form-example)
    endif()
endif()
unset(_form_web_root)
unset(_form_web_component)
unset(_form_web_exclude)
unset(_form_web_group)
unset(_form_web_cases)
unset(_form_web_target)
unset(_form_web_case)