# Umicom Framework
# File: cmake/UmicomEditorPreferences.cmake
# PURPOSE: Integrate checked settings updates and native editor preference controls.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_platform)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_preferences_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
install(FILES "${_preferences_root}/include/umicom/platform/settings_changes.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/platform" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_platform include/umicom/platform/settings_changes.h)
endif()
if(TARGET umicom_ui_gtk4 AND TARGET umicom_editor)
    target_sources(umicom_ui_gtk4 PRIVATE "${_preferences_root}/adapters/gtk4/indentation_preferences_gtk4.c")
    target_link_libraries(umicom_ui_gtk4 PUBLIC Umicom::editor)
    install(FILES "${_preferences_root}/include/umicom/ui/gtk4/indentation_preferences.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 include/umicom/ui/gtk4/indentation_preferences.h)
    endif()
endif()
install(FILES "${_preferences_root}/docs/guides/checked-settings-changes.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    add_executable(umicom-settings-changes-test "${_preferences_root}/tests/platform/test_settings_changes.c")
    target_link_libraries(umicom-settings-changes-test PRIVATE Umicom::platform)
    set(_preferences_targets umicom-settings-changes-test)
    foreach(_preferences_case IN ITEMS read apply normalised noop stale-first stale-last invalid-first invalid-last
        unknown duplicate null-member long-value read-unknown read-duplicate read-arguments apply-arguments independent repeat)
        set(_preferences_test "framework.settings.changes.${_preferences_case}")
        add_test(NAME ${_preferences_test} COMMAND umicom-settings-changes-test ${_preferences_case})
        set_tests_properties(${_preferences_test} PROPERTIES TIMEOUT 30 LABELS "framework;settings;transaction;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${_preferences_test} TARGETS umicom-settings-changes-test)
        endif()
    endforeach()
    if(TARGET umicom_ui_gtk4 AND TARGET umicom_editor)
        add_executable(umicom-indentation-preferences-test "${_preferences_root}/tests/ui_workstation/test_indentation_preferences_gtk4.c")
        target_link_libraries(umicom-indentation-preferences-test PRIVATE Umicom::ui_gtk4)
        list(APPEND _preferences_targets umicom-indentation-preferences-test)
        foreach(_preferences_case IN ITEMS initial spaces tabs typed empty zero large fraction suffix arguments)
            set(_preferences_test "framework.editor.preferences.gtk4.${_preferences_case}")
            add_test(NAME ${_preferences_test} COMMAND umicom-indentation-preferences-test ${_preferences_case})
            set_tests_properties(${_preferences_test} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77
                ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;preferences;gtk4;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_preferences_test} TARGETS umicom-indentation-preferences-test)
            endif()
        endforeach()
    endif()
    foreach(_preferences_target IN LISTS _preferences_targets)
        set_target_properties(${_preferences_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_preferences_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_preferences_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_preferences_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_preferences_target} FILES "${_preferences_root}/src/platform/settings_changes.inc")
        endif()
    endforeach()
endif()
unset(_preferences_root)
unset(_preferences_case)
unset(_preferences_test)
unset(_preferences_target)
unset(_preferences_targets)
