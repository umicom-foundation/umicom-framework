# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Explicit file transfer composes portable bundles with Platform file ownership.
if(NOT TARGET Umicom::data OR NOT TARGET Umicom::platform)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_bundle_files_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_record_bundle_files STATIC "${_bundle_files_root}/src/data/record_bundle_files.c")
add_library(Umicom::record_bundle_files ALIAS umicom_record_bundle_files)
set_target_properties(umicom_record_bundle_files PROPERTIES EXPORT_NAME record_bundle_files
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_record_bundle_files PUBLIC Umicom::data Umicom::platform)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_record_bundle_files)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_record_bundle_files)
endif()
install(TARGETS umicom_record_bundle_files EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_record_bundle_files)
install(FILES "${_bundle_files_root}/include/umicom/data/record_bundle_files.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_record_bundle_files include/umicom/data/record_bundle_files.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-record-bundle-files-test "${_bundle_files_root}/tests/data_history/test_record_bundle_files.c")
    target_link_libraries(umicom-record-bundle-files-test PRIVATE Umicom::record_bundle_files)
    set_target_properties(umicom-record-bundle-files-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-record-bundle-files-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-record-bundle-files-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-record-bundle-files-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-bundle-files-test FILES
            "${_bundle_files_root}/tests/build_log/fixture.h"
            "${_bundle_files_root}/tests/support/symbolic_link.h")
    endif()
    foreach(_bundle_files_case IN ITEMS roundtrip exclusive unicode relative traversal missing missing-parent directory malformed oversized null-bundle symlink)
        add_test(NAME framework.data.bundle.files.${_bundle_files_case} COMMAND umicom-record-bundle-files-test ${_bundle_files_case})
        set_tests_properties(framework.data.bundle.files.${_bundle_files_case} PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;filesystem;regression")
        if(_bundle_files_case STREQUAL "symlink")
            set_tests_properties(framework.data.bundle.files.${_bundle_files_case} PROPERTIES SKIP_RETURN_CODE 77)
        endif()
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.bundle.files.${_bundle_files_case} TARGETS umicom-record-bundle-files-test)
        endif()
    endforeach()
endif()
# Export qualification exercises both stores without changing caller transactions.
if(BUILD_TESTING)
    add_executable(umicom-record-bundle-export-test "${_bundle_files_root}/tests/data_history/test_record_bundle_export.c")
    target_link_libraries(umicom-record-bundle-export-test PRIVATE Umicom::record_bundle_files)
    set_target_properties(umicom-record-bundle-export-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-record-bundle-export-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-record-bundle-export-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-record-bundle-export-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-bundle-export-test FILES
            "${_bundle_files_root}/tests/build_log/fixture.h"
            "${_bundle_files_root}/tests/support/symbolic_link.h")
    endif()
    set(_bundle_export_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _bundle_export_backends sqlite)
    endif()
    foreach(_bundle_export_backend IN LISTS _bundle_export_backends)
        set(_bundle_export_args "")
        if(_bundle_export_backend STREQUAL "sqlite")
            set(_bundle_export_args sqlite)
        endif()
        foreach(_bundle_export_case IN ITEMS roundtrip stale metadata digest new null relative exclusive nested capacity missing binary later missing-content)
            add_test(NAME framework.data.bundle.export.${_bundle_export_backend}.${_bundle_export_case}
                COMMAND umicom-record-bundle-export-test ${_bundle_export_case} ${_bundle_export_args})
            set_tests_properties(framework.data.bundle.export.${_bundle_export_backend}.${_bundle_export_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;record-bundle;filesystem;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.bundle.export.${_bundle_export_backend}.${_bundle_export_case} TARGETS umicom-record-bundle-export-test)
            endif()
        endforeach()
    endforeach()
endif()
unset(_bundle_export_backends)
unset(_bundle_export_backend)
unset(_bundle_export_args)
unset(_bundle_export_case)
unset(_bundle_files_root)
unset(_bundle_files_case)
