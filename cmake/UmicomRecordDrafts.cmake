# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Editable record state remains part of the data SDK. Test ownership lets the
# affected-test service select this workflow when its shared sources change.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
get_filename_component(_draft_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_draft.h)
endif()
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_data FILES
        "${_draft_root}/src/data/include/record_fields.h")
endif()
foreach(_draft_component IN ITEMS Framework FrameworkSDK)
    if(_draft_component STREQUAL "FrameworkSDK")
        set(_draft_exclude EXCLUDE_FROM_ALL)
    else()
        set(_draft_exclude "")
    endif()
    install(FILES "${_draft_root}/docs/guides/record-drafts.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT "${_draft_component}" ${_draft_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-record-draft-test "${_draft_root}/tests/data_history/test_record_draft.c")
    add_executable(umicom-record-draft-storage-test "${_draft_root}/tests/data_history/test_record_draft_storage.c")
    add_executable(umicom-record-draft-review-test "${_draft_root}/tests/data_history/test_record_draft_review.c")
    add_executable(umicom-record-draft-example "${_draft_root}/examples/data_history/record_drafts.c")
    foreach(_draft_target IN ITEMS umicom-record-draft-test umicom-record-draft-storage-test umicom-record-draft-review-test umicom-record-draft-example)
        target_link_libraries(${_draft_target} PRIVATE Umicom::data)
        set_target_properties(${_draft_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_draft_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_draft_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_draft_target})
        endif()
    endforeach()
    foreach(_draft_case IN ITEMS new open-integrity dirty-guard discard binary invalid-attribution
            save-success save-failure edit-during-save edit-away-back completions pending-guard
            token-lifetime overflow argument-atomicity independent)
        add_test(NAME framework.data.draft.${_draft_case} COMMAND umicom-record-draft-test ${_draft_case})
        set_tests_properties(framework.data.draft.${_draft_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;data;draft;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.draft.${_draft_case} TARGETS umicom-record-draft-test)
        endif()
    endforeach()
    # Comparison acceptance is portable and remains available without SQLite or GTK.
    foreach(_draft_review_case IN ITEMS preserve changed-baseline identity same-revision pending invalid new-collision matches-latest)
        add_test(NAME framework.data.draft.review.${_draft_review_case}
            COMMAND umicom-record-draft-review-test ${_draft_review_case})
        set_tests_properties(framework.data.draft.review.${_draft_review_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;data;draft;review;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.draft.review.${_draft_review_case} TARGETS umicom-record-draft-review-test)
        endif()
    endforeach()
    set(_draft_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _draft_backends sqlite)
    endif()
    foreach(_draft_backend IN LISTS _draft_backends)
        foreach(_draft_case IN ITEMS stale snapshot busy request-integrity)
            add_test(NAME framework.data.draft.${_draft_backend}.${_draft_case}
                COMMAND umicom-record-draft-storage-test ${_draft_backend} ${_draft_case})
            set_tests_properties(framework.data.draft.${_draft_backend}.${_draft_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;draft;${_draft_backend};regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.draft.${_draft_backend}.${_draft_case}
                    TARGETS umicom-record-draft-storage-test)
            endif()
        endforeach()
    endforeach()
    add_test(NAME framework.data.draft.example COMMAND umicom-record-draft-example)
    set_tests_properties(framework.data.draft.example PROPERTIES TIMEOUT 30 LABELS "framework;data;draft;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.draft.example TARGETS umicom-record-draft-example)
    endif()
endif()
unset(_draft_root)
unset(_draft_component)
unset(_draft_exclude)
unset(_draft_target)
unset(_draft_case)
unset(_draft_backends)
unset(_draft_backend)

unset(_draft_review_case)
