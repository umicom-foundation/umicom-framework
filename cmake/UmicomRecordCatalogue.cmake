# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Discovery and reviewed opening share the portable data component.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_record_catalogue_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_catalogue.h)
endif()
foreach(_record_catalogue_component IN ITEMS Framework FrameworkSDK)
    if(_record_catalogue_component STREQUAL "FrameworkSDK")
        set(_record_catalogue_exclude EXCLUDE_FROM_ALL)
    else()
        set(_record_catalogue_exclude "")
    endif()
    install(FILES "${_record_catalogue_root}/docs/guides/record-catalogue.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_record_catalogue_component} ${_record_catalogue_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-record-catalogue-test "${_record_catalogue_root}/tests/data_history/test_record_catalogue.c")
    target_link_libraries(umicom-record-catalogue-test PRIVATE Umicom::data)
    add_executable(umicom-record-catalogue-example "${_record_catalogue_root}/examples/data_history/record_catalogue.c")
    target_link_libraries(umicom-record-catalogue-example PRIVATE Umicom::data)
    foreach(_record_catalogue_target IN ITEMS umicom-record-catalogue-test umicom-record-catalogue-example)
        set_target_properties(${_record_catalogue_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_record_catalogue_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_record_catalogue_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_record_catalogue_target})
        endif()
    endforeach()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-catalogue-test FILES
            "${_record_catalogue_root}/src/data/include/record_history_internal.h")
    endif()
    set(_record_catalogue_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _record_catalogue_backends sqlite)
    endif()
    if(SQLite3_FOUND)
        add_test(NAME framework.data.catalogue.sqlite.scan-limit COMMAND umicom-record-catalogue-test sqlite scan-limit)
        set_tests_properties(framework.data.catalogue.sqlite.scan-limit PROPERTIES TIMEOUT 30
            LABELS "framework;data;catalogue;sqlite;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.catalogue.sqlite.scan-limit TARGETS umicom-record-catalogue-test)
        endif()
    endif()
    foreach(_record_catalogue_backend IN LISTS _record_catalogue_backends)
        foreach(_record_catalogue_case IN ITEMS empty pages search invalid nested changed-head added-head changed-query
                other-namespace cursor bad-key missing-row bad-head entity-limit metadata reviewed-open stale-open changed-metadata broken-content)
            add_test(NAME framework.data.catalogue.${_record_catalogue_backend}.${_record_catalogue_case}
                COMMAND umicom-record-catalogue-test ${_record_catalogue_backend} ${_record_catalogue_case})
            set_tests_properties(framework.data.catalogue.${_record_catalogue_backend}.${_record_catalogue_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;catalogue;${_record_catalogue_backend};regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.catalogue.${_record_catalogue_backend}.${_record_catalogue_case}
                    TARGETS umicom-record-catalogue-test)
            endif()
        endforeach()
    endforeach()
    add_test(NAME framework.data.catalogue.example COMMAND umicom-record-catalogue-example)
    set_tests_properties(framework.data.catalogue.example PROPERTIES TIMEOUT 30 LABELS "framework;data;catalogue;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.catalogue.example TARGETS umicom-record-catalogue-example)
    endif()
endif()
unset(_record_catalogue_root)
unset(_record_catalogue_component)
unset(_record_catalogue_exclude)
unset(_record_catalogue_target)
unset(_record_catalogue_backends)
unset(_record_catalogue_backend)
unset(_record_catalogue_case)
