# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Keep the identity decision in security; the adapter joins security and storage
# without introducing a dependency from the core data library back to security.
if(NOT TARGET Umicom::security OR NOT TARGET Umicom::data)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_authorized_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_security PRIVATE "${_authorized_root}/src/security/record_access.c")
add_library(umicom_authorized_records STATIC "${_authorized_root}/src/data/authorized_records.c")
add_library(Umicom::authorized_records ALIAS umicom_authorized_records)
target_link_libraries(umicom_authorized_records PUBLIC Umicom::security Umicom::data)
set_target_properties(umicom_authorized_records PROPERTIES EXPORT_NAME authorized_records
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_authorized_records)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_authorized_records)
endif()
install(TARGETS umicom_authorized_records EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_authorized_records)
install(FILES "${_authorized_root}/include/umicom/data/authorized_records.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
install(FILES "${_authorized_root}/include/umicom/security/record_access.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/security" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_authorized_records include/umicom/data/authorized_records.h)
    umicom_release_inventory_own_headers(umicom_security include/umicom/security/record_access.h)
endif()
foreach(_authorized_component IN ITEMS Framework FrameworkSDK)
    set(_authorized_exclude "")
    if(_authorized_component STREQUAL "FrameworkSDK")
        set(_authorized_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_authorized_root}/docs/guides/authorized-records.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_authorized_component} ${_authorized_exclude})
endforeach()
if(BUILD_TESTING)
    set(_authorized_request_cases valid null operation-zero operation-unknown time-zero
        session-empty session-unclosed session-control entity-empty entity-unclosed
        entity-wildcard entity-path entity-unicode purpose-empty purpose-unclosed
        purpose-wildcard purpose-path namespace namespace-boundary namespace-root
        maximum-identifiers factory-prefix factory-source factory-copy)
    set(_authorized_policy_cases allow no-rules operation-only purpose-only wrong-purpose
        wrong-principal purpose-other-record explicit-operation-deny explicit-purpose-deny
        last-matching-rule unknown-session revoked expired before-issued clock-rollback
        disabled reenabled missing-identity current-revision history-capability
        create-capability amend-capability clear-policy receipt-is-not-authority)
    set(_authorized_reads_cases latest history reviewed reviewed-stale reviewed-other-entity
        reviewed-unclosed reviewed-tampered wrong-latest-operation wrong-history-operation
        zero-revision missing-revision missing-entity permission-denied history-denied
        revoked nested no-existence-leak null)
    set(_authorized_writes_cases create amend stale occupied wrong-create-mode wrong-amend-mode
        empty-content null-content maximum-content oversized-content revision-overflow
        empty-reason control-reason unclosed-reason maximum-reason permission-denied
        purpose-denied create-denied amend-denied disabled revoked-after-read nested null)
    set(_authorized_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _authorized_backends sqlite)
    endif()
    foreach(_authorized_group IN ITEMS request policy reads writes example)
        set(_authorized_target "umicom-authorized-record-${_authorized_group}-test")
        if(_authorized_group STREQUAL "request" OR _authorized_group STREQUAL "policy")
            set(_authorized_source "tests/security/test_record_access_${_authorized_group}.c")
        elseif(_authorized_group STREQUAL "example")
            set(_authorized_source "examples/data_history/authorized_records.c")
        else()
            set(_authorized_source "tests/data_history/test_authorized_record_${_authorized_group}.c")
        endif()
        add_executable(${_authorized_target} "${_authorized_root}/${_authorized_source}")
        target_link_libraries(${_authorized_target} PRIVATE Umicom::authorized_records)
        set_target_properties(${_authorized_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_authorized_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_authorized_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_authorized_target})
        endif()
        if(NOT _authorized_group STREQUAL "example" AND COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_authorized_target} FILES
                "${_authorized_root}/tests/security/record_access_fixture.h")
        endif()
        set(_authorized_group_backends memory)
        if(_authorized_group STREQUAL "reads" OR _authorized_group STREQUAL "writes")
            set(_authorized_group_backends ${_authorized_backends})
        endif()
        set(_authorized_cases ${_authorized_${_authorized_group}_cases})
        if(_authorized_group STREQUAL "example")
            set(_authorized_cases run)
        endif()
        foreach(_authorized_backend IN LISTS _authorized_group_backends)
            foreach(_authorized_case IN LISTS _authorized_cases)
                set(_authorized_test "framework.authorized_records.${_authorized_group}.${_authorized_backend}.${_authorized_case}")
                set(_authorized_args ${_authorized_case})
                if(_authorized_group STREQUAL "reads" OR _authorized_group STREQUAL "writes")
                    set(_authorized_args ${_authorized_backend} ${_authorized_case})
                elseif(_authorized_group STREQUAL "example")
                    set(_authorized_args "")
                endif()
                add_test(NAME ${_authorized_test} COMMAND ${_authorized_target} ${_authorized_args})
                set_tests_properties(${_authorized_test} PROPERTIES TIMEOUT 30
                    LABELS "framework;security;data;authorized-records;${_authorized_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_authorized_test} TARGETS ${_authorized_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
unset(_authorized_root)
unset(_authorized_component)
unset(_authorized_exclude)
unset(_authorized_request_cases)
unset(_authorized_policy_cases)
unset(_authorized_reads_cases)
unset(_authorized_writes_cases)
unset(_authorized_backends)
unset(_authorized_group)
unset(_authorized_target)
unset(_authorized_source)
unset(_authorized_group_backends)
unset(_authorized_cases)
unset(_authorized_backend)
unset(_authorized_case)
unset(_authorized_test)
unset(_authorized_args)
