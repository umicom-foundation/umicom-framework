# Discovery reads data before application CMake is evaluated. The bounded build
# identity subset excludes YAML expressions, paths and CMake list syntax.
# Runtime capabilities remain the native manifest parser's responsibility.
function(umicom_application_module_descriptor manifest prefix)
    if(NOT EXISTS "${manifest}" OR IS_DIRECTORY "${manifest}")
        message(FATAL_ERROR "Application manifest is missing: ${manifest}")
    endif()
    file(SIZE "${manifest}" _bytes)
    if(_bytes GREATER 65536 OR _bytes EQUAL 0)
        message(FATAL_ERROR "Application manifest must contain 1..65536 bytes: ${manifest}")
    endif()
    file(READ "${manifest}" _hex HEX)
    string(REGEX MATCHALL ".." _octets "${_hex}")
    foreach(_octet IN LISTS _octets)
        if(_octet MATCHES "^(0[0-8bcef]|1[0-9a-f]|7f)$")
            message(FATAL_ERROR "Control byte in application manifest: ${manifest}")
        endif()
    endforeach()
    file(READ "${manifest}" _text)
    string(REPLACE "\r\n" "\n" _text "${_text}")
    if(_text MATCHES "\r")
        message(FATAL_ERROR "Bare carriage return in application manifest: ${manifest}")
    endif()
    # Brackets and backslashes are not valid build identity characters. Mask
    # them before list conversion so unrelated YAML arrays cannot merge lines.
    string(REPLACE "[" "~" _text "${_text}")
    string(REPLACE "]" "~" _text "${_text}")
    string(REPLACE "\\" "~" _text "${_text}")
    string(REPLACE ";" "\\;" _text "${_text}")
    string(REPLACE "\n" ";" _lines "${_text}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    endif()
    set(_section "")
    set(_seen "")
    set(_frontends "")
    foreach(_field id name version executable native_executable console_executable component)
        set(_${_field} "")
    endforeach()
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _trimmed)
        if(_trimmed STREQUAL "" OR _trimmed MATCHES "^#")
            continue()
        endif()
        if(NOT _seen)
            if(NOT _line STREQUAL "schema: umicom.application.v1")
                message(FATAL_ERROR "Discovery requires the nested application schema first: ${manifest}")
            endif()
            list(APPEND _seen schema)
            continue()
        endif()
        if(_line MATCHES "^schema:")
            message(FATAL_ERROR "Duplicate application schema: ${manifest}")
        endif()
        if(_section STREQUAL "frontends" AND _line MATCHES "^  - (console|gtk|gtk4|web|qt|qt6|wt|mobile)$")
            list(APPEND _frontends "${CMAKE_MATCH_1}")
        endif()
        if(_line MATCHES "^([^ \t:]+):")
            set(_section "${CMAKE_MATCH_1}")
            if(_section STREQUAL "application" OR _section STREQUAL "installation" OR
               _section STREQUAL "frontends")
                if(NOT _line STREQUAL "${_section}:" OR "section_${_section}" IN_LIST _seen)
                    message(FATAL_ERROR "Repeated or malformed ${_section} block: ${manifest}")
                endif()
                list(APPEND _seen "section_${_section}")
            endif()
            continue()
        endif()
        set(_field "")
        if(_section STREQUAL "application" AND
           _trimmed MATCHES "^(id|name|version|executable|native_executable|console_executable):")
            set(_field "${CMAKE_MATCH_1}")
        elseif(_section STREQUAL "installation" AND _trimmed MATCHES "^component:")
            set(_field component)
        endif()
        if(_field STREQUAL "")
            continue()
        endif()
        if(NOT _line MATCHES "^  ${_field}: (.+)$" OR _field IN_LIST _seen)
            message(FATAL_ERROR "Duplicate or malformed ${_field}: ${manifest}")
        endif()
        set(_value "${CMAKE_MATCH_1}")
        string(LENGTH "${_value}" _length)
        if(_length GREATER 255 OR NOT _value MATCHES "^[A-Za-z0-9][A-Za-z0-9 _.()-]*$")
            message(FATAL_ERROR "Unsupported ${_field} value: ${manifest}")
        endif()
        if(NOT _field STREQUAL "name" AND NOT _value MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
            message(FATAL_ERROR "Identity fields must be plain identifiers: ${manifest}")
        endif()
        if(_value MATCHES "[ .]$")
            message(FATAL_ERROR "An identity cannot end in a space or dot: ${manifest}")
        endif()
        set(_${_field} "${_value}")
        list(APPEND _seen "${_field}")
    endforeach()
    foreach(_field id name version executable)
        if(_${_field} STREQUAL "")
            message(FATAL_ERROR "Application manifest requires ${_field}: ${manifest}")
        endif()
    endforeach()
    if(NOT _frontends)
        message(FATAL_ERROR "At least one supported frontend is required: ${manifest}")
    endif()
    if(NOT _native_executable STREQUAL "" AND
       NOT "gtk" IN_LIST _frontends AND NOT "gtk4" IN_LIST _frontends)
        message(FATAL_ERROR "Native executable requires a GTK frontend: ${manifest}")
    endif()
    if(NOT _console_executable STREQUAL "" AND NOT "console" IN_LIST _frontends)
        message(FATAL_ERROR "Console executable requires a console frontend: ${manifest}")
    endif()
    if(NOT _native_executable STREQUAL "" AND _native_executable STREQUAL _console_executable)
        message(FATAL_ERROR "Native and console executables must be distinct: ${manifest}")
    endif()
    set(_basename "${_native_executable}")
    if(_basename STREQUAL "")
        set(_basename "${_executable}")
    endif()
    string(REGEX REPLACE "^umicom-" "" _suffix "${_basename}")
    if(_suffix STREQUAL "")
        message(FATAL_ERROR "Application executable needs a name after umicom-: ${manifest}")
    endif()
    string(REGEX REPLACE "[-.]" "_" _suffix "${_suffix}")
    string(TOUPPER "${_suffix}" _suffix)
    set(_option "UMICOM_APPLICATIONS_BUILD_${_suffix}")
    if(_component STREQUAL "")
        string(REGEX REPLACE "[^A-Za-z0-9]" "" _component "${_name}")
    endif()
    if(_component STREQUAL "" OR NOT _component MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$")
        message(FATAL_ERROR "Installer component must be an identifier: ${manifest}")
    endif()
    foreach(_field id name executable native_executable console_executable component option)
        set(${prefix}_${_field} "${_${_field}}" PARENT_SCOPE)
    endforeach()
endfunction()

# Git interprets its own quoted configuration; CMake validates the resulting
# paths. There is no directory glob, clone, fetch or implicit source execution.
# Preserve the earlier text-output reader for engineering comparison. The
# replacement consumes exact Git records, preventing quoted subsection names or
# embedded newlines in values from changing the registration boundaries.
if(FALSE)
function(umicom_registered_application_paths root output)
    find_package(Git REQUIRED QUIET)
    set(_registry "${root}/.gitmodules")
    if(NOT EXISTS "${_registry}")
        message(FATAL_ERROR "Application discovery requires ${_registry}")
    endif()
    file(SIZE "${_registry}" _registry_bytes)
    if(_registry_bytes GREATER 65536)
        message(FATAL_ERROR "Submodule registry exceeds the discovery bound: ${_registry}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" config --no-includes
        --file "${_registry}" --get-regexp "^submodule\\..*\\.path$"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _records ERROR_VARIABLE _error
        TIMEOUT 15 OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _result STREQUAL "0" AND NOT _result STREQUAL "1")
        message(FATAL_ERROR "Cannot read submodule registry: ${_error}")
    endif()
    string(REPLACE "\r\n" "\n" _records "${_records}")
    # Reject list separators before splitting instead of registering a new path.
    if(_records MATCHES "[;\\\\]")
        message(FATAL_ERROR "Unsupported separator in submodule registry")
    endif()
    string(REPLACE "\n" ";" _records "${_records}")
    set(_paths "")
    foreach(_record IN LISTS _records)
        if(NOT _record MATCHES "^submodule\\..*\\.path[ \t]+(.+)$")
            message(FATAL_ERROR "Malformed submodule path record: ${_record}")
        endif()
        set(_path "${CMAKE_MATCH_1}")
        if(NOT _path MATCHES "^applications/")
            continue()
        endif()
        if(NOT _path MATCHES "^applications/[a-z0-9][a-z0-9-]*$")
            message(FATAL_ERROR "Application modules must be direct children of applications/: ${_path}")
        endif()
        if(_path IN_LIST _paths)
            message(FATAL_ERROR "Duplicate registered application path: ${_path}")
        endif()
        list(APPEND _paths "${_path}")
    endforeach()
    list(LENGTH _paths _count)
    if(_count GREATER 128)
        message(FATAL_ERROR "Application registry exceeds the 128-module discovery bound")
    endif()
    list(SORT _paths)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_registry}")
    endif()
    set(${output} "${_paths}" PARENT_SCOPE)
endfunction()

endif()

# Use the same portable slug contract as the native runtime service. A source
# checkout must remain usable on Windows even when configure runs on Linux.
function(umicom_application_module_slug_valid slug output)
    string(LENGTH "${slug}" _length)
    set(_valid TRUE)
    if(_length LESS 1 OR _length GREATER 63 OR
       NOT slug MATCHES "^[a-z][a-z0-9-]*$" OR slug MATCHES "-$" OR
       slug MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$")
        set(_valid FALSE)
    endif()
    set(${output} "${_valid}" PARENT_SCOPE)
endfunction()

# Git documents a NUL record terminator and newline key/value separator with
# --null. Capture to an owned temporary file so CMake never treats a NUL byte
# as the end of a variable. Hex decoding preserves byte and record boundaries.
function(umicom_registered_application_paths root output)
    find_package(Git REQUIRED QUIET)
    set(_registry "${root}/.gitmodules")
    if(NOT EXISTS "${_registry}" OR IS_DIRECTORY "${_registry}")
        message(FATAL_ERROR "Application discovery requires ${_registry}")
    endif()
    file(SIZE "${_registry}" _registry_bytes)
    if(_registry_bytes GREATER 65536)
        message(FATAL_ERROR "Submodule registry exceeds the discovery bound: ${_registry}")
    endif()
    file(READ "${_registry}" _registry_before HEX)
    string(REGEX MATCHALL ".." _registry_octets "${_registry_before}")
    if("00" IN_LIST _registry_octets)
        message(FATAL_ERROR "NUL byte in submodule registry")
    endif()
    # The earlier wording assumed an out-of-source configure. In script mode
    # CMAKE_CURRENT_BINARY_DIR is the invocation directory; callers should run
    # inspection scripts from their chosen scratch/build directory.
    # This file belongs to configure's binary directory, never the source tree.
    # The comment above describes normal out-of-source configuration only.
    # A fresh name keeps independent discovery calls from sharing partial data.
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/umicom-module-discovery")
    string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef _nonce)
    set(_capture "${CMAKE_CURRENT_BINARY_DIR}/umicom-module-discovery/paths-${_nonce}.bin")
    execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks config --no-includes
        --file "${_registry}" --null --get-regexp "^submodule\\..*\\.path$"
        RESULT_VARIABLE _result OUTPUT_FILE "${_capture}" ERROR_VARIABLE _error TIMEOUT 15)
    set(_records "")
    set(_capture_bytes 0)
    set(_capture_ok FALSE)
    if(EXISTS "${_capture}" AND NOT IS_DIRECTORY "${_capture}")
        file(SIZE "${_capture}" _capture_bytes)
        if(_capture_bytes LESS_EQUAL 1048576)
            file(READ "${_capture}" _records HEX)
            set(_capture_ok TRUE)
        endif()
        file(REMOVE "${_capture}")
    endif()
    if(NOT _capture_ok)
        message(FATAL_ERROR "Submodule path capture is missing or exceeds its bound")
    endif()
    if(NOT _result STREQUAL "0")
        if(NOT _result STREQUAL "1" OR NOT _capture_bytes EQUAL 0 OR NOT _error STREQUAL "")
            message(FATAL_ERROR "Cannot read submodule registry: ${_error}")
        endif()
    elseif(NOT _error STREQUAL "")
        message(FATAL_ERROR "Unexpected Git diagnostics while reading submodule registry: ${_error}")
    endif()
    if(NOT EXISTS "${_registry}")
        message(FATAL_ERROR "Submodule registry changed during discovery")
    endif()
    file(SIZE "${_registry}" _registry_after_bytes)
    if(NOT _registry_after_bytes EQUAL _registry_bytes)
        message(FATAL_ERROR "Submodule registry changed during discovery")
    endif()
    file(READ "${_registry}" _registry_after HEX)
    if(NOT _registry_before STREQUAL _registry_after)
        message(FATAL_ERROR "Submodule registry changed during discovery")
    endif()
    string(REGEX MATCHALL ".." _octets "${_records}")
    set(_paths "")
    set(_key "")
    set(_path "")
    set(_in_value FALSE)
    foreach(_octet IN LISTS _octets)
        if(_octet STREQUAL "00")
            if(NOT _in_value OR NOT _key MATCHES "^submodule\\..+\\.path$" OR _path STREQUAL "")
                message(FATAL_ERROR "Malformed submodule path record")
            endif()
            if(_path MATCHES "^applications/")
                string(SUBSTRING "${_path}" 13 -1 _slug)
                umicom_application_module_slug_valid("${_slug}" _valid)
                if(NOT _valid)
                    message(FATAL_ERROR "Application modules must be portable direct children of applications/: ${_path}")
                endif()
                if(_path IN_LIST _paths)
                    message(FATAL_ERROR "Duplicate registered application path: ${_path}")
                endif()
                list(APPEND _paths "${_path}")
                list(LENGTH _paths _count)
                if(_count GREATER 128)
                    message(FATAL_ERROR "Application registry exceeds the 128-module discovery bound")
                endif()
            endif()
            set(_key "")
            set(_path "")
            set(_in_value FALSE)
        elseif(_octet STREQUAL "0a" AND NOT _in_value)
            set(_in_value TRUE)
        else()
            math(EXPR _value "0x${_octet}")
            if(_value LESS 32 OR _value EQUAL 127)
                message(FATAL_ERROR "Control byte in submodule path record")
            endif()
            string(ASCII ${_value} _character)
            if(_in_value)
                string(APPEND _path "${_character}")
                string(LENGTH "${_path}" _path_length)
                if(_path_length GREATER_EQUAL 2048)
                    message(FATAL_ERROR "Submodule path exceeds the portable path bound")
                endif()
            else()
                string(APPEND _key "${_character}")
            endif()
        endif()
    endforeach()
    if(_in_value OR NOT _key STREQUAL "" OR NOT _path STREQUAL "")
        message(FATAL_ERROR "Incomplete submodule path record")
    endif()
    list(SORT _paths)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_registry}")
    endif()
    set(${output} "${_paths}" PARENT_SCOPE)
endfunction()

# Resolve metadata beneath its module root, including Windows junctions.
# This is source-tree containment, not a sandbox for trusted CMake programs.
function(umicom_application_module_containment root relative)
    file(REAL_PATH "${root}" _root)
    file(REAL_PATH "${root}/${relative}" _module)
    cmake_path(IS_PREFIX _root "${_module}" NORMALIZE _inside)
    if(NOT _inside OR _module STREQUAL _root)
        message(FATAL_ERROR "Application module escapes the suite: ${relative}")
    endif()
    foreach(_leaf CMakeLists.txt application.umicom.yaml)
        if(NOT EXISTS "${_module}/${_leaf}" OR IS_DIRECTORY "${_module}/${_leaf}")
            message(FATAL_ERROR "Application module lacks ${_leaf}: ${relative}")
        endif()
        file(REAL_PATH "${_module}/${_leaf}" _file)
        cmake_path(IS_PREFIX _module "${_file}" NORMALIZE _inside)
        if(NOT _inside)
            message(FATAL_ERROR "Application metadata escapes its module: ${relative}/${_leaf}")
        endif()
    endforeach()
endfunction()

# Consumers use their existing add-subdirectory helper after validation.
# Disabled applications still participate in identity collision checks.
function(umicom_discover_application_modules)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "ALL" "ROOT;PREFIX"
        "EXCLUDE_PATHS;RESERVED_OPTIONS;RESERVED_COMPONENTS")
    if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_ROOT OR NOT ARG_PREFIX)
        message(FATAL_ERROR "Discovery requires ROOT and PREFIX")
    endif()
    umicom_registered_application_paths("${ARG_ROOT}" _paths)
    set(_available "")
    set(_missing "")
    set(_ids "")
    set(_executables "")
    set(_options "${ARG_RESERVED_OPTIONS}")
    set(_components "${ARG_RESERVED_COMPONENTS}")
    list(TRANSFORM _components TOLOWER)
    foreach(_path IN LISTS _paths)
        # Core modules are validated for collisions as well, but keep their
        # established orchestration and option spellings in the parent suite.
        if(NOT EXISTS "${ARG_ROOT}/${_path}/CMakeLists.txt")
            list(APPEND _missing "${_path}")
            continue()
        endif()
        umicom_application_module_containment("${ARG_ROOT}" "${_path}")
        umicom_application_module_descriptor(
            "${ARG_ROOT}/${_path}/application.umicom.yaml" _entry)
        string(TOLOWER "${_entry_id}" _id)
        string(TOLOWER "${_entry_component}" _component_key)
        if(_id IN_LIST _ids)
            message(FATAL_ERROR "Application identity collision: ${_path}")
        endif()
        list(APPEND _ids "${_id}")
        # The legacy executable may equal one explicit frontend in this module.
        set(_local_names "${_entry_executable};${_entry_native_executable};${_entry_console_executable}")
        list(TRANSFORM _local_names TOLOWER)
        list(REMOVE_DUPLICATES _local_names)
        foreach(_name IN LISTS _local_names)
            if(NOT _name STREQUAL "")
                if(_name IN_LIST _executables)
                    message(FATAL_ERROR "Application executable collision: ${_name}")
                endif()
                list(APPEND _executables "${_name}")
            endif()
        endforeach()
        if(_path IN_LIST ARG_EXCLUDE_PATHS)
            continue()
        endif()
        if(_entry_option IN_LIST _options OR _component_key IN_LIST _components)
            message(FATAL_ERROR "Application option or installer component collision: ${_path}")
        endif()
        list(APPEND _options "${_entry_option}")
        list(APPEND _components "${_component_key}")
        list(APPEND _available "${_path}")
        string(SHA256 _key "${_path}")
        foreach(_field id name executable native_executable console_executable component option)
            set(${ARG_PREFIX}_${_key}_${_field} "${_entry_${_field}}" PARENT_SCOPE)
        endforeach()
        option(${_entry_option} "Build ${_entry_name}" OFF)
        if(ARG_ALL)
            set(${_entry_option} ON CACHE BOOL "Build ${_entry_name}" FORCE)
        endif()
    endforeach()
    if(_missing AND ARG_ALL)
        message(FATAL_ERROR "Initialise these application submodules before building all modules: ${_missing}")
    endif()
    foreach(_path IN LISTS _missing)
        message(STATUS "Application not initialised; no manifest loaded: ${_path}")
    endforeach()
    set(${ARG_PREFIX}_PATHS "${_available}" PARENT_SCOPE)
    set(${ARG_PREFIX}_MISSING "${_missing}" PARENT_SCOPE)
endfunction()

# Keep module tests and install() rules in their existing source directory.
# Setting the inherited default component avoids rebuilding installer target
# lists in every application repository or generated project.
function(umicom_add_application_module option_name relative_path display_name component)
    if(NOT DEFINED ${option_name})
        message(FATAL_ERROR "Application build option is not declared: ${option_name}")
    endif()
    if(NOT ${option_name})
        message(STATUS "Disabled application module: ${display_name}")
        return()
    endif()
    if(NOT component MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$")
        message(FATAL_ERROR "Invalid application installer component: ${component}")
    endif()
    umicom_application_module_containment("${CMAKE_CURRENT_SOURCE_DIR}" "${relative_path}")
    get_property(_registered GLOBAL PROPERTY UMICOM_SUITE_APPLICATION_DIRECTORIES)
    if(relative_path IN_LIST _registered)
        message(FATAL_ERROR "Application module already registered: ${relative_path}")
    endif()
    get_property(_components GLOBAL PROPERTY UMICOM_SUITE_COMPONENT_IDS)
    string(TOLOWER "${component}" _component_key)
    list(TRANSFORM _components TOLOWER)
    if(_component_key IN_LIST _components)
        message(FATAL_ERROR "Installer component already registered: ${component}")
    endif()
    set(CMAKE_INSTALL_DEFAULT_COMPONENT_NAME "${component}")
    add_subdirectory("${relative_path}")
    set_property(GLOBAL APPEND PROPERTY UMICOM_SUITE_APPLICATION_DIRECTORIES "${relative_path}")
    set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${relative_path}"
        PROPERTY UMICOM_APPLICATION_INSTALL_COMPONENT "${component}")
    set_property(GLOBAL APPEND PROPERTY UMICOM_SUITE_COMPONENT_IDS "${component}")
    set_property(GLOBAL APPEND PROPERTY UMICOM_SUITE_COMPONENT_NAMES "${display_name}")
    message(STATUS "Enabled application module: ${display_name}")
endfunction()
