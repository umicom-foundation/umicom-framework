# Umicom Framework
# File: cmake/UmicomDocumentIndentation.cmake
# PURPOSE: Export per-document indentation policy and register owner-run regressions.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_indent_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
install(FILES "${_indent_root}/include/umicom/document/indentation_override.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/document" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_document include/umicom/document/indentation_override.h)
endif()
if(TARGET umicom_ui_gtk4)
    target_sources(umicom_ui_gtk4 PRIVATE "${_indent_root}/adapters/gtk4/document_indentation_review_gtk4.c")
    install(FILES "${_indent_root}/include/umicom/ui/gtk4/document_indentation.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 include/umicom/ui/gtk4/document_indentation.h)
    endif()
endif()
install(FILES "${_indent_root}/docs/guides/document-indentation.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_indent_review_cases inherit override clear same-as-default default-change default-aba override-aba noop-default noop-override noop-clear stale-noop other-document closed foreign-owner foreign-view tampered-values invalid-width invalid-boolean arguments failed-output alias readonly text-does-not-stale history-unchanged close-reopen)
    set(_indent_edit_cases tab-spaces tab-literal selection outdent mixed-outdent explicit-token inactive clear-inherits default-change pending-draft readonly foreign-view undo-redo)
    set(_indent_busy_cases set-during-write clear-during-write same-during-write defaults-during-write inspect-during-write)
    set(_indent_projection_cases override inherit two-documents tab selection retire default-observer other-document-observer close-observer rebind-observer arguments)
    set(_indent_native_cases entry apply inherit invalid stale-default stale-override inactive closed-document readonly retired rebound busy cancel repeat completion-retire message-retire arguments)
    foreach(_indent_group IN ITEMS review edit busy projection native)
        set(_indent_owner document)
        set(_indent_source tests/document/test_indentation_override.c)
        if(_indent_group STREQUAL "edit")
            set(_indent_source tests/document/test_indentation_override_edit.c)
        elseif(_indent_group STREQUAL "busy")
            set(_indent_source tests/document/test_indentation_override_busy.c)
        elseif(_indent_group STREQUAL "projection")
            set(_indent_owner ui_gtk4)
            set(_indent_source tests/document/test_indentation_projection_gtk4.c)
        elseif(_indent_group STREQUAL "native")
            set(_indent_owner ui_gtk4)
            set(_indent_source tests/document/test_indentation_review_gtk4.c)
        endif()
        if(NOT TARGET umicom_${_indent_owner})
            continue()
        endif()
        set(_indent_target "umicom-document-indentation-${_indent_group}-test")
        add_executable(${_indent_target} "${_indent_root}/${_indent_source}")
        target_link_libraries(${_indent_target} PRIVATE Umicom::${_indent_owner})
        set_target_properties(${_indent_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_indent_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_indent_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_indent_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_indent_target} FILES
                "${_indent_root}/tests/document/replacement_fixture.h"
                "${_indent_root}/tests/document/native_edit_fixture.h"
                "${_indent_root}/src/document/indentation_override.inc"
                "${_indent_root}/src/document/indentation.inc"
                "${_indent_root}/adapters/gtk4/editor_indentation.inc")
        endif()
        foreach(_indent_case IN LISTS _indent_${_indent_group}_cases)
            set(_indent_test "framework.document.indentation.${_indent_group}.${_indent_case}")
            file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/document-indentation/${_indent_group}/${_indent_case}")
            add_test(NAME ${_indent_test} COMMAND ${_indent_target} ${_indent_case})
            set_tests_properties(${_indent_test} PROPERTIES TIMEOUT 60
                WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/document-indentation/${_indent_group}/${_indent_case}"
                LABELS "framework;document;editor;indentation;regression")
            if(_indent_owner STREQUAL "ui_gtk4")
                set_tests_properties(${_indent_test} PROPERTIES SKIP_RETURN_CODE 77
                    ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;document;editor;indentation;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_indent_test} TARGETS ${_indent_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_indent_root)
unset(_indent_group)
unset(_indent_owner)
unset(_indent_source)
unset(_indent_target)
unset(_indent_test)
unset(_indent_case)
unset(_indent_review_cases)
unset(_indent_edit_cases)
unset(_indent_busy_cases)
unset(_indent_projection_cases)
unset(_indent_native_cases)
