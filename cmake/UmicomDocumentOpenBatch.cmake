# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# A captured opening plan extends the existing document owner without new I/O.
if(NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_open_batch_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_document PRIVATE "${_open_batch_root}/src/document/open_batch.c")
install(FILES "${_open_batch_root}/include/umicom/document/open_batch.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/document" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_document include/umicom/document/open_batch.h)
endif()
install(FILES "${_open_batch_root}/docs/guides/opening-several-documents.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_open_batch_capture_cases arguments limit owned initial inspect null-member empty-member relative long-member)
    set(_open_batch_progress_cases all missing denied broken binary huge all-failed duplicate equivalent dirty
        cancel-before cancel-after reentry other-owner)
    foreach(_open_batch_group IN ITEMS capture progress)
        set(_open_batch_target "umicom-document-open-batch-${_open_batch_group}-test")
        add_executable(${_open_batch_target} "${_open_batch_root}/tests/document/test_open_batch_${_open_batch_group}.c")
        target_link_libraries(${_open_batch_target} PRIVATE Umicom::document)
        set_target_properties(${_open_batch_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_open_batch_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_open_batch_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_open_batch_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_open_batch_target} FILES
                "${_open_batch_root}/tests/document/open_batch_fixture.h")
        endif()
        foreach(_open_batch_case IN LISTS _open_batch_${_open_batch_group}_cases)
            set(_open_batch_test "framework.document.open_batch.${_open_batch_group}.${_open_batch_case}")
            add_test(NAME ${_open_batch_test} COMMAND ${_open_batch_target} ${_open_batch_case})
            set_tests_properties(${_open_batch_test} PROPERTIES TIMEOUT 30
                LABELS "framework;document;opening;ownership;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_open_batch_test} TARGETS ${_open_batch_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_open_batch_root)
unset(_open_batch_target)
unset(_open_batch_group)
unset(_open_batch_test)
unset(_open_batch_case)
unset(_open_batch_capture_cases)
unset(_open_batch_progress_cases)
