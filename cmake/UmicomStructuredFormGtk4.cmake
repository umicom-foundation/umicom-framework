# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Optional native composition uses the same portable application validator.
if(NOT TARGET Umicom::ui_gtk4 OR NOT TARGET Umicom::application)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_structured_form_gtk_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_structured_form_gtk4 STATIC "${_structured_form_gtk_root}/adapters/gtk4/structured_form_gtk4.c")
target_sources(umicom_structured_form_gtk4 PRIVATE "${_structured_form_gtk_root}/adapters/gtk4/structured_form_value.c")
add_library(Umicom::structured_form_gtk4 ALIAS umicom_structured_form_gtk4)
set_target_properties(umicom_structured_form_gtk4 PROPERTIES EXPORT_NAME structured_form_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_structured_form_gtk4 PUBLIC Umicom::application Umicom::ui_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_structured_form_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_structured_form_gtk4)
endif()
install(TARGETS umicom_structured_form_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_structured_form_gtk4)
install(FILES "${_structured_form_gtk_root}/include/umicom/ui/gtk4/structured_form.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_structured_form_gtk4 include/umicom/ui/gtk4/structured_form.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-gtk-test "${_structured_form_gtk_root}/tests/application_experience/test_structured_form_gtk4.c")
    target_link_libraries(umicom-form-gtk-test PRIVATE Umicom::structured_form_gtk4)
    add_executable(umicom-structured-form-native-example "${_structured_form_gtk_root}/examples/structured_forms/native.c")
    target_link_libraries(umicom-structured-form-native-example PRIVATE Umicom::structured_form_gtk4)
    foreach(_structured_form_gtk_target IN ITEMS umicom-form-gtk-test umicom-structured-form-native-example)
        set_target_properties(${_structured_form_gtk_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_structured_form_gtk_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_structured_form_gtk_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_structured_form_gtk_target})
        endif()
    endforeach()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-gtk-test FILES
            "${_structured_form_gtk_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_structured_form_gtk_case IN ITEMS apply submit missing invalid-second numeric later-edit notification-retire retired unroot utf8)
        add_test(NAME framework.structured_forms.gtk.${_structured_form_gtk_case}
            COMMAND umicom-form-gtk-test ${_structured_form_gtk_case})
        set_tests_properties(framework.structured_forms.gtk.${_structured_form_gtk_case} PROPERTIES
            TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings"
            LABELS "framework;forms;gtk4;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.gtk.${_structured_form_gtk_case} TARGETS umicom-form-gtk-test)
        endif()
    endforeach()
    add_executable(umicom-form-controls-test "${_structured_form_gtk_root}/tests/application_experience/test_structured_form_controls.c")
    target_link_libraries(umicom-form-controls-test PRIVATE Umicom::structured_form_gtk4)
    set_target_properties(umicom-form-controls-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-controls-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-controls-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-controls-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-controls-test FILES
            "${_structured_form_gtk_root}/tests/application_experience/structured_form_fixture.h"
            "${_structured_form_gtk_root}/adapters/gtk4/structured_form_value.h")
    endif()
    foreach(_structured_form_control_case IN ITEMS multiline boolean boolean-true boolean-false choice choice-initial choice-clear choice-label choice-utf8 capacity retired-buffer)
        add_test(NAME framework.structured_forms.gtk.controls.${_structured_form_control_case}
            COMMAND umicom-form-controls-test ${_structured_form_control_case})
        set_tests_properties(framework.structured_forms.gtk.controls.${_structured_form_control_case} PROPERTIES
            TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;forms;gtk4;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.gtk.controls.${_structured_form_control_case} TARGETS umicom-form-controls-test)
        endif()
    endforeach()
    unset(_structured_form_control_case)
endif()
unset(_structured_form_gtk_root)
unset(_structured_form_gtk_target)
unset(_structured_form_gtk_case)
