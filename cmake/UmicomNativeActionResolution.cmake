include_guard(GLOBAL)
if(BUILD_TESTING)
    add_executable(umicom-native-action-resolution-test "${CMAKE_CURRENT_LIST_DIR}/../tests/language_runtime/test_native_action_resolution.c")
    target_link_libraries(umicom-native-action-resolution-test PRIVATE Umicom::developer Umicom::editor Umicom::platform)
    umicom_apply_warnings(umicom-native-action-resolution-test)
    umicom_apply_sanitizers(umicom-native-action-resolution-test)
    if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_link_options(umicom-native-action-resolution-test PRIVATE -municode)
    endif()
    add_dependencies(umicom-native-action-resolution-test umicom-language-process-fixture)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-native-action-resolution-test)
    endif()
    foreach(case valid all unicode outside stale unknown query-error shutdown-error disabled command empty-context diagnostic-error unchanged related-report choices complete no-data error missing-edit malformed changed-title added-command timeout)
        add_test(NAME framework.language_runtime.native_action_resolution.${case} COMMAND umicom-native-action-resolution-test ${case} "$<TARGET_FILE:umicom-language-process-fixture>")
        set_tests_properties(framework.language_runtime.native_action_resolution.${case} PROPERTIES TIMEOUT 40
            LABELS "framework;language;rename;native;ownership;regression")
    endforeach()
endif()
