# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# The native controller composes shared transfer, file selection and review.
if(NOT TARGET Umicom::form_bundle_review_gtk4 OR NOT TARGET Umicom::record_bundle_files)
    return()
endif()
if(NOT TARGET Umicom::record_transfer_receipt_gtk4)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_form_import_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_form_record_import_gtk4 STATIC "${_form_import_root}/adapters/gtk4/form_record_import_gtk4.c")
add_library(Umicom::form_record_import_gtk4 ALIAS umicom_form_record_import_gtk4)
set_target_properties(umicom_form_record_import_gtk4 PROPERTIES EXPORT_NAME form_record_import_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_form_record_import_gtk4 PUBLIC Umicom::form_bundle_review_gtk4 Umicom::record_bundle_files)
target_link_libraries(umicom_form_record_import_gtk4 PUBLIC Umicom::record_transfer_receipt_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_form_record_import_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_form_record_import_gtk4)
endif()
install(TARGETS umicom_form_record_import_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_form_record_import_gtk4)
install(FILES "${_form_import_root}/include/umicom/ui/gtk4/form_record_import.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_record_import_gtk4 include/umicom/ui/gtk4/form_record_import.h)
endif()
if(BUILD_TESTING AND SQLite3_FOUND)
    add_executable(umicom-form-record-import-gtk4-test "${_form_import_root}/tests/data_history/test_form_record_import_gtk4.c")
    target_link_libraries(umicom-form-record-import-gtk4-test PRIVATE Umicom::form_record_import_gtk4)
    set_target_properties(umicom-form-record-import-gtk4-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-record-import-gtk4-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-record-import-gtk4-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-record-import-gtk4-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-record-import-gtk4-test FILES
            "${_form_import_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_import_case IN ITEMS receipt-buttons receipt-explicit receipt-source receipt-empty receipt-invalid receipt-collision receipt-retire receipt-later-edit receipt-mutate-authorize receipt-visible-authorize receipt-denied receipt-time receipt-null receipt-read-invalidated receipt-utf8 review restore buttons unconfirmed denied retire-authorize edit-authorize withdraw-authorize
        reenter-authorize completion-reentry changed-read retire-read dispose-read retire-write edit-write collision bad-file wrong-namespace
        relative null-authorizer double-admission read-no-write)
        set(_form_import_test framework.structured_forms.import.gtk.${_form_import_case})
        add_test(NAME ${_form_import_test} COMMAND umicom-form-record-import-gtk4-test ${_form_import_case}
            "${CMAKE_CURRENT_BINARY_DIR}/form-import-fixtures")
        set_tests_properties(${_form_import_test} PROPERTIES TIMEOUT 45 SKIP_RETURN_CODE 77
            ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;forms;gtk4;data;sqlite;record-bundle;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${_form_import_test} TARGETS umicom-form-record-import-gtk4-test)
        endif()
    endforeach()
endif()
foreach(_form_import_doc_component IN ITEMS Framework FrameworkSDK)
    set(_form_import_doc_exclude "")
    if(_form_import_doc_component STREQUAL "FrameworkSDK")
        set(_form_import_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_import_root}/docs/guides/native-form-record-import.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_import_doc_component} ${_form_import_doc_exclude})
endforeach()
unset(_form_import_root)
unset(_form_import_case)
unset(_form_import_test)
unset(_form_import_doc_component)
unset(_form_import_doc_exclude)
