        umicom_apply_sanitizers(${target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${target})
        endif()
    endforeach()
    foreach(case buckets tie full half flat zero empty unordered negative overflow range-overflow collapsed-edge nan-price nan-volume negative-volume small large fraction-zero fraction-large fraction-nan capacity)
