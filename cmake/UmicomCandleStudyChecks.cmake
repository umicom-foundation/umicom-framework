# Numeric expectations and real scene composition are distinct regressions.
include_guard(GLOBAL)
if(BUILD_TESTING)
    add_executable(umicom-candle-study-test "${CMAKE_CURRENT_LIST_DIR}/../tests/chart/test_candle_study.c")
    target_link_libraries(umicom-candle-study-test PRIVATE Umicom::chart)
    add_executable(umicom-candle-study-scene-test "${CMAKE_CURRENT_LIST_DIR}/../tests/chart/test_candle_study_scene.c")
    target_link_libraries(umicom-candle-study-scene-test PRIVATE Umicom::trading_ui)
    foreach(target umicom-candle-study-test umicom-candle-study-scene-test)
        umicom_apply_warnings(${target})
        umicom_apply_sanitizers(${target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${target})
        endif()
    endforeach()
    foreach(case weighted bollinger donchian zero-window large-volume large-price negative-price zero-price constant overflow duplicate-time unsorted nan negative-volume invalid-ohlc period-small period-large kind short empty capacity)
        add_test(NAME framework.chart.candle_study.${case} COMMAND umicom-candle-study-test ${case})
        set_tests_properties(framework.chart.candle_study.${case} PROPERTIES TIMEOUT 20 LABELS "framework;chart;regression")
    endforeach()
    foreach(case weighted bollinger donchian short timeframe)
        add_test(NAME framework.chart.candle_study.scene.${case} COMMAND umicom-candle-study-scene-test ${case})
        set_tests_properties(framework.chart.candle_study.scene.${case} PROPERTIES TIMEOUT 20 LABELS "framework;chart;trading;regression")
    endforeach()
endif()

