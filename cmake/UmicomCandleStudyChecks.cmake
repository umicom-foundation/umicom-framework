        set_tests_properties(framework.chart.volume_profile.${case} PROPERTIES TIMEOUT 20 LABELS "framework;chart;volume;regression")
    endforeach()
    foreach(case scene timeframe adapter invalid-time)
        add_test(NAME framework.chart.volume_profile.scene.${case} COMMAND umicom-volume-profile-scene-test ${case})
        set_tests_properties(framework.chart.volume_profile.scene.${case} PROPERTIES TIMEOUT 20 LABELS "framework;chart;trading;regression")
    endforeach()
endif()
install(FILES "${CMAKE_CURRENT_LIST_DIR}/../docs/learning/candle-studies.html"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/umicom/learning COMPONENT Learning)

if(BUILD_TESTING AND TARGET umicom_ui_gtk4)
    add_executable(umicom-study-selector-gtk-test "${CMAKE_CURRENT_LIST_DIR}/../tests/chart/test_study_selector_gtk4.c")
    target_link_libraries(umicom-study-selector-gtk-test PRIVATE Umicom::ui_gtk4)
    umicom_apply_warnings(umicom-study-selector-gtk-test)
    umicom_apply_sanitizers(umicom-study-selector-gtk-test)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-study-selector-gtk-test)
    endif()
    foreach(case weighted bollinger donchian profile retained detached)
        add_test(NAME framework.chart.study_selector.gtk.${case} COMMAND umicom-study-selector-gtk-test ${case})
        set_tests_properties(framework.chart.study_selector.gtk.${case} PROPERTIES TIMEOUT 20 SKIP_RETURN_CODE 77 LABELS "framework;chart;gtk4;ownership;regression")
