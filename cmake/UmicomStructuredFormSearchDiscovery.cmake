# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Shared discovery resolves immutable historical schemas before filtering rows.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_search_discovery_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE
    "${_search_discovery_root}/src/application/experience/structured_form_search_resolver.c")
install(FILES "${_search_discovery_root}/include/umicom/application/experience/structured_form_search_resolver.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_search_resolver.h)
endif()
if(TARGET umicom_form_records)
    target_sources(umicom_form_records PRIVATE
        "${_search_discovery_root}/src/data/structured_form_search_reader.c"
        "${_search_discovery_root}/src/data/structured_form_search_catalogue.c")
    foreach(_search_discovery_header IN ITEMS structured_form_search_reader structured_form_search_catalogue)
        install(FILES "${_search_discovery_root}/include/umicom/data/${_search_discovery_header}.h"
            DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
        if(COMMAND umicom_release_inventory_own_headers)
            umicom_release_inventory_own_headers(umicom_form_records "include/umicom/data/${_search_discovery_header}.h")
        endif()
    endforeach()
endif()
foreach(_search_discovery_component IN ITEMS Framework FrameworkSDK)
    set(_search_discovery_exclude "")
    if(_search_discovery_component STREQUAL "FrameworkSDK")
        set(_search_discovery_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_search_discovery_root}/docs/guides/discover-saved-searches.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_search_discovery_component} ${_search_discovery_exclude})
endforeach()
if(BUILD_TESTING)
    set(_search_discovery_resolver_cases roundtrip old-version unknown-version unknown-form empty-catalogue outer-magic inner-magic truncation trailing oversized title-nul title-empty prefix-invalid filter-length identity-length identity-nul zero-version term-count unit-change operand-invalid alias null)
    set(_search_discovery_reader_cases decode latest historical reviewed reviewed-stale reviewed-metadata missing namespace unknown-schema malformed metadata-only digest metadata length entity alias nested-load nested-reviewed null)
    set(_search_discovery_catalogue_cases empty all pages title key case-sensitive namespace version foreign-form unknown-version malformed excluded-damage metadata-only limit-zero limit-large bad-snapshot cursor-without-snapshot unclosed-query bad-prefix unregistered-query nested changed-title changed-scope changed-version changed-head new-head cursor-missing cursor-filtered last-cursor reviewed reviewed-stale capacity alias null)
    foreach(_search_discovery_group IN ITEMS resolver reader catalogue)
        set(_search_discovery_backends memory)
        if(_search_discovery_group STREQUAL "resolver")
            set(_search_discovery_source tests/application_experience/test_structured_form_search_resolver.c)
            set(_search_discovery_library Umicom::application)
        elseif(TARGET Umicom::form_records)
            set(_search_discovery_source "tests/data_history/test_structured_form_search_${_search_discovery_group}.c")
            set(_search_discovery_library Umicom::form_records)
            get_target_property(_search_discovery_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
            if("UMICOM_HAS_SQLITE=1" IN_LIST _search_discovery_definitions)
                list(APPEND _search_discovery_backends sqlite)
            endif()
        else()
            continue()
        endif()
        set(_search_discovery_target "umicom-search-${_search_discovery_group}-test")
        add_executable(${_search_discovery_target} "${_search_discovery_root}/${_search_discovery_source}")
        target_link_libraries(${_search_discovery_target} PRIVATE ${_search_discovery_library})
        set_target_properties(${_search_discovery_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_search_discovery_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_search_discovery_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_search_discovery_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_search_discovery_target} FILES
                "${_search_discovery_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_search_discovery_backend IN LISTS _search_discovery_backends)
            set(_search_discovery_args "")
            if(_search_discovery_backend STREQUAL "sqlite")
                set(_search_discovery_args sqlite)
            endif()
            foreach(_search_discovery_case IN LISTS _search_discovery_${_search_discovery_group}_cases)
                set(_search_discovery_test "framework.structured_forms.discovery.${_search_discovery_group}.${_search_discovery_backend}.${_search_discovery_case}")
                add_test(NAME ${_search_discovery_test} COMMAND ${_search_discovery_target} ${_search_discovery_case} ${_search_discovery_args})
                set_tests_properties(${_search_discovery_test} PROPERTIES TIMEOUT 45 LABELS "framework;forms;search-discovery;${_search_discovery_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_search_discovery_test} TARGETS ${_search_discovery_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(TARGET Umicom::form_records)
        add_executable(umicom-search-discovery-example "${_search_discovery_root}/examples/data_history/form_search_discovery.c")
        target_link_libraries(umicom-search-discovery-example PRIVATE Umicom::form_records)
        set_target_properties(umicom-search-discovery-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(umicom-search-discovery-example)
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(umicom-search-discovery-example)
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(umicom-search-discovery-example)
        endif()
        add_test(NAME framework.structured_forms.discovery.example COMMAND umicom-search-discovery-example)
        set_tests_properties(framework.structured_forms.discovery.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;search-discovery;example")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.discovery.example TARGETS umicom-search-discovery-example)
        endif()
    endif()
endif()
unset(_search_discovery_root)
unset(_search_discovery_header)
unset(_search_discovery_component)
unset(_search_discovery_exclude)
unset(_search_discovery_group)
unset(_search_discovery_backends)
unset(_search_discovery_source)
unset(_search_discovery_library)
unset(_search_discovery_definitions)
unset(_search_discovery_target)
unset(_search_discovery_backend)
unset(_search_discovery_args)
unset(_search_discovery_case)
unset(_search_discovery_test)
unset(_search_discovery_resolver_cases)
unset(_search_discovery_reader_cases)
unset(_search_discovery_catalogue_cases)
