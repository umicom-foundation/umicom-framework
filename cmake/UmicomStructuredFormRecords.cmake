# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# The persistence adapter joins application values and data transactions without
# making either foundational library depend on the other.
if(NOT TARGET Umicom::application OR NOT TARGET Umicom::data)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_form_records_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_form_records STATIC "${_form_records_root}/src/data/structured_form_record.c")
add_library(Umicom::form_records ALIAS umicom_form_records)
set_target_properties(umicom_form_records PROPERTIES EXPORT_NAME form_records
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_form_records PUBLIC Umicom::application Umicom::data)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_form_records)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_form_records)
endif()
install(TARGETS umicom_form_records EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_form_records)
install(FILES "${_form_records_root}/include/umicom/data/structured_form_record.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_record.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-record-test "${_form_records_root}/tests/data_history/test_structured_form_record.c")
    target_link_libraries(umicom-form-record-test PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-record-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-record-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-record-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-record-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-record-test FILES
            "${_form_records_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_records_case IN ITEMS roundtrip history stale-open stale-save wrong-schema invalid-answer foreign-payload nested oversize)
        add_test(NAME framework.structured_forms.record.${_form_records_case} COMMAND umicom-form-record-test ${_form_records_case})
        set_tests_properties(framework.structured_forms.record.${_form_records_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;forms;data;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.record.${_form_records_case} TARGETS umicom-form-record-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME framework.structured_forms.record.sqlite.${_form_records_case}
                COMMAND umicom-form-record-test ${_form_records_case} sqlite)
            set_tests_properties(framework.structured_forms.record.sqlite.${_form_records_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;forms;data;sqlite;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.record.sqlite.${_form_records_case} TARGETS umicom-form-record-test)
            endif()
        endif()
    endforeach()
endif()
unset(_form_records_root)
unset(_form_records_case)
