# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# The same bounded history query serves native and headless product hosts.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
get_filename_component(_history_page_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_history_page.h)
endif()
foreach(_history_page_component IN ITEMS Framework FrameworkSDK)
    if(_history_page_component STREQUAL "FrameworkSDK")
        set(_history_page_exclude EXCLUDE_FROM_ALL)
    else()
        set(_history_page_exclude "")
    endif()
    install(FILES "${_history_page_root}/docs/guides/record-history-pages.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_history_page_component} ${_history_page_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-record-history-page-test "${_history_page_root}/tests/data_history/test_record_history_page.c")
    target_link_libraries(umicom-record-history-page-test PRIVATE Umicom::data)
    set_target_properties(umicom-record-history-page-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-record-history-page-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-record-history-page-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-record-history-page-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-history-page-test FILES
            "${_history_page_root}/src/data/include/record_history_internal.h")
    endif()
    add_executable(umicom-record-history-page-example "${_history_page_root}/examples/data_history/record_history_pages.c")
    target_link_libraries(umicom-record-history-page-example PRIVATE Umicom::data)
    set_target_properties(umicom-record-history-page-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-record-history-page-example)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-record-history-page-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-record-history-page-example)
    endif()
    add_test(NAME framework.data.history.page.example COMMAND umicom-record-history-page-example)
    set_tests_properties(framework.data.history.page.example PROPERTIES TIMEOUT 30 LABELS "framework;data;history;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.history.page.example TARGETS umicom-record-history-page-example)
    endif()
    set(_history_page_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _history_page_backends sqlite)
    endif()
    foreach(_history_page_backend IN LISTS _history_page_backends)
        foreach(_history_page_case IN ITEMS empty pages invalid changed-head nested missing-row time-boundary)
            add_test(NAME framework.data.history.page.${_history_page_backend}.${_history_page_case}
                COMMAND umicom-record-history-page-test ${_history_page_backend} ${_history_page_case})
            set_tests_properties(framework.data.history.page.${_history_page_backend}.${_history_page_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;history;pagination;${_history_page_backend};regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.history.page.${_history_page_backend}.${_history_page_case}
                    TARGETS umicom-record-history-page-test)
            endif()
        endforeach()
    endforeach()
endif()
unset(_history_page_root)
unset(_history_page_component)
unset(_history_page_exclude)
unset(_history_page_backends)
unset(_history_page_backend)
unset(_history_page_case)
