# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Native maintenance delegates all storage rules to the shared Data Server.
if(NOT TARGET Umicom::data OR NOT TARGET Umicom::ui_gtk4 OR NOT TARGET Umicom::platform)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_maintenance_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_database_maintenance_gtk4 STATIC "${_maintenance_root}/adapters/gtk4/database_maintenance_gtk4.c")
add_library(Umicom::database_maintenance_gtk4 ALIAS umicom_database_maintenance_gtk4)
set_target_properties(umicom_database_maintenance_gtk4 PROPERTIES EXPORT_NAME database_maintenance_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_database_maintenance_gtk4 PUBLIC Umicom::data Umicom::ui_gtk4 Umicom::platform)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_database_maintenance_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_database_maintenance_gtk4)
endif()
install(TARGETS umicom_database_maintenance_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_database_maintenance_gtk4)
install(FILES "${_maintenance_root}/include/umicom/ui/gtk4/database_maintenance.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_database_maintenance_gtk4 include/umicom/ui/gtk4/database_maintenance.h)
endif()
foreach(_maintenance_component IN ITEMS Framework FrameworkSDK)
    set(_maintenance_exclude "")
    if(_maintenance_component STREQUAL "FrameworkSDK")
        set(_maintenance_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_maintenance_root}/docs/guides/native-database-maintenance.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_maintenance_component} ${_maintenance_exclude})
endforeach()
get_target_property(_maintenance_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
if(BUILD_TESTING AND "UMICOM_HAS_SQLITE=1" IN_LIST _maintenance_definitions)
    add_executable(umicom-database-maintenance-gtk-test "${_maintenance_root}/tests/data_history/test_database_maintenance_gtk4.c")
    target_link_libraries(umicom-database-maintenance-gtk-test PRIVATE Umicom::database_maintenance_gtk4)
    set_target_properties(umicom-database-maintenance-gtk-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-database-maintenance-gtk-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-database-maintenance-gtk-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-database-maintenance-gtk-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-database-maintenance-gtk-test FILES "${_maintenance_root}/tests/data_history/readonly_fixture.h")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/database-maintenance-fixtures")
    foreach(_maintenance_case IN ITEMS check check-unhealthy backup recover button-check button-backup button-recover
            denied missing relative-source relative-destination invalid-operation null-authorizer busy captured-source captured-destination
            edit-authorize retire-authorize reenter-authorize changed-check retired-check changed-copy retired-copy disposed-copy
            occupied no-destination-check prior-result completion-reentry changed-after-check changed-after-copy)
        add_test(NAME framework.data.maintenance.gtk.${_maintenance_case}
            COMMAND umicom-database-maintenance-gtk-test ${_maintenance_case} "${CMAKE_CURRENT_BINARY_DIR}/database-maintenance-fixtures")
        set_tests_properties(framework.data.maintenance.gtk.${_maintenance_case} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77
            ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;data;sqlite;backup;recovery;gtk4;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.maintenance.gtk.${_maintenance_case} TARGETS umicom-database-maintenance-gtk-test)
        endif()
    endforeach()
endif()
unset(_maintenance_root)
unset(_maintenance_component)
unset(_maintenance_exclude)
unset(_maintenance_definitions)
unset(_maintenance_case)
