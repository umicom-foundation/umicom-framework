# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Synthetic form semantics remain reusable by native and browser clients.
if(NOT TARGET Umicom::application)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_healthcare_forms_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_healthcare_forms STATIC "${_healthcare_forms_root}/src/healthcare/synthetic_profile.c")
add_library(Umicom::healthcare_forms ALIAS umicom_healthcare_forms)
set_target_properties(umicom_healthcare_forms PROPERTIES EXPORT_NAME healthcare_forms
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_healthcare_forms PUBLIC Umicom::application)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_healthcare_forms)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_healthcare_forms)
endif()
install(TARGETS umicom_healthcare_forms EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_healthcare_forms)
install(FILES "${_healthcare_forms_root}/include/umicom/healthcare/synthetic_profile.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/healthcare" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_healthcare_forms include/umicom/healthcare/synthetic_profile.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-synthetic-profile-test "${_healthcare_forms_root}/tests/healthcare/test_synthetic_profile.c")
    target_link_libraries(umicom-synthetic-profile-test PRIVATE Umicom::healthcare_forms)
    set_target_properties(umicom-synthetic-profile-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-synthetic-profile-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-synthetic-profile-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-synthetic-profile-test)
    endif()
    foreach(_healthcare_profile_case IN ITEMS schema keys required date choice missing length roundtrip)
        add_test(NAME framework.healthcare.profile.${_healthcare_profile_case}
            COMMAND umicom-synthetic-profile-test ${_healthcare_profile_case})
        set_tests_properties(framework.healthcare.profile.${_healthcare_profile_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;healthcare;synthetic;forms;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.healthcare.profile.${_healthcare_profile_case} TARGETS umicom-synthetic-profile-test)
        endif()
    endforeach()
endif()
unset(_healthcare_forms_root)
unset(_healthcare_profile_case)
