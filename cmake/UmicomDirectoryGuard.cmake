# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Keep native cooperative ownership coverage with the platform/build libraries.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomImpactInventory.cmake")
if(BUILD_TESTING AND (WIN32 OR CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$"))
    add_executable(umi-file-lease-test "${CMAKE_CURRENT_LIST_DIR}/../tests/platform/test_file_lease.c")
    target_link_libraries(umi-file-lease-test PRIVATE Umicom::platform)
    foreach(_kind IN ITEMS path session)
        if(_kind STREQUAL "path")
            set(_source test_guard_path.c)
        else()
            set(_source test_session_guard.c)
        endif()
        add_executable("umi-directory-${_kind}-test" "${CMAKE_CURRENT_LIST_DIR}/../tests/build_directory/${_source}")
        target_link_libraries("umi-directory-${_kind}-test" PRIVATE Umicom::build)
    endforeach()
    foreach(_target IN ITEMS umi-file-lease-test umi-directory-path-test umi-directory-session-test)
        set_target_properties("${_target}" PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings("${_target}")
        umicom_apply_sanitizers("${_target}")
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target("${_target}")
        endif()
    endforeach()
    set(_lease_cases contents contention different invalid missing-parent directory unicode cross-process symlink)
    if(NOT WIN32)
        list(APPEND _lease_cases fifo)
    endif()
    foreach(_case IN LISTS _lease_cases)
        set(_name "framework.platform.file_lease.${_case}")
        add_test(NAME "${_name}" COMMAND umi-file-lease-test "${_case}" "$<TARGET_FILE:umi-file-lease-test>")
        set_tests_properties("${_name}" PROPERTIES TIMEOUT 30 LABELS "framework;platform;ownership;regression")
        umicom_test_impact_owners("${_name}" TARGETS umi-file-lease-test)
    endforeach()
    # An unavailable Windows symlink capability remains explicitly skipped.
    # Ordinary lease/content/process checks must still execute and pass.
    if(WIN32)
        set_tests_properties(framework.platform.file_lease.symlink PROPERTIES SKIP_RETURN_CODE 77)
    endif()
    foreach(_case IN ITEMS format invalid capacity ownership)
        set(_name "framework.build.directory_guard.path.${_case}")
        add_test(NAME "${_name}" COMMAND umi-directory-path-test "${_case}")
        set_tests_properties("${_name}" PROPERTIES TIMEOUT 30 LABELS "framework;build;ownership;regression")
        umicom_test_impact_owners("${_name}" TARGETS umi-directory-path-test)
    endforeach()
    foreach(_case IN ITEMS complete failure cancel destroy busy missing preset disabled)
        set(_name "framework.build.directory_guard.session.${_case}")
        add_test(NAME "${_name}" COMMAND umi-directory-session-test "${_case}")
        set_tests_properties("${_name}" PROPERTIES TIMEOUT 30 LABELS "framework;build;ownership;regression")
        umicom_test_impact_owners("${_name}" TARGETS umi-directory-session-test)
    endforeach()
elseif(BUILD_TESTING)
    message(STATUS "Native file lease qualification unavailable on this host; no passing result is implied")
endif()
