# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Read-only snapshots reuse portable validation without editable host state.
if(NOT TARGET Umicom::ui_gtk4 OR NOT TARGET Umicom::application)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_form_inspect_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_form_inspect_gtk4 STATIC "${_form_inspect_root}/adapters/gtk4/structured_form_inspect_gtk4.c")
add_library(Umicom::form_inspect_gtk4 ALIAS umicom_form_inspect_gtk4)
set_target_properties(umicom_form_inspect_gtk4 PROPERTIES EXPORT_NAME form_inspect_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_form_inspect_gtk4 PUBLIC Umicom::application Umicom::ui_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_form_inspect_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_form_inspect_gtk4)
endif()
install(TARGETS umicom_form_inspect_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_form_inspect_gtk4)
install(FILES "${_form_inspect_root}/include/umicom/ui/gtk4/structured_form_inspect.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_inspect_gtk4 include/umicom/ui/gtk4/structured_form_inspect.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-inspect-test "${_form_inspect_root}/tests/application_experience/test_structured_form_inspect_gtk4.c")
    target_link_libraries(umicom-form-inspect-test PRIVATE Umicom::form_inspect_gtk4)
    set_target_properties(umicom-form-inspect-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-inspect-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-inspect-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-inspect-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-inspect-test FILES
            "${_form_inspect_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_inspect_case IN ITEMS known missing unanswered owned readonly secret invalid utf8 label-utf8 markup)
        add_test(NAME framework.structured_forms.inspect.gtk.${_form_inspect_case}
            COMMAND umicom-form-inspect-test ${_form_inspect_case})
        set_tests_properties(framework.structured_forms.inspect.gtk.${_form_inspect_case} PROPERTIES
            TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings"
            LABELS "framework;forms;gtk4;inspection;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.inspect.gtk.${_form_inspect_case} TARGETS umicom-form-inspect-test)
        endif()
    endforeach()
endif()
unset(_form_inspect_root)
unset(_form_inspect_case)
