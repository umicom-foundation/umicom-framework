# Umicom Framework
# File: cmake/UmicomDocumentLanguage.cmake
# PURPOSE: Export document language policy and register headless and native editing checks.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor OR NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_language_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_language_pair IN ITEMS "document/languages.h|umicom_document" "document/language_override.h|umicom_document")
    string(REPLACE "|" ";" _language_parts "${_language_pair}")
    list(GET _language_parts 0 _language_header)
    list(GET _language_parts 1 _language_owner)
    get_filename_component(_language_directory "${_language_header}" DIRECTORY)
    install(FILES "${_language_root}/include/umicom/${_language_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_language_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_language_owner} "include/umicom/${_language_header}")
    endif()
endforeach()
install(FILES "${_language_root}/docs/guides/document-language.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(TARGET umicom_ui_gtk4)
    target_sources(umicom_ui_gtk4 PRIVATE "${_language_root}/adapters/gtk4/language_choice_gtk4.c" "${_language_root}/adapters/gtk4/document_language_gtk4.c")
    foreach(_language_header IN ITEMS language_choice document_language)
        install(FILES "${_language_root}/include/umicom/ui/gtk4/${_language_header}.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
        if(COMMAND umicom_release_inventory_own_headers)
            umicom_release_inventory_own_headers(umicom_ui_gtk4 "include/umicom/ui/gtk4/${_language_header}.h")
        endif()
    endforeach()
endif()
if(BUILD_TESTING)
    set(_language_catalogue_cases catalogue unknown bounded arguments plain c cpp asm python3 javascript typescript json jsonc xml html css markdown cmake makefile sh powershell sql yaml toml ini java c-sharp rust go kotlin swift ruby perl r lua)
    set(_language_override_cases inspect apply clear same-detected noop automatic-noop aba foreign-owner foreign-view tampered-id tampered-name tampered-effective tampered-detected tampered-override unterminated closed invalid-choice null-owner null-review null-output zero-id alias inactive)
    set(_language_history_cases pending selection readonly history undo redo comment large clean text-revision policy-after-sync)
    set(_language_choice_cases create select unknown unselected arguments existing-output wrong-widget all-choices model-lifetime retained-model)
    set(_language_native_cases entry cancel apply automatic repeat stale text-change inactive closed readonly unbind parent-close completion-retire constructor-retire arguments)
    foreach(_language_group IN ITEMS catalogue override history choice native)
        set(_language_owner document)
        set(_language_source "tests/document/test_language_override.c")
        if(_language_group STREQUAL "catalogue")
            set(_language_source "tests/document/test_language_catalogue.c")
        elseif(_language_group STREQUAL "history")
            set(_language_source "tests/document/test_language_override_history.c")
        elseif(_language_group STREQUAL "choice")
            set(_language_owner ui_gtk4)
            set(_language_source "tests/document/test_language_choice_gtk4.c")
        elseif(_language_group STREQUAL "native")
            set(_language_owner ui_gtk4)
            set(_language_source "tests/document/test_language_override_gtk4.c")
        endif()
        if(NOT TARGET umicom_${_language_owner})
            continue()
        endif()
        set(_language_target "umicom-document-language-${_language_group}-test")
        add_executable(${_language_target} "${_language_root}/${_language_source}")
        target_link_libraries(${_language_target} PRIVATE Umicom::${_language_owner})
        set_target_properties(${_language_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_language_target})
        umicom_apply_sanitizers(${_language_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_language_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_language_target} FILES
                "${_language_root}/src/document/language_override.inc"
                "${_language_root}/adapters/gtk4/document_language_gtk4.c"
                "${_language_root}/tests/document/replacement_fixture.h"
                "${_language_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_language_case IN LISTS _language_${_language_group}_cases)
            set(_language_test "framework.document.language.${_language_group}.${_language_case}")
            add_test(NAME ${_language_test} COMMAND ${_language_target} ${_language_case})
            set_tests_properties(${_language_test} PROPERTIES TIMEOUT 60 LABELS "framework;editor;document;document-language;regression")
            if(_language_group STREQUAL "native" OR _language_group STREQUAL "choice")
                set_tests_properties(${_language_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;document-language;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_language_test} TARGETS ${_language_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_language_variable IN ITEMS root pair parts header owner directory group source target case test catalogue_cases override_cases history_cases choice_cases native_cases)
    unset(_language_${_language_variable})
endforeach()
unset(_language_variable)
