#-----------------------------------------------------------------------------
# Umicom Framework
# File: cmake/UmicomFrameworkConfig.cmake.in
#
# PURPOSE:
#   Expose installed targets, dependencies and the producer's SDK identity.
#
# AUTHOR AND ORGANISATION:
# Sammy Hegab
# Umicom Foundation
#
# LICENCE:
# MIT
#-----------------------------------------------------------------------------
@PACKAGE_INIT@

# Dependency packages may change PACKAGE_PREFIX_DIR in their own configuration.
# Retain Framework location before resolving those external packages.
set(_umicom_framework_install_prefix "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
@UMICOM_FRAMEWORK_FIND_SQLITE@
@UMICOM_FRAMEWORK_FIND_CAIRO@
@UMICOM_FRAMEWORK_FIND_GTK4@
@UMICOM_FRAMEWORK_FIND_PNG@

# Optional AI transport dependencies are installed only when that capability
# is composed. Resolve them before importing static-library link interfaces;
# a core-only Framework installation has no such fragment and remains unchanged.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomAiWorkspaceDependencies.cmake" OPTIONAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomConnectionCheckDependencies.cmake" OPTIONAL)
# Market-tape presentation has an optional, separately installed GTK dependency.
# A core-only installation does not acquire a GUI requirement.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomMarketTapeDependencies.cmake" OPTIONAL)
# Optional native broker window requires GTK only when exported.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomIbkrGtkDependencies.cmake" OPTIONAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomCreativePlaybackDependencies.cmake" OPTIONAL)
# The Qt adapter is composed later than the root package configuration.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomQt6Dependencies.cmake" OPTIONAL)
# A separately composed designer adapter has its own GTK imported target.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomDesignerGtkDependencies.cmake" OPTIONAL)
# Restore our prefix before publishing Framework resource paths.
set(PACKAGE_PREFIX_DIR "${_umicom_framework_install_prefix}")
set(UMICOM_FRAMEWORK_INSTALL_PREFIX "${PACKAGE_PREFIX_DIR}")
unset(_umicom_framework_install_prefix)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomFrameworkTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/UmicomRequireInstalledSdk.cmake")
set(UMICOM_FRAMEWORK_EXAMPLES_ROOT
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/umicom-framework/examples")
# Expose the installed contract version so generated extensions do not copy a
# numeric ABI value that can drift away from the Framework headers.
# The former fixed number is retained for review. The public version header
# now supplies this value to both the package and its passive SDK receipt.
#[[
set(UMICOM_FRAMEWORK_ABI_VERSION 2)
]]
set(UMICOM_FRAMEWORK_ABI_VERSION @UMICOM_FRAMEWORK_PACKAGE_ABI@)
set(UMICOM_FRAMEWORK_TARGET_SYSTEM "@CMAKE_SYSTEM_NAME@")
set(UMICOM_FRAMEWORK_TARGET_POINTER_BYTES "@CMAKE_SIZEOF_VOID_P@")
set(UMICOM_FRAMEWORK_PRODUCER_C_COMPILER "@CMAKE_C_COMPILER_ID@")
set(UMICOM_FRAMEWORK_PRODUCER_C_COMPILER_VERSION "@CMAKE_C_COMPILER_VERSION@")
# Processor spelling is informational: host-derived names do not certify the
# instruction set emitted by a particular cross compiler or multilib option.
set(UMICOM_FRAMEWORK_REPORTED_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@")
include("${CMAKE_CURRENT_LIST_DIR}/UmicomRequireSdkEnvironment.cmake")
set(UMICOM_FRAMEWORK_RESOURCE_ROOT
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/umicom/framework/resources")
# Give documentation-aware applications one portable installed location for
# the offline learning library and future generated reference pages.
set(UMICOM_FRAMEWORK_DOCUMENTATION_ROOT
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/umicom/docs")
include("${CMAKE_CURRENT_LIST_DIR}/UmicomApplicationBranding.cmake")

# Components map directly to exported Umicom::<component> targets. This keeps
# find_package(UmicomFramework COMPONENTS sdk delivery) honest for consumers.
foreach(_umicom_component IN LISTS UmicomFramework_FIND_COMPONENTS)
    if(TARGET "Umicom::${_umicom_component}")
        set("UmicomFramework_${_umicom_component}_FOUND" TRUE)
    else()
        set("UmicomFramework_${_umicom_component}_FOUND" FALSE)
        if(NOT UmicomFramework_FIND_QUIETLY)
            message(STATUS
                "Umicom Framework component not found: ${_umicom_component}")
        endif()
    endif()
endforeach()

check_required_components(UmicomFramework)

# Installed project creators can inspect registered application modules too.
include("${CMAKE_CURRENT_LIST_DIR}/UmicomApplicationModules.cmake")
