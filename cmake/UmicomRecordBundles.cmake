# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Bounded record transfer uses the existing data transaction and SDK ownership.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_bundle_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_data PRIVATE "${_bundle_root}/src/data/record_bundle_codec.c"
    "${_bundle_root}/src/data/record_bundle_store.c")
install(FILES "${_bundle_root}/include/umicom/data/record_bundle.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_bundle.h)
endif()
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_data FILES
        "${_bundle_root}/src/data/include/record_bundle_internal.h"
        "${_bundle_root}/src/data/include/record_document_internal.h"
        "${_bundle_root}/src/data/include/record_history_internal.h")
endif()
if(BUILD_TESTING)
    add_executable(umicom-record-bundle-codec-test "${_bundle_root}/tests/data_history/test_record_bundle_codec.c")
    add_executable(umicom-record-bundle-store-test "${_bundle_root}/tests/data_history/test_record_bundle_store.c")
    add_executable(umicom-record-bundle-example "${_bundle_root}/examples/data_history/record_bundles.c")
    foreach(_bundle_target IN ITEMS umicom-record-bundle-codec-test umicom-record-bundle-store-test umicom-record-bundle-example)
        target_link_libraries(${_bundle_target} PRIVATE Umicom::data)
        set_target_properties(${_bundle_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_bundle_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_bundle_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_bundle_target})
        endif()
    endforeach()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-bundle-store-test FILES
            "${_bundle_root}/src/data/include/record_history_internal.h")
    endif()
    foreach(_bundle_case IN ITEMS roundtrip binary empty canonical truncated digest magic reserved zero-count count-overflow text-length content-length embedded-null trailing body-digest foreign-entity output index)
        add_test(NAME framework.data.bundle.codec.${_bundle_case} COMMAND umicom-record-bundle-codec-test ${_bundle_case})
        set_tests_properties(framework.data.bundle.codec.${_bundle_case} PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;codec;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.bundle.codec.${_bundle_case} TARGETS umicom-record-bundle-codec-test)
        endif()
    endforeach()
    foreach(_bundle_case IN ITEMS restore collision orphan-rollback nested-capture nested-restore missing capacity source-independent other-entity large repeat future-history future-content malformed-content-key neighbor-entity)
        add_test(NAME framework.data.bundle.store.${_bundle_case} COMMAND umicom-record-bundle-store-test ${_bundle_case})
        set_tests_properties(framework.data.bundle.store.${_bundle_case} PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;transaction;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.bundle.store.${_bundle_case} TARGETS umicom-record-bundle-store-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME framework.data.bundle.store.sqlite.${_bundle_case} COMMAND umicom-record-bundle-store-test ${_bundle_case} sqlite)
            set_tests_properties(framework.data.bundle.store.sqlite.${_bundle_case} PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;sqlite;transaction;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.bundle.store.sqlite.${_bundle_case} TARGETS umicom-record-bundle-store-test)
            endif()
        endif()
    endforeach()
    if(SQLite3_FOUND)
        foreach(_bundle_failure IN ITEMS write-failure commit-failure automatic-rollback scan-limit scan-boundary)
            add_test(NAME framework.data.bundle.failure.${_bundle_failure} COMMAND umicom-record-bundle-store-test ${_bundle_failure} sqlite)
            set_tests_properties(framework.data.bundle.failure.${_bundle_failure} PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;sqlite;recovery;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.bundle.failure.${_bundle_failure} TARGETS umicom-record-bundle-store-test)
            endif()
        endforeach()
        unset(_bundle_failure)
        add_test(NAME framework.data.bundle.cross-backend COMMAND umicom-record-bundle-store-test cross-backend sqlite)
        set_tests_properties(framework.data.bundle.cross-backend PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;sqlite;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.bundle.cross-backend TARGETS umicom-record-bundle-store-test)
        endif()
    endif()
    add_test(NAME framework.data.bundle.example COMMAND umicom-record-bundle-example)
    set_tests_properties(framework.data.bundle.example PROPERTIES TIMEOUT 30 LABELS "framework;data;record-bundle;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.bundle.example TARGETS umicom-record-bundle-example)
    endif()
endif()
foreach(_bundle_component IN ITEMS Framework FrameworkSDK)
    set(_bundle_exclude "")
    if(_bundle_component STREQUAL "FrameworkSDK")
        set(_bundle_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_bundle_root}/docs/guides/record-bundles.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_bundle_component} ${_bundle_exclude})
endforeach()
unset(_bundle_root)
unset(_bundle_target)
unset(_bundle_case)
unset(_bundle_component)
unset(_bundle_exclude)
