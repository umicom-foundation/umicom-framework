# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# The data codec remains portable. File recovery composes it with the existing
# platform owner without making every data consumer depend on desktop storage.
if(NOT TARGET Umicom::data OR NOT TARGET Umicom::platform)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_record_recovery_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_record_recovery STATIC "${_record_recovery_root}/src/data/record_draft_files.c")
add_library(Umicom::record_recovery ALIAS umicom_record_recovery)
set_target_properties(umicom_record_recovery PROPERTIES EXPORT_NAME record_recovery
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_record_recovery PUBLIC Umicom::data Umicom::platform)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_record_recovery)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_record_recovery)
endif()
install(TARGETS umicom_record_recovery EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_record_recovery)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_draft_snapshot.h)
    umicom_release_inventory_own_headers(umicom_record_recovery include/umicom/data/record_draft_files.h)
endif()
foreach(_record_recovery_component IN ITEMS Framework FrameworkSDK)
    if(_record_recovery_component STREQUAL "FrameworkSDK")
        set(_record_recovery_exclude EXCLUDE_FROM_ALL)
    else()
        set(_record_recovery_exclude "")
    endif()
    install(FILES "${_record_recovery_root}/docs/guides/record-draft-recovery.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_record_recovery_component} ${_record_recovery_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-record-draft-snapshot-test "${_record_recovery_root}/tests/data_history/test_record_draft_snapshot.c")
    target_link_libraries(umicom-record-draft-snapshot-test PRIVATE Umicom::data)
    add_executable(umicom-record-draft-files-test "${_record_recovery_root}/tests/data_history/test_record_draft_files.c")
    target_link_libraries(umicom-record-draft-files-test PRIVATE Umicom::record_recovery)
    add_executable(umicom-record-draft-recovery-example "${_record_recovery_root}/examples/data_history/record_draft_recovery.c")
    target_link_libraries(umicom-record-draft-recovery-example PRIVATE Umicom::data)
    foreach(_record_recovery_target IN ITEMS umicom-record-draft-snapshot-test umicom-record-draft-files-test umicom-record-draft-recovery-example)
        set_target_properties(${_record_recovery_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_record_recovery_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_record_recovery_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_record_recovery_target})
        endif()
    endforeach()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-draft-files-test FILES
            "${_record_recovery_root}/tests/build_log/fixture.h"
            "${_record_recovery_root}/tests/support/symbolic_link.h")
    endif()
    foreach(_record_recovery_case IN ITEMS new saved empty binary limit max-baseline integrity truncated trailing framing canonical metadata new-metadata
            dirty pending capture-state token store-match store-mismatch stale-save missing)
        add_test(NAME framework.data.draft.snapshot.${_record_recovery_case}
            COMMAND umicom-record-draft-snapshot-test ${_record_recovery_case})
        set_tests_properties(framework.data.draft.snapshot.${_record_recovery_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;data;draft;recovery;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.draft.snapshot.${_record_recovery_case} TARGETS umicom-record-draft-snapshot-test)
        endif()
    endforeach()
    foreach(_record_recovery_case IN ITEMS roundtrip exclusive unicode malformed oversized invalid missing directory)
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/record-draft-files/${_record_recovery_case}")
        add_test(NAME framework.data.draft.files.${_record_recovery_case}
            COMMAND umicom-record-draft-files-test ${_record_recovery_case})
        set_tests_properties(framework.data.draft.files.${_record_recovery_case} PROPERTIES
            WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/record-draft-files/${_record_recovery_case}"
            TIMEOUT 30 LABELS "framework;data;draft;recovery;filesystem;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.draft.files.${_record_recovery_case} TARGETS umicom-record-draft-files-test)
        endif()
    endforeach()
    add_test(NAME framework.data.draft.recovery.example COMMAND umicom-record-draft-recovery-example)
    set_tests_properties(framework.data.draft.recovery.example PROPERTIES TIMEOUT 30 LABELS "framework;data;draft;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.draft.recovery.example TARGETS umicom-record-draft-recovery-example)
    endif()
endif()
unset(_record_recovery_root)
unset(_record_recovery_component)
unset(_record_recovery_exclude)
unset(_record_recovery_target)
unset(_record_recovery_case)
