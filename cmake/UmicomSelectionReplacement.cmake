# File: cmake/UmicomSelectionReplacement.cmake
# PURPOSE: Export selection replacement and register focused engine, document and native checks.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor OR NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_selected_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_selected_pair IN ITEMS "editor/search_range.h|umicom_editor" "document/selection_replace.h|umicom_document")
    string(REPLACE "|" ";" _selected_parts "${_selected_pair}")
    list(GET _selected_parts 0 _selected_header)
    list(GET _selected_parts 1 _selected_owner)
    get_filename_component(_selected_directory "${_selected_header}" DIRECTORY)
    install(FILES "${_selected_root}/include/umicom/${_selected_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_selected_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_selected_owner} "include/umicom/${_selected_header}")
    endif()
endforeach()
if(TARGET umicom_ui_gtk4)
    install(FILES "${_selected_root}/include/umicom/ui/gtk4/selection_replace.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 "include/umicom/ui/gtk4/selection_replace.h")
    endif()
endif()
install(FILES "${_selected_root}/docs/guides/selection-replacement.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_selected_engine_cases middle prefix suffix full zero empty nomatch straddle left-boundary right-boundary whole-word inside-other-match overlap grow shrink delete same case-exact case-insensitive smart-lower smart-upper newline crlf not-search-output range-end)
    set(_selected_bounds_cases arguments bad-start bad-span invalid-case invalid-word capacity overlap-text overlap-needle overlap-replacement overflow all-matches binary null-empty optional-count size-only utf8-word)
    set(_selected_document_cases capture apply undo pending-typing delete no-match whole-word-left whole-word-right smart-case unicode crlf empty-selection read-only bad-needle bad-replacement split-utf8 split-crlf foreign-view stale closed other-owner inactive caret approval review-revision arguments invalid-policy owned)
    set(_selected_native_cases prefill apply undo cancel no-preview no-approval edit-after-preview stale read-only empty-selection no-match busy unbind constructor-unbind constructor-repeat completion-retire delete arguments options)
    foreach(_selected_group IN ITEMS engine bounds document native)
        set(_selected_owner editor)
        set(_selected_source "tests/editor/test_search_range.c")
        if(_selected_group STREQUAL "bounds")
            set(_selected_source "tests/editor/test_search_range_bounds.c")
        elseif(_selected_group STREQUAL "document")
            set(_selected_source "tests/document/test_selection_replace.c")
            set(_selected_owner document)
        elseif(_selected_group STREQUAL "native")
            set(_selected_source "tests/document/test_selection_replace_gtk4.c")
            set(_selected_owner ui_gtk4)
        endif()
        if(NOT TARGET umicom_${_selected_owner})
            continue()
        endif()
        set(_selected_target "umicom-selection-replace-${_selected_group}-test")
        add_executable(${_selected_target} "${_selected_root}/${_selected_source}")
        target_link_libraries(${_selected_target} PRIVATE Umicom::${_selected_owner})
        set_target_properties(${_selected_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_selected_target})
        umicom_apply_sanitizers(${_selected_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_selected_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_selected_target} FILES
                "${_selected_root}/src/editor/search_range.inc"
                "${_selected_root}/src/document/selection_replace.inc"
                "${_selected_root}/adapters/gtk4/document_proposal_review.inc"
                "${_selected_root}/tests/document/replacement_fixture.h"
                "${_selected_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_selected_case IN LISTS _selected_${_selected_group}_cases)
            set(_selected_test "framework.selection_replace.${_selected_group}.${_selected_case}")
            add_test(NAME ${_selected_test} COMMAND ${_selected_target} ${_selected_case})
            set_tests_properties(${_selected_test} PROPERTIES TIMEOUT 60 LABELS "framework;editor;document;selection-replacement;regression")
            if(_selected_group STREQUAL "native")
                set_tests_properties(${_selected_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;selection-replacement;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_selected_test} TARGETS ${_selected_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_selected_variable IN ITEMS root pair parts header owner directory group source target case test engine_cases bounds_cases document_cases native_cases)
    unset(_selected_${_selected_variable})
endforeach()
unset(_selected_variable)
