# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Import history and its provenance share the existing Data Server transaction.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_transfer_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_data PRIVATE "${_transfer_root}/src/data/record_transfer.c"
    "${_transfer_root}/src/data/record_transfer_receipt.c")
install(FILES "${_transfer_root}/include/umicom/data/record_transfer.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/record_transfer.h)
endif()
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_data FILES
        "${_transfer_root}/src/data/include/record_transfer_internal.h"
        "${_transfer_root}/src/data/include/record_bundle_internal.h"
        "${_transfer_root}/src/data/include/record_document_internal.h")
endif()
if(BUILD_TESTING)
    add_executable(umicom-record-transfer-test "${_transfer_root}/tests/data_history/test_record_transfer.c")
    add_executable(umicom-record-transfer-receipt-test "${_transfer_root}/tests/data_history/test_record_transfer_receipt.c")
    add_executable(umicom-record-transfer-example "${_transfer_root}/examples/data_history/record_transfers.c")
    add_test(NAME framework.data.transfer.example COMMAND umicom-record-transfer-example)
    set_tests_properties(framework.data.transfer.example PROPERTIES TIMEOUT 30 LABELS "framework;data;record-transfer;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.transfer.example TARGETS umicom-record-transfer-example)
    endif()
    foreach(_transfer_target IN ITEMS umicom-record-transfer-test umicom-record-transfer-receipt-test umicom-record-transfer-example)
        target_link_libraries(${_transfer_target} PRIVATE Umicom::data)
        set_target_properties(${_transfer_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_transfer_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_transfer_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_transfer_target})
        endif()
    endforeach()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-record-transfer-test FILES
            "${_transfer_root}/src/data/include/record_history_internal.h")
        umicom_target_qualification_inputs(umicom-record-transfer-receipt-test FILES
            "${_transfer_root}/src/data/include/record_transfer_internal.h")
    endif()
    foreach(_transfer_receipt_case IN ITEMS id-contract validate-digest validate-body validate-receipt roundtrip digest checksum magic separator truncated noncanonical foreign-namespace amended nested-receipt invalid-source unterminated-id boundary-id zero-time null long-history metadata identity)
        add_test(NAME framework.data.transfer.receipt.${_transfer_receipt_case}
            COMMAND umicom-record-transfer-receipt-test ${_transfer_receipt_case})
        set_tests_properties(framework.data.transfer.receipt.${_transfer_receipt_case} PROPERTIES TIMEOUT 30
            LABELS "framework;data;record-transfer;provenance;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.transfer.receipt.${_transfer_receipt_case} TARGETS umicom-record-transfer-receipt-test)
        endif()
    endforeach()
    set(_transfer_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _transfer_backends sqlite)
    endif()
    foreach(_transfer_backend IN LISTS _transfer_backends)
        set(_transfer_args "")
        if(_transfer_backend STREQUAL "sqlite")
            set(_transfer_args sqlite)
        endif()
        foreach(_transfer_case IN ITEMS restore receipt-collision record-collision receipt-orphan nested wrong-digest invalid-id invalid-time reserved repeat later altered-history altered-content amended-receipt missing-receipt other-entity)
            add_test(NAME framework.data.transfer.store.${_transfer_backend}.${_transfer_case}
                COMMAND umicom-record-transfer-test ${_transfer_case} ${_transfer_args})
            set_tests_properties(framework.data.transfer.store.${_transfer_backend}.${_transfer_case} PROPERTIES TIMEOUT 30
                LABELS "framework;data;record-transfer;transaction;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.transfer.store.${_transfer_backend}.${_transfer_case} TARGETS umicom-record-transfer-test)
            endif()
        endforeach()
    endforeach()
    if(SQLite3_FOUND)
        foreach(_transfer_fault_case IN ITEMS write-failure automatic-rollback commit-failure)
            add_test(NAME framework.data.transfer.store.sqlite.${_transfer_fault_case}
                COMMAND umicom-record-transfer-test ${_transfer_fault_case} sqlite)
            set_tests_properties(framework.data.transfer.store.sqlite.${_transfer_fault_case} PROPERTIES TIMEOUT 30
                LABELS "framework;data;record-transfer;transaction;sqlite;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.transfer.store.sqlite.${_transfer_fault_case} TARGETS umicom-record-transfer-test)
            endif()
        endforeach()
    endif()
endif()
foreach(_transfer_doc_component IN ITEMS Framework FrameworkSDK)
    set(_transfer_doc_exclude "")
    if(_transfer_doc_component STREQUAL "FrameworkSDK")
        set(_transfer_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_transfer_root}/docs/guides/record-transfer-receipts.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_transfer_doc_component} ${_transfer_doc_exclude})
endforeach()
unset(_transfer_root)
unset(_transfer_target)
unset(_transfer_receipt_case)
unset(_transfer_backends)
unset(_transfer_backend)
unset(_transfer_args)
unset(_transfer_case)
unset(_transfer_fault_case)
unset(_transfer_doc_component)
unset(_transfer_doc_exclude)