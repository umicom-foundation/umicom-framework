# Register verification targets only when the developer has enabled testing.
if(BUILD_TESTING)
    # Define the add observability performance test build helper so parent and application
    # projects apply one consistent rule.
    function(umicom_add_observability_performance_test target test_name source)
        # Configure the optional target only when its feature has created it.
        if(TARGET "${target}")
            return()
        endif()
        add_executable("${target}" "${UMICOM_OBSERVABILITY_PERFORMANCE_ROOT}/${source}")
        target_link_libraries("${target}" PRIVATE Umicom::observability)
        # Use the shared build helper when it is available from the parent composition.
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings("${target}")
        endif()
        # Use the shared build helper when it is available from the parent composition.
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers("${target}")
        endif()
        add_test(NAME "${test_name}" COMMAND "${target}")
        set_tests_properties("${test_name}" PROPERTIES LABELS "framework;observability-performance")
    endfunction()

