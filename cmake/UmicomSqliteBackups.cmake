# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Backup owns Platform output-file creation; Data Server owns SQLite handles.
if(NOT TARGET Umicom::data OR NOT TARGET Umicom::platform)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_sqlite_backup_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
# Existing data filesystem helpers already require Platform. Express the static
# link dependency so installed data consumers resolve the new-file service too.
target_link_libraries(umicom_data PRIVATE Umicom::platform)
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_data FILES "${_sqlite_backup_root}/src/data/include/sqlite_backup_internal.h")
endif()
foreach(_sqlite_backup_component IN ITEMS Framework FrameworkSDK)
    set(_sqlite_backup_exclude "")
    if(_sqlite_backup_component STREQUAL "FrameworkSDK")
        set(_sqlite_backup_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_sqlite_backup_root}/docs/guides/sqlite-backup-recovery.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_sqlite_backup_component} ${_sqlite_backup_exclude})
endforeach()
get_target_property(_sqlite_backup_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
if(BUILD_TESTING AND "UMICOM_HAS_SQLITE=1" IN_LIST _sqlite_backup_definitions)
    set(_sqlite_backup_create_cases roundtrip wal existing same-source nested memory readonly relative missing-parent unhealthy extra-table later-source twice null-output empty contended long-path legacy null-server)
    set(_sqlite_backup_restore_cases roundtrip existing same-source missing-source malformed unrelated relative-source relative-target unhealthy legacy source-wal null-output null-source source-retained)
    set(_sqlite_backup_history_cases document history receipt verify append-recovered catalogue binary metadata)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sqlite-backup-fixtures")
    foreach(_sqlite_backup_group IN ITEMS create restore history)
        set(_sqlite_backup_target "umicom-sqlite-backup-${_sqlite_backup_group}-test")
        add_executable(${_sqlite_backup_target} "${_sqlite_backup_root}/tests/data_history/test_sqlite_backup_${_sqlite_backup_group}.c")
        target_link_libraries(${_sqlite_backup_target} PRIVATE Umicom::data)
        set_target_properties(${_sqlite_backup_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_sqlite_backup_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_sqlite_backup_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_sqlite_backup_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_sqlite_backup_target} FILES "${_sqlite_backup_root}/tests/data_history/readonly_fixture.h")
        endif()
        foreach(_sqlite_backup_case IN LISTS _sqlite_backup_${_sqlite_backup_group}_cases)
            add_test(NAME framework.data.sqlite-backup.${_sqlite_backup_group}.${_sqlite_backup_case}
                COMMAND ${_sqlite_backup_target} ${_sqlite_backup_case} "${CMAKE_CURRENT_BINARY_DIR}/sqlite-backup-fixtures")
            set_tests_properties(framework.data.sqlite-backup.${_sqlite_backup_group}.${_sqlite_backup_case} PROPERTIES TIMEOUT 30
                LABELS "framework;data;sqlite;backup;recovery;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.sqlite-backup.${_sqlite_backup_group}.${_sqlite_backup_case} TARGETS ${_sqlite_backup_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_sqlite_backup_root)
unset(_sqlite_backup_component)
unset(_sqlite_backup_exclude)
unset(_sqlite_backup_definitions)
unset(_sqlite_backup_create_cases)
unset(_sqlite_backup_restore_cases)
unset(_sqlite_backup_history_cases)
unset(_sqlite_backup_group)
unset(_sqlite_backup_target)
unset(_sqlite_backup_case)
get_target_property(_backup_example_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
if(BUILD_TESTING AND "UMICOM_HAS_SQLITE=1" IN_LIST _backup_example_definitions)
    add_executable(umicom-data-backup-example "${CMAKE_CURRENT_LIST_DIR}/../examples/data_history/sqlite_backup.c")
    target_link_libraries(umicom-data-backup-example PRIVATE Umicom::data)
    set_target_properties(umicom-data-backup-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-data-backup-example)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-data-backup-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-data-backup-example)
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/backup-example-output")
    add_test(NAME framework.data.sqlite-backup.example COMMAND umicom-data-backup-example "${CMAKE_CURRENT_BINARY_DIR}/backup-example-output")
    set_tests_properties(framework.data.sqlite-backup.example PROPERTIES TIMEOUT 30 LABELS "framework;data;sqlite;backup;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.sqlite-backup.example TARGETS umicom-data-backup-example)
    endif()
endif()
unset(_backup_example_definitions)