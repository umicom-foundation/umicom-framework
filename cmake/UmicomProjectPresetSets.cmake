if(NOT TARGET umicom_developer)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_preset_set_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_developer PRIVATE "${_preset_set_root}/src/developer_project/preset_set.c")
install(FILES "${_preset_set_root}/include/umicom/developer_project/preset_set.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/developer_project" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_developer include/umicom/developer_project/preset_set.h)
endif()
install(FILES "${_preset_set_root}/docs/guides/related-build-presets.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_preset_set_inspect_cases related missing-build missing-test ambiguous-build ambiguous-test hidden-configure false-configure hidden-build false-build hidden-test false-test unrelated case-sensitive includes configure-inherits build-inherits hidden-inherits unrelated-inherits configure-condition build-condition wrong-stage invalid-index arguments)
    set(_preset_set_select_cases different-names in-place unrelated-fields owned missing ambiguous
        incomplete legacy invalid-profile null-output null-profile hidden)
    set(_preset_set_graph_cases inherited included user false-condition ambiguous)
    foreach(_preset_set_group IN ITEMS inspect select graph)
        set(_preset_set_target "umicom-preset-set-${_preset_set_group}-test")
        add_executable(${_preset_set_target} "${_preset_set_root}/tests/project_presets/test_set_${_preset_set_group}.c")
        target_link_libraries(${_preset_set_target} PRIVATE Umicom::developer)
        set_target_properties(${_preset_set_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_preset_set_target})
        umicom_apply_sanitizers(${_preset_set_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_preset_set_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_preset_set_target} FILES
                "${_preset_set_root}/tests/project_presets/preset_set_fixture.h"
                "${_preset_set_root}/src/developer_project/preset_graph.inc")
        endif()
        foreach(_preset_set_case IN LISTS _preset_set_${_preset_set_group}_cases)
            set(_preset_set_test "framework.project_presets.set.${_preset_set_group}.${_preset_set_case}")
            add_test(NAME ${_preset_set_test} COMMAND ${_preset_set_target} ${_preset_set_case})
            set_tests_properties(${_preset_set_test} PROPERTIES TIMEOUT 45
                LABELS "framework;developer;presets;selection;regression")
            if(_preset_set_group STREQUAL "graph")
                file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/preset-set/${_preset_set_case}")
                set_tests_properties(${_preset_set_test} PROPERTIES
                    WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/preset-set/${_preset_set_case}")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_preset_set_test} TARGETS ${_preset_set_target})
            endif()
        endforeach()
    endforeach()
endif()
function(umicom_attach_preset_set_native_checks)
    if(NOT BUILD_TESTING OR NOT TARGET umicom_ui_gtk4 OR TARGET umicom-preset-set-gtk4-test)
        return()
    endif()
    add_executable(umicom-preset-set-gtk4-test
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/project_presets/test_set_gtk4.c")
    target_link_libraries(umicom-preset-set-gtk4-test PRIVATE Umicom::ui_gtk4)
    umicom_apply_warnings(umicom-preset-set-gtk4-test)
    umicom_apply_sanitizers(umicom-preset-set-gtk4-test)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-preset-set-gtk4-test)
    endif()
    foreach(_preset_set_native_case IN ITEMS select apply ambiguous incomplete missing retained stale
        close-notification edit-notification project-notification reentrant-notification)
        set(_preset_set_native_test "framework.project_presets.set.gtk4.${_preset_set_native_case}")
        add_test(NAME ${_preset_set_native_test} COMMAND umicom-preset-set-gtk4-test ${_preset_set_native_case})
        set_tests_properties(${_preset_set_native_test} PROPERTIES TIMEOUT 45 SKIP_RETURN_CODE 77
            ENVIRONMENT "G_DEBUG=fatal-warnings"
            LABELS "framework;developer;presets;gtk4;ownership;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${_preset_set_native_test} TARGETS umicom-preset-set-gtk4-test)
        endif()
    endforeach()
endfunction()
umicom_attach_preset_set_native_checks()
if(NOT TARGET umicom_ui_gtk4)
    cmake_language(DEFER CALL umicom_attach_preset_set_native_checks)
endif()
unset(_preset_set_root)
unset(_preset_set_group)
unset(_preset_set_target)
unset(_preset_set_test)
unset(_preset_set_case)
unset(_preset_set_inspect_cases)
unset(_preset_set_select_cases)
unset(_preset_set_graph_cases)
