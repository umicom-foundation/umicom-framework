# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Saved receipt reading composes read-only storage and the shared receipt view.
if(NOT TARGET Umicom::record_transfer_receipt_gtk4 OR NOT TARGET Umicom::platform)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_receipt_inspector_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_record_transfer_inspector_gtk4 STATIC "${_receipt_inspector_root}/adapters/gtk4/record_transfer_inspector_gtk4.c")
add_library(Umicom::record_transfer_inspector_gtk4 ALIAS umicom_record_transfer_inspector_gtk4)
set_target_properties(umicom_record_transfer_inspector_gtk4 PROPERTIES EXPORT_NAME record_transfer_inspector_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_record_transfer_inspector_gtk4 PUBLIC Umicom::record_transfer_receipt_gtk4 Umicom::platform)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_record_transfer_inspector_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_record_transfer_inspector_gtk4)
endif()
install(TARGETS umicom_record_transfer_inspector_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_record_transfer_inspector_gtk4)
install(FILES "${_receipt_inspector_root}/include/umicom/ui/gtk4/record_transfer_inspector.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_record_transfer_inspector_gtk4 include/umicom/ui/gtk4/record_transfer_inspector.h)
endif()
foreach(_receipt_inspector_component IN ITEMS Framework FrameworkSDK)
    set(_receipt_inspector_exclude "")
    if(_receipt_inspector_component STREQUAL "FrameworkSDK")
        set(_receipt_inspector_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_receipt_inspector_root}/docs/guides/native-receipt-inspection.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_receipt_inspector_component} ${_receipt_inspector_exclude})
endforeach()
get_target_property(_receipt_inspector_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
if(BUILD_TESTING AND "UMICOM_HAS_SQLITE=1" IN_LIST _receipt_inspector_definitions)
    add_executable(umicom-receipt-inspector-gtk-test "${_receipt_inspector_root}/tests/data_history/test_record_transfer_inspector_gtk4.c")
    target_link_libraries(umicom-receipt-inspector-gtk-test PRIVATE Umicom::record_transfer_inspector_gtk4)
    set_target_properties(umicom-receipt-inspector-gtk-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-receipt-inspector-gtk-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-receipt-inspector-gtk-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-receipt-inspector-gtk-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-receipt-inspector-gtk-test FILES
            "${_receipt_inspector_root}/tests/data_history/readonly_fixture.h"
            "${_receipt_inspector_root}/src/data/include/record_history_internal.h")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/receipt-inspector-fixtures")
    foreach(_receipt_inspector_case IN ITEMS view verify buttons denied missing-store missing-receipt corrupt-history view-corrupt-history
            relative invalid-id null-authorizer busy changed-read retired-read disposed-read edit-authorize
            retire-authorize reenter-authorize completion-reentry captured-path changed-after-read)
        add_test(NAME framework.data.transfer.inspector.gtk.${_receipt_inspector_case}
            COMMAND umicom-receipt-inspector-gtk-test ${_receipt_inspector_case} "${CMAKE_CURRENT_BINARY_DIR}/receipt-inspector-fixtures")
        set_tests_properties(framework.data.transfer.inspector.gtk.${_receipt_inspector_case} PROPERTIES TIMEOUT 30
            SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;data;record-transfer;inspection;gtk4;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.transfer.inspector.gtk.${_receipt_inspector_case} TARGETS umicom-receipt-inspector-gtk-test)
        endif()
    endforeach()
endif()
unset(_receipt_inspector_root)
unset(_receipt_inspector_component)
unset(_receipt_inspector_exclude)
unset(_receipt_inspector_definitions)
unset(_receipt_inspector_case)