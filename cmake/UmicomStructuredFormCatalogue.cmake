# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Stable schema selection is portable; stored history adds the data adapter.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_catalogue_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE "${_form_catalogue_root}/src/application/experience/structured_form_catalogue.c")
install(FILES "${_form_catalogue_root}/include/umicom/application/experience/structured_form_catalogue.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_catalogue.h)
endif()
if(TARGET umicom_form_records)
    target_sources(umicom_form_records PRIVATE "${_form_catalogue_root}/src/data/structured_form_reader.c")
    install(FILES "${_form_catalogue_root}/include/umicom/data/structured_form_reader.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_reader.h)
    endif()
endif()
if(BUILD_TESTING)
    foreach(_form_catalogue_group IN ITEMS catalogue reader)
        if(_form_catalogue_group STREQUAL "catalogue")
            set(_form_catalogue_source tests/application_experience/test_structured_form_catalogue.c)
            set(_form_catalogue_library Umicom::application)
            set(_form_catalogue_cases empty invalid duplicate ordered exact latest array-copy capacity overflow unknown-version unknown-id roundtrip
                trailing body-truncated header-truncated magic id-null id-token zero-version zero-revision saved-ahead field-count output-unchanged alias bad-index)
        elseif(TARGET umicom_form_records)
            set(_form_catalogue_source tests/data_history/test_structured_form_reader.c)
            set(_form_catalogue_library Umicom::form_records)
            set(_form_catalogue_cases history latest unknown corrupt reviewed stale metadata unchanged alias missing)
        else()
            continue()
        endif()
        set(_form_catalogue_target umicom-form-${_form_catalogue_group}-test)
        add_executable(${_form_catalogue_target} "${_form_catalogue_root}/${_form_catalogue_source}")
        target_link_libraries(${_form_catalogue_target} PRIVATE ${_form_catalogue_library})
        set_target_properties(${_form_catalogue_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_form_catalogue_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_form_catalogue_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_form_catalogue_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_form_catalogue_target} FILES
                "${_form_catalogue_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_form_catalogue_case IN LISTS _form_catalogue_cases)
            set(_form_catalogue_test framework.structured_forms.${_form_catalogue_group}.${_form_catalogue_case})
            add_test(NAME ${_form_catalogue_test} COMMAND ${_form_catalogue_target} ${_form_catalogue_case})
            set_tests_properties(${_form_catalogue_test} PROPERTIES TIMEOUT 30 LABELS "framework;forms;schema-catalogue;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_form_catalogue_test} TARGETS ${_form_catalogue_target})
            endif()
            if(_form_catalogue_group STREQUAL "reader" AND SQLite3_FOUND)
                add_test(NAME ${_form_catalogue_test}.sqlite COMMAND ${_form_catalogue_target} ${_form_catalogue_case} sqlite)
                set_tests_properties(${_form_catalogue_test}.sqlite PROPERTIES TIMEOUT 30 LABELS "framework;forms;data;sqlite;schema-catalogue;regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_form_catalogue_test}.sqlite TARGETS ${_form_catalogue_target})
                endif()
            endif()
        endforeach()
    endforeach()
endif()
foreach(_form_catalogue_doc_component IN ITEMS Framework FrameworkSDK)
    set(_form_catalogue_doc_exclude "")
    if(_form_catalogue_doc_component STREQUAL "FrameworkSDK")
        set(_form_catalogue_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_catalogue_root}/docs/guides/form-schema-catalogue.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_catalogue_doc_component} ${_form_catalogue_doc_exclude})
endforeach()
unset(_form_catalogue_root)
unset(_form_catalogue_group)
unset(_form_catalogue_source)
unset(_form_catalogue_library)
unset(_form_catalogue_cases)
unset(_form_catalogue_target)
unset(_form_catalogue_case)
unset(_form_catalogue_test)
unset(_form_catalogue_doc_component)
unset(_form_catalogue_doc_exclude)
