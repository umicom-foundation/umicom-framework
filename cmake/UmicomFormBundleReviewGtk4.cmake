# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Native transfer previews share portable validation and read-only form widgets.
if(NOT TARGET Umicom::form_records OR NOT TARGET Umicom::form_inspect_gtk4)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_bundle_review_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_form_bundle_review_gtk4 STATIC "${_bundle_review_root}/adapters/gtk4/form_bundle_review_gtk4.c")
add_library(Umicom::form_bundle_review_gtk4 ALIAS umicom_form_bundle_review_gtk4)
set_target_properties(umicom_form_bundle_review_gtk4 PROPERTIES EXPORT_NAME form_bundle_review_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_form_bundle_review_gtk4 PUBLIC Umicom::form_records Umicom::form_inspect_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_form_bundle_review_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_form_bundle_review_gtk4)
endif()
install(TARGETS umicom_form_bundle_review_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_form_bundle_review_gtk4)
if(COMMAND umicom_target_qualification_inputs)
    umicom_target_qualification_inputs(umicom_form_bundle_review_gtk4 FILES
        "${_bundle_review_root}/adapters/gtk4/record_time_internal.h")
endif()
install(FILES "${_bundle_review_root}/include/umicom/ui/gtk4/form_bundle_review.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_bundle_review_gtk4 include/umicom/ui/gtk4/form_bundle_review.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-bundle-review-gtk4-test "${_bundle_review_root}/tests/data_history/test_form_bundle_review_gtk4.c")
    target_link_libraries(umicom-form-bundle-review-gtk4-test PRIVATE Umicom::form_bundle_review_gtk4)
    set_target_properties(umicom-form-bundle-review-gtk4-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-bundle-review-gtk4-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-bundle-review-gtk4-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-bundle-review-gtk4-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-bundle-review-gtk4-test FILES
            "${_bundle_review_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_bundle_review_case IN ITEMS history unchecked confirmed withdrawn retired unrooted owned readonly markup utf8 secret wrong-widget clock)
        set(_bundle_review_test framework.structured_forms.bundle.gtk.${_bundle_review_case})
        add_test(NAME ${_bundle_review_test} COMMAND umicom-form-bundle-review-gtk4-test ${_bundle_review_case})
        set_tests_properties(${_bundle_review_test} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77
            ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;forms;gtk4;record-bundle;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${_bundle_review_test} TARGETS umicom-form-bundle-review-gtk4-test)
        endif()
    endforeach()
endif()
foreach(_bundle_review_doc_component IN ITEMS Framework FrameworkSDK)
    set(_bundle_review_doc_exclude "")
    if(_bundle_review_doc_component STREQUAL "FrameworkSDK")
        set(_bundle_review_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_bundle_review_root}/docs/guides/native-form-transfer-review.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_bundle_review_doc_component} ${_bundle_review_doc_exclude})
endforeach()
unset(_bundle_review_root)
unset(_bundle_review_case)
unset(_bundle_review_test)
unset(_bundle_review_doc_component)
unset(_bundle_review_doc_exclude)
