# PURPOSE: Export whitespace planning and native review with owner-run regression coverage.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_document OR NOT TARGET umicom_editor)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_white_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_editor PRIVATE "${_white_root}/src/editor/whitespace.c")
target_sources(umicom_document PRIVATE "${_white_root}/src/document/whitespace_commands.c")
foreach(_white_pair IN ITEMS "editor/whitespace.h|umicom_editor" "document/whitespace.h|umicom_document" "document/whitespace_commands.h|umicom_document")
    string(REPLACE "|" ";" _white_parts "${_white_pair}")
    list(GET _white_parts 0 _white_header)
    list(GET _white_parts 1 _white_target)
    get_filename_component(_white_directory "${_white_header}" DIRECTORY)
    install(FILES "${_white_root}/include/umicom/${_white_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_white_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_white_target} "include/umicom/${_white_header}")
    endif()
endforeach()
if(TARGET umicom_ui_gtk4)
    target_sources(umicom_ui_gtk4 PRIVATE "${_white_root}/adapters/gtk4/document_whitespace_gtk4.c")
    install(FILES "${_white_root}/include/umicom/ui/gtk4/document_whitespace.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 include/umicom/ui/gtk4/document_whitespace.h)
    endif()
endif()
install(FILES "${_white_root}/docs/guides/review-whitespace.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_white_trim_cases mixed-endings no-final only-whitespace empty unicode non-ascii-space interior-space caret-trimmed selection-trimmed selected-lines end-at-start caret-line eof-line terminal-empty-line unchanged owned-output)
    set(_white_indentation_cases expand compact mixed-prefix interior-tabs blank-prefix unicode mixed-endings selected-lines end-at-start eof expand-caret compact-caret selection width-one width-sixteen unchanged)
    set(_white_limits_cases invalid-utf8 embedded-nul split-scalar split-crlf cursor-range selection-range invalid-operation invalid-width invalid-scope arguments failed-output cancel input-limit output-limit exact-limit)
    set(_white_review_cases trim expand compact selection caret-move inactive pending-draft undo-redo unchanged stale-text stale-aba readonly-create readonly-apply foreign-view foreign-owner closed declined repeat arguments owned-text)
    set(_white_commands_cases catalogue defaults override unknown closed invalid)
    set(_white_native_cases entry apply expand compact selection stale inactive closed-document readonly retired rebound cancel repeat completion-retire message-retire arguments constructor-retire)
    foreach(_white_group IN ITEMS trim indentation limits review commands native)
        set(_white_owner editor)
        set(_white_source "tests/editor/test_whitespace_${_white_group}.c")
        if(_white_group STREQUAL "review" OR _white_group STREQUAL "commands")
            set(_white_owner document)
            set(_white_source "tests/document/test_whitespace_${_white_group}.c")
        elseif(_white_group STREQUAL "native")
            set(_white_owner ui_gtk4)
            set(_white_source tests/document/test_whitespace_review_gtk4.c)
        endif()
        if(NOT TARGET umicom_${_white_owner})
            continue()
        endif()
        set(_white_target "umicom-whitespace-${_white_group}-test")
        add_executable(${_white_target} "${_white_root}/${_white_source}")
        target_link_libraries(${_white_target} PRIVATE Umicom::${_white_owner})
        set_target_properties(${_white_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_white_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_white_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_white_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_white_target} FILES
                "${_white_root}/src/document/whitespace_review.inc"
                "${_white_root}/tests/document/replacement_fixture.h"
                "${_white_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_white_case IN LISTS _white_${_white_group}_cases)
            set(_white_test "framework.editor.whitespace.${_white_group}.${_white_case}")
            file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/whitespace/${_white_group}/${_white_case}")
            add_test(NAME ${_white_test} COMMAND ${_white_target} ${_white_case})
            set_tests_properties(${_white_test} PROPERTIES TIMEOUT 60
                WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qualification/whitespace/${_white_group}/${_white_case}"
                LABELS "framework;document;editor;whitespace;regression")
            if(_white_group STREQUAL "native")
                set_tests_properties(${_white_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings"
                    LABELS "framework;document;editor;whitespace;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_white_test} TARGETS ${_white_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_white_variable IN ITEMS root pair parts header directory target group owner source case test trim_cases indentation_cases limits_cases review_cases commands_cases native_cases)
    unset(_white_${_white_variable})
endforeach()
unset(_white_variable)

# Compile the native public header on its own before its integration test.
# This catches missing GTK declarations even when the test fixture happens
# to include GTK first. Reuse the Framework header-consumer mechanism.
if(BUILD_TESTING AND TARGET umicom-whitespace-native-test)
    include("${CMAKE_CURRENT_LIST_DIR}/UmicomPublicHeaderCompileChecks.cmake")
    umicom_add_public_header_compile_check(umicom-whitespace-header-check
        umicom_ui_gtk4 "${CMAKE_CURRENT_LIST_DIR}/../include"
        "umicom/ui/gtk4/document_whitespace.h")
    add_dependencies(umicom-whitespace-native-test umicom-whitespace-header-check)
endif()
