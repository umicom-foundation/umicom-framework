# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Health operations remain part of the opaque Data Server component.
if(NOT TARGET Umicom::data)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_sqlite_health_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
install(FILES "${_sqlite_health_root}/include/umicom/data/sqlite_health.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data include/umicom/data/sqlite_health.h)
endif()
foreach(_sqlite_health_component IN ITEMS Framework FrameworkSDK)
    set(_sqlite_health_exclude "")
    if(_sqlite_health_component STREQUAL "FrameworkSDK")
        set(_sqlite_health_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_sqlite_health_root}/docs/guides/sqlite-health.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_sqlite_health_component} ${_sqlite_health_exclude})
endforeach()
get_target_property(_sqlite_health_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
if(BUILD_TESTING AND "UMICOM_HAS_SQLITE=1" IN_LIST _sqlite_health_definitions)
    set(_sqlite_integrity_cases healthy constraint multiple limit readonly memory nested null null-output preserved long-diagnostic foreign-key-scope legacy checks-disabled)
    set(_sqlite_checkpoint_cases wal non-wal busy legacy-busy readonly nested memory null null-output retry)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sqlite-health-fixtures")
    foreach(_sqlite_health_group IN ITEMS integrity checkpoint)
        set(_sqlite_health_target "umicom-sqlite-${_sqlite_health_group}-report-test")
        add_executable(${_sqlite_health_target} "${_sqlite_health_root}/tests/data_history/test_sqlite_${_sqlite_health_group}_report.c")
        target_link_libraries(${_sqlite_health_target} PRIVATE Umicom::data)
        set_target_properties(${_sqlite_health_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_sqlite_health_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_sqlite_health_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_sqlite_health_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_sqlite_health_target} FILES "${_sqlite_health_root}/tests/data_history/readonly_fixture.h")
        endif()
        foreach(_sqlite_health_case IN LISTS _sqlite_${_sqlite_health_group}_cases)
            add_test(NAME framework.data.sqlite-health.${_sqlite_health_group}.${_sqlite_health_case}
                COMMAND ${_sqlite_health_target} ${_sqlite_health_case} "${CMAKE_CURRENT_BINARY_DIR}/sqlite-health-fixtures")
            set_tests_properties(framework.data.sqlite-health.${_sqlite_health_group}.${_sqlite_health_case} PROPERTIES TIMEOUT 30
                LABELS "framework;data;sqlite;health;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.sqlite-health.${_sqlite_health_group}.${_sqlite_health_case} TARGETS ${_sqlite_health_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_sqlite_health_root)
unset(_sqlite_health_component)
unset(_sqlite_health_exclude)
unset(_sqlite_health_definitions)
unset(_sqlite_integrity_cases)
unset(_sqlite_checkpoint_cases)
unset(_sqlite_health_group)
unset(_sqlite_health_target)
unset(_sqlite_health_case)