#-----------------------------------------------------------------------------
# Umicom Framework
# File: cmake/UmicomLocalModelsDependencies.cmake.in
#
# PURPOSE:
#   Resolve the optional download dependency before importing the native model SDK target.
#
# AUTHOR AND ORGANISATION:
# Sammy Hegab
# Umicom Foundation
#
# LICENCE:
# MIT
#-----------------------------------------------------------------------------

if(@UMICOM_MODEL_DOWNLOAD_BUILT@)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    if(NOT TARGET PkgConfig::UMICOM_MODELS_CURL)
        pkg_check_modules(UMICOM_MODELS_CURL REQUIRED IMPORTED_TARGET GLOBAL libcurl>=7.85.0)
    endif()
endif()
