# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Add semantic answers without changing the legacy form descriptor ABI.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_structured_forms_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE
    "${_structured_forms_root}/src/application/experience/form_temporal.c"
    "${_structured_forms_root}/src/application/experience/structured_form.c"
    "${_structured_forms_root}/src/application/experience/structured_form_edit.c"
    "${_structured_forms_root}/src/application/experience/structured_form_migration.c"
    "${_structured_forms_root}/src/application/experience/structured_form_snapshot.c")
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_application
        include/umicom/application/experience/form_temporal.h
        include/umicom/application/experience/structured_form.h
        include/umicom/application/experience/structured_form_edit.h
        include/umicom/application/experience/structured_form_migration.h
        include/umicom/application/experience/structured_form_snapshot.h)
endif()
foreach(_structured_forms_component IN ITEMS Framework FrameworkSDK)
    set(_structured_forms_exclude "")
    if(_structured_forms_component STREQUAL "FrameworkSDK")
        set(_structured_forms_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_structured_forms_root}/docs/guides/structured-forms.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_structured_forms_component} ${_structured_forms_exclude})
    install(DIRECTORY "${_structured_forms_root}/examples/structured_forms/"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/examples/structured_forms"
        COMPONENT ${_structured_forms_component} ${_structured_forms_exclude}
        FILES_MATCHING PATTERN "*.c" PATTERN "*.h" PATTERN "CMakeLists.txt")
endforeach()
if(BUILD_TESTING)
    foreach(_structured_forms_group IN ITEMS temporal schema answers edit migration snapshot)
        if(_structured_forms_group STREQUAL "temporal")
            set(_structured_forms_source test_form_temporal.c)
            set(_structured_forms_cases date offset ambiguous bounded)
        elseif(_structured_forms_group STREQUAL "schema")
            set(_structured_forms_source test_structured_form_schema.c)
            set(_structured_forms_cases version rules count identity unit unit-token format policy nan-range infinite-range default)
        elseif(_structured_forms_group STREQUAL "answers")
            set(_structured_forms_source test_structured_form_answers.c)
            set(_structured_forms_cases submit missing unit stale saved overflow version shape time readonly)
        elseif(_structured_forms_group STREQUAL "edit")
            set(_structured_forms_source test_structured_form_edit.c)
            set(_structured_forms_cases undo invalid-second duplicate stale-value stale-revision readonly unterminated identity empty inverse-stale)
        elseif(_structured_forms_group STREQUAL "migration")
            set(_structured_forms_source test_structured_form_migration.c)
            set(_structured_forms_cases reorder alias removed-empty unit type format constraint removed-answer unknown-policy version)
        else()
            set(_structured_forms_source test_structured_form_snapshot.c)
            set(_structured_forms_cases roundtrip truncated capacity version trailing magic field embedded-null integers alias)
        endif()
        set(_structured_forms_target umicom-form-${_structured_forms_group}-test)
        add_executable(${_structured_forms_target} "${_structured_forms_root}/tests/application_experience/${_structured_forms_source}")
        target_link_libraries(${_structured_forms_target} PRIVATE Umicom::application)
        set_target_properties(${_structured_forms_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_structured_forms_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_structured_forms_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_structured_forms_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_structured_forms_target} FILES
                "${_structured_forms_root}/tests/application_experience/structured_form_fixture.h"
                "${_structured_forms_root}/src/application/experience/structured_form_internal.h")
        endif()
        foreach(_structured_forms_case IN LISTS _structured_forms_cases)
            set(_structured_forms_test framework.structured_forms.${_structured_forms_group}.${_structured_forms_case})
            add_test(NAME ${_structured_forms_test} COMMAND ${_structured_forms_target} ${_structured_forms_case})
            set_tests_properties(${_structured_forms_test} PROPERTIES TIMEOUT 30 LABELS "framework;forms;application;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_structured_forms_test} TARGETS ${_structured_forms_target})
            endif()
        endforeach()
    endforeach()
    add_executable(umicom-structured-form-example "${_structured_forms_root}/examples/structured_forms/main.c")
    target_link_libraries(umicom-structured-form-example PRIVATE Umicom::application)
    set_target_properties(umicom-structured-form-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-structured-form-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-structured-form-example)
    endif()
    add_test(NAME framework.structured_forms.example COMMAND umicom-structured-form-example)
    set_tests_properties(framework.structured_forms.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.structured_forms.example TARGETS umicom-structured-form-example)
    endif()
endif()
unset(_structured_forms_root)
unset(_structured_forms_component)
unset(_structured_forms_exclude)
unset(_structured_forms_group)
unset(_structured_forms_source)
unset(_structured_forms_cases)
unset(_structured_forms_target)
unset(_structured_forms_case)
unset(_structured_forms_test)
