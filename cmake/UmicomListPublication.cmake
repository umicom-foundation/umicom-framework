# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Native row publication shares host checks across Explorer and other application lists.
include_guard(GLOBAL)
function(umicom_attach_list_publication)
    if(NOT TARGET umicom_ui_gtk4)
        return()
    endif()
    get_target_property(attached umicom_ui_gtk4 UMICOM_LIST_PUBLICATION_ATTACHED)
    if(attached)
        return()
    endif()
    set_target_properties(umicom_ui_gtk4 PROPERTIES UMICOM_LIST_PUBLICATION_ATTACHED TRUE)
    target_sources(umicom_ui_gtk4 PRIVATE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../adapters/gtk4/list_publication.c")
    if(NOT BUILD_TESTING)
        return()
    endif()
    add_executable(umicom-list-publication-test
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/gui_control_checks/test_list_publication.c")
    target_link_libraries(umicom-list-publication-test PRIVATE Umicom::ui_gtk4)
    set_target_properties(umicom-list-publication-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    umicom_apply_warnings(umicom-list-publication-test)
    umicom_apply_sanitizers(umicom-list-publication-test)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-list-publication-test)
    endif()
    foreach(case normal empty denied cancel-remove cancel-append reenter release-input foreign-removal-row foreign-append-row parented duplicate floating invalid capacity old-capacity ancestor native-root)
        add_test(NAME framework.ui.list_publication.${case} COMMAND umicom-list-publication-test "${case}")
        set_tests_properties(framework.ui.list_publication.${case} PROPERTIES
            TIMEOUT 45 SKIP_RETURN_CODE 77 LABELS "framework;gtk4;list;ownership;regression")
    endforeach()
endfunction()
umicom_attach_list_publication()
if(NOT TARGET umicom_ui_gtk4)
    cmake_language(DEFER CALL umicom_attach_list_publication)
endif()
