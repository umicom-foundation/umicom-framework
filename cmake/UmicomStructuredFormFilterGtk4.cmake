# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# A reusable native query editor shares parsing and revision rules with other hosts.
if(NOT TARGET Umicom::ui_gtk4 OR NOT TARGET Umicom::application)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_form_filter_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_structured_form_filter_gtk4 STATIC "${_form_filter_root}/adapters/gtk4/structured_form_filter_gtk4.c")
add_library(Umicom::structured_form_filter_gtk4 ALIAS umicom_structured_form_filter_gtk4)
set_target_properties(umicom_structured_form_filter_gtk4 PROPERTIES EXPORT_NAME structured_form_filter_gtk4
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
target_link_libraries(umicom_structured_form_filter_gtk4 PUBLIC Umicom::application Umicom::ui_gtk4)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_structured_form_filter_gtk4)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_structured_form_filter_gtk4)
endif()
install(TARGETS umicom_structured_form_filter_gtk4 EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_structured_form_filter_gtk4)
install(FILES "${_form_filter_root}/include/umicom/ui/gtk4/structured_form_filter.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_structured_form_filter_gtk4 include/umicom/ui/gtk4/structured_form_filter.h)
endif()
foreach(_form_filter_component IN ITEMS Framework FrameworkSDK)
    set(_form_filter_exclude "")
    if(_form_filter_component STREQUAL "FrameworkSDK")
        set(_form_filter_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_filter_root}/docs/guides/native-typed-filters.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_filter_component} ${_form_filter_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-form-filter-gtk-test "${_form_filter_root}/tests/application_experience/test_structured_form_filter_gtk4.c")
    target_link_libraries(umicom-form-filter-gtk-test PRIVATE Umicom::structured_form_filter_gtk4)
    set_target_properties(umicom-form-filter-gtk-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-filter-gtk-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-filter-gtk-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-filter-gtk-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-filter-gtk-test FILES
            "${_form_filter_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_filter_case IN ITEMS empty add-button remove-button typed invalid-text outside-threshold state-retains-text unit set set-invalid-preserved stale-add stale-remove stale-set capacity remove-invalid retained-row retained-control retired disposed null secret utf8-label utf8-value reenter-observer edit-observer read-observer retire-observer clear multiterm long-value invalid-selection retained-add)
        add_test(NAME framework.structured_forms.filter.gtk.${_form_filter_case}
            COMMAND umicom-form-filter-gtk-test ${_form_filter_case})
        set_tests_properties(framework.structured_forms.filter.gtk.${_form_filter_case} PROPERTIES
            TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings"
            LABELS "framework;forms;gtk4;search;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.filter.gtk.${_form_filter_case} TARGETS umicom-form-filter-gtk-test)
        endif()
    endforeach()
endif()
unset(_form_filter_root)
unset(_form_filter_component)
unset(_form_filter_exclude)
unset(_form_filter_case)
