# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Saved definitions are portable; persistence composes existing atomic records.
if(NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_preset_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_application PRIVATE
    "${_form_preset_root}/src/application/experience/structured_form_filter_snapshot.c"
    "${_form_preset_root}/src/application/experience/structured_form_search_preset.c")
foreach(_form_preset_header IN ITEMS structured_form_filter_snapshot structured_form_search_preset)
    install(FILES "${_form_preset_root}/include/umicom/application/experience/${_form_preset_header}.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/application/experience" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_application "include/umicom/application/experience/${_form_preset_header}.h")
    endif()
endforeach()
if(TARGET umicom_form_records)
    target_sources(umicom_form_records PRIVATE "${_form_preset_root}/src/data/structured_form_search_preset.c")
    install(FILES "${_form_preset_root}/include/umicom/data/structured_form_search_preset.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_search_preset.h)
    endif()
endif()
foreach(_form_preset_component IN ITEMS Framework FrameworkSDK)
    set(_form_preset_exclude "")
    if(_form_preset_component STREQUAL "FrameworkSDK")
        set(_form_preset_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_preset_root}/docs/guides/saved-form-searches.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_preset_component} ${_form_preset_exclude})
endforeach()
if(BUILD_TESTING)
    set(_form_preset_filter_cases roundtrip empty states integer-min integer-max boolean text maximum outside-range inactive capacity truncation trailing magic version identity unit type format field count operator state embedded-nul noncanonical alias-encode alias-decode null)
    set(_form_preset_definition_cases roundtrip title-empty title-control title-termination prefix-empty prefix-dot prefix-character prefix-termination metadata-termination filter-invalid empty-filter unicode capacity truncation trailing magic embedded-nul schema alias-encode alias-decode null)
    set(_form_preset_record_cases create amend historical stale collision missing namespace empty-key key-character key-length unclosed-id invalid-preset wrong-schema reviewed reviewed-stale reviewed-metadata malformed malformed-amend metadata-only nested-save nested-load query query-zero query-large query-alias null)
    foreach(_form_preset_group IN ITEMS filter definition record)
        set(_form_preset_target "umicom-form-preset-${_form_preset_group}-test")
        set(_form_preset_backends memory)
        if(_form_preset_group STREQUAL "filter")
            set(_form_preset_source tests/application_experience/test_structured_form_filter_snapshot.c)
            set(_form_preset_library Umicom::application)
        elseif(_form_preset_group STREQUAL "definition")
            set(_form_preset_source tests/application_experience/test_structured_form_search_preset.c)
            set(_form_preset_library Umicom::application)
        elseif(TARGET Umicom::form_records)
            set(_form_preset_source tests/data_history/test_structured_form_search_preset.c)
            set(_form_preset_library Umicom::form_records)
            get_target_property(_form_preset_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
            if("UMICOM_HAS_SQLITE=1" IN_LIST _form_preset_definitions)
                list(APPEND _form_preset_backends sqlite)
            endif()
        else()
            continue()
        endif()
        add_executable(${_form_preset_target} "${_form_preset_root}/${_form_preset_source}")
        target_link_libraries(${_form_preset_target} PRIVATE ${_form_preset_library})
        set_target_properties(${_form_preset_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_form_preset_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_form_preset_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_form_preset_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_form_preset_target} FILES "${_form_preset_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_form_preset_backend IN LISTS _form_preset_backends)
            set(_form_preset_args "")
            if(_form_preset_backend STREQUAL "sqlite")
                set(_form_preset_args sqlite)
            endif()
            foreach(_form_preset_case IN LISTS _form_preset_${_form_preset_group}_cases)
                set(_form_preset_test framework.structured_forms.saved-search.${_form_preset_group}.${_form_preset_backend}.${_form_preset_case})
                add_test(NAME ${_form_preset_test} COMMAND ${_form_preset_target} ${_form_preset_case} ${_form_preset_args})
                set_tests_properties(${_form_preset_test} PROPERTIES TIMEOUT 30 LABELS "framework;forms;saved-search;${_form_preset_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_form_preset_test} TARGETS ${_form_preset_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(TARGET Umicom::form_records)
        add_executable(umicom-form-search-presets-example "${_form_preset_root}/examples/data_history/form_search_presets.c")
        target_link_libraries(umicom-form-search-presets-example PRIVATE Umicom::form_records)
        set_target_properties(umicom-form-search-presets-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(umicom-form-search-presets-example)
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(umicom-form-search-presets-example)
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(umicom-form-search-presets-example)
        endif()
        add_test(NAME framework.structured_forms.saved-search.example COMMAND umicom-form-search-presets-example)
        set_tests_properties(framework.structured_forms.saved-search.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;saved-search;example")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.saved-search.example TARGETS umicom-form-search-presets-example)
        endif()
    endif()
endif()
unset(_form_preset_root)
unset(_form_preset_header)
unset(_form_preset_component)
unset(_form_preset_exclude)
unset(_form_preset_filter_cases)
unset(_form_preset_definition_cases)
unset(_form_preset_record_cases)
unset(_form_preset_group)
unset(_form_preset_target)
unset(_form_preset_backends)
unset(_form_preset_source)
unset(_form_preset_library)
unset(_form_preset_definitions)
unset(_form_preset_backend)
unset(_form_preset_args)
unset(_form_preset_case)
unset(_form_preset_test)
