# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Keep typed form composition separate from both foundational libraries.
if(NOT TARGET Umicom::application OR NOT TARGET Umicom::authorized_records)
    return()
endif()
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/UmicomSdkComponent.cmake")
include(GNUInstallDirs)
get_filename_component(_authorized_form_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(umicom_authorized_form_records STATIC "${_authorized_form_root}/src/data/authorized_form_records.c")
add_library(Umicom::authorized_form_records ALIAS umicom_authorized_form_records)
target_link_libraries(umicom_authorized_form_records PUBLIC Umicom::application Umicom::authorized_records)
set_target_properties(umicom_authorized_form_records PROPERTIES EXPORT_NAME authorized_form_records
    C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(COMMAND umicom_apply_warnings)
    umicom_apply_warnings(umicom_authorized_form_records)
endif()
if(COMMAND umicom_apply_sanitizers)
    umicom_apply_sanitizers(umicom_authorized_form_records)
endif()
install(TARGETS umicom_authorized_form_records EXPORT UmicomFrameworkTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT Framework)
umicom_register_sdk_libraries(umicom_authorized_form_records)
install(FILES "${_authorized_form_root}/include/umicom/data/authorized_form_records.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_authorized_form_records include/umicom/data/authorized_form_records.h)
endif()
foreach(_authorized_form_component IN ITEMS Framework FrameworkSDK)
    set(_authorized_form_exclude "")
    if(_authorized_form_component STREQUAL "FrameworkSDK")
        set(_authorized_form_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_authorized_form_root}/docs/guides/authorized-form-records.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_authorized_form_component} ${_authorized_form_exclude})
endforeach()
if(BUILD_TESTING)
    set(_authorized_form_load_cases latest history reviewed schema-version foreign-payload denied-before-decode
        history-denied reviewed-stale latest-after-amend history-after-amend reviewed-other reviewed-tampered
        disabled revoked wrong-purpose wrong-operation missing nested null-schema null)
    set(_authorized_form_save_cases create unanswered-draft caller-dirty occupied foreign-previous amend stale
        previous-schema read-required amend-required revoked-after-review edit-versus-record create-denied
        disabled wrong-purpose invalid-answer wrong-input-schema wrong-mode nested invalid-reason overflow null)
    set(_authorized_form_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _authorized_form_backends sqlite)
    endif()
    foreach(_authorized_form_group IN ITEMS load save)
        set(_authorized_form_target "umicom-authorized-form-${_authorized_form_group}-test")
        add_executable(${_authorized_form_target}
            "${_authorized_form_root}/tests/data_history/test_authorized_form_${_authorized_form_group}.c")
        target_link_libraries(${_authorized_form_target} PRIVATE Umicom::authorized_form_records)
        set_target_properties(${_authorized_form_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_authorized_form_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_authorized_form_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_authorized_form_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_authorized_form_target} FILES
                "${_authorized_form_root}/tests/data_history/authorized_form_fixture.h"
                "${_authorized_form_root}/tests/security/record_access_fixture.h"
                "${_authorized_form_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_authorized_form_backend IN LISTS _authorized_form_backends)
            foreach(_authorized_form_case IN LISTS _authorized_form_${_authorized_form_group}_cases)
                set(_authorized_form_test "framework.authorized_forms.${_authorized_form_group}.${_authorized_form_backend}.${_authorized_form_case}")
                add_test(NAME ${_authorized_form_test} COMMAND ${_authorized_form_target}
                    ${_authorized_form_backend} ${_authorized_form_case})
                set_tests_properties(${_authorized_form_test} PROPERTIES TIMEOUT 30
                    LABELS "framework;forms;security;data;${_authorized_form_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_authorized_form_test} TARGETS ${_authorized_form_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
unset(_authorized_form_root)
unset(_authorized_form_component)
unset(_authorized_form_exclude)
unset(_authorized_form_load_cases)
unset(_authorized_form_save_cases)
unset(_authorized_form_backends)
unset(_authorized_form_group)
unset(_authorized_form_target)
unset(_authorized_form_backend)
unset(_authorized_form_case)
unset(_authorized_form_test)
