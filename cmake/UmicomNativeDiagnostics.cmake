include_guard(GLOBAL)
if(BUILD_TESTING)
    add_executable(umicom-native-diagnostics-test "${CMAKE_CURRENT_LIST_DIR}/../tests/language_runtime/test_native_diagnostics.c")
    target_link_libraries(umicom-native-diagnostics-test PRIVATE Umicom::developer Umicom::editor Umicom::platform)
    umicom_apply_warnings(umicom-native-diagnostics-test)
    umicom_apply_sanitizers(umicom-native-diagnostics-test)
    if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_link_options(umicom-native-diagnostics-test PRIVATE -municode)
    endif()
    add_dependencies(umicom-native-diagnostics-test umicom-language-process-fixture)
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-native-diagnostics-test)
    endif()
    foreach(case valid unicode empty literal invalid timeout encoding shutdown cancel surrogate outside related choices wrong-uri stale unversioned)
        add_test(NAME framework.language_runtime.native_diagnostics.${case} COMMAND umicom-native-diagnostics-test ${case} "$<TARGET_FILE:umicom-language-process-fixture>")
        set_tests_properties(framework.language_runtime.native_diagnostics.${case} PROPERTIES TIMEOUT 40
            LABELS "framework;language;diagnostics;native;ownership;regression")
    endforeach()
endif()
