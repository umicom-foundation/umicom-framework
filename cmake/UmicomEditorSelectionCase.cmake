# File: cmake/UmicomEditorSelectionCase.cmake
# PURPOSE: Register selection case coverage for editor and document consumers.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_case_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
install(FILES "${_case_root}/docs/guides/selection-case-conversion.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_case_plan_cases uppercase lowercase partial reverse unicode emoji punctuation unchanged crlf
        multiline empty utf8 boundary range nul bare-cr limit cancel owned arguments version)
    set(_case_engine_cases uppercase lowercase high-bytes reverse)
    set(_case_document_cases uppercase lowercase unicode unchanged empty readonly inactive closed
        identity pending command argument selection)
    set(_case_catalogue_cases count resolve sort case unknown)
    foreach(_case_group IN ITEMS plan engine document catalogue)
        if(_case_group STREQUAL "plan")
            set(_case_source tests/editor/test_selection_case.c)
            set(_case_library Umicom::editor)
        elseif(_case_group STREQUAL "engine")
            set(_case_source tests/editor/test_case_engine.c)
            set(_case_library Umicom::editor)
        else()
            if(NOT TARGET Umicom::document)
                continue()
            endif()
            if(_case_group STREQUAL "document")
                set(_case_source tests/document/test_selection_case.c)
            else()
                set(_case_source tests/document/test_selection_command_catalogue.c)
            endif()
            set(_case_library Umicom::document)
        endif()
        set(_case_target "umicom-selection-case-${_case_group}-test")
        add_executable(${_case_target} "${_case_root}/${_case_source}")
        target_link_libraries(${_case_target} PRIVATE ${_case_library})
        set_target_properties(${_case_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_case_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_case_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_case_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_case_target} FILES
                "${_case_root}/src/editor/line_edit_plan.inc"
                "${_case_root}/src/document/line_edit.inc"
                "${_case_root}/src/document/line_edit_commands.inc"
                "${_case_root}/tests/document/replacement_fixture.h")
        endif()
        foreach(_case_name IN LISTS _case_${_case_group}_cases)
            set(_case_test "framework.editor.selection_case.${_case_group}.${_case_name}")
            add_test(NAME ${_case_test} COMMAND ${_case_target} ${_case_name})
            set_tests_properties(${_case_test} PROPERTIES TIMEOUT 30
                LABELS "framework;editor;document;selection;case;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_case_test} TARGETS ${_case_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_case_root)
unset(_case_group)
unset(_case_source)
unset(_case_library)
unset(_case_target)
unset(_case_test)
unset(_case_name)
unset(_case_plan_cases)
unset(_case_engine_cases)
unset(_case_document_cases)
unset(_case_catalogue_cases)
