# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Search drafts reuse the existing record owner and recovery codec.
if(NOT TARGET umicom_form_records)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_search_session_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_form_records PRIVATE "${_search_session_root}/src/data/structured_form_search_session.c")
install(FILES "${_search_session_root}/include/umicom/data/structured_form_search_session.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_search_session.h)
endif()
foreach(_search_session_component IN ITEMS Framework FrameworkSDK)
    set(_search_session_exclude "")
    if(_search_session_component STREQUAL "FrameworkSDK")
        set(_search_session_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_search_session_root}/docs/guides/search-draft-recovery.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_search_session_component} ${_search_session_exclude})
endforeach()
if(BUILD_TESTING)
    set(_search_session_lifecycle_cases empty begin open edit no-op revert stale-edit stale-generation dirty-begin dirty-open discard-new discard-saved reopen invalid-title invalid-filter wrong-scope bad-entity open-digest open-scope open-schema create-invalid null)
    set(_search_session_save_cases new amend clean invalid-attribution zero-time stale-edit stale-generation prepare busy later-edit failure wrong-token wrong-metadata duplicate-completion stale-head collision discard-pending restore-pending capture-pending request-tamper null)
    set(_search_session_recovery_cases new saved clean codec wrong-current-scope wrong-baseline-scope wrong-schema wrong-entity damaged-baseline damaged-current new-baseline-metadata dirty-target clean-target wrong-store later-head capture-empty null)
    get_target_property(_search_session_definitions Umicom::data INTERFACE_COMPILE_DEFINITIONS)
    foreach(_search_session_group IN ITEMS lifecycle save recovery)
        set(_search_session_target "umicom-search-session-${_search_session_group}-test")
        set(_search_session_backends memory)
        if(NOT _search_session_group STREQUAL "lifecycle" AND "UMICOM_HAS_SQLITE=1" IN_LIST _search_session_definitions)
            list(APPEND _search_session_backends sqlite)
        endif()
        add_executable(${_search_session_target} "${_search_session_root}/tests/data_history/test_search_session_${_search_session_group}.c")
        target_link_libraries(${_search_session_target} PRIVATE Umicom::form_records)
        set_target_properties(${_search_session_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_search_session_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_search_session_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_search_session_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_search_session_target} FILES
                "${_search_session_root}/tests/data_history/search_session_fixture.h"
                "${_search_session_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_search_session_backend IN LISTS _search_session_backends)
            set(_search_session_args "")
            if(_search_session_backend STREQUAL "sqlite")
                set(_search_session_args sqlite)
            endif()
            foreach(_search_session_case IN LISTS _search_session_${_search_session_group}_cases)
                set(_search_session_test "framework.structured_forms.search-session.${_search_session_group}.${_search_session_backend}.${_search_session_case}")
                add_test(NAME ${_search_session_test} COMMAND ${_search_session_target} ${_search_session_case} ${_search_session_args})
                set_tests_properties(${_search_session_test} PROPERTIES TIMEOUT 30 LABELS "framework;forms;search-session;${_search_session_backend};regression")
                if(COMMAND umicom_test_impact_owners)
                    umicom_test_impact_owners(${_search_session_test} TARGETS ${_search_session_target})
                endif()
            endforeach()
        endforeach()
    endforeach()
    add_executable(umicom-search-recovery-example "${_search_session_root}/examples/data_history/form_search_recovery.c")
    target_link_libraries(umicom-search-recovery-example PRIVATE Umicom::form_records)
    set_target_properties(umicom-search-recovery-example PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-search-recovery-example)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-search-recovery-example)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-search-recovery-example)
    endif()
    add_test(NAME framework.structured_forms.search-session.example COMMAND umicom-search-recovery-example)
    set_tests_properties(framework.structured_forms.search-session.example PROPERTIES TIMEOUT 30 LABELS "framework;forms;search-session;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.structured_forms.search-session.example TARGETS umicom-search-recovery-example)
    endif()
endif()
unset(_search_session_root)
unset(_search_session_component)
unset(_search_session_exclude)
unset(_search_session_lifecycle_cases)
unset(_search_session_save_cases)
unset(_search_session_recovery_cases)
unset(_search_session_definitions)
unset(_search_session_group)
unset(_search_session_target)
unset(_search_session_backends)
unset(_search_session_backend)
unset(_search_session_args)
unset(_search_session_case)
unset(_search_session_test)
