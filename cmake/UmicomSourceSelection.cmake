# Umicom Framework
# File: cmake/UmicomSourceSelection.cmake
# PURPOSE: Export source selection and register focused engine, document and native checks.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor OR NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_unit_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_unit_pair IN ITEMS "editor/source_selection.h|umicom_editor" "document/source_selection.h|umicom_document")
    string(REPLACE "|" ";" _unit_parts "${_unit_pair}")
    list(GET _unit_parts 0 _unit_header)
    list(GET _unit_parts 1 _unit_owner)
    get_filename_component(_unit_directory "${_unit_header}" DIRECTORY)
    install(FILES "${_unit_root}/include/umicom/${_unit_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_unit_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_unit_owner} "include/umicom/${_unit_header}")
    endif()
endforeach()
if(TARGET umicom_ui_gtk4)
    install(FILES "${_unit_root}/include/umicom/ui/gtk4/source_selection.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 "include/umicom/ui/gtk4/source_selection.h")
    endif()
endif()
install(FILES "${_unit_root}/docs/guides/source-selection.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_unit_engine_cases word-start word-middle word-end next-word word-eof underscore digits before-dot after-dot unicode-word nonbmp-word combining line-start line-middle line-ending line-lf line-crlf line-cr after-crlf final-empty empty empty-ending no-final blank-line whitespace-line unicode-line)
    set(_unit_bounds_cases arguments missing-word empty-word punctuation bad-caret split-utf8 split-crlf overlong truncated nul invalid-kind oversized view-version view-capacity)
    set(_unit_document_cases word line line-ending readonly pending inactive history existing-selection no-word empty-line unicode closed arguments catalogue invalid-kind)
    set(_unit_native_cases word line line-ending readonly pending no-word completion-retire unbound arguments)
    foreach(_unit_group IN ITEMS engine bounds document native)
        set(_unit_owner editor)
        set(_unit_source "tests/editor/test_source_selection.c")
        if(_unit_group STREQUAL "bounds")
            set(_unit_source "tests/editor/test_source_selection_bounds.c")
        elseif(_unit_group STREQUAL "document")
            set(_unit_source "tests/document/test_source_selection.c")
            set(_unit_owner document)
        elseif(_unit_group STREQUAL "native")
            set(_unit_source "tests/document/test_source_selection_gtk4.c")
            set(_unit_owner ui_gtk4)
        endif()
        if(NOT TARGET umicom_${_unit_owner})
            continue()
        endif()
        set(_unit_target "umicom-source-select-${_unit_group}-test")
        add_executable(${_unit_target} "${_unit_root}/${_unit_source}")
        target_link_libraries(${_unit_target} PRIVATE Umicom::${_unit_owner})
        set_target_properties(${_unit_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_unit_target})
        umicom_apply_sanitizers(${_unit_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_unit_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_unit_target} FILES
                "${_unit_root}/src/editor/source_selection.c"
                "${_unit_root}/src/document/source_selection.c"
                "${_unit_root}/adapters/gtk4/document_source_selection.inc"
                "${_unit_root}/tests/document/replacement_fixture.h"
                "${_unit_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_unit_case IN LISTS _unit_${_unit_group}_cases)
            set(_unit_test "framework.source_selection.${_unit_group}.${_unit_case}")
            add_test(NAME ${_unit_test} COMMAND ${_unit_target} ${_unit_case})
            set_tests_properties(${_unit_test} PROPERTIES TIMEOUT 60 LABELS "framework;editor;document;source-selection;regression")
            if(_unit_group STREQUAL "native")
                set_tests_properties(${_unit_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;source-selection;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_unit_test} TARGETS ${_unit_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_unit_variable IN ITEMS root pair parts header owner directory group source target case test engine_cases bounds_cases document_cases native_cases)
    unset(_unit_${_unit_variable})
endforeach()
unset(_unit_variable)
