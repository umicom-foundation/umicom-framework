if(BUILD_TESTING)
    function(umicom_add_regulatory_reporting_test target test_name source)
        if(TARGET "${target}")
            return()
        endif()
        add_executable("${target}" "${UMICOM_REGULATORY_REPORTING_ROOT}/${source}")
        target_link_libraries("${target}" PRIVATE Umicom::finance)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings("${target}")
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers("${target}")
        endif()
        add_test(NAME "${test_name}" COMMAND "${target}")
        set_tests_properties("${test_name}" PROPERTIES LABELS "framework;regulatory-reporting;data-governance;financial-control")
    endfunction()

