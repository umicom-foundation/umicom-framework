# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Typed transfer adds semantic review to portable history integrity.
if(NOT TARGET umicom_form_records)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_bundle_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_form_records PRIVATE "${_form_bundle_root}/src/data/structured_form_bundle.c")
install(FILES "${_form_bundle_root}/include/umicom/data/structured_form_bundle.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_bundle.h)
endif()
if(BUILD_TESTING)
    add_executable(umicom-form-bundle-test "${_form_bundle_root}/tests/data_history/test_structured_form_bundle.c")
    target_link_libraries(umicom-form-bundle-test PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-bundle-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-bundle-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-bundle-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-bundle-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-bundle-test FILES
            "${_form_bundle_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_bundle_case IN ITEMS receipt receipt-digest receipt-collision summary history restore collision nested wrong-digest short-digest namespace namespace-invalid
        empty-suffix key-policy key-rejected foreign-history foreign-current unknown-history unknown-current invalid-history invalid-current
        owned-copy draft bad-index null provenance clone)
        set(_form_bundle_test framework.structured_forms.bundle.${_form_bundle_case})
        add_test(NAME ${_form_bundle_test} COMMAND umicom-form-bundle-test ${_form_bundle_case})
        set_tests_properties(${_form_bundle_test} PROPERTIES TIMEOUT 30 LABELS "framework;forms;data;record-bundle;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${_form_bundle_test} TARGETS umicom-form-bundle-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME ${_form_bundle_test}.sqlite COMMAND umicom-form-bundle-test ${_form_bundle_case} sqlite)
            set_tests_properties(${_form_bundle_test}.sqlite PROPERTIES TIMEOUT 30 LABELS "framework;forms;data;sqlite;record-bundle;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_form_bundle_test}.sqlite TARGETS umicom-form-bundle-test)
            endif()
        endif()
    endforeach()
endif()
foreach(_form_bundle_doc_component IN ITEMS Framework FrameworkSDK)
    set(_form_bundle_doc_exclude "")
    if(_form_bundle_doc_component STREQUAL "FrameworkSDK")
        set(_form_bundle_doc_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_bundle_root}/docs/guides/form-record-transfer.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_bundle_doc_component} ${_form_bundle_doc_exclude})
endforeach()
unset(_form_bundle_root)
unset(_form_bundle_case)
unset(_form_bundle_test)
unset(_form_bundle_doc_component)
unset(_form_bundle_doc_exclude)
