include_guard(GLOBAL)
include(GNUInstallDirs)
if(TARGET umicom_document)
    install(FILES "${CMAKE_CURRENT_LIST_DIR}/../include/umicom/document/bookmark_selection.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/document" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_document include/umicom/document/bookmark_selection.h)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom_document FILES
            "${CMAKE_CURRENT_LIST_DIR}/../src/document/bookmark_selection.inc")
    endif()
endif()
if(TARGET umicom_ui_gtk4)
    install(FILES "${CMAKE_CURRENT_LIST_DIR}/../include/umicom/ui/gtk4/bookmark_panel.h"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(umicom_ui_gtk4 include/umicom/ui/gtk4/bookmark_panel.h)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom_ui_gtk4 FILES
            "${CMAKE_CURRENT_LIST_DIR}/../adapters/gtk4/document_bookmark_panel.inc")
    endif()
endif()
if(TARGET umicom_developer)
    foreach(group surface_profiles activation_profiles command_aliases)
        if(group STREQUAL "command_aliases")
            set(header "view_bookmarks.h")
        else()
            set(header "bookmarks.h")
        endif()
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/../include/umicom/studio_runtime/${group}/${header}"
            DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/studio_runtime/${group}" COMPONENT Framework)
        if(COMMAND umicom_release_inventory_own_headers)
            umicom_release_inventory_own_headers(umicom_developer include/umicom/studio_runtime/${group}/${header})
        endif()
    endforeach()
endif()
install(FILES "${CMAKE_CURRENT_LIST_DIR}/../docs/guides/session-bookmark-panel.html"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(NOT BUILD_TESTING)
    return()
endif()
function(umicom_bookmark_panel_group group owner)
    if(NOT TARGET ${owner})
        return()
    endif()
    set(target "umi-bookmark-${group}-test")
    add_executable(${target} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/bookmark_selection/test_${group}.c")
    target_link_libraries(${target} PRIVATE ${owner})
    set_target_properties(${target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    umicom_apply_warnings(${target})
    umicom_apply_sanitizers(${target})
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(${target})
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(${target} FILES
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/bookmark_selection/fixture.h")
    endif()
    foreach(case IN LISTS ARGN)
        set(test "framework.document.bookmark_panel.${group}.${case}")
        set(directory "${CMAKE_CURRENT_BINARY_DIR}/qualification/bookmark-panel/${group}/${case}")
        file(MAKE_DIRECTORY "${directory}")
        add_test(NAME ${test} COMMAND ${target} ${case})
        set_tests_properties(${test} PROPERTIES TIMEOUT 60 WORKING_DIRECTORY "${directory}"
            LABELS "framework;document;bookmarks;regression")
        if(group STREQUAL "native")
            set_tests_properties(${test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings")
        endif()
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(${test} TARGETS ${target})
        endif()
    endforeach()
endfunction()
umicom_bookmark_panel_group(selection Umicom::document visit remove stale-visit stale-remove bounds null closed same-name-reopen removed-line readonly history metadata first middle last stale-after-remove)
umicom_bookmark_panel_group(native Umicom::ui_gtk4 visit remove closed stale retained-row unbound retired callback-unbind callback-close summary-unbind refresh-reentry save-busy close-busy invalid detached-control context-destroy)
umicom_bookmark_panel_group(catalogue Umicom::developer identity activation alias contract layout old-layout)
