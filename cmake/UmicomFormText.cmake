# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# One numeric boundary serves native and web form adapters.
if(NOT TARGET umicom_base OR NOT TARGET umicom_application)
    return()
endif()
include_guard(GLOBAL)
get_filename_component(_form_text_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_base PRIVATE "${_form_text_root}/src/base/ascii_number.c")
target_sources(umicom_application PRIVATE "${_form_text_root}/src/application/experience/structured_form_text.c")
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_base include/umicom/base/ascii_number.h)
    umicom_release_inventory_own_headers(umicom_application include/umicom/application/experience/structured_form_text.h)
endif()
if(BUILD_TESTING)
    foreach(_form_text_group IN ITEMS ascii text)
        if(_form_text_group STREQUAL "ascii")
            set(_form_text_source tests/application_experience/test_ascii_number.c)
            set(_form_text_cases unsigned signed overflow spelling decimal roundtrip subnormal capacity locale embedded bounded negative-zero)
        else()
            set(_form_text_source tests/application_experience/test_structured_form_text.c)
            set(_form_text_cases decimal integer boolean text missing unit stale-storage unterminated range format capacity choice)
        endif()
        set(_form_text_target umicom-form-${_form_text_group}-test)
        add_executable(${_form_text_target} "${_form_text_root}/${_form_text_source}")
        target_link_libraries(${_form_text_target} PRIVATE Umicom::application)
        set_target_properties(${_form_text_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_form_text_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_form_text_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_form_text_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_form_text_target} FILES "${_form_text_root}/tests/application_experience/structured_form_fixture.h")
        endif()
        foreach(_form_text_case IN LISTS _form_text_cases)
            add_test(NAME framework.structured_forms.${_form_text_group}.${_form_text_case}
                COMMAND ${_form_text_target} ${_form_text_case})
            set_tests_properties(framework.structured_forms.${_form_text_group}.${_form_text_case}
                PROPERTIES TIMEOUT 30 LABELS "framework;forms;regression" SKIP_RETURN_CODE 77)
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.${_form_text_group}.${_form_text_case} TARGETS ${_form_text_target})
            endif()
        endforeach()
    endforeach()
endif()
unset(_form_text_root)
unset(_form_text_group)
unset(_form_text_source)
unset(_form_text_cases)
unset(_form_text_target)
unset(_form_text_case)