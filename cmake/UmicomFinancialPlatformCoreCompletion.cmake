if(BUILD_TESTING)
    function(umicom_add_financial_platform_test target test_name source)
        if(TARGET "${target}")
            return()
        endif()

        add_executable(
            "${target}"
            "${CMAKE_CURRENT_LIST_DIR}/../tests/financial_platform/${source}"
        )

        target_link_libraries("${target}" PRIVATE Umicom::finance)

        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings("${target}")
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers("${target}")
        endif()

        add_test(NAME "${test_name}" COMMAND "${target}")
        set_tests_properties(
            "${test_name}"
            PROPERTIES LABELS
            "framework;financial-platform;finance;payments;ledger;settlement;reconciliation"
        )
    endfunction()

