# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Keep typed session ownership beside the existing form/record composition.
if(NOT TARGET umicom_form_records)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_form_session_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(umicom_form_records PRIVATE "${_form_session_root}/src/data/structured_form_session.c")
install(FILES "${_form_session_root}/include/umicom/data/structured_form_session.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/data" COMPONENT Framework)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_form_records include/umicom/data/structured_form_session.h)
endif()
foreach(_form_session_component IN ITEMS Framework FrameworkSDK)
    set(_form_session_exclude "")
    if(_form_session_component STREQUAL "FrameworkSDK")
        set(_form_session_exclude EXCLUDE_FROM_ALL)
    endif()
    install(FILES "${_form_session_root}/docs/guides/form-sessions.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT ${_form_session_component} ${_form_session_exclude})
endforeach()
if(BUILD_TESTING)
    add_executable(umicom-form-session-test "${_form_session_root}/tests/data_history/test_structured_form_session.c")
    target_link_libraries(umicom-form-session-test PRIVATE Umicom::form_records)
    set_target_properties(umicom-form-session-test PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(COMMAND umicom_apply_warnings)
        umicom_apply_warnings(umicom-form-session-test)
    endif()
    if(COMMAND umicom_apply_sanitizers)
        umicom_apply_sanitizers(umicom-form-session-test)
    endif()
    if(COMMAND umicom_register_validation_target)
        umicom_register_validation_target(umicom-form-session-test)
    endif()
    if(COMMAND umicom_target_qualification_inputs)
        umicom_target_qualification_inputs(umicom-form-session-test FILES
            "${_form_session_root}/tests/application_experience/structured_form_fixture.h")
    endif()
    foreach(_form_session_case IN ITEMS begin discard-new context required recovery-new recovery-schema pending failed-save later-edit wrong-reply roundtrip no-op recovery-saved request-lifetime recovery-conflict)
        add_test(NAME framework.structured_forms.session.${_form_session_case}
            COMMAND umicom-form-session-test ${_form_session_case})
        set_tests_properties(framework.structured_forms.session.${_form_session_case}
            PROPERTIES TIMEOUT 30 LABELS "framework;forms;data;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.structured_forms.session.${_form_session_case} TARGETS umicom-form-session-test)
        endif()
        if(SQLite3_FOUND)
            add_test(NAME framework.structured_forms.session.sqlite.${_form_session_case}
                COMMAND umicom-form-session-test ${_form_session_case} sqlite)
            set_tests_properties(framework.structured_forms.session.sqlite.${_form_session_case}
                PROPERTIES TIMEOUT 30 LABELS "framework;forms;data;sqlite;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.structured_forms.session.sqlite.${_form_session_case} TARGETS umicom-form-session-test)
            endif()
        endif()
    endforeach()
endif()
unset(_form_session_root)
unset(_form_session_component)
unset(_form_session_exclude)
unset(_form_session_case)