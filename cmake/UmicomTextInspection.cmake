# File: cmake/UmicomTextInspection.cmake
# PURPOSE: Export read-only source inspection and register independently named regression cases.
# AUTHOR AND ORGANISATION: Sammy Hegab, Umicom Foundation
# LICENCE: MIT
if(NOT TARGET umicom_editor OR NOT TARGET umicom_document)
    return()
endif()
include_guard(GLOBAL)
include(GNUInstallDirs)
get_filename_component(_inspect_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_inspect_pair IN ITEMS "editor/text_inspection.h|umicom_editor" "document/inspection.h|umicom_document")
    string(REPLACE "|" ";" _inspect_parts "${_inspect_pair}")
    list(GET _inspect_parts 0 _inspect_header)
    list(GET _inspect_parts 1 _inspect_target)
    get_filename_component(_inspect_directory "${_inspect_header}" DIRECTORY)
    install(FILES "${_inspect_root}/include/umicom/${_inspect_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/${_inspect_directory}" COMPONENT Framework)
    if(COMMAND umicom_release_inventory_own_headers)
        umicom_release_inventory_own_headers(${_inspect_target} "include/umicom/${_inspect_header}")
    endif()
endforeach()
if(TARGET umicom_ui_gtk4)
    target_sources(umicom_ui_gtk4 PRIVATE "${_inspect_root}/adapters/gtk4/text_inspection_gtk4.c" "${_inspect_root}/adapters/gtk4/document_inspection_gtk4.c")
    foreach(_inspect_header IN ITEMS text_inspection document_inspection)
        install(FILES "${_inspect_root}/include/umicom/ui/gtk4/${_inspect_header}.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/umicom/ui/gtk4" COMPONENT Framework)
        if(COMMAND umicom_release_inventory_own_headers)
            umicom_release_inventory_own_headers(umicom_ui_gtk4 "include/umicom/ui/gtk4/${_inspect_header}.h")
        endif()
    endforeach()
endif()
install(FILES "${_inspect_root}/docs/guides/source-inspection.html" DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides" COMPONENT Framework)
if(BUILD_TESTING)
    set(_inspect_metrics_cases empty ascii lf crlf cr mixed blank trailing interior unicode nonbmp combining words selection empty-selection selected-crlf owned no-final)
    set(_inspect_unicode_cases two-byte three-byte four-byte largest overlong-two overlong-three overlong-four surrogate above-unicode continuation truncated-two truncated-three truncated-four bad-continuation nul utf8-bom)
    set(_inspect_notices_cases bidi isolate marks zero-width nbsp control tabs locations selected limit over-limit plain)
    set(_inspect_limits_cases arguments existing-output cursor-range selection-range split-scalar split-crlf end zero-span cancel reset oversized exact-limit summary-output notice-output text-output after-input)
    set(_inspect_document_cases capture selection pending readonly inactive edited closed owner-retired identity missing arguments history)
    set(_inspect_native_cases entry readonly selection retained edited inactive repeat close-reopen unbind parent-close constructor-retire arguments)
    foreach(_inspect_group IN ITEMS metrics unicode notices limits document native)
        set(_inspect_owner editor)
        set(_inspect_source "tests/editor/test_text_inspection_${_inspect_group}.c")
        if(_inspect_group STREQUAL "document")
            set(_inspect_owner document)
            set(_inspect_source "tests/document/test_text_inspection.c")
        elseif(_inspect_group STREQUAL "native")
            set(_inspect_owner ui_gtk4)
            set(_inspect_source "tests/document/test_text_inspection_gtk4.c")
        endif()
        if(NOT TARGET umicom_${_inspect_owner})
            continue()
        endif()
        set(_inspect_target "umicom-text-inspection-${_inspect_group}-test")
        add_executable(${_inspect_target} "${_inspect_root}/${_inspect_source}")
        target_link_libraries(${_inspect_target} PRIVATE Umicom::${_inspect_owner})
        set_target_properties(${_inspect_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        umicom_apply_warnings(${_inspect_target})
        umicom_apply_sanitizers(${_inspect_target})
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_inspect_target})
        endif()
        if(COMMAND umicom_target_qualification_inputs)
            umicom_target_qualification_inputs(${_inspect_target} FILES
                "${_inspect_root}/src/editor/text_inspection_internal.h"
                "${_inspect_root}/src/document/text_inspection.inc"
                "${_inspect_root}/tests/document/replacement_fixture.h"
                "${_inspect_root}/tests/document/native_edit_fixture.h")
        endif()
        foreach(_inspect_case IN LISTS _inspect_${_inspect_group}_cases)
            set(_inspect_test "framework.editor.text_inspection.${_inspect_group}.${_inspect_case}")
            add_test(NAME ${_inspect_test} COMMAND ${_inspect_target} ${_inspect_case})
            set_tests_properties(${_inspect_test} PROPERTIES TIMEOUT 60 LABELS "framework;editor;document;inspection;regression")
            if(_inspect_group STREQUAL "native")
                set_tests_properties(${_inspect_test} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "G_DEBUG=fatal-warnings" LABELS "framework;editor;inspection;gtk4;regression")
            endif()
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(${_inspect_test} TARGETS ${_inspect_target})
            endif()
        endforeach()
    endforeach()
endif()
foreach(_inspect_variable IN ITEMS root pair parts header target directory group owner source case test metrics_cases unicode_cases notices_cases limits_cases document_cases native_cases)
    unset(_inspect_${_inspect_variable})
endforeach()
unset(_inspect_variable)
