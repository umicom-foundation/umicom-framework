# Umicom Framework | Sammy Hegab, Umicom Foundation | MIT
# Amendment history is part of the existing Data Server library and export.
# Optional test registration never changes SQLite availability or hides failures.
if(NOT TARGET umicom_data)
    return()
endif()
include_guard(GLOBAL)
get_filename_component(_history_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(COMMAND umicom_release_inventory_own_headers)
    umicom_release_inventory_own_headers(umicom_data
        include/umicom/data/lineage.h include/umicom/data/record_history.h)
endif()
if(COMMAND umicom_target_qualification_inputs)
    # The shared private codec must invalidate affected-test observations too.
    umicom_target_qualification_inputs(umicom_data FILES
        "${_history_root}/src/data/include/record_fields.h")
endif()
foreach(_history_component IN ITEMS Framework FrameworkSDK)
    if(_history_component STREQUAL "FrameworkSDK")
        set(_history_exclude EXCLUDE_FROM_ALL)
    else()
        set(_history_exclude "")
    endif()
    install(DIRECTORY "${_history_root}/examples/data_history/"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/examples/data_history"
        COMPONENT "${_history_component}" ${_history_exclude})
    install(FILES "${_history_root}/docs/guides/record-amendments.html"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/umicom-framework/docs/guides"
        COMPONENT "${_history_component}" ${_history_exclude})
endforeach()
if(BUILD_TESTING)
    find_package(Threads REQUIRED)
    add_executable(umicom-lineage-history-test "${_history_root}/tests/data_history/test_lineage.c")
    add_executable(umicom-record-history-test "${_history_root}/tests/data_history/test_record_history.c")
    add_executable(umicom-record-history-example "${_history_root}/examples/data_history/record_amendments.c")
    target_link_libraries(umicom-record-history-test PRIVATE Threads::Threads)
    foreach(_history_target IN ITEMS umicom-lineage-history-test umicom-record-history-test umicom-record-history-example)
        target_link_libraries(${_history_target} PRIVATE Umicom::data)
        set_target_properties(${_history_target} PROPERTIES C_STANDARD 23 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(COMMAND umicom_apply_warnings)
            umicom_apply_warnings(${_history_target})
        endif()
        if(COMMAND umicom_apply_sanitizers)
            umicom_apply_sanitizers(${_history_target})
        endif()
        if(COMMAND umicom_register_validation_target)
            umicom_register_validation_target(${_history_target})
        endif()
    endforeach()
    foreach(_case IN ITEMS reopen empty-fields failed-save invalid-fields malformed exhaustion)
        add_test(NAME framework.data.lineage.${_case} COMMAND umicom-lineage-history-test ${_case})
        set_tests_properties(framework.data.lineage.${_case} PROPERTIES
            TIMEOUT 30 LABELS "framework;data;lineage;regression")
        if(COMMAND umicom_test_impact_owners)
            umicom_test_impact_owners(framework.data.lineage.${_case} TARGETS umicom-lineage-history-test)
        endif()
    endforeach()
    set(_history_backends memory)
    if(SQLite3_FOUND)
        list(APPEND _history_backends sqlite)
    endif()
    foreach(_backend IN LISTS _history_backends)
        foreach(_case IN ITEMS roundtrip stale nested competing isolation invalid clock orphan corrupt codec)
            add_test(NAME framework.data.history.${_backend}.${_case}
                COMMAND umicom-record-history-test ${_backend} ${_case})
            set_tests_properties(framework.data.history.${_backend}.${_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;history;${_backend};regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.history.${_backend}.${_case} TARGETS umicom-record-history-test)
            endif()
        endforeach()
    endforeach()
    add_test(NAME framework.data.history.memory.capacity COMMAND umicom-record-history-test memory capacity)
    set_tests_properties(framework.data.history.memory.capacity PROPERTIES
        TIMEOUT 60 LABELS "framework;data;history;memory;regression")
    add_test(NAME framework.data.history.example COMMAND umicom-record-history-example)
    set_tests_properties(framework.data.history.example PROPERTIES TIMEOUT 30 LABELS "framework;data;history;example")
    if(COMMAND umicom_test_impact_owners)
        umicom_test_impact_owners(framework.data.history.memory.capacity TARGETS umicom-record-history-test)
        umicom_test_impact_owners(framework.data.history.example TARGETS umicom-record-history-example)
    endif()
    if(SQLite3_FOUND)
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/record-history-fixtures")
        foreach(_case IN ITEMS head-failure commit-failure reopen)
            add_test(NAME framework.data.history.sqlite.${_case}
                COMMAND umicom-record-history-test sqlite ${_case} "${CMAKE_CURRENT_BINARY_DIR}/record-history-fixtures")
            set_tests_properties(framework.data.history.sqlite.${_case} PROPERTIES
                TIMEOUT 30 LABELS "framework;data;history;sqlite;regression")
            if(COMMAND umicom_test_impact_owners)
                umicom_test_impact_owners(framework.data.history.sqlite.${_case} TARGETS umicom-record-history-test)
            endif()
        endforeach()
    endif()
endif()
unset(_history_root)
unset(_history_component)
unset(_history_exclude)
unset(_history_target)
unset(_history_backends)
unset(_backend)
unset(_case)
