@PACKAGE_INIT@
# The optional lifecycle sources use the standard thread dependency.
include(CMakeFindDependencyMacro)
if(@UMICOM_RELEASE_BASELINE_RETAIN_LIFECYCLE@)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UmicomReleaseBaselineTargets.cmake")
check_required_components(UmicomReleaseBaseline)
